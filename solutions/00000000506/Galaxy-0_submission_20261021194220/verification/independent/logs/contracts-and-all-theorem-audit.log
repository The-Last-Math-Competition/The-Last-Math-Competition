def TLMC506.IsIdeal : (TLMC506.Poly → Prop) → Prop :=
fun I =>
  I TLMC506.zero ∧
    (∀ (p q : TLMC506.Poly), I p → I q → I (TLMC506.add p q)) ∧ ∀ (p q : TLMC506.Poly), I q → I (TLMC506.mul p q)
def TLMC506.IsMonomial : TLMC506.Poly → Prop :=
fun p => ∃ a b, ∀ (i j : Nat), p.coeff i j = decide (i = a ∧ j = b)
def TLMC506.IsTwoMonomialGeneratedIdeal : (TLMC506.Poly → Prop) → Prop :=
fun I =>
  TLMC506.IsIdeal I ∧
    ∃ g h,
      TLMC506.IsMonomial g ∧
        TLMC506.IsMonomial h ∧ ∀ (p : TLMC506.Poly), I p ↔ ∃ a b, p = TLMC506.add (TLMC506.mul g a) (TLMC506.mul h b)
def TLMC506.IsSyzygy : TLMC506.FreeTwo → Prop :=
fun v => TLMC506.augmentation v = TLMC506.zero
def TLMC506.PresentationHomogeneousZ : TLMC506.FreeTwo → Int → Prop :=
fun v d => TLMC506.ShiftHomogeneousZ v.fst 1 d ∧ TLMC506.ShiftHomogeneousZ v.snd 1 d
def TLMC506.FirstBettiSupportZ : Int → Prop :=
fun d => ∃ v, TLMC506.IsSyzygy v ∧ TLMC506.PresentationHomogeneousZ v d ∧ ¬TLMC506.InMaximalTimesSyzygy v
def TLMC506.InMaximalTimesSyzygy : TLMC506.FreeTwo → Prop :=
fun v => ∃ a b, TLMC506.IsSyzygy a ∧ TLMC506.IsSyzygy b ∧ v = TLMC506.pairAdd (TLMC506.pairX a) (TLMC506.pairY b)
inductive TLMC506.IdealSyzygyProduct : TLMC506.FreeTwo → Prop
number of parameters: 0
constructors:
TLMC506.IdealSyzygyProduct.zero : TLMC506.IdealSyzygyProduct TLMC506.pairZero
TLMC506.IdealSyzygyProduct.single : ∀ (p : TLMC506.Poly) (v : TLMC506.FreeTwo),
  TLMC506.InIdeal p → TLMC506.IsSyzygy v → TLMC506.IdealSyzygyProduct (TLMC506.pairMul p v)
TLMC506.IdealSyzygyProduct.add : ∀ {v w : TLMC506.FreeTwo},
  TLMC506.IdealSyzygyProduct v → TLMC506.IdealSyzygyProduct w → TLMC506.IdealSyzygyProduct (TLMC506.pairAdd v w)
def TLMC506.SyzygyResidueEq : TLMC506.Syzygy → TLMC506.Syzygy → Prop :=
fun s t => TLMC506.InMaximalTimesSyzygy (TLMC506.pairAdd s.val t.val)
def TLMC506.VerifiedMinimalResolution : Prop :=
(∀ (p : TLMC506.Poly), TLMC506.InIdeal p → ∃ v, TLMC506.augmentation v = p) ∧
  (∀ (v : TLMC506.FreeTwo), TLMC506.IsSyzygy v ↔ ∃ h, v = TLMC506.koszul h) ∧
    (∀ (p q : TLMC506.Poly), TLMC506.koszul p = TLMC506.koszul q → p = q) ∧
      (∀ (p q : TLMC506.Poly),
          TLMC506.koszul (TLMC506.add p q) = TLMC506.pairAdd (TLMC506.koszul p) (TLMC506.koszul q)) ∧
        (∀ (p q : TLMC506.Poly), TLMC506.koszul (TLMC506.mul p q) = TLMC506.pairMul p (TLMC506.koszul q)) ∧
          (∀ (v w : TLMC506.FreeTwo),
              TLMC506.augmentation (TLMC506.pairAdd v w) =
                TLMC506.add (TLMC506.augmentation v) (TLMC506.augmentation w)) ∧
            (∀ (p : TLMC506.Poly) (v : TLMC506.FreeTwo),
                TLMC506.augmentation (TLMC506.pairMul p v) = TLMC506.mul p (TLMC506.augmentation v)) ∧
              (∀ (h : TLMC506.Poly) (d : Nat),
                  TLMC506.PresentationHomogeneous (TLMC506.koszul h) d ↔ TLMC506.ShiftHomogeneous h 2 d) ∧
                (∀ (v : TLMC506.FreeTwo) (d : Nat),
                    TLMC506.PresentationHomogeneous v d → TLMC506.Homogeneous (TLMC506.augmentation v) d) ∧
                  (∀ (h : TLMC506.Poly),
                      TLMC506.InIdeal (TLMC506.koszul h).fst ∧ TLMC506.InIdeal (TLMC506.koszul h).snd) ∧
                    ∀ (p : TLMC506.Poly),
                      TLMC506.InIdeal p →
                        ∃ a b,
                          TLMC506.InMaximalTimesIdeal (TLMC506.add p (TLMC506.generatorCombination a b)) ∧
                            ∀ (a' b' : Bool),
                              TLMC506.InMaximalTimesIdeal (TLMC506.add p (TLMC506.generatorCombination a' b')) →
                                a' = a ∧ b' = b
def TLMC506.IsolatedInSubset : {α : Type} → ((α → Prop) → Prop) → (α → Prop) → α → Prop :=
fun {α} isOpen S j => S j ∧ ∃ U, isOpen U ∧ U j ∧ ∀ (k : α), U k → S k → k = j
def TLMC506.NoIsolatedPoints : {α : Type} → ((α → Prop) → Prop) → (α → Prop) → Prop :=
fun {α} isOpen S => ¬∃ j, TLMC506.IsolatedInSubset isOpen S j
