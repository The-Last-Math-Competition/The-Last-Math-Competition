import PolynomialCore

namespace TLMC506

def dropX (p : Poly) : Poly where
  coeff i j := p.coeff (i+1) j
  finite := by
    obtain ⟨N, hN⟩ := p.finite
    refine ⟨N, ?_⟩
    intro i j hij
    exact hN (i+1) j (by omega)

def dropY (p : Poly) : Poly where
  coeff i j := p.coeff i (j+1)
  finite := by
    obtain ⟨N, hN⟩ := p.finite
    refine ⟨N, ?_⟩
    intro i j hij
    exact hN i (j+1) (by omega)

def axisY (p : Poly) : Poly where
  coeff i j := if i = 0 then p.coeff 0 (j+1) else false
  finite := by
    obtain ⟨N, hN⟩ := p.finite
    refine ⟨N, ?_⟩
    intro i j hij
    by_cases hi : i = 0
    · simp only [hi]
      exact hN 0 (j+1) (by omega)
    · simp only [hi, if_false]

def constant (c : Bool) : Poly where
  coeff i j := c && decide (i = 0 ∧ j = 0)
  finite := by
    refine ⟨1, ?_⟩
    intro i j hij
    have h : ¬ (i = 0 ∧ j = 0) := by omega
    simp [h]

def scale (c : Bool) (p : Poly) : Poly where
  coeff i j := c && p.coeff i j
  finite := by
    obtain ⟨N, hN⟩ := p.finite
    refine ⟨N, ?_⟩
    intro i j hij
    simp only [hN i j hij, Bool.and_false]

@[simp] theorem dropX_coeff (p : Poly) (i j : Nat) :
    (dropX p).coeff i j = p.coeff (i+1) j := rfl
@[simp] theorem dropY_coeff (p : Poly) (i j : Nat) :
    (dropY p).coeff i j = p.coeff i (j+1) := rfl
@[simp] theorem constant_coeff (c : Bool) (i j : Nat) :
    (constant c).coeff i j = (c && decide (i = 0 ∧ j = 0)) := rfl
@[simp] theorem scale_coeff (c : Bool) (p : Poly) (i j : Nat) :
    (scale c p).coeff i j = (c && p.coeff i j) := rfl
@[simp] theorem constant_false : constant false = zero := by
  apply Poly.ext; intros; rfl
@[simp] theorem constant_true : constant true = one := by
  apply Poly.ext; intros; rfl
@[simp] theorem scale_false (p : Poly) : scale false p = zero := by
  apply Poly.ext; intros; rfl
@[simp] theorem scale_true (p : Poly) : scale true p = p := by
  apply Poly.ext; intros; rfl

theorem constant_split (p : Poly) :
    p = add (constant (p.coeff 0 0)) (add (xMul (dropX p)) (yMul (axisY p))) := by
  apply Poly.ext; intro i j
  cases i with
  | zero => cases j <;> simp [axisY]
  | succ i => cases j <;> simp [axisY]

/-- The ideal generated by the two monomials X and Y, in concrete coordinates. -/
def InIdeal (p : Poly) : Prop :=
  ∃ a b : Poly, p = add (xMul a) (yMul b)

theorem ideal_iff_constant_zero (p : Poly) : InIdeal p ↔ p.coeff 0 0 = false := by
  constructor
  · rintro ⟨a, b, rfl⟩; rfl
  · intro h
    refine ⟨dropX p, axisY p, ?_⟩
    simpa only [h, constant_false, zero_add] using constant_split p

theorem X_in_ideal : InIdeal X := by
  refine ⟨one, zero, ?_⟩
  simp [X]
theorem Y_in_ideal : InIdeal Y := by
  refine ⟨zero, one, ?_⟩
  simp [Y]
theorem zero_in_ideal : InIdeal zero := (ideal_iff_constant_zero _).mpr rfl
theorem add_in_ideal {p q : Poly} (hp : InIdeal p) (hq : InIdeal q) : InIdeal (add p q) := by
  rw [ideal_iff_constant_zero] at hp hq ⊢
  simp only [add_coeff, hp, hq, Bool.false_xor]
theorem xMul_in_ideal (p : Poly) : InIdeal (xMul p) :=
  (ideal_iff_constant_zero _).mpr rfl
theorem yMul_in_ideal (p : Poly) : InIdeal (yMul p) :=
  (ideal_iff_constant_zero _).mpr rfl

abbrev FreeTwo := Poly × Poly
def pairZero : FreeTwo := (zero, zero)
def pairAdd (v w : FreeTwo) : FreeTwo := (add v.1 w.1, add v.2 w.2)
def pairX (v : FreeTwo) : FreeTwo := (xMul v.1, xMul v.2)
def pairY (v : FreeTwo) : FreeTwo := (yMul v.1, yMul v.2)
def pairScale (c : Bool) (v : FreeTwo) : FreeTwo := (scale c v.1, scale c v.2)

/-- Augmentation R(-1)^2 → I, (a,b) ↦ Xa+Yb. -/
def augmentation (v : FreeTwo) : Poly := add (xMul v.1) (yMul v.2)
def IsSyzygy (v : FreeTwo) : Prop := augmentation v = zero
abbrev Syzygy := {v : FreeTwo // IsSyzygy v}

/-- In characteristic two the Koszul relation (-Y,X) equals (Y,X). -/
def koszul (h : Poly) : FreeTwo := (yMul h, xMul h)

theorem koszul_syzygy (h : Poly) : IsSyzygy (koszul h) := by
  unfold IsSyzygy augmentation koszul
  rw [xMul_yMul, add_self]

theorem syzygy_boundary_x {v : FreeTwo} (hv : IsSyzygy v) (i : Nat) :
    v.1.coeff i 0 = false := by
  have h := congrArg (fun p : Poly => p.coeff (i+1) 0) hv
  simpa [augmentation] using h

theorem syzygy_boundary_y {v : FreeTwo} (hv : IsSyzygy v) (j : Nat) :
    v.2.coeff 0 j = false := by
  have h := congrArg (fun p : Poly => p.coeff 0 (j+1)) hv
  simpa [augmentation] using h

theorem syzygy_coeff_relation {v : FreeTwo} (hv : IsSyzygy v) (i j : Nat) :
    v.1.coeff i (j+1) = v.2.coeff (i+1) j := by
  have h := congrArg (fun p : Poly => p.coeff (i+1) (j+1)) hv
  exact (xor_eq_false_iff _ _).mp h

/-- All first syzygies, not merely the displayed relation, are computed. -/
theorem syzygy_parametrization {v : FreeTwo} (hv : IsSyzygy v) :
    v = koszul (dropY v.1) := by
  apply Prod.ext
  · apply Poly.ext; intro i j
    cases j with
    | zero => exact syzygy_boundary_x hv i
    | succ j => rfl
  · apply Poly.ext; intro i j
    cases i with
    | zero => exact syzygy_boundary_y hv j
    | succ i => exact (syzygy_coeff_relation hv i j).symm

theorem koszul_injective {p q : Poly} (h : koszul p = koszul q) : p = q :=
  yMul_injective (congrArg Prod.fst h)

theorem kernel_exact (v : FreeTwo) :
    IsSyzygy v ↔ ∃ h : Poly, v = koszul h := by
  constructor
  · intro hv; exact ⟨dropY v.1, syzygy_parametrization hv⟩
  · rintro ⟨h, rfl⟩; exact koszul_syzygy h

theorem kernel_free_rank_one (v : FreeTwo) (hv : IsSyzygy v) :
    ∃ h : Poly, v = koszul h ∧ ∀ h', v = koszul h' → h' = h := by
  refine ⟨dropY v.1, syzygy_parametrization hv, ?_⟩
  intro h' hh'
  exact koszul_injective (hh'.symm.trans (syzygy_parametrization hv))

theorem koszul_add (p q : Poly) : koszul (add p q) = pairAdd (koszul p) (koszul q) := by
  apply Prod.ext
  · exact yMul_add p q
  · exact xMul_add p q
theorem koszul_x (p : Poly) : koszul (xMul p) = pairX (koszul p) := by
  apply Prod.ext
  · exact (xMul_yMul p).symm
  · rfl
theorem koszul_y (p : Poly) : koszul (yMul p) = pairY (koszul p) := by
  apply Prod.ext
  · rfl
  · exact xMul_yMul p
theorem koszul_zero : koszul zero = pairZero := by simp [koszul, pairZero]
theorem koszul_scale (c : Bool) (p : Poly) :
    koszul (scale c p) = pairScale c (koszul p) := by
  cases c <;> simp [pairScale, koszul_zero, pairZero]

/-- Membership in the homogeneous maximal ideal times the first syzygy module. -/
def InMaximalTimesSyzygy (v : FreeTwo) : Prop :=
  ∃ a b : FreeTwo, IsSyzygy a ∧ IsSyzygy b ∧ v = pairAdd (pairX a) (pairY b)

theorem koszul_in_maximal_iff (h : Poly) :
    InMaximalTimesSyzygy (koszul h) ↔ h.coeff 0 0 = false := by
  constructor
  · rintro ⟨a, b, ha, hb, heq⟩
    rw [syzygy_parametrization ha, syzygy_parametrization hb,
      ← koszul_x, ← koszul_y, ← koszul_add] at heq
    have eq := koszul_injective heq
    have hc := congrArg (fun p : Poly => p.coeff 0 0) eq
    exact hc
  · intro h0
    obtain ⟨a, b, hab⟩ := (ideal_iff_constant_zero h).mpr h0
    refine ⟨koszul a, koszul b, koszul_syzygy a, koszul_syzygy b, ?_⟩
    rw [hab, koszul_add, koszul_x, koszul_y]

end TLMC506
