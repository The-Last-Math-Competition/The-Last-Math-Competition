import Mathlib.Combinatorics.SimpleGraph.Finite
import Mathlib.Combinatorics.SimpleGraph.Path
import Mathlib.Probability.Distributions.Uniform
import Mathlib.MeasureTheory.Measure.Dirac
import Mathlib.Tactic

open MeasureTheory Filter
open scoped ENNReal Topology BigOperators

namespace Conjecture9305
noncomputable section

/-- The usual objects before taking rooted isomorphism classes.  Both finite
    and countably infinite connected locally finite graphs are included. -/
structure RootedGraph where
  V : Type
  graph : SimpleGraph V
  root : V
  countable : Countable V
  connected : graph.Connected
  locallyFinite : ∀ v, (graph.neighborSet v).Finite

def RootIso (G H : RootedGraph) : Prop :=
  ∃ e : G.graph ≃g H.graph, e G.root = H.root

lemma rootIso_refl (G : RootedGraph) : RootIso G G :=
  ⟨SimpleGraph.Iso.refl, rfl⟩

lemma rootIso_symm {G H : RootedGraph} (h : RootIso G H) : RootIso H G := by
  rcases h with ⟨e, he⟩
  exact ⟨e.symm, by rw [← he]; simp⟩

lemma rootIso_trans {G H K : RootedGraph} (h : RootIso G H) (h' : RootIso H K) :
    RootIso G K := by
  rcases h with ⟨e, he⟩
  rcases h' with ⟨f, hf⟩
  exact ⟨e.trans f, (congrArg f he).trans hf⟩

instance rootedSetoid : Setoid RootedGraph where
  r := RootIso
  iseqv := ⟨rootIso_refl, rootIso_symm, rootIso_trans⟩

/-- Actual rooted graph isomorphism classes, rather than vertex labels. -/
abbrev RootedSpace := Quotient rootedSetoid
def rootedClass (G : RootedGraph) : RootedSpace := Quotient.mk _ G

/-- Membership in the graph-distance ball, defined by genuine graph walks. -/
def Near (G : RootedGraph) (r : ℕ) (v : G.V) : Prop :=
  ∃ p : G.graph.Walk G.root v, p.length ≤ r

def ballGraph (G : RootedGraph) (r : ℕ) := G.graph.induce {v | Near G r v}
def ballRoot (G : RootedGraph) (r : ℕ) : {v : G.V // Near G r v} :=
  ⟨G.root, ⟨SimpleGraph.Walk.nil, Nat.zero_le _⟩⟩

def BallIso (G H : RootedGraph) (r : ℕ) : Prop :=
  ∃ e : ballGraph G r ≃g ballGraph H r, e (ballRoot G r) = ballRoot H r

lemma near_iso {G H : RootedGraph} (e : G.graph ≃g H.graph)
    (he : e G.root = H.root) (r : ℕ) (v : G.V) :
    Near G r v ↔ Near H r (e v) := by
  constructor
  · rintro ⟨p, hp⟩
    unfold Near
    rw [← he]
    exact ⟨p.map e.toHom, by simpa using hp⟩
  · rintro ⟨p, hp⟩
    have hr : e.symm H.root = G.root := by rw [← he]; simp
    unfold Near
    rw [← hr, ← e.symm_apply_apply v]
    exact ⟨p.map e.symm.toHom, by simpa using hp⟩

def ballIsoOfIso {G H : RootedGraph} (e : G.graph ≃g H.graph)
    (he : e G.root = H.root) (r : ℕ) : ballGraph G r ≃g ballGraph H r where
  toFun x := ⟨e x, (near_iso e he r x).mp x.property⟩
  invFun y := ⟨e.symm y, by
    have := (near_iso e he r (e.symm y)).mpr (by
      rw [e.apply_symm_apply]; exact y.property)
    exact this⟩
  left_inv x := by ext; simp
  right_inv y := by ext; simp
  map_rel_iff' := by intro a b; exact e.map_rel_iff

lemma rootIso_ballIso {G H : RootedGraph} (h : RootIso G H) (r : ℕ) : BallIso G H r := by
  rcases h with ⟨e, he⟩
  exact ⟨ballIsoOfIso e he r, by ext; exact he⟩

/-- A radius-r cylinder, on rooted isomorphism classes. -/
def cylinder (H : RootedGraph) (r : ℕ) : Set RootedSpace :=
  {x | ∃ G, rootedClass G = x ∧ BallIso G H r}

/-- The standard local sigma algebra generated by finite-radius cylinders. -/
instance : MeasurableSpace RootedSpace :=
  MeasurableSpace.generateFrom {s | ∃ H r, s = cylinder H r}

lemma measurable_cylinder (H : RootedGraph) (r : ℕ) : MeasurableSet (cylinder H r) :=
  MeasurableSpace.measurableSet_generateFrom ⟨H, r, rfl⟩

def VertexTransitive (G : RootedGraph) : Prop :=
  ∀ u v : G.V, ∃ e : G.graph ≃g G.graph, e u = v

def transitiveClasses : Set RootedSpace :=
  {x | ∃ G, rootedClass G = x ∧ VertexTransitive G}

def vertexDegree (G : RootedGraph) (v : G.V) : ℕ := Nat.card (G.graph.neighborSet v)

lemma degree_iso {G H : RootedGraph} (e : G.graph ≃g H.graph) (v : G.V) :
    vertexDegree G v = vertexDegree H (e v) :=
  Nat.card_congr (e.mapNeighborSet v)

lemma transitive_degree_eq {G : RootedGraph} (h : VertexTransitive G) (u v : G.V) :
    vertexDegree G u = vertexDegree G v := by
  rcases h u v with ⟨e, he⟩
  simpa [he] using degree_iso e u

lemma near_of_adj (G : RootedGraph) {v : G.V} (h : G.graph.Adj G.root v) :
    Near G 2 v :=
  ⟨SimpleGraph.Walk.cons h SimpleGraph.Walk.nil, by simp⟩

lemma neighbor_near_two (G : RootedGraph) {v w : G.V}
    (h : G.graph.Adj G.root v) (h' : G.graph.Adj v w) : Near G 2 w :=
  ⟨SimpleGraph.Walk.cons h (SimpleGraph.Walk.cons h' SimpleGraph.Walk.nil), by simp⟩

def neighborBallEquiv (G : RootedGraph) (r : ℕ) (v : {v : G.V // Near G r v})
    (h : ∀ w, G.graph.Adj v.val w → Near G r w) :
    (ballGraph G r).neighborSet v ≃ G.graph.neighborSet v.val where
  toFun w := ⟨w.val.val, w.property⟩
  invFun w := ⟨⟨w.val, h w.val w.property⟩, w.property⟩
  left_inv w := by ext; rfl
  right_inv w := by ext; rfl

lemma degree_ball (G : RootedGraph) (r : ℕ) (v : {v : G.V // Near G r v})
    (h : ∀ w, G.graph.Adj v.val w → Near G r w) :
    Nat.card ((ballGraph G r).neighborSet v) = vertexDegree G v.val :=
  Nat.card_congr (neighborBallEquiv G r v h)

lemma ball_root_degree (G : RootedGraph) :
    Nat.card ((ballGraph G 2).neighborSet (ballRoot G 2)) = vertexDegree G G.root := by
  apply degree_ball
  exact fun _ h => near_of_adj G h

lemma ball_neighbor_degree (G : RootedGraph) (v : {v : G.V // Near G 2 v})
    (h : (ballGraph G 2).Adj (ballRoot G 2) v) :
    Nat.card ((ballGraph G 2).neighborSet v) = vertexDegree G v.val := by
  apply degree_ball
  exact fun _ h' => neighbor_near_two G h h'

def p3 : SimpleGraph (Fin 3) where
  Adj a b := a ≠ b ∧ (a = 1 ∨ b = 1)
  symm := by intro a b h; exact ⟨h.1.symm, h.2.symm⟩
  loopless := by intro a h; exact h.1 rfl

instance : DecidableRel p3.Adj := fun a b => inferInstanceAs (Decidable (a ≠ b ∧ (a = 1 ∨ b = 1)))

lemma p3_walk_two (a b : Fin 3) : ∃ p : p3.Walk a b, p.length ≤ 2 := by
  fin_cases a <;> fin_cases b
  all_goals first
    | exact ⟨SimpleGraph.Walk.nil, by decide⟩
    | exact ⟨SimpleGraph.Walk.cons (by decide) SimpleGraph.Walk.nil, by decide⟩
    | exact ⟨SimpleGraph.Walk.cons (show p3.Adj _ 1 by decide)
        (SimpleGraph.Walk.cons (by decide) SimpleGraph.Walk.nil), by decide⟩

def pathRooted (r : Fin 3) : RootedGraph where
  V := Fin 3
  graph := p3
  root := r
  countable := inferInstance
  connected := ⟨fun a b => ⟨(p3_walk_two a b).choose⟩⟩
  locallyFinite := fun _ => Set.toFinite _

lemma path_all_near (r v : Fin 3) : Near (pathRooted r) 2 v := p3_walk_two r v

lemma path_degree (r v : Fin 3) :
    vertexDegree (pathRooted r) v = if v = 1 then 2 else 1 := by
  change Nat.card (p3.neighborSet v) = _
  rw [Nat.card_eq_fintype_card]
  fin_cases v <;> decide

lemma path_unequal_neighbor (r : Fin 3) :
    ∃ v : Fin 3, p3.Adj r v ∧ vertexDegree (pathRooted r) r ≠ vertexDegree (pathRooted r) v := by
  fin_cases r
  · exact ⟨1, by decide, by simp [path_degree]⟩
  · exact ⟨0, by decide, by simp [path_degree]⟩
  · exact ⟨1, by decide, by simp [path_degree]⟩

/-- The radius-two obstruction uses full degrees of the root and its neighbor.
    It does not incorrectly identify the whole graph from its radius-two ball. -/
theorem ball_path_not_transitive (G : RootedGraph) (r : Fin 3)
    (h : BallIso G (pathRooted r) 2) : ¬ VertexTransitive G := by
  intro htrans
  rcases h with ⟨e, he⟩
  rcases path_unequal_neighbor r with ⟨v, hv, hdeg⟩
  let b : {v : Fin 3 // Near (pathRooted r) 2 v} := ⟨v, path_all_near r v⟩
  let a := e.symm b
  have ha : (ballGraph G 2).Adj (ballRoot G 2) a := by
    apply e.map_rel_iff.mp
    change (ballGraph (pathRooted r) 2).Adj (e (ballRoot G 2)) (e (e.symm b))
    rw [he, e.apply_symm_apply]
    exact hv
  have hroot := Nat.card_congr (e.mapNeighborSet (ballRoot G 2))
  have hvtx := Nat.card_congr (e.mapNeighborSet a)
  rw [he, ball_root_degree G, ball_root_degree (pathRooted r)] at hroot
  rw [ball_neighbor_degree G a ha] at hvtx
  have hb : (ballGraph (pathRooted r) 2).Adj (ballRoot (pathRooted r) 2) b := hv
  have hba : e a = b := e.apply_symm_apply b
  rw [hba, ball_neighbor_degree (pathRooted r) b hb] at hvtx
  apply hdeg
  calc
    vertexDegree (pathRooted r) r = vertexDegree G G.root := hroot.symm
    _ = vertexDegree G a.val := transitive_degree_eq htrans _ _
    _ = vertexDegree (pathRooted r) v := hvtx

lemma ballIso_symm {G H : RootedGraph} {r : ℕ} (h : BallIso G H r) : BallIso H G r := by
  rcases h with ⟨e, he⟩
  exact ⟨e.symm, by rw [← he]; simp⟩

lemma ballIso_trans {G H K : RootedGraph} {r : ℕ}
    (h : BallIso G H r) (h' : BallIso H K r) : BallIso G K r := by
  rcases h with ⟨e, he⟩
  rcases h' with ⟨f, hf⟩
  exact ⟨e.trans f, (congrArg f he).trans hf⟩

def obstruction : Set RootedSpace := ⋃ r : Fin 3, cylinder (pathRooted r) 2

lemma measurable_obstruction : MeasurableSet obstruction :=
  MeasurableSet.iUnion fun r => measurable_cylinder (pathRooted r) 2

lemma path_mem_obstruction (r : Fin 3) : rootedClass (pathRooted r) ∈ obstruction := by
  apply Set.mem_iUnion.mpr
  exact ⟨r, pathRooted r, rfl, rootIso_ballIso (rootIso_refl _) 2⟩

theorem obstruction_excludes_transitive {x : RootedSpace}
    (hx : x ∈ obstruction) : x ∉ transitiveClasses := by
  rcases Set.mem_iUnion.mp hx with ⟨r, G, hG, hball⟩
  rintro ⟨H, hH, htrans⟩
  have hi : RootIso H G := Quotient.exact (hH.trans hG.symm)
  exact ball_path_not_transitive H r
    (ballIso_trans (rootIso_ballIso hi 2) hball) htrans

/-- The finite graphs really are disjoint unions of m+1 copies of P3. -/
def copies (m : ℕ) : SimpleGraph (Fin (m+1) × Fin 3) where
  Adj a b := a.1 = b.1 ∧ p3.Adj a.2 b.2
  symm := by intro a b h; exact ⟨h.1.symm, p3.symm h.2⟩
  loopless := by intro a h; exact p3.loopless a.2 h.2

def copyHom (m : ℕ) (i : Fin (m+1)) : p3 →g copies m where
  toFun v := (i,v)
  map_rel' := fun h => ⟨rfl, h⟩

lemma walk_same_copy (m : ℕ) {a b : Fin (m+1) × Fin 3} (p : (copies m).Walk a b) :
    a.1 = b.1 := by
  induction p with
  | nil => rfl
  | cons h _ ih => exact h.1.trans ih

lemma reachable_copy (m : ℕ) (a : Fin (m+1) × Fin 3) (v : Fin 3) :
    (copies m).Reachable a (a.1,v) := by
  rcases p3_walk_two a.2 v with ⟨p, _⟩
  exact ⟨p.map (copyHom m a.1)⟩

def componentIso (m : ℕ) (a : Fin (m+1) × Fin 3) :
    (copies m).induce {v | (copies m).Reachable a v} ≃g p3 where
  toFun w := w.val.2
  invFun v := ⟨(a.1,v), reachable_copy m a v⟩
  left_inv w := by
    apply Subtype.ext
    apply Prod.ext
    · have hw : a.1 = w.val.1 := walk_same_copy m w.property.some
      exact hw
    · rfl
  right_inv _ := rfl
  map_rel_iff' := by
    intro u v
    constructor
    · intro h
      exact ⟨(walk_same_copy m u.property.some).symm.trans
        (walk_same_copy m v.property.some), h⟩
    · exact fun h => h.2

def componentRooted (m : ℕ) (a : Fin (m+1) × Fin 3) : RootedGraph where
  V := {v | (copies m).Reachable a v}
  graph := (copies m).induce {v | (copies m).Reachable a v}
  root := ⟨a, SimpleGraph.Reachable.refl a⟩
  countable := inferInstance
  connected := (pathRooted a.2).connected.map (componentIso m a).symm.toHom
    (componentIso m a).symm.surjective
  locallyFinite := fun _ => Set.toFinite _

lemma component_class (m : ℕ) (a : Fin (m+1) × Fin 3) :
    rootedClass (componentRooted m a) = rootedClass (pathRooted a.2) :=
  Quotient.sound ⟨componentIso m a, rfl⟩

def pathPMF : PMF RootedSpace :=
  (PMF.uniformOfFintype (Fin 3)).map (fun r => rootedClass (pathRooted r))

def uniformRootPMF (m : ℕ) : PMF RootedSpace :=
  (PMF.uniformOfFintype (Fin (m+1) × Fin 3)).map (fun a => rootedClass (componentRooted m a))

lemma uniform_product_second (m : ℕ) :
    (PMF.uniformOfFintype (Fin (m+1) × Fin 3)).map Prod.snd =
      PMF.uniformOfFintype (Fin 3) := by
  classical
  ext b
  simp only [PMF.map_apply, tsum_fintype, PMF.uniformOfFintype_apply,
    Fintype.card_prod, Fintype.card_fin, Finset.sum_product]
  rw [Fintype.sum_prod_type]
  simp only [Prod.snd, Finset.sum_ite_eq, Finset.sum_ite_eq', Finset.mem_univ, if_true]
  simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  rw [Nat.cast_mul, ENNReal.mul_inv]
  rw [← mul_assoc, ENNReal.mul_inv_cancel (by simp) (by simp), one_mul]
  all_goals simp

theorem uniformRootPMF_eq (m : ℕ) : uniformRootPMF m = pathPMF := by
  have hf : (fun a => rootedClass (componentRooted m a)) =
      (fun a : Fin (m+1) × Fin 3 => rootedClass (pathRooted a.2)) :=
    funext (component_class m)
  unfold uniformRootPMF pathPMF
  rw [hf]
  change (PMF.uniformOfFintype (Fin (m+1) × Fin 3)).map
    ((fun r => rootedClass (pathRooted r)) ∘ Prod.snd) = _
  rw [← PMF.map_comp, uniform_product_second]

def pathLaw : Measure RootedSpace := pathPMF.toMeasure
def uniformRootLaw (m : ℕ) : Measure RootedSpace := (uniformRootPMF m).toMeasure

instance : IsProbabilityMeasure pathLaw := by unfold pathLaw; infer_instance
instance (m : ℕ) : IsProbabilityMeasure (uniformRootLaw m) := by
  unfold uniformRootLaw; infer_instance

theorem uniformRootLaw_eq (m : ℕ) : uniformRootLaw m = pathLaw := by
  simp only [uniformRootLaw, pathLaw, uniformRootPMF_eq]

/-- The usual definition of local weak convergence by probabilities of rooted
    graph-distance-ball isomorphism cylinders. -/
def LocallyWeakConverges (μ : ℕ → Measure RootedSpace) (ν : Measure RootedSpace) : Prop :=
  ∀ H r, Tendsto (fun m => μ m (cylinder H r)) atTop (nhds (ν (cylinder H r)))

theorem copies_local_weak_limit : LocallyWeakConverges uniformRootLaw pathLaw := by
  intro H r
  simp only [uniformRootLaw_eq]
  exact tendsto_const_nhds

theorem vertex_count_unbounded : Tendsto (fun m => Fintype.card (Fin (m+1) × Fin 3)) atTop atTop := by
  simp only [Fintype.card_prod, Fintype.card_fin]
  exact tendsto_atTop_mono (fun m => show m ≤ (m+1)*3 by omega) tendsto_id

theorem pathLaw_obstruction : pathLaw obstruction = 1 := by
  apply (PMF.toMeasure_apply_eq_one_iff pathPMF obstruction measurable_obstruction).mpr
  intro x hx
  rcases (PMF.mem_support_map_iff _ _ _).mp hx with ⟨r, _, hr⟩
  rw [← hr]
  exact path_mem_obstruction r

def ConcentratedOnTransitive (μ : Measure RootedSpace) : Prop :=
  ∀ᵐ x ∂μ, x ∈ transitiveClasses

theorem transitiveLaw_obstruction_zero (μ : Measure RootedSpace)
    (h : ConcentratedOnTransitive μ) : μ obstruction = 0 := by
  have hz : ∀ᵐ x ∂μ, x ∉ obstruction := h.mono fun _ hx ho =>
    obstruction_excludes_transitive ho hx
  simpa only [ae_iff, not_not, Set.setOf_mem_eq] using hz

/-- A barycentric decomposition is impossible even without requiring its
    component measures to be extreme.  This therefore refutes the stronger
    asserted decomposition into extreme laws supported on transitive graphs. -/
theorem no_transitive_barycentric_decomposition {I : Type*} [MeasurableSpace I]
    (mixing : Measure I) (components : I → Measure RootedSpace)
    (hsupport : ∀ᵐ i ∂mixing, ConcentratedOnTransitive (components i)) :
    ¬ (∀ s, MeasurableSet s → pathLaw s = ∫⁻ i, components i s ∂mixing) := by
  intro hdecomp
  have hz : (fun i => components i obstruction) =ᵐ[mixing] fun _ => 0 :=
    hsupport.mono fun i hi => transitiveLaw_obstruction_zero (components i) hi
  have heq := hdecomp obstruction measurable_obstruction
  rw [pathLaw_obstruction, lintegral_congr_ae hz, lintegral_zero] at heq
  exact one_ne_zero heq

#print axioms copies_local_weak_limit
#print axioms uniformRootPMF_eq
#print axioms vertex_count_unbounded
#print axioms obstruction_excludes_transitive
#print axioms pathLaw_obstruction
#print axioms no_transitive_barycentric_decomposition

end
end Conjecture9305
