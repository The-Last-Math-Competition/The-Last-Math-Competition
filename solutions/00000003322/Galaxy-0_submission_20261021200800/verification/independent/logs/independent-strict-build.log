TLMC506.polynomial_ring_laws :
  (∀ (p q : TLMC506.Poly), TLMC506.add p q = TLMC506.add q p) ∧
    (∀ (p q r : TLMC506.Poly), TLMC506.add (TLMC506.add p q) r = TLMC506.add p (TLMC506.add q r)) ∧
      (∀ (p : TLMC506.Poly), TLMC506.add p TLMC506.zero = p) ∧
        (∀ (p : TLMC506.Poly), TLMC506.add p p = TLMC506.zero) ∧
          (∀ (p q : TLMC506.Poly), TLMC506.mul p q = TLMC506.mul q p) ∧
            (∀ (p q r : TLMC506.Poly), TLMC506.mul (TLMC506.mul p q) r = TLMC506.mul p (TLMC506.mul q r)) ∧
              (∀ (p : TLMC506.Poly), TLMC506.mul TLMC506.one p = p) ∧
                ∀ (p q r : TLMC506.Poly),
                  TLMC506.mul p (TLMC506.add q r) = TLMC506.add (TLMC506.mul p q) (TLMC506.mul p r)
'TLMC506.polynomial_ring_laws' depends on axioms: [propext, Classical.choice, Quot.sound]
