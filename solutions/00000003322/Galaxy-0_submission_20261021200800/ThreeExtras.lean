import ThreeRing
namespace ThreePoly

/-- Divide the restriction to the plane X=0 by Y, after removing its Y=0 face. -/
def axisY (p : Poly) : Poly where
  coeff i j k := if i = 0 then p.coeff 0 (j+1) k else false
  finite := by
    obtain ⟨N,hN⟩ := p.finite
    refine ⟨N, ?_⟩
    intro i j k h
    by_cases hi : i=0
    · simp only [hi]
      exact hN 0 (j+1) k (by omega)
    · simp [hi]

/-- Divide the restriction to the Z-axis by Z, after removing its constant. -/
def axisZ (p : Poly) : Poly where
  coeff i j k := if i = 0 ∧ j = 0 then p.coeff 0 0 (k+1) else false
  finite := by
    obtain ⟨N,hN⟩ := p.finite
    refine ⟨N, ?_⟩
    intro i j k h
    by_cases hij : i=0 ∧ j=0
    · rw [if_pos hij]
      exact hN 0 0 (k+1) (by omega)
    · rw [if_neg hij]

/-- Decomposition into the constant and the ideal generated by X,Y,Z. -/
theorem constant_split (p : Poly) :
    p = add (constant (p.coeff 0 0 0))
      (add (xMul (dropX p)) (add (yMul (axisY p)) (zMul (axisZ p)))) := by
  apply Poly.ext
  intro i j k
  cases i <;> cases j <;> cases k <;> simp [axisY,axisZ]

theorem mul_constant_coefficient (p q : Poly) :
    (mul p q).coeff 0 0 0 = (p.coeff 0 0 0 && q.coeff 0 0 0) := by
  conv => lhs; rw [constant_split p]
  rw [add_mul,add_mul,add_mul,constant_mul,xMul_mul,yMul_mul,zMul_mul]
  simp

/-- Kernel of the residue homomorphism to F₂. -/
def Maximal (p : Poly) : Prop := p.coeff 0 0 0 = false

/-- Ordinary three-generator description of (X,Y,Z). -/
def MaximalGenerated (p : Poly) : Prop :=
  ∃ a b c, p = add (mul X a) (add (mul Y b) (mul Z c))

theorem maximal_iff_generated (p : Poly) : Maximal p ↔ MaximalGenerated p := by
  constructor
  · intro h
    change p.coeff 0 0 0 = false at h
    refine ⟨dropX p,axisY p,axisZ p,?_⟩
    simpa only [h,constant_false,zero_add,X_mul,Y_mul,Z_mul] using constant_split p
  · rintro ⟨a,b,c,rfl⟩
    simp [Maximal]

@[simp] theorem maximal_zero : Maximal zero := rfl

theorem maximal_add {p q : Poly} (hp : Maximal p) (hq : Maximal q) : Maximal (add p q) := by
  change (p.coeff 0 0 0 ^^ q.coeff 0 0 0) = false
  rw [hp,hq]; rfl

theorem maximal_mul (p : Poly) {q : Poly} (hq : Maximal q) : Maximal (mul p q) := by
  change (mul p q).coeff 0 0 0 = false
  rw [mul_constant_coefficient,hq,Bool.and_false]

/-- The kernel is precisely the smallest polynomial ideal containing X,Y,Z. -/
theorem maximal_generated_least (J : Poly → Prop)
    (hadd : ∀ p q, J p → J q → J (add p q))
    (hmul : ∀ p q, J q → J (mul p q))
    (hx : J X) (hy : J Y) (hz : J Z) : ∀ p, Maximal p → J p := by
  intro p hp
  obtain ⟨a,b,c,rfl⟩ := (maximal_iff_generated p).mp hp
  apply hadd
  · rw [mul_comm]; exact hmul _ _ hx
  · apply hadd
    · rw [mul_comm]; exact hmul _ _ hy
    · rw [mul_comm]; exact hmul _ _ hz

/-- Surjective residue ring map, with the actual homogeneous maximal ideal as kernel. -/
theorem residue_field_certificate :
    (∀ p q, (add p q).coeff 0 0 0 = (p.coeff 0 0 0 ^^ q.coeff 0 0 0)) ∧
    (∀ p q, (mul p q).coeff 0 0 0 = (p.coeff 0 0 0 && q.coeff 0 0 0)) ∧
    one.coeff 0 0 0 = true ∧
    (∀ c : Bool, ∃ p : Poly, p.coeff 0 0 0 = c) ∧
    (∀ p, p.coeff 0 0 0 = false ↔ MaximalGenerated p) := by
  refine ⟨fun _ _ => rfl,mul_constant_coefficient,rfl,?_,maximal_iff_generated⟩
  intro c
  exact ⟨constant c, by cases c <;> rfl⟩

end ThreePoly
