/-
  Formal Resolution of Conjecture 00000004507 (The Last Math Competition)
  Core Lean 4.19.0 — Zero external dependencies, zero sorry, zero native_decide,
  zero custom axioms.

  Source statement:
  "Definition: A Galois connection is a monotone adjoint pair between posets.
   Conjecture: The minimal representation of its inverse is a closure system
   generated by units, the representation length is an explicit count of units,
   and finite lattices attain the lower bound 2."
-/

namespace Conjecture00000004507

/-! ## Section 1: Pure List & Cardinality Infrastructure -/

/-- Duplicate-free list predicate. -/
inductive Nodup {α : Type u} : List α → Prop where
  | nil : Nodup []
  | cons {a : α} {l : List α} : a ∉ l → Nodup l → Nodup (a :: l)

/-- Remove only the first occurrence of `a` from `l`. -/
def eraseFirst {α : Type u} [DecidableEq α] (a : α) : List α → List α
  | [] => []
  | x :: xs => if x = a then xs else x :: eraseFirst a xs

theorem length_eraseFirst_of_mem {α : Type u} [DecidableEq α] {a : α} :
    ∀ {l : List α}, a ∈ l → l.length = (eraseFirst a l).length + 1
  | [], h => nomatch h
  | x :: xs, h => by
    unfold eraseFirst
    by_cases hxa : x = a
    · simp [hxa]
    · simp only [hxa, ↓reduceIte, List.length_cons]
      cases h with
      | head => exact absurd rfl hxa
      | tail _ hxs =>
        have ih := length_eraseFirst_of_mem hxs
        omega

theorem mem_eraseFirst_of_ne {α : Type u} [DecidableEq α] {x a : α} (hne : x ≠ a) :
    ∀ {l : List α}, x ∈ l → x ∈ eraseFirst a l
  | [], h => nomatch h
  | y :: ys, h => by
    unfold eraseFirst
    by_cases hya : y = a
    · simp only [hya, ↓reduceIte]
      cases h with
      | head => exact absurd hya hne
      | tail _ hys => exact hys
    · simp only [hya, ↓reduceIte]
      cases h with
      | head => exact List.Mem.head _
      | tail _ hys => exact List.Mem.tail _ (mem_eraseFirst_of_ne hne hys)

/-- Pigeonhole / subset length inequality: any duplicate-free list `l₁` whose elements
    all appear in `l₂` has `l₁.length ≤ l₂.length`. -/
theorem nodup_sub_length_le {α : Type u} [DecidableEq α] :
    ∀ {l₁ : List α}, Nodup l₁ → ∀ {l₂ : List α}, (∀ x, x ∈ l₁ → x ∈ l₂) → l₁.length ≤ l₂.length
  | [], _, _, _ => Nat.zero_le _
  | a :: xs, Nodup.cons ha_not_mem hxs, l₂, hsub => by
    have ha_l₂ : a ∈ l₂ := hsub a (List.Mem.head _)
    have hlen_l₂ : l₂.length = (eraseFirst a l₂).length + 1 := length_eraseFirst_of_mem ha_l₂
    have hsub_xs : ∀ x, x ∈ xs → x ∈ eraseFirst a l₂ := by
      intro x hx
      have hne : x ≠ a := by
        intro hxeqa
        rw [hxeqa] at hx
        exact ha_not_mem hx
      exact mem_eraseFirst_of_ne hne (hsub x (List.Mem.tail _ hx))
    have ih := nodup_sub_length_le hxs hsub_xs
    simp only [List.length_cons]
    omega

def allList {α : Type u} (p : α → Bool) : List α → Bool
  | [] => true
  | x :: xs => p x && allList p xs

theorem allList_eq_true {α : Type u} {p : α → Bool} :
    ∀ {l : List α}, allList p l = true ↔ ∀ x, x ∈ l → p x = true
  | [] =>
    ⟨fun _ _ h => (nomatch h), fun _ => rfl⟩
  | x :: xs => by
    simp only [allList, Bool.and_eq_true]
    constructor
    · intro ⟨hpx, hall⟩ y hy
      cases hy with
      | head => exact hpx
      | tail _ hys => exact (allList_eq_true.mp hall) y hys
    · intro h
      exact ⟨h x (List.Mem.head _), allList_eq_true.mpr (fun y hy => h y (List.Mem.tail _ hy))⟩

def elemList {α : Type u} [DecidableEq α] (a : α) : List α → Bool
  | [] => false
  | x :: xs => decide (a = x) || elemList a xs

theorem elemList_eq_true {α : Type u} [DecidableEq α] {a : α} :
    ∀ {l : List α}, elemList a l = true ↔ a ∈ l
  | [] =>
    ⟨fun h => Bool.noConfusion h, fun h => nomatch h⟩
  | x :: xs => by
    simp only [elemList, Bool.or_eq_true, decide_eq_true_eq]
    constructor
    · intro h
      cases h with
      | inl heq => rw [heq]; exact List.Mem.head _
      | inr hxs => exact List.Mem.tail _ (elemList_eq_true.mp hxs)
    · intro h
      cases h with
      | head => exact Or.inl rfl
      | tail _ hxs => exact Or.inr (elemList_eq_true.mpr hxs)

def filterList {α : Type u} (p : α → Bool) : List α → List α
  | [] => []
  | x :: xs => if p x then x :: filterList p xs else filterList p xs

theorem mem_filterList {α : Type u} {p : α → Bool} {a : α} :
    ∀ {l : List α}, a ∈ filterList p l ↔ a ∈ l ∧ p a = true
  | [] =>
    ⟨fun h => (nomatch h), fun ⟨h, _⟩ => (nomatch h)⟩
  | x :: xs => by
    unfold filterList
    by_cases hpx : p x = true
    · simp only [hpx, ↓reduceIte]
      constructor
      · intro h
        cases h with
        | head => exact ⟨List.Mem.head _, hpx⟩
        | tail _ hxs =>
          have ⟨hm, hp⟩ := mem_filterList.mp hxs
          exact ⟨List.Mem.tail _ hm, hp⟩
      · intro ⟨hm, hp⟩
        cases hm with
        | head => exact List.Mem.head _
        | tail _ hxs => exact List.Mem.tail _ (mem_filterList.mpr ⟨hxs, hp⟩)
    · have hpfalse : p x = false := Bool.eq_false_iff.mpr hpx
      simp only [hpfalse, Bool.false_eq_true, ↓reduceIte]
      constructor
      · intro hxs
        have ⟨hm, hp⟩ := mem_filterList.mp hxs
        exact ⟨List.Mem.tail _ hm, hp⟩
      · intro ⟨hm, hp⟩
        cases hm with
        | head => exact absurd hp hpx
        | tail _ hxs => exact mem_filterList.mpr ⟨hxs, hp⟩

theorem nodup_filterList {α : Type u} {p : α → Bool} :
    ∀ {l : List α}, Nodup l → Nodup (filterList p l)
  | [], _ => Nodup.nil
  | x :: xs, Nodup.cons hx_not_mem hxs => by
    unfold filterList
    by_cases hpx : p x = true
    · simp only [hpx, ↓reduceIte]
      refine Nodup.cons ?_ (nodup_filterList hxs)
      intro hmem
      exact hx_not_mem (mem_filterList.mp hmem).1
    · have hpfalse : p x = false := Bool.eq_false_iff.mpr hpx
      simp only [hpfalse, Bool.false_eq_true, ↓reduceIte]
      exact nodup_filterList hxs

/-! ## Section 2: Posets, Monotone Galois Connections, and Galois Inverses -/

/-- Partially ordered set `(α, le)`. -/
structure Poset (α : Type u) where
  le : α → α → Prop
  le_refl : ∀ x, le x x
  le_trans : ∀ {x y z}, le x y → le y z → le x z
  le_antisymm : ∀ {x y}, le x y → le y x → x = y

/-- Order dual `P^op` of a poset `P`. -/
def Poset.dual {α : Type u} (P : Poset α) : Poset α where
  le x y := P.le y x
  le_refl x := P.le_refl x
  le_trans h₁ h₂ := P.le_trans h₂ h₁
  le_antisymm h₁ h₂ := P.le_antisymm h₂ h₁

/-- A monotone Galois connection (monotone adjoint pair) between posets `P` and `Q`. -/
structure GaloisConnection {α : Type u} {β : Type v}
    (P : Poset α) (Q : Poset β) (f : α → β) (g : β → α) : Prop where
  f_mono : ∀ {x₁ x₂}, P.le x₁ x₂ → Q.le (f x₁) (f x₂)
  g_mono : ∀ {y₁ y₂}, Q.le y₁ y₂ → P.le (g y₁) (g y₂)
  adj : ∀ x y, Q.le (f x) y ↔ P.le x (g y)

namespace GaloisConnection

variable {α : Type u} {β : Type v} {P : Poset α} {Q : Poset β} {f : α → β} {g : β → α}

theorem unit_le (gc : GaloisConnection P Q f g) (x : α) : P.le x (g (f x)) :=
  (gc.adj x (f x)).mp (Q.le_refl (f x))

theorem counit_le (gc : GaloisConnection P Q f g) (y : β) : Q.le (f (g y)) y :=
  (gc.adj (g y) y).mpr (P.le_refl (g y))

/-- Equivalence between the adjointness condition and inflation/deflation laws. -/
theorem iff_unit_counit :
    GaloisConnection P Q f g ↔
      (∀ {x₁ x₂}, P.le x₁ x₂ → Q.le (f x₁) (f x₂)) ∧
      (∀ {y₁ y₂}, Q.le y₁ y₂ → P.le (g y₁) (g y₂)) ∧
      (∀ x, P.le x (g (f x))) ∧
      (∀ y, Q.le (f (g y)) y) := by
  constructor
  · intro gc
    exact ⟨gc.f_mono, gc.g_mono, gc.unit_le, gc.counit_le⟩
  · intro ⟨hf, hg, hunit, hcounit⟩
    refine ⟨hf, hg, fun x y => ⟨?_, ?_⟩⟩
    · intro hfy
      exact P.le_trans (hunit x) (hg hfy)
    · intro hxg
      exact Q.le_trans (hf hxg) (hcounit y)

/-- Uniqueness of the right adjoint (upper Galois inverse) `g` for a given `f`. -/
theorem right_adjoint_unique {g₁ g₂ : β → α}
    (gc₁ : GaloisConnection P Q f g₁) (gc₂ : GaloisConnection P Q f g₂) : g₁ = g₂ := by
  funext y
  apply P.le_antisymm
  · exact (gc₂.adj (g₁ y) y).mp (gc₁.counit_le y)
  · exact (gc₁.adj (g₂ y) y).mp (gc₂.counit_le y)

/-- Reflexive generalized inverse law `f ∘ g ∘ f = f`. -/
theorem f_g_f (gc : GaloisConnection P Q f g) (x : α) : f (g (f x)) = f x :=
  Q.le_antisymm (gc.counit_le (f x)) (gc.f_mono (gc.unit_le x))

/-- Reflexive generalized inverse law `g ∘ f ∘ g = g`. -/
theorem g_f_g (gc : GaloisConnection P Q f g) (y : β) : g (f (g y)) = g y :=
  P.le_antisymm (gc.g_mono (gc.counit_le y)) (gc.unit_le (g y))

/-- The closure operator `c = g ∘ f` on `P` is idempotent (`c (c x) = c x`). -/
theorem closure_idem (gc : GaloisConnection P Q f g) (x : α) :
    g (f (g (f x))) = g (f x) :=
  gc.g_f_g (f x)

/-- Exact equality `Im(g) = Fix(g ∘ f)` between the image of the right adjoint
    and the fixed points of the induced closure operator `g ∘ f`. -/
theorem mem_im_right_iff_closed (gc : GaloisConnection P Q f g) (x : α) :
    (∃ y, g y = x) ↔ g (f x) = x := by
  constructor
  · intro ⟨y, hy⟩
    rw [← hy]
    exact gc.g_f_g y
  · intro hx
    exact ⟨f x, hx⟩

/-- Passing to order duals turns `(g, f)` into a monotone Galois connection `Q^op ⇄ P^op`. -/
theorem dual (gc : GaloisConnection P Q f g) :
    GaloisConnection Q.dual P.dual g f where
  f_mono h := gc.g_mono h
  g_mono h := gc.f_mono h
  adj y x := (gc.adj x y).symm

/-- Restricted order isomorphism between closed elements `Fix(g ∘ f)` and
    kernel-fixed (open) elements `Fix(f ∘ g)`. -/
def toOpen (_ : GaloisConnection P Q f g)
    (x : { a : α // g (f a) = a }) : { b : β // f (g b) = b } :=
  ⟨f x.1, by rw [x.2]⟩

def toClosed (_ : GaloisConnection P Q f g)
    (y : { b : β // f (g b) = b }) : { a : α // g (f a) = a } :=
  ⟨g y.1, by rw [y.2]⟩

theorem toClosed_toOpen (gc : GaloisConnection P Q f g)
    (x : { a : α // g (f a) = a }) : toClosed gc (toOpen gc x) = x := by
  cases x with
  | mk a ha =>
    simp only [toOpen, toClosed]
    exact Subtype.ext ha

theorem toOpen_toClosed (gc : GaloisConnection P Q f g)
    (y : { b : β // f (g b) = b }) : toOpen gc (toClosed gc y) = y := by
  cases y with
  | mk b hb =>
    simp only [toOpen, toClosed]
    exact Subtype.ext hb

end GaloisConnection

/-- Identity monotone Galois connection `(id, id)` on any poset `P`. -/
theorem id_galois {α : Type u} (P : Poset α) :
    GaloisConnection P P (fun x => x) (fun x => x) where
  f_mono h := h
  g_mono h := h
  adj _ _ := Iff.rfl

/-- General poset obstruction: on the 2-element antichain `A₂` (`Bool` ordered by `=`),
    `(id, id)` is a monotone Galois connection, yet `Im(id)` has neither an empty meet (top)
    nor a binary meet `false ∧ true`. -/
def Antichain2 : Poset Bool where
  le x y := x = y
  le_refl _ := rfl
  le_trans h₁ h₂ := Eq.trans h₁ h₂
  le_antisymm h₁ _ := h₁

theorem antichain2_no_top_and_no_meet :
    GaloisConnection Antichain2 Antichain2 (fun x => x) (fun x => x) ∧
    (¬ ∃ t : Bool, ∀ x : Bool, Antichain2.le x t) ∧
    (¬ ∃ m : Bool, Antichain2.le m false ∧ Antichain2.le m true) := by
  refine ⟨id_galois Antichain2, ?_, ?_⟩
  · intro ⟨t, ht⟩
    have h0 : false = t := ht false
    have h1 : true = t := ht true
    exact Bool.noConfusion (Eq.trans h0 h1.symm)
  · intro ⟨m, hm0, hm1⟩
    exact Bool.noConfusion (Eq.trans hm0.symm hm1)

/-! ## Section 3: Complete Lattices, Closure Systems, and the Infinite Counterexample -/

/-- Complete lattice specified via arbitrary infima `sInf` (with `sSup` derived dually). -/
structure CompleteLattice (α : Type u) extends Poset α where
  sInf : (α → Prop) → α
  sInf_le : ∀ (S : α → Prop) (x : α), S x → le (sInf S) x
  le_sInf : ∀ (S : α → Prop) (z : α), (∀ x, S x → le z x) → le z (sInf S)

namespace CompleteLattice

def top {α : Type u} (L : CompleteLattice α) : α :=
  L.sInf (fun _ => False)

theorem le_top {α : Type u} (L : CompleteLattice α) (z : α) : L.le z L.top :=
  L.le_sInf _ z (fun _ h => False.elim h)

def sSup {α : Type u} (L : CompleteLattice α) (S : α → Prop) : α :=
  L.sInf (fun u => ∀ x, S x → L.le x u)

theorem le_sSup {α : Type u} (L : CompleteLattice α) (S : α → Prop) {x : α} (hx : S x) :
    L.le x (L.sSup S) :=
  L.le_sInf _ x (fun _ hu => hu x hx)

theorem sSup_le {α : Type u} (L : CompleteLattice α) (S : α → Prop) {u : α}
    (hu : ∀ x, S x → L.le x u) : L.le (L.sSup S) u :=
  L.sInf_le _ u hu

end CompleteLattice

/-- A closure system (Moore family) on a complete lattice `L` is closed under arbitrary `sInf`. -/
def IsClosureSystem {α : Type u} (L : CompleteLattice α) (C : α → Prop) : Prop :=
  ∀ S : α → Prop, (∀ x, S x → C x) → C (L.sInf S)

/-- For any monotone Galois connection `(f, g) : L ⇄ Q` out of a complete lattice `L`,
    the image `Im(g)` of the Galois inverse `g` is a closure system in `L`. -/
theorem galois_im_isClosureSystem {α : Type u} {β : Type v}
    (L : CompleteLattice α) (Q : Poset β) {f : α → β} {g : β → α}
    (gc : GaloisConnection L.toPoset Q f g) :
    IsClosureSystem L (fun x => ∃ y, g y = x) := by
  intro S hS
  rw [gc.mem_im_right_iff_closed]
  apply L.le_antisymm
  · apply L.le_sInf
    intro x hx
    have hx_closed : g (f x) = x := (gc.mem_im_right_iff_closed x).mp (hS x hx)
    have hle : L.le (g (f (L.sInf S))) (g (f x)) :=
      gc.g_mono (gc.f_mono (L.sInf_le S x hx))
    rwa [hx_closed] at hle
  · exact gc.unit_le (L.sInf S)

/-- Conversely, every closure system `C` on `L` arises as `Im(g)` of a canonical
    monotone Galois connection `(cl, incl) : L ⇄ C`. -/
def SubPoset {α : Type u} (P : Poset α) (C : α → Prop) : Poset { x : α // C x } where
  le a b := P.le a.1 b.1
  le_refl a := P.le_refl a.1
  le_trans h₁ h₂ := P.le_trans h₁ h₂
  le_antisymm h₁ h₂ := Subtype.ext (P.le_antisymm h₁ h₂)

theorem closureSystem_arises_from_galois {α : Type u}
    (L : CompleteLattice α) {C : α → Prop} (hC : IsClosureSystem L C) :
    ∃ (f : α → { c : α // C c }) (g : { c : α // C c } → α),
      GaloisConnection L.toPoset (SubPoset L.toPoset C) f g ∧
      ∀ x, (∃ y, g y = x) ↔ C x := by
  let f : α → { c : α // C c } := fun x =>
    ⟨L.sInf (fun c => C c ∧ L.le x c), hC _ (fun _ h => h.1)⟩
  let g : { c : α // C c } → α := fun y => y.1
  refine ⟨f, g, ?_, ?_⟩
  · refine ⟨?_, ?_, ?_⟩
    · intro x₁ x₂ hx
      apply L.le_sInf
      intro c ⟨hcC, hx₂c⟩
      exact L.sInf_le _ c ⟨hcC, L.le_trans hx hx₂c⟩
    · intro y₁ y₂ hy
      exact hy
    · intro x y
      constructor
      · intro hfy
        have hxf : L.le x (f x).1 := L.le_sInf _ x (fun _ h => h.2)
        exact L.le_trans hxf hfy
      · intro hxy
        exact L.sInf_le _ y.1 ⟨y.2, hxy⟩
  · intro x
    constructor
    · intro ⟨y, hy⟩
      rw [← hy]
      exact y.2
    · intro hx
      exact ⟨⟨x, hx⟩, rfl⟩

/-- `B` meet-generates a closure system `C` in `L` under arbitrary `sInf`. -/
def Generates {α : Type u} (L : CompleteLattice α) (C : α → Prop) (B : α → Prop) : Prop :=
  (∀ b, B b → C b) ∧ ∀ x, C x → ∃ S : α → Prop, (∀ s, S s → B s) ∧ x = L.sInf S

/-- Binary tree encoding dyadic rationals in `(0, 1)` (`mid = 1/2`, `left x = x/2`,
    `right x = (x+1)/2`) as a countable dense unbounded strict order. -/
inductive Dyadic where
  | mid : Dyadic
  | left : Dyadic → Dyadic
  | right : Dyadic → Dyadic

namespace Dyadic

def lt : Dyadic → Dyadic → Prop
  | left _, mid => True
  | left _, right _ => True
  | mid, right _ => True
  | left x, left y => lt x y
  | right x, right y => lt x y
  | _, _ => False

theorem lt_irrefl : ∀ x : Dyadic, ¬ lt x x
  | mid, h => h
  | left x, h => lt_irrefl x h
  | right x, h => lt_irrefl x h

theorem lt_trans : ∀ (x y z : Dyadic), lt x y → lt y z → lt x z
  | left _, mid, right _, _, _ => trivial
  | left _, left _, mid, _, _ => trivial
  | left _, left _, right _, _, _ => trivial
  | left _, right _, right _, _, _ => trivial
  | mid, right _, right _, _, _ => trivial
  | left x, left y, left z, h₁, h₂ => lt_trans x y z h₁ h₂
  | right x, right y, right z, h₁, h₂ => lt_trans x y z h₁ h₂
  | mid, mid, _, h₁, _ => False.elim h₁
  | mid, left _, _, h₁, _ => False.elim h₁
  | right _, mid, _, h₁, _ => False.elim h₁
  | right _, left _, _, h₁, _ => False.elim h₁
  | _, mid, mid, _, h₂ => False.elim h₂
  | _, mid, left _, _, h₂ => False.elim h₂
  | _, right _, mid, _, h₂ => False.elim h₂
  | _, right _, left _, _, h₂ => False.elim h₂

theorem exists_gt : ∀ x : Dyadic, ∃ y : Dyadic, lt x y
  | mid => ⟨right mid, trivial⟩
  | left _ => ⟨mid, trivial⟩
  | right x =>
    let ⟨y, hy⟩ := exists_gt x
    ⟨right y, hy⟩

theorem exists_lt : ∀ x : Dyadic, ∃ y : Dyadic, lt y x
  | mid => ⟨left mid, trivial⟩
  | right _ => ⟨mid, trivial⟩
  | left x =>
    let ⟨y, hy⟩ := exists_lt x
    ⟨left y, hy⟩

theorem lt_dense : ∀ (x y : Dyadic), lt x y → ∃ z : Dyadic, lt x z ∧ lt z y
  | left x, mid, _ =>
    let ⟨z, hz⟩ := exists_gt x
    ⟨left z, hz, trivial⟩
  | left _, right _, _ =>
    ⟨mid, trivial, trivial⟩
  | mid, right y, _ =>
    let ⟨z, hz⟩ := exists_lt y
    ⟨right z, trivial, hz⟩
  | left x, left y, h =>
    let ⟨z, hz₁, hz₂⟩ := lt_dense x y h
    ⟨left z, hz₁, hz₂⟩
  | right x, right y, h =>
    let ⟨z, hz₁, hz₂⟩ := lt_dense x y h
    ⟨right z, hz₁, hz₂⟩
  | mid, mid, h => False.elim h
  | mid, left _, h => False.elim h
  | right _, mid, h => False.elim h
  | right _, left _, h => False.elim h

end Dyadic

/-- Open rounded upper Dedekind cuts of `Dyadic`, ordered by reverse inclusion
    (isomorphic as a complete lattice to the real unit interval `[0, 1]`). -/
structure Cut where
  mem : Dyadic → Prop
  isUpper : ∀ {x y : Dyadic}, mem x → Dyadic.lt x y → mem y
  isRounded : ∀ {x : Dyadic}, mem x → ∃ w : Dyadic, mem w ∧ Dyadic.lt w x

theorem Cut.ext {u v : Cut} (h : ∀ x, u.mem x ↔ v.mem x) : u = v := by
  cases u with
  | mk mu _ _ =>
    cases v with
    | mk mv _ _ =>
      have hfun : mu = mv := funext (fun x => propext (h x))
      subst hfun
      rfl

def CutLattice : CompleteLattice Cut where
  le u v := ∀ x, v.mem x → u.mem x
  le_refl _ _ hx := hx
  le_trans h₁ h₂ x hx := h₁ x (h₂ x hx)
  le_antisymm h₁ h₂ := Cut.ext (fun x => ⟨h₂ x, h₁ x⟩)
  sInf S := {
    mem := fun x => ∃ u, S u ∧ u.mem x
    isUpper := by
      intro x y ⟨u, hSu, hx⟩ hxy
      exact ⟨u, hSu, u.isUpper hx hxy⟩
    isRounded := by
      intro x ⟨u, hSu, hx⟩
      obtain ⟨w, hw, hwx⟩ := u.isRounded hx
      exact ⟨w, ⟨u, hSu, hw⟩, hwx⟩
  }
  sInf_le S u hSu x hx := ⟨u, hSu, hx⟩
  le_sInf := by
    intro S z hz x ⟨u, hSu, hx⟩
    exact hz u hSu x hx

/-- Principal open cut `(d, ∞)` for `d : Dyadic`. -/
def pCut (d : Dyadic) : Cut where
  mem x := Dyadic.lt d x
  isUpper {x y} hx hxy := Dyadic.lt_trans d x y hx hxy
  isRounded {x} hx := Dyadic.lt_dense d x hx

/-- Non-vacuity: the principal open cuts `{ pCut d | d : Dyadic }` meet-generate `CutLattice`. -/
theorem pCut_generates_cutLattice :
    Generates CutLattice (fun _ => True) (fun v => ∃ d, v = pCut d) := by
  refine ⟨fun _ _ => trivial, fun w _ => ?_⟩
  refine ⟨fun v => ∃ d, w.mem d ∧ v = pCut d, ?_, ?_⟩
  · intro s ⟨d, _, hs⟩
    exact ⟨d, hs⟩
  · apply Cut.ext
    intro x
    dsimp [CutLattice]
    constructor
    · intro hwx
      obtain ⟨d, hwd, hdx⟩ := w.isRounded hwx
      exact ⟨pCut d, ⟨d, hwd, rfl⟩, hdx⟩
    · intro ⟨v, ⟨d, hwd, hveq⟩, hvx⟩
      rw [hveq] at hvx
      exact w.isUpper hwd hvx

/-- Infinite complete lattice counterexample to Clause 1 of Conjecture 00000004507:
    For the identity Galois connection `(id, id)` on `CutLattice`, EVERY meet-generating
    subset `B` admits a strict proper subset `B \ {b₀}` that still meet-generates the entire
    closure system `Im(id) = Cut`. Hence NO minimal meet-generating representation exists. -/
theorem dyadicCut_no_minimal_generator :
    ∀ B : Cut → Prop,
      Generates CutLattice (fun _ => True) B →
      ∃ b₀ : Cut, B b₀ ∧ Generates CutLattice (fun _ => True) (fun v => B v ∧ v ≠ b₀) := by
  intro B ⟨_, hGen⟩
  -- Helper unpacking `Generates` pointwise
  have unpack : ∀ u : Cut, ∀ x : Dyadic, u.mem x → ∃ v : Cut, B v ∧ CutLattice.le u v ∧ v.mem x := by
    intro u x hux
    obtain ⟨S, hSB, huS⟩ := hGen u trivial
    have hmem : (CutLattice.sInf S).mem x := by rw [← huS]; exact hux
    obtain ⟨v, hSv, hvx⟩ := hmem
    refine ⟨v, hSB v hSv, ?_, hvx⟩
    rw [huS]
    exact CutLattice.sInf_le S v hSv
  -- Obtain at least one element `b₀ ∈ B`
  have hmid : (pCut Dyadic.mid).mem (Dyadic.right Dyadic.mid) := trivial
  obtain ⟨b₀, hb₀B, _, _⟩ := unpack (pCut Dyadic.mid) (Dyadic.right Dyadic.mid) hmid
  refine ⟨b₀, hb₀B, fun _ _ => trivial, fun w _ => ?_⟩
  let S' : Cut → Prop := fun v => (B v ∧ v ≠ b₀) ∧ CutLattice.le w v
  refine ⟨S', fun _ hv => hv.1, ?_⟩
  apply Cut.ext
  intro x
  constructor
  · intro hwx
    obtain ⟨d, hwd, hdx⟩ := w.isRounded hwx
    have hw_le_pd : CutLattice.le w (pCut d) := fun z hz => w.isUpper hwd hz
    by_cases hcase : CutLattice.le (pCut d) b₀ ∧ b₀.mem x
    · obtain ⟨hpd_b₀, hb₀x⟩ := hcase
      obtain ⟨r, hb₀r, hrx⟩ := b₀.isRounded hb₀x
      have hdr : Dyadic.lt d r := hpd_b₀ r hb₀r
      have hpd_pr : CutLattice.le (pCut d) (pCut r) := fun z hz => Dyadic.lt_trans d r z hdr hz
      obtain ⟨v, hvB, hpr_v, hvx⟩ := unpack (pCut r) x hrx
      have hv_ne : v ≠ b₀ := by
        intro hveq
        rw [hveq] at hpr_v
        exact Dyadic.lt_irrefl r (hpr_v r hb₀r)
      exact ⟨v, ⟨⟨hvB, hv_ne⟩, CutLattice.le_trans hw_le_pd (CutLattice.le_trans hpd_pr hpr_v)⟩, hvx⟩
    · obtain ⟨v, hvB, hpd_v, hvx⟩ := unpack (pCut d) x hdx
      have hv_ne : v ≠ b₀ := by
        intro hveq
        rw [hveq] at hpd_v hvx
        exact hcase ⟨hpd_v, hvx⟩
      exact ⟨v, ⟨⟨hvB, hv_ne⟩, CutLattice.le_trans hw_le_pd hpd_v⟩, hvx⟩
  · intro ⟨v, ⟨_, hwv⟩, hvx⟩
    exact hwv x hvx

/-- Moreover, `CutLattice` has ZERO completely meet-irreducible elements. -/
theorem dyadicCut_no_meetIrreducible (u : Cut) (_ : u ≠ CutLattice.top) :
    ∃ S : Cut → Prop, u = CutLattice.sInf S ∧ ∀ v, S v → v ≠ u := by
  refine ⟨fun v => ∃ d, u.mem d ∧ v = pCut d, ?_, ?_⟩
  · apply Cut.ext
    intro x
    dsimp [CutLattice]
    constructor
    · intro hux
      obtain ⟨d, hud, hdx⟩ := u.isRounded hux
      exact ⟨pCut d, ⟨d, hud, rfl⟩, hdx⟩
    · intro ⟨v, ⟨d, hud, hveq⟩, hvx⟩
      rw [hveq] at hvx
      exact u.isUpper hud hvx
  · intro v ⟨d, hud, hveq⟩ heq
    rw [hveq] at heq
    have hdd : (pCut d).mem d := by rw [heq]; exact hud
    exact Dyadic.lt_irrefl d hdd

/-! ## Section 4: Finite Lattices, Minimal Unit Generation, and Exact Thresholds -/

/-- Explicit finite lattice over a decidable-equality type `α`. -/
structure FiniteLattice (α : Type) [DecidableEq α] where
  elems : List α
  elems_nodup : Nodup elems
  elems_complete : ∀ x : α, x ∈ elems
  top : α
  bot : α
  inf : α → α → α
  sup : α → α → α
  inf_comm : ∀ x y, inf x y = inf y x
  inf_assoc : ∀ x y z, inf (inf x y) z = inf x (inf y z)
  inf_idem : ∀ x, inf x x = x
  inf_top : ∀ x, inf x top = x
  sup_comm : ∀ x y, sup x y = sup y x
  sup_assoc : ∀ x y z, sup (sup x y) z = sup x (sup y z)
  sup_idem : ∀ x, sup x x = x
  sup_bot : ∀ x, sup x bot = x
  inf_sup_self : ∀ x y, inf x (sup x y) = x
  sup_inf_self : ∀ x y, sup x (inf x y) = x

namespace FiniteLattice

variable {α : Type} [DecidableEq α] (L : FiniteLattice α)

/-- Induced partial order `x ≤ y ↔ x ∧ y = x`. -/
def le (x y : α) : Prop := L.inf x y = x

instance instDecidableLe (x y : α) : Decidable (L.le x y) := by
  unfold le
  infer_instance

theorem le_refl (x : α) : L.le x x := L.inf_idem x

theorem le_trans {x y z : α} (h₁ : L.le x y) (h₂ : L.le y z) : L.le x z := by
  unfold le at *
  calc L.inf x z
    _ = L.inf (L.inf x y) z := by rw [h₁]
    _ = L.inf x (L.inf y z) := L.inf_assoc x y z
    _ = L.inf x y := by rw [h₂]
    _ = x := h₁

theorem le_antisymm {x y : α} (h₁ : L.le x y) (h₂ : L.le y x) : x = y := by
  unfold le at *
  calc x
    _ = L.inf x y := h₁.symm
    _ = L.inf y x := L.inf_comm x y
    _ = y := h₂

def toPoset : Poset α where
  le := L.le
  le_refl := L.le_refl
  le_trans := @L.le_trans
  le_antisymm := @L.le_antisymm

theorem le_top (x : α) : L.le x L.top := L.inf_top x

theorem top_inf (x : α) : L.inf L.top x = x := by
  rw [L.inf_comm, L.inf_top]

theorem le_iff_sup_eq (x y : α) : L.le x y ↔ L.sup x y = y := by
  unfold le
  constructor
  · intro h
    calc L.sup x y
      _ = L.sup (L.inf x y) y := by rw [h]
      _ = L.sup y (L.inf y x) := by rw [L.sup_comm, L.inf_comm]
      _ = y := L.sup_inf_self y x
  · intro h
    calc L.inf x y
      _ = L.inf x (L.sup x y) := by rw [h]
      _ = x := L.inf_sup_self x y

theorem bot_le (x : α) : L.le L.bot x := by
  rw [L.le_iff_sup_eq, L.sup_comm, L.sup_bot]

theorem inf_le_left (x y : α) : L.le (L.inf x y) x := by
  unfold le
  calc L.inf (L.inf x y) x
    _ = L.inf x (L.inf x y) := L.inf_comm _ _
    _ = L.inf (L.inf x x) y := (L.inf_assoc x x y).symm
    _ = L.inf x y := by rw [L.inf_idem]

theorem inf_le_right (x y : α) : L.le (L.inf x y) y := by
  rw [L.inf_comm]
  exact L.inf_le_left y x

theorem le_inf {z x y : α} (hx : L.le z x) (hy : L.le z y) : L.le z (L.inf x y) := by
  unfold le at *
  calc L.inf z (L.inf x y)
    _ = L.inf (L.inf z x) y := (L.inf_assoc z x y).symm
    _ = L.inf z y := by rw [hx]
    _ = z := hy

theorem le_sup_left (x y : α) : L.le x (L.sup x y) :=
  L.inf_sup_self x y

theorem le_sup_right (x y : α) : L.le y (L.sup x y) := by
  rw [L.sup_comm]
  exact L.le_sup_left y x

theorem sup_le {x y z : α} (hx : L.le x z) (hy : L.le y z) : L.le (L.sup x y) z := by
  rw [L.le_iff_sup_eq] at *
  calc L.sup (L.sup x y) z
    _ = L.sup x (L.sup y z) := L.sup_assoc x y z
    _ = L.sup x z := by rw [hy]
    _ = z := hx

/-- Finite meet of a list of elements (`listInf [] = top`). -/
def listInf (S : List α) : α :=
  S.foldr L.inf L.top

/-- Finite join of a list of elements (`listSup [] = bot`). -/
def listSup (S : List α) : α :=
  S.foldr L.sup L.bot

theorem listInf_nil : L.listInf [] = L.top := rfl

theorem listInf_cons (a : α) (S : List α) : L.listInf (a :: S) = L.inf a (L.listInf S) := rfl

theorem listInf_append : ∀ (S₁ S₂ : List α),
    L.listInf (S₁ ++ S₂) = L.inf (L.listInf S₁) (L.listInf S₂)
  | [], S₂ => by
    simp only [List.nil_append, listInf_nil]
    exact (L.top_inf (L.listInf S₂)).symm
  | a :: xs, S₂ => by
    simp only [List.cons_append, listInf_cons]
    rw [listInf_append xs S₂, L.inf_assoc]

theorem listInf_le_of_mem : ∀ {S : List α} {x : α}, x ∈ S → L.le (L.listInf S) x
  | [], _, h => nomatch h
  | a :: xs, _, h => by
    cases h with
    | head => exact L.inf_le_left a (L.listInf xs)
    | tail _ hxs => exact L.le_trans (L.inf_le_right a (L.listInf xs)) (listInf_le_of_mem hxs)

theorem le_listInf {z : α} : ∀ {S : List α}, (∀ x, x ∈ S → L.le z x) → L.le z (L.listInf S)
  | [], _ => L.le_top z
  | a :: _, h =>
    L.le_inf (h a (List.Mem.head _)) (le_listInf (fun x hx => h x (List.Mem.tail _ hx)))

theorem le_listSup_of_mem : ∀ {S : List α} {x : α}, x ∈ S → L.le x (L.listSup S)
  | [], _, h => nomatch h
  | a :: xs, _, h => by
    cases h with
    | head => exact L.le_sup_left a (L.listSup xs)
    | tail _ hxs => exact L.le_trans (le_listSup_of_mem hxs) (L.le_sup_right a (L.listSup xs))

theorem listSup_le {z : α} : ∀ {S : List α}, (∀ x, x ∈ S → L.le x z) → L.le (L.listSup S) z
  | [], _ => L.bot_le z
  | a :: _, h =>
    L.sup_le (h a (List.Mem.head _)) (listSup_le (fun x hx => h x (List.Mem.tail _ hx)))

/-- Finite closure system `C` represented as a duplicate-free list containing `top`
    and closed under binary meets. -/
structure IsFinClosureSystem (C : List α) : Prop where
  nodup : Nodup C
  top_mem : L.top ∈ C
  inf_mem : ∀ {x y}, x ∈ C → y ∈ C → L.inf x y ∈ C

theorem listInf_mem_of_subset {C : List α} (hC : L.IsFinClosureSystem C) :
    ∀ {S : List α}, (∀ s, s ∈ S → s ∈ C) → L.listInf S ∈ C
  | [], _ => hC.top_mem
  | a :: _, hS =>
    hC.inf_mem (hS a (List.Mem.head _))
      (listInf_mem_of_subset hC (fun s hs => hS s (List.Mem.tail _ hs)))

/-- The closed elements `Im(g) = Fix(g ∘ f)` of any monotone Galois connection `(f, g) : L ⇄ Q`
    form an `IsFinClosureSystem` on `L`. -/
def galoisClosedList {β : Type v} (f : α → β) (g : β → α) : List α :=
  filterList (fun x => decide (g (f x) = x)) L.elems

theorem galoisClosedList_mem_iff {β : Type v} {Q : Poset β} {f : α → β} {g : β → α}
    (gc : GaloisConnection L.toPoset Q f g) (x : α) :
    x ∈ L.galoisClosedList f g ↔ ∃ y, g y = x := by
  unfold galoisClosedList
  rw [mem_filterList, decide_eq_true_eq, ← gc.mem_im_right_iff_closed]
  exact ⟨fun h => h.2, fun h => ⟨L.elems_complete x, h⟩⟩

theorem galoisClosedList_isClosureSystem {β : Type v} {Q : Poset β} {f : α → β} {g : β → α}
    (gc : GaloisConnection L.toPoset Q f g) :
    L.IsFinClosureSystem (L.galoisClosedList f g) where
  nodup := nodup_filterList L.elems_nodup
  top_mem := by
    unfold galoisClosedList
    rw [mem_filterList, decide_eq_true_eq]
    refine ⟨L.elems_complete L.top, ?_⟩
    exact L.le_antisymm (L.le_top _) (gc.unit_le L.top)
  inf_mem := by
    intro x y hx hy
    unfold galoisClosedList at *
    rw [mem_filterList, decide_eq_true_eq] at *
    refine ⟨L.elems_complete _, L.le_antisymm ?_ (gc.unit_le _)⟩
    apply L.le_inf
    · have h₁ : L.le (g (f (L.inf x y))) (g (f x)) :=
        gc.g_mono (gc.f_mono (L.inf_le_left x y))
      rwa [hx.2] at h₁
    · have h₂ : L.le (g (f (L.inf x y))) (g (f y)) :=
        gc.g_mono (gc.f_mono (L.inf_le_right x y))
      rwa [hy.2] at h₂

/-- Computable Boolean predicate for meet-irreducibility inside `C`. -/
def isMeetIrredBool (C : List α) (m : α) : Bool :=
  elemList m C && !(decide (m = L.top)) &&
    allList (fun a => allList (fun b =>
      !(decide (L.inf a b = m)) || decide (m = a) || decide (m = b)) C) C

/-- The canonical list `M(C)` of meet-irreducible elements of `C`. -/
def meetIrreds (C : List α) : List α :=
  filterList (L.isMeetIrredBool C) C

theorem mem_meetIrreds_iff {C : List α} {m : α} :
    m ∈ L.meetIrreds C ↔
      m ∈ C ∧ m ≠ L.top ∧ ∀ a, a ∈ C → ∀ b, b ∈ C → L.inf a b = m → (m = a ∨ m = b) := by
  unfold meetIrreds isMeetIrredBool
  rw [mem_filterList]
  constructor
  · intro ⟨hmC, hb⟩
    simp only [Bool.and_eq_true, Bool.not_eq_true', decide_eq_false_iff_not,
      allList_eq_true] at hb
    obtain ⟨⟨_, hne⟩, hall⟩ := hb
    refine ⟨hmC, hne, ?_⟩
    intro a ha b hbC hinf
    have hrow := hall a ha b hbC
    simp only [Bool.or_eq_true, Bool.not_eq_true', decide_eq_false_iff_not,
      decide_eq_true_eq] at hrow
    rcases hrow with (hnot | hma) | hmb
    · exact absurd hinf hnot
    · exact Or.inl hma
    · exact Or.inr hmb
  · intro ⟨hmC, hne, hirr⟩
    refine ⟨hmC, ?_⟩
    simp only [Bool.and_eq_true, Bool.not_eq_true', decide_eq_false_iff_not,
      allList_eq_true]
    refine ⟨⟨elemList_eq_true.mpr hmC, hne⟩, ?_⟩
    intro a ha b hbC
    simp only [Bool.or_eq_true, Bool.not_eq_true', decide_eq_false_iff_not,
      decide_eq_true_eq]
    by_cases hinf : L.inf a b = m
    · rcases hirr a ha b hbC hinf with hma | hmb
      · exact Or.inl (Or.inr hma)
      · exact Or.inr hmb
    · exact Or.inl (Or.inl hinf)

theorem nodup_meetIrreds {C : List α} (hC : L.IsFinClosureSystem C) :
    Nodup (L.meetIrreds C) :=
  nodup_filterList hC.nodup

/-- Reading I generation predicate: `B` generates `C` under arbitrary meets `listInf`
    (including `listInf [] = top`). -/
def GeneratesClosure (B C : List α) : Prop :=
  ∀ x, x ∈ C ↔ ∃ S : List α, (∀ s, s ∈ S → s ∈ B) ∧ x = L.listInf S

/-- Strict upset of `x` in `C` used as fuel measure for finite meet-irreducible decomposition. -/
def strictUpset (C : List α) (x : α) : List α :=
  filterList (fun y => decide (L.le x y) && !(decide (x = y))) C

theorem strictUpset_decrease {C : List α} (hC : L.IsFinClosureSystem C) {x a : α}
    (haC : a ∈ C) (hxa : L.le x a) (hne : x ≠ a) :
    (L.strictUpset C a).length + 1 ≤ (L.strictUpset C x).length := by
  have hnodup_a : Nodup (a :: L.strictUpset C a) := by
    refine Nodup.cons ?_ (nodup_filterList hC.nodup)
    intro ha_mem
    simp [strictUpset, mem_filterList] at ha_mem
  have hsub : ∀ z, z ∈ a :: L.strictUpset C a → z ∈ L.strictUpset C x := by
    intro z hz
    unfold strictUpset
    rw [mem_filterList]
    simp only [Bool.and_eq_true, Bool.not_eq_true', decide_eq_false_iff_not, decide_eq_true_eq]
    cases hz with
    | head => exact ⟨haC, hxa, hne⟩
    | tail _ hza =>
      have hza' : z ∈ L.strictUpset C a := hza
      unfold strictUpset at hza'
      rw [mem_filterList] at hza'
      simp only [Bool.and_eq_true, Bool.not_eq_true', decide_eq_false_iff_not,
        decide_eq_true_eq] at hza'
      obtain ⟨hzC, haz, _⟩ := hza'
      refine ⟨hzC, L.le_trans hxa haz, ?_⟩
      intro hxz
      rw [← hxz] at haz
      exact hne (L.le_antisymm hxa haz)
  exact nodup_sub_length_le hnodup_a hsub

/-- Every element of a finite closure system `C` is a meet of elements of `M(C)`. -/
theorem exists_meetIrred_decomp {C : List α} (hC : L.IsFinClosureSystem C) :
    ∀ (k : Nat) {x : α}, (L.strictUpset C x).length ≤ k → x ∈ C →
      ∃ S : List α, (∀ s, s ∈ S → s ∈ L.meetIrreds C) ∧ x = L.listInf S
  | 0, x, hlen, hxC => by
    by_cases hxtop : x = L.top
    · exact ⟨[], ⟨fun _ h => (nomatch h), hxtop⟩⟩
    · -- `x` must be meet-irreducible, otherwise some `a ∈ C` strictly above `x` contradicts `hlen`
      have hirr : x ∈ L.meetIrreds C := by
        rw [L.mem_meetIrreds_iff]
        refine ⟨hxC, hxtop, ?_⟩
        intro a haC b _ hinf
        by_cases hxa : x = a
        · exact Or.inl hxa
        · have hle_xa : L.le x a := by rw [← hinf]; exact L.inf_le_left a b
          have hdec := L.strictUpset_decrease hC haC hle_xa hxa
          omega
      refine ⟨[x], ?_, (L.inf_top x).symm⟩
      intro s hs
      cases hs with
      | head => exact hirr
      | tail _ h => exact nomatch h
  | k + 1, x, hlen, hxC => by
    by_cases hxtop : x = L.top
    · exact ⟨[], ⟨fun _ h => (nomatch h), hxtop⟩⟩
    · by_cases hirr : x ∈ L.meetIrreds C
      · refine ⟨[x], ?_, (L.inf_top x).symm⟩
        intro s hs
        cases hs with
        | head => exact hirr
        | tail _ h => exact nomatch h
      · -- `x` is reducible in `C`: find `a, b ∈ C` with `inf a b = x`, `x ≠ a`, `x ≠ b`
        have hnot_all : ¬ allList (fun a => allList (fun b =>
            !(decide (L.inf a b = x)) || decide (x = a) || decide (x = b)) C) C = true := by
          intro hall_ok
          apply hirr
          rw [L.mem_meetIrreds_iff]
          refine ⟨hxC, hxtop, ?_⟩
          intro a haC b hbC hinf
          have hrow := (allList_eq_true.mp (allList_eq_true.mp hall_ok a haC)) b hbC
          simp only [Bool.or_eq_true, Bool.not_eq_true', decide_eq_false_iff_not,
            decide_eq_true_eq] at hrow
          rcases hrow with (hnot | hma) | hmb
          · exact absurd hinf hnot
          · exact Or.inl hma
          · exact Or.inr hmb
        have hex : ∃ a, a ∈ C ∧ ∃ b, b ∈ C ∧ L.inf a b = x ∧ x ≠ a ∧ x ≠ b := by
          apply Classical.byContradiction
          intro hno
          apply hnot_all
          rw [allList_eq_true]
          intro a haC
          rw [allList_eq_true]
          intro b hbC
          simp only [Bool.or_eq_true, Bool.not_eq_true', decide_eq_false_iff_not,
            decide_eq_true_eq]
          by_cases hinf : L.inf a b = x
          · by_cases hxa : x = a
            · exact Or.inl (Or.inr hxa)
            · by_cases hxb : x = b
              · exact Or.inr hxb
              · exact False.elim (hno ⟨a, haC, b, hbC, hinf, hxa, hxb⟩)
          · exact Or.inl (Or.inl hinf)
        obtain ⟨a, haC, b, hbC, hinf, hxa, hxb⟩ := hex
        have hle_xa : L.le x a := by rw [← hinf]; exact L.inf_le_left a b
        have hle_xb : L.le x b := by rw [← hinf]; exact L.inf_le_right a b
        have hdec_a := L.strictUpset_decrease hC haC hle_xa hxa
        have hdec_b := L.strictUpset_decrease hC hbC hle_xb hxb
        obtain ⟨Sa, hSa, ha_eq⟩ := exists_meetIrred_decomp hC k (by omega) haC
        obtain ⟨Sb, hSb, hb_eq⟩ := exists_meetIrred_decomp hC k (by omega) hbC
        refine ⟨Sa ++ Sb, ?_, ?_⟩
        · intro s hs
          rcases List.mem_append.mp hs with hsa | hsb
          · exact hSa s hsa
          · exact hSb s hsb
        · rw [listInf_append L, ← ha_eq, ← hb_eq, hinf]

/-- Fundamental Theorem of Closure Generation on Finite Lattices (Sufficiency):
    `M(C)` generates `C`. -/
theorem meetIrreds_generates {C : List α} (hC : L.IsFinClosureSystem C) :
    L.GeneratesClosure (L.meetIrreds C) C := by
  intro x
  constructor
  · intro hxC
    exact exists_meetIrred_decomp L hC (L.strictUpset C x).length (Nat.le_refl _) hxC
  · intro ⟨S, hS, hxeq⟩
    rw [hxeq]
    exact listInf_mem_of_subset L hC (fun s hs => (L.mem_meetIrreds_iff.mp (hS s hs)).1)

/-- Fundamental Theorem of Closure Generation on Finite Lattices (Necessity):
    Every meet-generating list `B` of `C` contains EVERY meet-irreducible element `m ∈ M(C)`. -/
theorem meetIrreds_subset_of_generates {B C : List α}
    (hC : L.IsFinClosureSystem C) (hGen : L.GeneratesClosure B C) :
    ∀ m, m ∈ L.meetIrreds C → m ∈ B := by
  have hBC : ∀ b, b ∈ B → b ∈ C := by
    intro b hb
    apply (hGen b).mpr
    refine ⟨[b], ?_, (L.inf_top b).symm⟩
    intro s hs
    cases hs with
    | head => exact hb
    | tail _ h => exact nomatch h
  intro m hm
  obtain ⟨hmC, hm_ne_top, hm_irr⟩ := L.mem_meetIrreds_iff.mp hm
  obtain ⟨S, hSB, hmeq⟩ := (hGen m).mp hmC
  have aux : ∀ (T : List α), (∀ s, s ∈ T → s ∈ B) → m = L.listInf T → m ∈ B := by
    intro T
    induction T with
    | nil =>
      intro _ htop
      exact absurd htop hm_ne_top
    | cons a ts ih =>
      intro hTB hcons
      have haB : a ∈ B := hTB a (List.Mem.head _)
      have haC : a ∈ C := hBC a haB
      have htsC : L.listInf ts ∈ C :=
        listInf_mem_of_subset L hC (fun s hs => hBC s (hTB s (List.Mem.tail _ hs)))
      rcases hm_irr a haC (L.listInf ts) htsC hcons.symm with hma | hmts
      · rwa [hma]
      · exact ih (fun s hs => hTB s (List.Mem.tail _ hs)) hmts
  exact aux S hSB hmeq

/-- `M(C)` achieves the unique minimum representation length `|M(C)|` among ALL
    meet-generating lists `B` of `C`. -/
theorem meetIrreds_min_length {B C : List α}
    (hC : L.IsFinClosureSystem C) (hGen : L.GeneratesClosure B C) :
    (L.meetIrreds C).length ≤ B.length :=
  nodup_sub_length_le (L.nodup_meetIrreds hC) (L.meetIrreds_subset_of_generates hC hGen)

/-- Universal inequality `|M(C)| + 1 ≤ |C|` (`top :: M(C)` is duplicate-free inside `C`). -/
theorem meetIrreds_length_succ_le {C : List α} (hC : L.IsFinClosureSystem C) :
    (L.meetIrreds C).length + 1 ≤ C.length := by
  have hnodup : Nodup (L.top :: L.meetIrreds C) := by
    refine Nodup.cons ?_ (L.nodup_meetIrreds hC)
    intro htop_mem
    exact (L.mem_meetIrreds_iff.mp htop_mem).2.1 rfl
  have hsub : ∀ x, x ∈ L.top :: L.meetIrreds C → x ∈ C := by
    intro x hx
    cases hx with
    | head => exact hC.top_mem
    | tail _ hxm => exact (L.mem_meetIrreds_iff.mp hxm).1
  exact nodup_sub_length_le hnodup hsub

theorem listInf_subset_singleton {m : α} :
    ∀ {S : List α}, (∀ s, s ∈ S → s = m) → L.listInf S = L.top ∨ L.listInf S = m
  | [], _ => Or.inl rfl
  | a :: xs, hS => by
    have ha : a = m := hS a (List.Mem.head _)
    rcases listInf_subset_singleton (fun s hs => hS s (List.Mem.tail _ hs)) with htop | hm
    · right
      simp only [listInf_cons, ha, htop, L.inf_top]
    · right
      simp only [listInf_cons, ha, hm, L.inf_idem]

/-- Exact Sharp Classification of Representation Length on Finite Lattices:
    (1) `|M(C)| = 0 ↔ |C| = 1`
    (2) `|M(C)| = 1 ↔ |C| = 2`
    (3) `2 ≤ |M(C)| ↔ 3 ≤ |C|` -/
theorem repLength_zero_iff {C : List α} (hC : L.IsFinClosureSystem C) :
    (L.meetIrreds C).length = 0 ↔ C.length = 1 := by
  have hge1 : 1 ≤ C.length := by
    have hsub : ∀ x, x ∈ [L.top] → x ∈ C := fun x hx => by
      cases hx with | head => exact hC.top_mem | tail _ h => exact nomatch h
    exact nodup_sub_length_le (Nodup.cons (fun h => by cases h) Nodup.nil) hsub
  constructor
  · intro h0
    have hgen := L.meetIrreds_generates hC
    have hall_top : ∀ x, x ∈ C → x ∈ [L.top] := by
      intro x hxC
      obtain ⟨S, hS, hxeq⟩ := (hgen x).mp hxC
      cases S with
      | nil => rw [hxeq]; exact List.Mem.head _
      | cons s _ =>
        have hsM : s ∈ L.meetIrreds C := hS s (List.Mem.head _)
        have hpos : 1 ≤ (L.meetIrreds C).length :=
          nodup_sub_length_le (Nodup.cons (fun h => by cases h) Nodup.nil)
            (fun y hy => by cases hy with | head => exact hsM | tail _ h => exact nomatch h)
        omega
    have hle1 : C.length ≤ 1 := nodup_sub_length_le hC.nodup hall_top
    omega
  · intro h1
    have hbound := L.meetIrreds_length_succ_le hC
    omega

theorem repLength_one_iff {C : List α} (hC : L.IsFinClosureSystem C) :
    (L.meetIrreds C).length = 1 ↔ C.length = 2 := by
  constructor
  · intro h1
    cases hm_eq : L.meetIrreds C with
    | nil => rw [hm_eq] at h1; contradiction
    | cons m rest =>
      cases rest with
      | cons _ _ => rw [hm_eq] at h1; simp at h1
      | nil =>
        have hgen := L.meetIrreds_generates hC
        have hC_sub : ∀ x, x ∈ C → x ∈ [m, L.top] := by
          intro x hxC
          obtain ⟨S, hS, hxeq⟩ := (hgen x).mp hxC
          have hSm : ∀ s, s ∈ S → s = m := by
            intro s hs
            have hsM := hS s hs
            rw [hm_eq] at hsM
            cases hsM with
            | head => rfl
            | tail _ h => exact nomatch h
          rcases listInf_subset_singleton L hSm with htop | hm_val
          · rw [hxeq, htop]; exact List.Mem.tail _ (List.Mem.head _)
          · rw [hxeq, hm_val]; exact List.Mem.head _
        have hle2 : C.length ≤ 2 := nodup_sub_length_le hC.nodup hC_sub
        have hbound := L.meetIrreds_length_succ_le hC
        omega
  · intro h2
    have hbound := L.meetIrreds_length_succ_le hC
    have hnot0 : (L.meetIrreds C).length ≠ 0 := by
      intro h0
      have hc1 := (L.repLength_zero_iff hC).mp h0
      omega
    omega

theorem repLength_ge_two_iff {C : List α} (hC : L.IsFinClosureSystem C) :
    2 ≤ (L.meetIrreds C).length ↔ 3 ≤ C.length := by
  have hge1 : 1 ≤ C.length := by
    have hbound := L.meetIrreds_length_succ_le hC
    omega
  have h0 := L.repLength_zero_iff hC
  have h1 := L.repLength_one_iff hC
  constructor
  · intro hge2
    by_cases hc1 : C.length = 1
    · have := h0.mpr hc1; omega
    · by_cases hc2 : C.length = 2
      · have := h1.mpr hc2; omega
      · omega
  · intro hge3
    by_cases hm0 : (L.meetIrreds C).length = 0
    · have := h0.mp hm0; omega
    · by_cases hm1 : (L.meetIrreds C).length = 1
      · have := h1.mp hm1; omega
      · omega

/-- Reading III: Nonempty-meet generating sets (`S ≠ []`) require `top :: M(C)`,
    giving minimum length `|M(C)| + 1`. -/
def GeneratesNonempty (B C : List α) : Prop :=
  ∀ x, x ∈ C ↔ ∃ S : List α, S ≠ [] ∧ (∀ s, s ∈ S → s ∈ B) ∧ x = L.listInf S

theorem top_mem_of_generatesNonempty {B C : List α}
    (hC : L.IsFinClosureSystem C) (hGen : L.GeneratesNonempty B C) :
    L.top ∈ B := by
  obtain ⟨S, hSne, hSB, htop_eq⟩ := (hGen L.top).mp hC.top_mem
  cases S with
  | nil => exact absurd rfl hSne
  | cons a xs =>
    have hle : L.le L.top a := by
      rw [htop_eq]
      exact L.inf_le_left a (L.listInf xs)
    have heq : L.top = a := L.le_antisymm hle (L.le_top a)
    rw [heq]
    exact hSB a (List.Mem.head _)

theorem nonempty_meet_min_length {B C : List α}
    (hC : L.IsFinClosureSystem C) (hGen : L.GeneratesNonempty B C) :
    (L.meetIrreds C).length + 1 ≤ B.length := by
  have hgen_std : L.GeneratesClosure B C := by
    intro x
    constructor
    · intro hxC
      obtain ⟨S, _, hSB, hxeq⟩ := (hGen x).mp hxC
      exact ⟨S, hSB, hxeq⟩
    · intro ⟨S, hSB, hxeq⟩
      cases S with
      | nil => rw [hxeq]; exact hC.top_mem
      | cons a xs => exact (hGen x).mpr ⟨a :: xs, fun h => List.noConfusion h, hSB, hxeq⟩
  have htopB : L.top ∈ B := L.top_mem_of_generatesNonempty hC hGen
  have hMB : ∀ m, m ∈ L.meetIrreds C → m ∈ B := L.meetIrreds_subset_of_generates hC hgen_std
  have hnodup : Nodup (L.top :: L.meetIrreds C) := by
    refine Nodup.cons ?_ (L.nodup_meetIrreds hC)
    intro hmem
    exact (L.mem_meetIrreds_iff.mp hmem).2.1 rfl
  have hsub : ∀ x, x ∈ L.top :: L.meetIrreds C → x ∈ B := by
    intro x hx
    cases hx with
    | head => exact htopB
    | tail _ hxm => exact hMB x hxm
  exact nodup_sub_length_le hnodup hsub

/-- Reading II: Concrete set-closure ground-set representation `L ↪ P(U)` via `joinIrreds`. -/
def isJoinIrredBool (j : α) : Bool :=
  !(decide (j = L.bot)) &&
    allList (fun a => allList (fun b =>
      !(decide (L.sup a b = j)) || decide (j = a) || decide (j = b)) L.elems) L.elems

def joinIrreds : List α :=
  filterList L.isJoinIrredBool L.elems

theorem mem_joinIrreds_iff {j : α} :
    j ∈ L.joinIrreds ↔
      j ≠ L.bot ∧ ∀ a b : α, L.sup a b = j → (j = a ∨ j = b) := by
  unfold joinIrreds isJoinIrredBool
  rw [mem_filterList]
  constructor
  · intro ⟨_, hb⟩
    simp only [Bool.and_eq_true, Bool.not_eq_true', decide_eq_false_iff_not,
      allList_eq_true] at hb
    obtain ⟨hne, hall⟩ := hb
    refine ⟨hne, fun a b hsup => ?_⟩
    have hrow := hall a (L.elems_complete a) b (L.elems_complete b)
    simp only [Bool.or_eq_true, Bool.not_eq_true', decide_eq_false_iff_not,
      decide_eq_true_eq] at hrow
    rcases hrow with (hnot | hja) | hjb
    · exact absurd hsup hnot
    · exact Or.inl hja
    · exact Or.inr hjb
  · intro ⟨hne, hirr⟩
    refine ⟨L.elems_complete j, ?_⟩
    simp only [Bool.and_eq_true, Bool.not_eq_true', decide_eq_false_iff_not,
      allList_eq_true]
    refine ⟨hne, fun a _ b _ => ?_⟩
    simp only [Bool.or_eq_true, Bool.not_eq_true', decide_eq_false_iff_not,
      decide_eq_true_eq]
    by_cases hsup : L.sup a b = j
    · rcases hirr a b hsup with hja | hjb
      · exact Or.inl (Or.inr hja)
      · exact Or.inr hjb
    · exact Or.inl (Or.inl hsup)

def strictLower (j : α) : List α :=
  filterList (fun x => decide (L.le x j) && !(decide (x = j))) L.elems

def jStar (j : α) : α :=
  L.listSup (L.strictLower j)

theorem le_jStar_of_lt {x j : α} (hxj : L.le x j) (hne : x ≠ j) : L.le x (L.jStar j) := by
  apply le_listSup_of_mem L
  unfold strictLower
  rw [mem_filterList]
  simp only [Bool.and_eq_true, Bool.not_eq_true', decide_eq_false_iff_not, decide_eq_true_eq]
  exact ⟨L.elems_complete x, hxj, hne⟩

theorem jStar_le (j : α) : L.le (L.jStar j) j := by
  apply listSup_le L
  intro x hx
  unfold strictLower at hx
  rw [mem_filterList] at hx
  simp only [Bool.and_eq_true, decide_eq_true_eq] at hx
  exact hx.2.1

theorem jStar_ne_of_joinIrred {j : α} (hj : j ∈ L.joinIrreds) : L.jStar j ≠ j := by
  obtain ⟨hneb, hirr⟩ := L.mem_joinIrreds_iff.mp hj
  have aux : ∀ (T : List α), L.listSup T = j → j ∈ T := by
    intro T
    induction T with
    | nil =>
      intro hbot
      exact absurd hbot.symm hneb
    | cons a ts ih =>
      intro hsup
      rcases hirr a (L.listSup ts) hsup with hja | hjts
      · rw [hja]; exact List.Mem.head _
      · exact List.Mem.tail _ (ih hjts.symm)
  intro heq
  have hmem : j ∈ L.strictLower j := aux (L.strictLower j) heq
  simp [strictLower, mem_filterList] at hmem

/-- Canonical concrete set-closure embedding `φ(x) = { j ∈ J(L) | j ≤ x }` into `P(J(L))`. -/
def canonicalSetEmbedding (x : α) (j : α) : Bool :=
  decide (L.le j x)

theorem canonicalSetEmbedding_preserves_inf_and_top :
    (∀ u, u ∈ L.joinIrreds → L.canonicalSetEmbedding L.top u = true) ∧
    (∀ x y u, u ∈ L.joinIrreds →
      L.canonicalSetEmbedding (L.inf x y) u =
        (L.canonicalSetEmbedding x u && L.canonicalSetEmbedding y u)) := by
  refine ⟨fun u _ => decide_eq_true (L.le_top u), fun x y u _ => ?_⟩
  unfold canonicalSetEmbedding
  by_cases hux : L.le u x
  · by_cases huy : L.le u y
    · simp [hux, huy, L.le_inf hux huy]
    · have hnot : ¬ L.le u (L.inf x y) := fun h => huy (L.le_trans h (L.inf_le_right x y))
      simp [hux, huy, hnot]
  · have hnot : ¬ L.le u (L.inf x y) := fun h => hux (L.le_trans h (L.inf_le_left x y))
    simp [hux, hnot]

/-- Helper finding first witness in `W` separating `j` from `jStar j`. -/
def findSep {γ : Type} (φ : α → γ → Bool) (j : α) : List γ → Option γ
  | [] => none
  | u :: us => if φ j u && !(φ (L.jStar j) u) then some u else findSep φ j us

/-- Helper mapping `J` through `findSep φ · U`. -/
def mapSep {γ : Type} (φ : α → γ → Bool) (U : List γ) : List α → List γ
  | [] => []
  | j :: js =>
    match L.findSep φ j U with
    | some u => u :: mapSep φ U js
    | none => mapSep φ U js

/-- Minimum Ground-Set Size Theorem (Reading II):
    Any concrete set-closure representation `φ : L → P(U)` preserving order and binary meets
    has `|J(L)| ≤ |U|`. -/
theorem concrete_ground_set_min_length {γ : Type} [DecidableEq γ]
    (U : List γ) (φ : α → γ → Bool)
    (hφ_le : ∀ x y, L.le x y ↔ ∀ u, u ∈ U → φ x u = true → φ y u = true)
    (hφ_inf : ∀ x y u, u ∈ U → φ (L.inf x y) u = (φ x u && φ y u)) :
    L.joinIrreds.length ≤ U.length := by
  have findSep_spec : ∀ {j : α}, j ∈ L.joinIrreds →
      ∃ u, L.findSep φ j U = some u ∧ u ∈ U ∧ φ j u = true ∧ φ (L.jStar j) u = false := by
    intro j hj
    have hnot_le : ¬ L.le j (L.jStar j) := by
      intro hle
      exact L.jStar_ne_of_joinIrred hj (L.le_antisymm (L.jStar_le j) hle)
    have hnot_all : ¬ (∀ u, u ∈ U → φ j u = true → φ (L.jStar j) u = true) :=
      fun hall => hnot_le ((hφ_le j (L.jStar j)).mpr hall)
    have walk : ∀ (W : List γ),
        (¬ ∀ u, u ∈ W → φ j u = true → φ (L.jStar j) u = true) →
        ∃ u, L.findSep φ j W = some u ∧ u ∈ W ∧ φ j u = true ∧ φ (L.jStar j) u = false := by
      intro W
      induction W with
      | nil =>
        intro hbad
        exact False.elim (hbad (fun _ h => nomatch h))
      | cons w ws ih =>
        intro hbad
        unfold findSep
        by_cases htest : (φ j w && !(φ (L.jStar j) w)) = true
        · simp only [htest, ↓reduceIte]
          simp only [Bool.and_eq_true, Bool.not_eq_true'] at htest
          exact ⟨w, rfl, List.Mem.head _, htest.1, htest.2⟩
        · have hfalse : (φ j w && !(φ (L.jStar j) w)) = false := Bool.eq_false_iff.mpr htest
          simp only [hfalse, Bool.false_eq_true, ↓reduceIte]
          have hws_bad : ¬ ∀ u, u ∈ ws → φ j u = true → φ (L.jStar j) u = true := by
            intro hws_ok
            apply hbad
            intro u hu hju
            cases hu with
            | head =>
              cases hstar : φ (L.jStar j) w
              · rw [hju, hstar] at htest
                exact absurd rfl htest
              · rfl
            | tail _ hus => exact hws_ok u hus hju
          obtain ⟨u, hgo, huws, h1, h2⟩ := ih hws_bad
          exact ⟨u, hgo, List.Mem.tail _ huws, h1, h2⟩
    exact walk U hnot_all
  have hnodup_J : Nodup L.joinIrreds := nodup_filterList L.elems_nodup
  have mapSep_props : ∀ {J : List α}, Nodup J → (∀ j, j ∈ J → j ∈ L.joinIrreds) →
      J.length = (L.mapSep φ U J).length ∧ Nodup (L.mapSep φ U J) ∧
      (∀ u, u ∈ L.mapSep φ U J → ∃ j, j ∈ J ∧ L.findSep φ j U = some u) ∧
      (∀ u, u ∈ L.mapSep φ U J → u ∈ U) := by
    intro J
    induction J with
    | nil =>
      intro _ _
      exact ⟨rfl, ⟨Nodup.nil, ⟨fun _ h => (nomatch h), fun _ h => (nomatch h)⟩⟩⟩
    | cons j₁ js ih =>
      intro hnod hJsub
      cases hnod with
      | cons hj₁_not hjs_nod =>
        obtain ⟨hlen_js, hnod_map, hsrc_js, hU_js⟩ :=
          ih hjs_nod (fun j hj => hJsub j (List.Mem.tail _ hj))
        have hj₁_irr : j₁ ∈ L.joinIrreds := hJsub j₁ (List.Mem.head _)
        obtain ⟨u₁, hfind₁, hu₁U, hφ₁_t, hφ₁_f⟩ := findSep_spec hj₁_irr
        unfold mapSep
        rw [hfind₁]
        refine ⟨by simp [hlen_js], Nodup.cons ?_ hnod_map, ?_, ?_⟩
        · intro hu₁_in
          obtain ⟨j₂, hj₂_js, hfind₂⟩ := hsrc_js u₁ hu₁_in
          have hj₂_irr : j₂ ∈ L.joinIrreds := hJsub j₂ (List.Mem.tail _ hj₂_js)
          obtain ⟨u₂, hfind₂', _, hφ₂_t, hφ₂_f⟩ := findSep_spec hj₂_irr
          rw [hfind₂] at hfind₂'
          injection hfind₂' with hu_eq
          subst hu_eq
          have hinf_u : φ (L.inf j₁ j₂) u₁ = true := by
            rw [hφ_inf j₁ j₂ u₁ hu₁U, hφ₁_t, hφ₂_t]; rfl
          have hinf_eq₁ : L.inf j₁ j₂ = j₁ := by
            apply Classical.byContradiction
            intro hne₁
            have hle_star₁ : L.le (L.inf j₁ j₂) (L.jStar j₁) :=
              L.le_jStar_of_lt (L.inf_le_left j₁ j₂) hne₁
            have hstar_true : φ (L.jStar j₁) u₁ = true :=
              (hφ_le _ _).mp hle_star₁ u₁ hu₁U hinf_u
            rw [hφ₁_f] at hstar_true
            exact Bool.noConfusion hstar_true
          have hinf_eq₂ : L.inf j₁ j₂ = j₂ := by
            apply Classical.byContradiction
            intro hne₂
            have hle_star₂ : L.le (L.inf j₁ j₂) (L.jStar j₂) :=
              L.le_jStar_of_lt (L.inf_le_right j₁ j₂) hne₂
            have hstar_true : φ (L.jStar j₂) u₁ = true :=
              (hφ_le _ _).mp hle_star₂ u₁ hu₁U hinf_u
            rw [hφ₂_f] at hstar_true
            exact Bool.noConfusion hstar_true
          have hjeq : j₁ = j₂ := hinf_eq₁.symm.trans hinf_eq₂
          rw [hjeq] at hj₁_not
          exact hj₁_not hj₂_js
        · intro u hu
          cases hu with
          | head => exact ⟨j₁, List.Mem.head _, hfind₁⟩
          | tail _ hus =>
            obtain ⟨j₂, hj₂, hf₂⟩ := hsrc_js u hus
            exact ⟨j₂, List.Mem.tail _ hj₂, hf₂⟩
        · intro u hu
          cases hu with
          | head => exact hu₁U
          | tail _ hus => exact hU_js u hus
  obtain ⟨hlen, hnod_map, _, hsubU⟩ := mapSep_props hnodup_J (fun _ h => h)
  rw [hlen]
  exact nodup_sub_length_le hnod_map hsubU

end FiniteLattice

/-! ## Section 5: Explicit Counterexamples (`C1`, `C2`) and Positive Witnesses (`C3`, `B2`) -/

/-- `C₁`: The 1-element finite lattice on `Unit`. -/
def C1 : FiniteLattice Unit where
  elems := [()]
  elems_nodup := Nodup.cons (fun h => nomatch h) Nodup.nil
  elems_complete := fun () => List.Mem.head _
  top := ()
  bot := ()
  inf _ _ := ()
  sup _ _ := ()
  inf_comm _ _ := rfl
  inf_assoc _ _ _ := rfl
  inf_idem _ := rfl
  inf_top _ := rfl
  sup_comm _ _ := rfl
  sup_assoc _ _ _ := rfl
  sup_idem _ := rfl
  sup_bot _ := rfl
  inf_sup_self _ _ := rfl
  sup_inf_self _ _ := rfl

/-- `C₂`: The nontrivial 2-element chain `false < true` on `Bool` (`|C₂| = 2`, `bot ≠ top`). -/
def C2 : FiniteLattice Bool where
  elems := [false, true]
  elems_nodup := Nodup.cons (by decide) (Nodup.cons (by decide) Nodup.nil)
  elems_complete b := by cases b <;> decide
  top := true
  bot := false
  inf a b := a && b
  sup a b := a || b
  inf_comm a b := by cases a <;> cases b <;> rfl
  inf_assoc a b c := by cases a <;> cases b <;> cases c <;> rfl
  inf_idem a := by cases a <;> rfl
  inf_top a := by cases a <;> rfl
  sup_comm a b := by cases a <;> cases b <;> rfl
  sup_assoc a b c := by cases a <;> cases b <;> cases c <;> rfl
  sup_idem a := by cases a <;> rfl
  sup_bot a := by cases a <;> rfl
  inf_sup_self a b := by cases a <;> cases b <;> rfl
  sup_inf_self a b := by cases a <;> cases b <;> rfl

/-- Carrier for the 3-element chain `C₃ = {e0 < e1 < e2}`. -/
inductive Elem3 where
  | e0 : Elem3
  | e1 : Elem3
  | e2 : Elem3
  deriving DecidableEq

namespace Elem3

def inf3 : Elem3 → Elem3 → Elem3
  | e0, _ => e0
  | _, e0 => e0
  | e1, _ => e1
  | _, e1 => e1
  | e2, e2 => e2

def sup3 : Elem3 → Elem3 → Elem3
  | e2, _ => e2
  | _, e2 => e2
  | e1, _ => e1
  | _, e1 => e1
  | e0, e0 => e0

end Elem3

/-- `C₃`: The 3-element chain finite lattice (`|C₃| = 3`). -/
def C3 : FiniteLattice Elem3 where
  elems := [Elem3.e0, Elem3.e1, Elem3.e2]
  elems_nodup :=
    Nodup.cons (by decide)
      (Nodup.cons (by decide)
        (Nodup.cons (by decide) Nodup.nil))
  elems_complete x := by cases x <;> decide
  top := Elem3.e2
  bot := Elem3.e0
  inf := Elem3.inf3
  sup := Elem3.sup3
  inf_comm x y := by cases x <;> cases y <;> rfl
  inf_assoc x y z := by cases x <;> cases y <;> cases z <;> rfl
  inf_idem x := by cases x <;> rfl
  inf_top x := by cases x <;> rfl
  sup_comm x y := by cases x <;> cases y <;> rfl
  sup_assoc x y z := by cases x <;> cases y <;> cases z <;> rfl
  sup_idem x := by cases x <;> rfl
  sup_bot x := by cases x <;> rfl
  inf_sup_self x y := by cases x <;> cases y <;> rfl
  sup_inf_self x y := by cases x <;> cases y <;> rfl

/-- `B₂`: The 4-element Boolean diamond lattice on `Bool × Bool` (`|B₂| = 4`). -/
def B2 : FiniteLattice (Bool × Bool) where
  elems := [(false, false), (false, true), (true, false), (true, true)]
  elems_nodup :=
    Nodup.cons (by decide)
      (Nodup.cons (by decide)
        (Nodup.cons (by decide)
          (Nodup.cons (by decide) Nodup.nil)))
  elems_complete p := by cases p with | mk a b => cases a <;> cases b <;> decide
  top := (true, true)
  bot := (false, false)
  inf p q := (p.1 && q.1, p.2 && q.2)
  sup p q := (p.1 || q.1, p.2 || q.2)
  inf_comm p q := by cases p with | mk a1 a2 => cases q with | mk b1 b2 => cases a1 <;> cases a2 <;> cases b1 <;> cases b2 <;> rfl
  inf_assoc p q r := by
    cases p with | mk a1 a2 => cases q with | mk b1 b2 => cases r with | mk c1 c2 =>
      cases a1 <;> cases a2 <;> cases b1 <;> cases b2 <;> cases c1 <;> cases c2 <;> rfl
  inf_idem p := by cases p with | mk a1 a2 => cases a1 <;> cases a2 <;> rfl
  inf_top p := by cases p with | mk a1 a2 => cases a1 <;> cases a2 <;> rfl
  sup_comm p q := by cases p with | mk a1 a2 => cases q with | mk b1 b2 => cases a1 <;> cases a2 <;> cases b1 <;> cases b2 <;> rfl
  sup_assoc p q r := by
    cases p with | mk a1 a2 => cases q with | mk b1 b2 => cases r with | mk c1 c2 =>
      cases a1 <;> cases a2 <;> cases b1 <;> cases b2 <;> cases c1 <;> cases c2 <;> rfl
  sup_idem p := by cases p with | mk a1 a2 => cases a1 <;> cases a2 <;> rfl
  sup_bot p := by cases p with | mk a1 a2 => cases a1 <;> cases a2 <;> rfl
  inf_sup_self p q := by cases p with | mk a1 a2 => cases q with | mk b1 b2 => cases a1 <;> cases a2 <;> cases b1 <;> cases b2 <;> rfl
  sup_inf_self p q := by cases p with | mk a1 a2 => cases q with | mk b1 b2 => cases a1 <;> cases a2 <;> cases b1 <;> cases b2 <;> rfl

/-- Counterexample 1 (`C₁`): On the 1-element finite lattice `C₁` with `(id, id)`,
    representation lengths under Reading I (`0`), Reading II (`0`), and Reading III (`1`)
    are all strictly less than `2`. -/
theorem c1_refutes_lower_bound_two :
    GaloisConnection C1.toPoset C1.toPoset (fun x => x) (fun x => x) ∧
    (C1.meetIrreds (C1.galoisClosedList (fun x => x) (fun x => x))).length = 0 ∧
    C1.joinIrreds.length = 0 ∧
    (C1.galoisClosedList (fun x => x) (fun x => x)).length = 1 :=
  ⟨id_galois C1.toPoset, rfl, rfl, rfl⟩

/-- Counterexample 2 (`C₂` with bijective `(id, id)`): Even on the NONTRIVIAL finite lattice `C₂`
    (`bot ≠ top`) with the bijective identity Galois connection `(id, id)`, the unique minimal
    meet-generating length (Reading I) is `1 < 2` and the minimal concrete set-closure
    ground-set length (Reading II) is `1 < 2`. -/
theorem c2_bijective_refutes_lower_bound_two :
    C2.bot ≠ C2.top ∧
    GaloisConnection C2.toPoset C2.toPoset (fun x => x) (fun x => x) ∧
    (C2.meetIrreds (C2.galoisClosedList (fun x => x) (fun x => x))).length = 1 ∧
    C2.joinIrreds.length = 1 :=
  ⟨by decide, id_galois C2.toPoset, rfl, rfl⟩

/-- Counterexample 3 (Constant Galois connection on ANY finite lattices `L₁, L₂`):
    `f(x) = L₂.bot` and `g(y) = L₁.top` ALWAYS form a monotone Galois connection `L₁ ⇄ L₂`
    whose closed-element closure system `[L₁.top]` has Reading I length `0 < 2`
    and Reading III length `1 < 2` (even when `|L₁|, |L₂| ≥ 2`). -/
theorem const_galois_refutes_all_readings {α β : Type} [DecidableEq α] [DecidableEq β]
    (L₁ : FiniteLattice α) (L₂ : FiniteLattice β) :
    GaloisConnection L₁.toPoset L₂.toPoset (fun _ => L₂.bot) (fun _ => L₁.top) ∧
    (L₁.meetIrreds (L₁.galoisClosedList (fun _ : α => L₂.bot) (fun _ : β => L₁.top))).length = 0 ∧
    (L₁.galoisClosedList (fun _ : α => L₂.bot) (fun _ : β => L₁.top)).length = 1 := by
  have hgc : GaloisConnection L₁.toPoset L₂.toPoset (fun _ => L₂.bot) (fun _ => L₁.top) := {
    f_mono := fun _ => L₂.le_refl L₂.bot
    g_mono := fun _ => L₁.le_refl L₁.top
    adj := fun x y => ⟨fun _ => L₁.le_top x, fun _ => L₂.bot_le y⟩
  }
  have hC : L₁.IsFinClosureSystem
      (L₁.galoisClosedList (fun _ : α => L₂.bot) (fun _ : β => L₁.top)) :=
    L₁.galoisClosedList_isClosureSystem hgc
  have hsub : ∀ x, x ∈ L₁.galoisClosedList (fun _ : α => L₂.bot) (fun _ : β => L₁.top) →
      x ∈ [L₁.top] := by
    intro x hx
    obtain ⟨_, rfl⟩ := (L₁.galoisClosedList_mem_iff hgc x).mp hx
    exact List.Mem.head _
  have hle1 : (L₁.galoisClosedList (fun _ : α => L₂.bot) (fun _ : β => L₁.top)).length ≤ 1 :=
    nodup_sub_length_le hC.nodup hsub
  have hge1 : 1 ≤ (L₁.galoisClosedList (fun _ : α => L₂.bot) (fun _ : β => L₁.top)).length := by
    have := L₁.meetIrreds_length_succ_le hC
    omega
  have hlen1 : (L₁.galoisClosedList (fun _ : α => L₂.bot) (fun _ : β => L₁.top)).length = 1 := by
    omega
  exact ⟨hgc, (L₁.repLength_zero_iff hC).mpr hlen1, hlen1⟩

/-- Non-invertibility and non-symmetry witness on `C₂`:
    For the constant Galois connection `f_const = false`, `g_const = true` on `C₂`,
    `g_const` is NOT injective (no two-sided inverse exists), and the un-dualized swapped
    pair `(g_const, f_const)` is NOT a monotone Galois connection on `(C₂, C₂)`. -/
theorem c2_const_non_invertible_and_swap_fails :
    GaloisConnection C2.toPoset C2.toPoset (fun _ => false) (fun _ => true) ∧
    (¬ ∀ y₁ y₂ : Bool, (fun _ : Bool => true) y₁ = (fun _ : Bool => true) y₂ → y₁ = y₂) ∧
    (¬ GaloisConnection C2.toPoset C2.toPoset (fun _ => true) (fun _ => false)) := by
  refine ⟨(const_galois_refutes_all_readings C2 C2).1, ?_, ?_⟩
  · intro hinj
    exact Bool.noConfusion (hinj false true rfl)
  · intro hswap
    have htrue : C2.le true true := rfl
    have hfalse : C2.le true false := (hswap.adj true true).mp htrue
    exact Bool.noConfusion hfalse

/-- Counterexample 4 (Non-constant 2-closed-element Galois connection on ANY finite lattice `L`
    with `a ≠ L.top`, including arbitrarily large finite lattices `|L| ≥ 3`):
    `g` is non-constant (`Im(g) = {a, L.top}` of size `2`), yet its unique minimal
    meet-generating length (Reading I) is `1 < 2`. -/
theorem nonconstant_two_elem_galois_length_one {α : Type} [DecidableEq α]
    (L : FiniteLattice α) {a : α} (ha : a ≠ L.top) :
    let f : α → Bool := fun x => if decide (L.le x a) then false else true
    let g : Bool → α := fun y => if y then L.top else a
    GaloisConnection L.toPoset C2.toPoset f g ∧
    g false ≠ g true ∧
    (L.meetIrreds (L.galoisClosedList f g)).length = 1 := by
  intro f g
  have hgc : GaloisConnection L.toPoset C2.toPoset f g := {
    f_mono := by
      intro x₁ x₂ hx
      unfold f
      by_cases hx₂ : L.le x₂ a
      · have hx₁ : L.le x₁ a := L.le_trans hx hx₂
        simp [hx₁, hx₂]; rfl
      · by_cases hx₁ : L.le x₁ a <;> simp [hx₁, hx₂] <;> rfl
    g_mono := by
      intro y₁ y₂ hy
      cases y₁ <;> cases y₂
      · exact L.le_refl a
      · exact L.le_top a
      · exact Bool.noConfusion hy
      · exact L.le_refl L.top
    adj := by
      intro x y
      unfold f g
      cases y
      · by_cases hxa : L.le x a
        · simp only [hxa, decide_true, ↓reduceIte]
          exact ⟨fun _ => hxa, fun _ => rfl⟩
        · simp only [hxa, decide_false, Bool.false_eq_true, ↓reduceIte]
          exact ⟨fun h => Bool.noConfusion h, fun h => absurd h hxa⟩
      · by_cases hxa : L.le x a
        · simp only [hxa, decide_true, ↓reduceIte]
          exact ⟨fun _ => L.le_top x, fun _ => rfl⟩
        · simp only [hxa, decide_false, Bool.false_eq_true, ↓reduceIte]
          exact ⟨fun _ => L.le_top x, fun _ => rfl⟩
  }
  have hC : L.IsFinClosureSystem (L.galoisClosedList f g) :=
    L.galoisClosedList_isClosureSystem hgc
  have hnod2 : Nodup [a, L.top] :=
    Nodup.cons (fun h => by cases h with | head => exact ha rfl | tail _ h' => nomatch h')
      (Nodup.cons (fun h => nomatch h) Nodup.nil)
  have hsub1 : ∀ x, x ∈ [a, L.top] → x ∈ L.galoisClosedList f g := by
    intro x hx
    rw [L.galoisClosedList_mem_iff hgc]
    cases hx with
    | head => exact ⟨false, rfl⟩
    | tail _ hxt => cases hxt with | head => exact ⟨true, rfl⟩ | tail _ h => nomatch h
  have hsub2 : ∀ x, x ∈ L.galoisClosedList f g → x ∈ [a, L.top] := by
    intro x hx
    obtain ⟨y, rfl⟩ := (L.galoisClosedList_mem_iff hgc x).mp hx
    cases y
    · exact List.Mem.head _
    · exact List.Mem.tail _ (List.Mem.head _)
  have hge2 : 2 ≤ (L.galoisClosedList f g).length :=
    nodup_sub_length_le hnod2 hsub1
  have hle2 : (L.galoisClosedList f g).length ≤ 2 :=
    nodup_sub_length_le hC.nodup hsub2
  have hlen2 : (L.galoisClosedList f g).length = 2 := by omega
  exact ⟨hgc, ha, (L.repLength_one_iff hC).mpr hlen2⟩

/-- Positive Non-Vacuity Witnesses (`C₃` and `B₂`):
    On the 3-element chain `C₃` and the 4-element Boolean lattice `B₂` with `(id, id)`,
    the sharp lower bound `2` of the salvaged theorem (`|Im(g)| ≥ 3 → length ≥ 2`) IS attained
    under both Reading I (`|M(L)| = 2`) and Reading II (`|J(L)| = 2`). -/
theorem c3_and_b2_attain_lower_bound_two :
    (C3.meetIrreds (C3.galoisClosedList (fun x => x) (fun x => x))).length = 2 ∧
    C3.joinIrreds.length = 2 ∧
    (B2.meetIrreds (B2.galoisClosedList (fun x => x) (fun x => x))).length = 2 ∧
    B2.joinIrreds.length = 2 :=
  ⟨rfl, rfl, rfl, rfl⟩

/-! ## Section 6: Master Resolution Theorem & Axiom Verification -/

/-- Complete formal resolution of Conjecture 00000004507:
    1. Refutation on `C₁` (Reading I = `0 < 2`, Reading II = `0 < 2`, Reading III = `1 < 2`);
    2. Refutation on `C₂` even for bijective `(id, id)` (Reading I = `1 < 2`, Reading II = `1 < 2`);
    3. Refutation on `C₂` (and any finite lattice) via constant Galois connections (Reading I = `0`, Reading III = `1`);
    4. Infinite complete lattice refutation of minimal unit generation (`CutLattice`);
    5. Exact salvaged theorem (`2 ≤ |M(C)| ↔ 3 ≤ |C|`) with non-vacuity witnesses `C₃` and `B₂` attaining `2`. -/
theorem conjecture_00000004507_disproved_and_classified :
    -- (1) Finite lattice counterexample C₁ (lengths 0, 0, 1 < 2)
    ((C1.meetIrreds (C1.galoisClosedList (fun x => x) (fun x => x))).length < 2 ∧
     C1.joinIrreds.length < 2 ∧
     (C1.galoisClosedList (fun x => x) (fun x => x)).length < 2) ∧
    -- (2) Nontrivial finite lattice counterexample C₂ with bijective (id, id) (lengths 1, 1 < 2)
    (C2.bot ≠ C2.top ∧
     (C2.meetIrreds (C2.galoisClosedList (fun x => x) (fun x => x))).length < 2 ∧
     C2.joinIrreds.length < 2) ∧
    -- (3) Infinite complete lattice counterexample with NO minimal meet-generating set
    (Generates CutLattice (fun _ => True) (fun v => ∃ d, v = pCut d) ∧
     ∀ B : Cut → Prop, Generates CutLattice (fun _ => True) B →
       ∃ b₀ : Cut, B b₀ ∧ Generates CutLattice (fun _ => True) (fun v => B v ∧ v ≠ b₀)) ∧
    -- (4) Positive non-vacuity witnesses C₃ and B₂ attaining the salvaged lower bound 2
    ((C3.meetIrreds (C3.galoisClosedList (fun x => x) (fun x => x))).length = 2 ∧
     (B2.meetIrreds (B2.galoisClosedList (fun x => x) (fun x => x))).length = 2) := by
  refine ⟨⟨by decide, by decide, by decide⟩,
          ⟨by decide, by decide, by decide⟩,
          ⟨pCut_generates_cutLattice, dyadicCut_no_minimal_generator⟩,
          ⟨rfl, rfl⟩⟩

