import Mathlib.RingTheory.PowerSeries.Inverse
import Mathlib.RingTheory.KrullDimension.PID
import Mathlib.Algebra.CharP.Frobenius
import Mathlib.Algebra.CharP.Algebra
import Mathlib.Algebra.Field.ZMod
import Mathlib.LinearAlgebra.Quotient.Basic
import Mathlib.Analysis.Asymptotics.Defs
import Mathlib.Analysis.SpecificLimits.Basic
import Mathlib.Tactic.NormNum
import Mathlib.Tactic.Positivity
import Mathlib.Tactic.Linarith

namespace TLMC3901
open PowerSeries
noncomputable section
abbrev R := PowerSeries (ZMod 2)
instance charTwo : CharP R 2 :=
  charP_of_injective_ringHom PowerSeries.C_injective 2
def I : Ideal R := Ideal.span {(X : R)}

theorem ring_dimension : ringKrullDim R=1 :=
  IsPrincipalIdealRing.ringKrullDim_eq_one R (IsDiscreteValuationRing.not_isField R)
theorem maximal_ideal : IsLocalRing.maximalIdeal R=I :=
  PowerSeries.maximalIdeal_eq_span_X
theorem X_nonzero : (X : R)≠0 := by exact PowerSeries.X_ne_zero

/-- The genuine ideal generated by the iterated Frobenius image. -/
def frobeniusPower (e : ℕ) : Ideal R := Ideal.map (iterateFrobenius R 2 e) I
theorem frobeniusPower_eq (e : ℕ) :
    frobeniusPower e=Ideal.span {(X : R)^(2^e)} := by
  simp [frobeniusPower,I,Ideal.map_span,iterateFrobenius_def]

theorem power_le_I (k : ℕ) : Ideal.span {(X : R)^(k+1)}≤I := by
  rw [Ideal.span_singleton_le_iff_mem,I,Ideal.mem_span_singleton]
  exact dvd_pow_self X (by omega)

def denominator (q : ℕ) : Submodule R I :=
  Submodule.comap (Submodule.subtype I) (Ideal.span {(X : R)^q})
abbrev QuotientAt (q : ℕ) := I ⧸ denominator q

def mulX : R→ₗ[R]I where
  toFun f := ⟨X*f,Ideal.mem_span_singleton.mpr ⟨f,rfl⟩⟩
  map_add' f g := Subtype.ext (mul_add X f g)
  map_smul' a f := by apply Subtype.ext; change X*(a*f)=a*(X*f); ring

theorem mulX_bijective : Function.Bijective mulX := by
  constructor
  · intro f g h
    exact mul_left_cancel₀ X_nonzero (congrArg Subtype.val h)
  · intro y
    obtain ⟨f,hf⟩ := Ideal.mem_span_singleton.mp y.2
    exact ⟨f,Subtype.ext hf.symm⟩

def mulXEquiv : R≃ₗ[R]I := LinearEquiv.ofBijective mulX mulX_bijective

theorem denominator_preimage (k : ℕ) :
    (denominator (k+1)).comap mulXEquiv.toLinearMap = Ideal.span {(X : R)^k} := by
  ext f
  simp only [Submodule.mem_comap,denominator,Ideal.mem_span_singleton]
  change (X : R)^(k+1)∣X*f ↔ (X : R)^k∣f
  rw [pow_succ']
  exact mul_dvd_mul_iff_left X_nonzero

theorem denominator_image (k : ℕ) :
    Submodule.map mulXEquiv.toLinearMap (Ideal.span {(X : R)^k}) = denominator (k+1) := by
  rw [← denominator_preimage k,Submodule.map_comap_eq]
  simp [LinearEquiv.range]

def quotientEquiv (k : ℕ) : (R ⧸ Ideal.span {(X : R)^k})≃ₗ[R]QuotientAt (k+1) :=
  Submodule.Quotient.equiv _ _ mulXEquiv (denominator_image k)

theorem quotient_length_succ (k : ℕ) : Module.length R (QuotientAt (k+1))=k := by
  rw [← (quotientEquiv k).length_eq]
  have h := IsDiscreteValuationRing.length_quotient_pow_maximalIdeal (R:=R) k
  rw [maximal_ideal,I,Ideal.span_singleton_pow] at h
  exact h

theorem frobeniusPower_le (e : ℕ) : frobeniusPower e≤I := by
  rw [frobeniusPower_eq]
  have hq : 0<2^e := by positivity
  have he : 2^e=(2^e-1)+1 := by omega
  rw [he]
  exact power_le_I _

/-- Actual I/I^[2^e], using the denominator's inclusion in I. -/
def frobeniusDenominator (e : ℕ) : Submodule R I :=
  Submodule.comap (Submodule.subtype I) (frobeniusPower e)
abbrev FrobeniusQuotient (e : ℕ) := I ⧸ frobeniusDenominator e

theorem actual_frobenius_length (e : ℕ) :
    Module.length R (FrobeniusQuotient e)=(2^e-1 : ℕ) := by
  have hd : frobeniusDenominator e=denominator (2^e) := by
    simp only [frobeniusDenominator,denominator,frobeniusPower_eq]
  change Module.length R (I ⧸ frobeniusDenominator e)=_
  rw [hd]
  have hq : 0<2^e := by positivity
  have he : 2^e=(2^e-1)+1 := by omega
  rw [he]
  exact quotient_length_succ _

theorem actual_length_finite (e : ℕ) :
    Module.length R (FrobeniusQuotient e)≠⊤ := by
  rw [actual_frobenius_length]
  exact ENat.natCast_ne_top _

/-- This value is extracted from the actual finite R-module length, not assigned. -/
def lengthValue (e : ℕ) : ℝ := (Module.length R (FrobeniusQuotient e)).toNat

theorem lengthValue_eq (e : ℕ) : lengthValue e=(2^e-1 : ℕ) := by
  unfold lengthValue
  rw [actual_frobenius_length,ENat.toNat_natCast]

theorem length_cofinally_unbounded (C : ℝ) (N : ℕ) :
    ∃ e≥N, C<lengthValue e := by
  let e := N+⌈C⌉₊+2
  have hpow : e+1≤2^e := Nat.succ_le_iff.mpr (Nat.lt_two_pow_self)
  have hlower : e≤2^e-1 := by omega
  refine ⟨e,by dsimp [e]; omega,?_⟩
  rw [lengthValue_eq]
  have hc : C≤(⌈C⌉₊:ℝ) := Nat.le_ceil C
  have he : (⌈C⌉₊:ℝ)+2≤(e:ℝ) := by
    have hN : 0≤(N:ℝ) := Nat.cast_nonneg N
    dsimp [e]
    push_cast
    linarith
  have hp : (e:ℝ)≤(2^e-1:ℕ) := by exact_mod_cast hlower
  linarith

theorem length_not_bounded :
    ¬∃ C : ℝ, ∃ N : ℕ, ∀ e≥N, lengthValue e≤C := by
  rintro ⟨C,N,h⟩
  obtain ⟨e,he,hlarge⟩ := length_cofinally_unbounded C N
  exact (not_lt_of_ge (h e he)) hlarge

theorem length_not_bigO_one :
    ¬Asymptotics.IsBigO Filter.atTop lengthValue (fun _ : ℕ => (1:ℝ)) := by
  intro h
  obtain ⟨C,_,hC⟩ := h.exists_pos
  obtain ⟨N,hN⟩ := Filter.eventually_atTop.mp hC.bound
  apply length_not_bounded
  refine ⟨C,N,fun e he => ?_⟩
  have hh := hN e he
  have hn : 0≤lengthValue e := by rw [lengthValue_eq]; positivity
  simpa only [Real.norm_of_nonneg hn,norm_one,mul_one] using hh

/-- n=1, so the conjectured q^(n-1) scale is exactly the constant-one scale. -/
theorem proposed_dimension_minus_one_exponent_fails :
    ¬Asymptotics.IsBigO Filter.atTop lengthValue
      (fun e : ℕ => ((2:ℝ)^e)^(1-1 : ℕ)) := by
  simpa only [Nat.sub_self,pow_zero] using length_not_bigO_one

theorem no_finite_leading_coefficient (c : ℝ) :
    ¬Filter.Tendsto (fun e : ℕ => lengthValue e/((2:ℝ)^e)^(1-1 : ℕ))
      Filter.atTop (nhds c) := by
  simp only [Nat.sub_self,pow_zero,div_one]
  intro h
  have he : ∀ᶠ e in Filter.atTop, lengthValue e<c+1 :=
    h.eventually (eventually_lt_nhds (lt_add_one c))
  obtain ⟨N,hN⟩ := Filter.eventually_atTop.mp he
  obtain ⟨e,heN,hlarge⟩ := length_cofinally_unbounded (c+1) N
  exact (not_lt_of_ge (hN e heN).le) hlarge

theorem reversed_quotient_not_nested : ¬I≤frobeniusPower 1 := by
  intro h
  have hm : (X:R)∈I := Ideal.subset_span (Set.mem_singleton X)
  have hd : (X:R)^2∣X := by
    have hh := h hm
    simpa [frobeniusPower_eq,Ideal.mem_span_singleton] using hh
  obtain ⟨a,ha⟩ := hd
  have he : (X:R)*1=X*(X*a) := by calc
    X*1=X := by rw [mul_one]
    _=X^2*a := ha
    _=X*(X*a) := by ring
  have hu : IsUnit (X:R) := isUnit_iff_dvd_one.mpr ⟨a,mul_left_cancel₀ X_nonzero he⟩
  exact PowerSeries.X_irreducible.not_isUnit hu

theorem actual_counterexample :
    ringKrullDim R=1 ∧ IsLocalRing.maximalIdeal R=I ∧
    (∀ e,Module.length R (FrobeniusQuotient e)=(2^e-1 : ℕ)) ∧
    ¬Asymptotics.IsBigO Filter.atTop lengthValue
      (fun e : ℕ => ((2:ℝ)^e)^(1-1 : ℕ)) :=
  ⟨ring_dimension,maximal_ideal,actual_frobenius_length,
    proposed_dimension_minus_one_exponent_fails⟩

end
end TLMC3901
