Conjecture1569.mem_angleSet_iff (S : Finset Conjecture1569.Plane) (θ : ℝ) :
  θ ∈ Conjecture1569.angleSet S ↔ ∃ a ∈ S, ∃ b ∈ S, ∃ c ∈ S, a ≠ b ∧ b ≠ c ∧ a ≠ c ∧ EuclideanGeometry.angle a b c = θ
Conjecture1569.configuration_card (n : ℕ) : (Conjecture1569.configuration n).card = n
Conjecture1569.configuration_angleSet_card_le (n : ℕ) :
  (Conjecture1569.angleSet (Conjecture1569.configuration n)).card ≤ 2
Conjecture1569.arbitrarily_large_counterexamples (C : ℝ) (N : ℕ) :
  ∃ n, N ≤ n ∧ ∃ S, S.card = n ∧ ↑(Conjecture1569.angleSet S).card < ↑n ^ 2 - C * ↑n
Conjecture1569.not_uniformQuadraticLowerBound : ¬Conjecture1569.UniformQuadraticLowerBound
Conjecture1569.original_conjunction_false (LatticeAttainment : Prop) :
  ¬(Conjecture1569.UniformQuadraticLowerBound ∧ LatticeAttainment)
