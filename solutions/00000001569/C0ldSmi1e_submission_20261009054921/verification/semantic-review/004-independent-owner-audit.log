@[reducible] def Conjecture1569.Plane : Type :=
EuclideanSpace ℝ (Fin 2)
def Conjecture1569.angleSet : Finset Conjecture1569.Plane → Finset ℝ :=
fun S =>
  Finset.image (fun t => EuclideanGeometry.angle t.1 t.2.1 t.2.2)
    ({t ∈ S ×ˢ S ×ˢ S | t.1 ≠ t.2.1 ∧ t.2.1 ≠ t.2.2 ∧ t.1 ≠ t.2.2})
def Conjecture1569.axisPoint : ℝ → Conjecture1569.Plane :=
fun x => !₂[x, 0]
def Conjecture1569.configuration : ℕ → Finset Conjecture1569.Plane :=
fun n => Finset.image (fun j => Conjecture1569.axisPoint ↑j) (Finset.range n)
def Conjecture1569.UniformQuadraticLowerBound : Prop :=
∃ C,
  0 ≤ C ∧
    ∃ N,
      ∀ (n : ℕ),
        N ≤ n → ∀ (S : Finset Conjecture1569.Plane), S.card = n → ↑n ^ 2 - C * ↑n ≤ ↑(Conjecture1569.angleSet S).card
