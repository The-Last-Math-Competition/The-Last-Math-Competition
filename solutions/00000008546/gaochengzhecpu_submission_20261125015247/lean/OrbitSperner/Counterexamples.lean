/-
  OrbitSperner/Counterexamples.lean
  Core Lean 4.19.0 formalization of:
  1. Freese-Dilworth Invariant Antichain Theorem: on ANY finite poset (Fin m, ≤),
     there exists an Aut(P)-invariant antichain attaining the classical Sperner width,
     so the invariant-antichain deficit is identically 0 across all finite posets.
  2. Faithful S_n-Poset Counterexample Family P(n) (size 4n + 6, n ≥ 2):
     a bounded graded Sperner poset with a faithful S_n-action whose quotient P(n)/S_n
     has maximum orbit-rank size 4 (symmetrized Sperner number) yet orbit-antichain width 5,
     refuting Clause 1 of Conjecture 00000008546 on general bounded graded Sperner posets.
  3. Asymptotic Refutation of Logarithmic Order Θ(log n) for both zero deficit and
     exponential orbit-Sperner deficits (canonical S_n and arbitrary nontrivial H ≤ S_n),
     assembling the complete disproof of Conjecture 00000008546.
-/
import OrbitSperner.SymmetricActions

namespace OrbitSperner

/-! ## 1. Freese-Dilworth Invariant Antichain Theorem for Arbitrary Finite Posets -/

/-- A decidable poset structure on `Fin m`. -/
structure DecPoset (m : Nat) where
  leBool : Fin m → Fin m → Bool
  le_refl : ∀ x, leBool x x = true
  le_antisymm : ∀ {x y}, leBool x y = true → leBool y x = true → x = y
  le_trans : ∀ {x y z}, leBool x y = true → leBool y z = true → leBool x z = true

namespace DecPoset

def toPoset {m : Nat} (P : DecPoset m) : Poset (Fin m) where
  le := fun x y => P.leBool x y = true
  le_refl := P.le_refl
  le_antisymm := P.le_antisymm
  le_trans := P.le_trans

def ltBool {m : Nat} (P : DecPoset m) (x y : Fin m) : Bool :=
  P.leBool x y && decide (x ≠ y)

theorem ltBool_iff {m : Nat} (P : DecPoset m) (x y : Fin m) :
    P.ltBool x y = true ↔ (P.leBool x y = true ∧ x ≠ y) := by
  unfold ltBool
  simp

/-- Boolean existential quantifier over `Fin m`. -/
def anyFin : (m : Nat) → (Fin m → Bool) → Bool
  | 0, _ => false
  | m + 1, Q => anyFin m (fun i => Q i.castSucc) || Q (Fin.last m)

theorem anyFin_eq_true_iff : ∀ {m : Nat} (Q : Fin m → Bool),
    anyFin m Q = true ↔ ∃ i : Fin m, Q i = true
  | 0, _ => by
    constructor
    · intro h; cases h
    · rintro ⟨i, _⟩; exact Fin.elim0 i
  | m + 1, Q => by
    unfold anyFin
    rw [Bool.or_eq_true, anyFin_eq_true_iff]
    constructor
    · rintro (⟨i, hi⟩ | hl)
      · exact ⟨i.castSucc, hi⟩
      · exact ⟨Fin.last m, hl⟩
    · rintro ⟨i, hi⟩
      if hlt : i.val < m then
        exact Or.inl ⟨⟨i.val, hlt⟩, hi⟩
      else
        have heq : i = Fin.last m := Fin.ext (by
          have hilt : i.val < m + 1 := i.isLt
          have hlv : (Fin.last m).val = m := rfl
          omega)
        rw [heq] at hi
        exact Or.inr hi

theorem anyFin_eq_false_iff {m : Nat} (Q : Fin m → Bool) :
    anyFin m Q = false ↔ ∀ i : Fin m, Q i = false := by
  cases h : anyFin m Q with
  | false =>
    constructor
    · intro _ i
      cases hqi : Q i with
      | false => rfl
      | true =>
        have ht := (anyFin_eq_true_iff Q).mpr ⟨i, hqi⟩
        rw [h] at ht
        cases ht
    · intro _; rfl
  | true =>
    constructor
    · intro hf; cases hf
    · intro hall
      rcases (anyFin_eq_true_iff Q).mp h with ⟨i, hi⟩
      rw [hall i] at hi
      cases hi

/-- Decidable antichain test for `S : BVec m` in `P : DecPoset m`. -/
def isAntichainBool {m : Nat} (P : DecPoset m) (S : BVec m) : Bool :=
  !(anyFin m (fun x => S x && anyFin m (fun y => S y && P.ltBool x y)))

theorem isAntichainBool_iff {m : Nat} (P : DecPoset m) (S : BVec m) :
    P.isAntichainBool S = true ↔ P.toPoset.IsAntichainPred (fun x => S x = true) := by
  unfold isAntichainBool
  rw [Bool.not_eq_true', anyFin_eq_false_iff]
  constructor
  · intro h x y hsx hsy hle
    exact Classical.byContradiction fun hne => by
      have hx := h x
      rw [hsx, Bool.true_and, anyFin_eq_false_iff] at hx
      have hy := hx y
      rw [hsy, Bool.true_and] at hy
      have hlt : P.ltBool x y = true := (P.ltBool_iff x y).mpr ⟨hle, hne⟩
      rw [hlt] at hy
      cases hy
  · intro hant x
    cases hsx : S x with
    | false => simp
    | true =>
      rw [Bool.true_and, anyFin_eq_false_iff]
      intro y
      cases hsy : S y with
      | false => simp
      | true =>
        rw [Bool.true_and]
        cases hlt : P.ltBool x y with
        | false => rfl
        | true =>
          rcases (P.ltBool_iff x y).mp hlt with ⟨hle, hne⟩
          exact False.elim (hne (hant hsx hsy hle))

/-- Order ideal (downset) generated by `S : BVec m` in `P`. -/
def downset {m : Nat} (P : DecPoset m) (S : BVec m) : BVec m :=
  fun y => anyFin m (fun x => S x && P.leBool y x)

theorem mem_downset_iff {m : Nat} (P : DecPoset m) (S : BVec m) (y : Fin m) :
    P.downset S y = true ↔ ∃ x : Fin m, S x = true ∧ P.leBool y x = true := by
  unfold downset
  rw [anyFin_eq_true_iff]
  constructor
  · rintro ⟨x, hx⟩
    simp at hx
    exact ⟨x, hx⟩
  · rintro ⟨x, hsx, hle⟩
    exact ⟨x, by simp [hsx, hle]⟩

/-- Two antichains with the same downset are equal. -/
theorem eq_of_downset_eq {m : Nat} (P : DecPoset m) {A B : BVec m}
    (hA : P.isAntichainBool A = true) (hB : P.isAntichainBool B = true)
    (hdown : P.downset A = P.downset B) : A = B := by
  have hantA := (P.isAntichainBool_iff A).mp hA
  have hantB := (P.isAntichainBool_iff B).mp hB
  funext x
  cases hax : A x with
  | true =>
    have hxdA : P.downset A x = true := (P.mem_downset_iff A x).mpr ⟨x, hax, P.le_refl x⟩
    rw [hdown] at hxdA
    rcases (P.mem_downset_iff B x).mp hxdA with ⟨b, hbb, hxb⟩
    have hbdB : P.downset B b = true := (P.mem_downset_iff B b).mpr ⟨b, hbb, P.le_refl b⟩
    rw [← hdown] at hbdB
    rcases (P.mem_downset_iff A b).mp hbdB with ⟨a, haa, hba⟩
    have hxa : x = a := hantA hax haa (P.le_trans hxb hba)
    subst hxa
    have hxb_eq : x = b := P.le_antisymm hxb hba
    subst hxb_eq
    exact hbb.symm
  | false =>
    cases hbx : B x with
    | false => rfl
    | true =>
      have hxdB : P.downset B x = true := (P.mem_downset_iff B x).mpr ⟨x, hbx, P.le_refl x⟩
      rw [← hdown] at hxdB
      rcases (P.mem_downset_iff A x).mp hxdB with ⟨a, haa, hxa⟩
      have hadA : P.downset A a = true := (P.mem_downset_iff A a).mpr ⟨a, haa, P.le_refl a⟩
      rw [hdown] at hadA
      rcases (P.mem_downset_iff B a).mp hadA with ⟨b, hbb, hab⟩
      have hxb : x = b := hantB hbx hbb (P.le_trans hxa hab)
      subst hxb
      have hxa_eq : x = a := P.le_antisymm hxa hab
      subst hxa_eq
      rw [haa] at hax
      cases hax

/-- Dilworth meet `min(A ∪ B)` of two antichains. -/
def minUnion {m : Nat} (P : DecPoset m) (A B : BVec m) : BVec m :=
  fun x => (A x || B x) && !(anyFin m (fun y => (A y || B y) && P.ltBool y x))

/-- Dilworth join `max(A ∪ B)` of two antichains. -/
def maxUnion {m : Nat} (P : DecPoset m) (A B : BVec m) : BVec m :=
  fun x => (A x || B x) && !(anyFin m (fun y => (A y || B y) && P.ltBool x y))

theorem minUnion_isAntichain {m : Nat} (P : DecPoset m) (A B : BVec m) :
    P.isAntichainBool (P.minUnion A B) = true := by
  rw [P.isAntichainBool_iff]
  intro x y hx hy hle
  exact Classical.byContradiction fun hne => by
    unfold minUnion at hx hy
    have hx' : (A x || B x) = true ∧ anyFin m (fun z => (A z || B z) && P.ltBool z x) = false := by
      simpa using hx
    have hy' : (A y || B y) = true ∧ anyFin m (fun z => (A z || B z) && P.ltBool z y) = false := by
      simpa using hy
    have hyx := (anyFin_eq_false_iff _).mp hy'.2 x
    rw [hx'.1, Bool.true_and] at hyx
    have hlt : P.ltBool x y = true := (P.ltBool_iff x y).mpr ⟨hle, hne⟩
    rw [hlt] at hyx
    cases hyx

theorem maxUnion_isAntichain {m : Nat} (P : DecPoset m) (A B : BVec m) :
    P.isAntichainBool (P.maxUnion A B) = true := by
  rw [P.isAntichainBool_iff]
  intro x y hx hy hle
  exact Classical.byContradiction fun hne => by
    unfold maxUnion at hx hy
    have hx' : (A x || B x) = true ∧ anyFin m (fun z => (A z || B z) && P.ltBool x z) = false := by
      simpa using hx
    have hy' : (A y || B y) = true ∧ anyFin m (fun z => (A z || B z) && P.ltBool y z) = false := by
      simpa using hy
    have hxy := (anyFin_eq_false_iff _).mp hx'.2 y
    rw [hy'.1, Bool.true_and] at hxy
    have hlt : P.ltBool x y = true := (P.ltBool_iff x y).mpr ⟨hle, hne⟩
    rw [hlt] at hxy
    cases hxy

theorem min_or_max_of_mem_one {m : Nat} (P : DecPoset m) {A B : BVec m}
    (hantA : P.toPoset.IsAntichainPred (fun u => A u = true))
    (hantB : P.toPoset.IsAntichainPred (fun u => B u = true))
    {x : Fin m} (hax : A x = false) (hbx : B x = true) :
    P.minUnion A B x = true ∨ P.maxUnion A B x = true := by
  cases hm : P.minUnion A B x with
  | true => exact Or.inl rfl
  | false =>
    cases hM : P.maxUnion A B x with
    | true => exact Or.inr rfl
    | false =>
      exfalso
      unfold minUnion at hm
      unfold maxUnion at hM
      rw [hax, hbx, Bool.false_or, Bool.true_and, Bool.not_eq_false', anyFin_eq_true_iff] at hm hM
      rcases hm with ⟨y, hy⟩
      rcases hM with ⟨z, hz⟩
      have hy' : (A y || B y) = true ∧ (P.leBool y x = true ∧ y ≠ x) := by
        rw [← P.ltBool_iff y x]
        simpa using hy
      have hz' : (A z || B z) = true ∧ (P.leBool x z = true ∧ x ≠ z) := by
        rw [← P.ltBool_iff x z]
        simpa using hz
      have hyA : A y = true := by
        cases hay : A y with
        | true => rfl
        | false =>
          have hby : B y = true := by have := hy'.1; rw [hay, Bool.false_or] at this; exact this
          exact False.elim (hy'.2.2 (hantB hby hbx hy'.2.1))
      have hzA : A z = true := by
        cases haz : A z with
        | true => rfl
        | false =>
          have hbz : B z = true := by have := hz'.1; rw [haz, Bool.false_or] at this; exact this
          exact False.elim (hz'.2.2 (hantB hbx hbz hz'.2.1))
      have hyz_le : P.leBool y z = true := P.le_trans hy'.2.1 hz'.2.1
      have hyz_eq : y = z := hantA hyA hzA hyz_le
      subst hyz_eq
      exact hy'.2.2 (P.le_antisymm hy'.2.1 hz'.2.1)

/-- Pointwise Dilworth multiplicity inequality at every `x : Fin m`. -/
theorem dilworth_pointwise_le {m : Nat} (P : DecPoset m) {A B : BVec m}
    (hA : P.isAntichainBool A = true) (hB : P.isAntichainBool B = true) (x : Fin m) :
    (if A x then 1 else 0) + (if B x then 1 else 0) ≤
      (if P.minUnion A B x then 1 else 0) + (if P.maxUnion A B x then 1 else 0) := by
  have hantA := (P.isAntichainBool_iff A).mp hA
  have hantB := (P.isAntichainBool_iff B).mp hB
  cases hax : A x <;> cases hbx : B x
  · simp
  · rcases P.min_or_max_of_mem_one hantA hantB hax hbx with hm | hM
    · rw [hm]; simp
    · rw [hM]; simp
  · have hsym_min : P.minUnion A B x = P.minUnion B A x := by
      unfold minUnion
      have hor : ∀ u, (A u || B u) = (B u || A u) := fun u => Bool.or_comm (A u) (B u)
      simp [hor]
    have hsym_max : P.maxUnion A B x = P.maxUnion B A x := by
      unfold maxUnion
      have hor : ∀ u, (A u || B u) = (B u || A u) := fun u => Bool.or_comm (A u) (B u)
      simp [hor]
    rw [hsym_min, hsym_max]
    rcases P.min_or_max_of_mem_one hantB hantA hbx hax with hm | hM
    · rw [hm]; simp
    · rw [hM]; simp
  · have hmin_t : P.minUnion A B x = true := by
      unfold minUnion
      rw [hax, Bool.true_or, Bool.true_and, Bool.not_eq_true', anyFin_eq_false_iff]
      intro y
      cases hlt : P.ltBool y x with
      | false => simp
      | true =>
        rcases (P.ltBool_iff y x).mp hlt with ⟨hle, hne⟩
        cases hay : A y with
        | true => exact False.elim (hne (hantA hay hax hle))
        | false =>
          cases hby : B y with
          | true => exact False.elim (hne (hantB hby hbx hle))
          | false => simp
    have hmax_t : P.maxUnion A B x = true := by
      unfold maxUnion
      rw [hax, Bool.true_or, Bool.true_and, Bool.not_eq_true', anyFin_eq_false_iff]
      intro y
      cases hlt : P.ltBool x y with
      | false => simp
      | true =>
        rcases (P.ltBool_iff x y).mp hlt with ⟨hle, hne⟩
        cases hay : A y with
        | true => exact False.elim (hne (hantA hax hay hle))
        | false =>
          cases hby : B y with
          | true => exact False.elim (hne (hantB hbx hby hle))
          | false => simp
    simp [hmin_t, hmax_t]

theorem finSum_add : ∀ (n : Nat) (f g : Fin n → Nat),
    finSum n (fun i => f i + g i) = finSum n f + finSum n g
  | 0, _, _ => rfl
  | n + 1, f, g => by
    change finSum n (fun i => f i.castSucc + g i.castSucc) + (f (Fin.last n) + g (Fin.last n)) =
      (finSum n (fun i => f i.castSucc) + f (Fin.last n)) +
      (finSum n (fun i => g i.castSucc) + g (Fin.last n))
    rw [finSum_add n (fun i => f i.castSucc) (fun i => g i.castSucc)]
    omega

theorem le_foldr_max {α : Type} (f : α → Nat) :
    ∀ {L : List α} {x : α}, x ∈ L → f x ≤ L.foldr (fun T acc => max (f T) acc) 0
  | [], _, hx => nomatch hx
  | a :: as, _, hx => by
    simp only [List.foldr]
    rcases List.mem_cons.mp hx with rfl | hx'
    · exact Nat.le_max_left _ _
    · exact Nat.le_trans (le_foldr_max f hx') (Nat.le_max_right _ _)

theorem exists_eq_foldr_max {α : Type} (f : α → Nat) :
    ∀ {L : List α}, L ≠ [] → ∃ x ∈ L, f x = L.foldr (fun T acc => max (f T) acc) 0
  | [], hne => False.elim (hne rfl)
  | [a], _ => ⟨a, List.Mem.head [], by simp⟩
  | a :: b :: bs, _ => by
    rcases exists_eq_foldr_max f (L := b :: bs) (by simp) with ⟨x₀, hx₀, hfx₀⟩
    let restMax := (b :: bs).foldr (fun T acc => max (f T) acc) 0
    change ∃ x ∈ a :: b :: bs, f x = max (f a) restMax
    if hge : restMax ≤ f a then
      exact ⟨a, List.Mem.head _, (Nat.max_eq_left hge).symm⟩
    else
      have hle : f a ≤ restMax := by omega
      exact ⟨x₀, List.Mem.tail a hx₀, hfx₀.trans (Nat.max_eq_right hle).symm⟩

/-- Classical Sperner width `width(P)` of a finite poset `P : DecPoset m`. -/
def posetWidth {m : Nat} (P : DecPoset m) : Nat :=
  ((allBVec m).filter P.isAntichainBool).foldr (fun S acc => max (weight S) acc) 0

theorem weight_le_posetWidth {m : Nat} (P : DecPoset m) {S : BVec m}
    (hS : P.isAntichainBool S = true) : weight S ≤ P.posetWidth :=
  le_foldr_max weight (List.mem_filter.mpr ⟨mem_allBVec S, hS⟩)

theorem exists_antichain_eq_posetWidth {m : Nat} (P : DecPoset m) :
    ∃ S : BVec m, P.isAntichainBool S = true ∧ weight S = P.posetWidth := by
  have hempty : P.isAntichainBool (falseBVec m) = true := by
    rw [P.isAntichainBool_iff]
    intro _ _ h
    cases h
  have hmem0 : falseBVec m ∈ (allBVec m).filter P.isAntichainBool :=
    List.mem_filter.mpr ⟨mem_allBVec _, hempty⟩
  have hne : (allBVec m).filter P.isAntichainBool ≠ [] :=
    fun hnil => by rw [hnil] at hmem0; nomatch hmem0
  rcases exists_eq_foldr_max weight hne with ⟨S, hSmem, hw⟩
  exact ⟨S, (List.mem_filter.mp hSmem).2, hw⟩

/-- If `A` and `B` are maximum-sized antichains in `P`, then `minUnion P A B` is also a
    maximum-sized antichain and `downset(minUnion P A B) ⊆ downset A ∩ downset B`. -/
theorem minUnion_max_antichain_props {m : Nat} (P : DecPoset m) {A B : BVec m}
    (hA : P.isAntichainBool A = true) (hB : P.isAntichainBool B = true)
    (hwA : weight A = P.posetWidth) (hwB : weight B = P.posetWidth) :
    P.isAntichainBool (P.minUnion A B) = true ∧
    weight (P.minUnion A B) = P.posetWidth ∧
    subsetLe (P.downset (P.minUnion A B)) (P.downset A) ∧
    subsetLe (P.downset (P.minUnion A B)) (P.downset B) := by
  let f : Fin m → Nat := fun x => (if A x then 1 else 0) + (if B x then 1 else 0)
  let g : Fin m → Nat := fun x =>
    (if P.minUnion A B x then 1 else 0) + (if P.maxUnion A B x then 1 else 0)
  have hpt : ∀ x, f x ≤ g x := fun x => P.dilworth_pointwise_le hA hB x
  have hmin_ant := P.minUnion_isAntichain A B
  have hmax_ant := P.maxUnion_isAntichain A B
  have hw_min_le := P.weight_le_posetWidth hmin_ant
  have hw_max_le := P.weight_le_posetWidth hmax_ant
  have hsum_f : finSum m f = weight A + weight B := finSum_add m _ _
  have hsum_g : finSum m g = weight (P.minUnion A B) + weight (P.maxUnion A B) := finSum_add m _ _
  have hsum_le : finSum m f ≤ finSum m g := finSum_le_finSum hpt
  have hw_min_eq : weight (P.minUnion A B) = P.posetWidth := by omega
  have hsum_eq : finSum m f = finSum m g := by omega
  have hpt_eq : ∀ x, f x = g x := (finSum_eq_iff_of_le hpt).mp hsum_eq
  have hc_in_both : ∀ c : Fin m, P.minUnion A B c = true →
      P.downset A c = true ∧ P.downset B c = true := by
    intro c hc
    have hcm_or : (A c || B c) = true := by
      unfold minUnion at hc
      exact (by simpa using hc : (A c || B c) = true ∧ _).1
    have hantA := (P.isAntichainBool_iff A).mp hA
    have hantB := (P.isAntichainBool_iff B).mp hB
    cases hmax_c : P.maxUnion A B c with
    | true =>
      have heq_c := hpt_eq c
      dsimp [f, g] at heq_c
      rw [hc, hmax_c] at heq_c
      cases hac : A c <;> cases hbc : B c <;> simp [hac, hbc] at heq_c
      exact ⟨(P.mem_downset_iff A c).mpr ⟨c, hac, P.le_refl c⟩,
             (P.mem_downset_iff B c).mpr ⟨c, hbc, P.le_refl c⟩⟩
    | false =>
      unfold maxUnion at hmax_c
      rw [hcm_or, Bool.true_and, Bool.not_eq_false', anyFin_eq_true_iff] at hmax_c
      rcases hmax_c with ⟨d, hd⟩
      have hd' : (A d || B d) = true ∧ (P.leBool c d = true ∧ c ≠ d) := by
        rw [← P.ltBool_iff c d]
        simpa using hd
      cases hac : A c with
      | true =>
        have hdB : B d = true := by
          cases had : A d with
          | true => exact False.elim (hd'.2.2 (hantA hac had hd'.2.1))
          | false => have := hd'.1; rw [had, Bool.false_or] at this; exact this
        exact ⟨(P.mem_downset_iff A c).mpr ⟨c, hac, P.le_refl c⟩,
               (P.mem_downset_iff B c).mpr ⟨d, hdB, hd'.2.1⟩⟩
      | false =>
        have hbc : B c = true := by have := hcm_or; rw [hac, Bool.false_or] at this; exact this
        have hdA : A d = true := by
          cases hbd : B d with
          | true => exact False.elim (hd'.2.2 (hantB hbc hbd hd'.2.1))
          | false => have := hd'.1; rw [hbd, Bool.or_false] at this; exact this
        exact ⟨(P.mem_downset_iff A c).mpr ⟨d, hdA, hd'.2.1⟩,
               (P.mem_downset_iff B c).mpr ⟨c, hbc, P.le_refl c⟩⟩
  refine ⟨hmin_ant, hw_min_eq, ?_, ?_⟩
  · intro y hy
    rcases (P.mem_downset_iff _ y).mp hy with ⟨c, hc, hyc⟩
    rcases (P.mem_downset_iff A c).mp (hc_in_both c hc).1 with ⟨a, ha, hca⟩
    exact (P.mem_downset_iff A y).mpr ⟨a, ha, P.le_trans hyc hca⟩
  · intro y hy
    rcases (P.mem_downset_iff _ y).mp hy with ⟨c, hc, hyc⟩
    rcases (P.mem_downset_iff B c).mp (hc_in_both c hc).2 with ⟨b, hb, hcb⟩
    exact (P.mem_downset_iff B y).mpr ⟨b, hb, P.le_trans hyc hcb⟩

/-- `σ : Perm m` is a poset automorphism of `P : DecPoset m`. -/
def IsAuto {m : Nat} (P : DecPoset m) (σ : Perm m) : Prop :=
  ∀ x y : Fin m, P.leBool (σ.toFun x) (σ.toFun y) = P.leBool x y

theorem downset_actPerm {m : Nat} (P : DecPoset m) {σ : Perm m} (hσ : P.IsAuto σ) (S : BVec m) :
    P.downset (actPerm σ S) = actPerm σ (P.downset S) := by
  funext y
  cases lhs : P.downset (actPerm σ S) y with
  | true =>
    rcases (P.mem_downset_iff _ y).mp lhs with ⟨x, hx, hyx⟩
    unfold actPerm at hx ⊢
    symm
    apply (P.mem_downset_iff S (σ.invFun y)).mpr
    refine ⟨σ.invFun x, hx, ?_⟩
    have hauto := hσ (σ.invFun y) (σ.invFun x)
    rw [σ.right_inv, σ.right_inv] at hauto
    rw [← hauto]
    exact hyx
  | false =>
    symm
    unfold actPerm
    cases rhs : P.downset S (σ.invFun y) with
    | false => rfl
    | true =>
      rcases (P.mem_downset_iff S (σ.invFun y)).mp rhs with ⟨z, hz, hyz⟩
      have hmem : P.downset (actPerm σ S) y = true := by
        apply (P.mem_downset_iff _ y).mpr
        refine ⟨σ.toFun z, ?_, ?_⟩
        · unfold actPerm; rw [σ.left_inv]; exact hz
        · have hauto := hσ (σ.invFun y) z
          rw [σ.right_inv] at hauto
          rw [hauto]
          exact hyz
      rw [lhs] at hmem
      cases hmem

theorem isAntichainBool_actPerm {m : Nat} (P : DecPoset m) {σ : Perm m}
    (hσ : P.IsAuto σ) {S : BVec m} (hS : P.isAntichainBool S = true) :
    P.isAntichainBool (actPerm σ S) = true := by
  rw [P.isAntichainBool_iff] at hS ⊢
  intro x y hx hy hle
  unfold actPerm at hx hy
  have hle' : P.leBool (σ.invFun x) (σ.invFun y) = true := by
    have hauto := hσ (σ.invFun x) (σ.invFun y)
    rw [σ.right_inv, σ.right_inv] at hauto
    rw [← hauto]
    exact hle
  have heq := hS hx hy hle'
  have hto := congrArg σ.toFun heq
  rw [σ.right_inv, σ.right_inv] at hto
  exact hto

/-- Minimum-arg picker over a non-empty list. -/
def argminList {α : Type} (f : α → Nat) : (l : List α) → l ≠ [] → α
  | [], h => False.elim (h rfl)
  | [a], _ => a
  | a :: b :: bs, _ =>
    let best := argminList f (b :: bs) (by simp)
    if f a ≤ f best then a else best

theorem argminList_spec {α : Type} (f : α → Nat) :
    ∀ (l : List α) (hne : l ≠ []),
      argminList f l hne ∈ l ∧ ∀ x ∈ l, f (argminList f l hne) ≤ f x
  | [], hne => False.elim (hne rfl)
  | [a], _ => ⟨List.Mem.head [], fun x hx => by
      rcases List.mem_cons.mp hx with rfl | h; exact Nat.le_refl _; nomatch h⟩
  | a :: b :: bs, _ => by
    rcases argminList_spec f (b :: bs) (by simp) with ⟨hmem_best, hle_best⟩
    unfold argminList
    dsimp
    by_cases hcmp : f a ≤ f (argminList f (b :: bs) (by simp))
    · simp only [hcmp, ↓reduceIte]
      refine ⟨List.Mem.head _, ?_⟩
      intro x hx
      rcases List.mem_cons.mp hx with rfl | hx'
      · exact Nat.le_refl _
      · exact Nat.le_trans hcmp (hle_best x hx')
    · simp only [hcmp, ↓reduceIte]
      refine ⟨List.Mem.tail a hmem_best, ?_⟩
      intro x hx
      rcases List.mem_cons.mp hx with rfl | hx'
      · omega
      · exact hle_best x hx'

/-- **Freese-Dilworth Invariant Antichain Theorem**:
    Every finite poset `P : DecPoset m` possesses a canonical maximum antichain `A*` of
    cardinality `P.posetWidth` that is invariant under **every** poset automorphism `σ` of `P`.
    Consequently, for any group acting on `P`, the invariant-antichain Sperner deficit is `0`. -/
theorem freese_dilworth_invariant_antichain {m : Nat} (P : DecPoset m) :
    ∃ Astar : BVec m,
      P.isAntichainBool Astar = true ∧
      weight Astar = P.posetWidth ∧
      ∀ σ : Perm m, P.IsAuto σ → actPerm σ Astar = Astar := by
  let maxAnts := (allBVec m).filter (fun S => P.isAntichainBool S && (weight S == P.posetWidth))
  rcases P.exists_antichain_eq_posetWidth with ⟨S₀, hS₀, hw₀⟩
  have hmem₀ : S₀ ∈ maxAnts :=
    List.mem_filter.mpr ⟨mem_allBVec S₀, by simp [hS₀, hw₀]⟩
  have hne : maxAnts ≠ [] := fun hnil => by rw [hnil] at hmem₀; nomatch hmem₀
  let cost : BVec m → Nat := fun S => weight (P.downset S)
  let Astar := argminList cost maxAnts hne
  rcases argminList_spec cost maxAnts hne with ⟨hA_mem, hA_min⟩
  have hA_filt : P.isAntichainBool Astar = true ∧ weight Astar = P.posetWidth := by
    have hm := (List.mem_filter.mp hA_mem).2
    simpa [Astar] using hm
  have huniq : ∀ B : BVec m, P.isAntichainBool B = true → weight B = P.posetWidth →
      cost B ≤ cost Astar → B = Astar := by
    intro B hB hwB hcostB
    rcases P.minUnion_max_antichain_props hA_filt.1 hB hA_filt.2 hwB with
      ⟨hC_ant, hC_w, hC_subA, hC_subB⟩
    let C := P.minUnion Astar B
    have hC_mem : C ∈ maxAnts :=
      List.mem_filter.mpr ⟨mem_allBVec C, by simp [C, hC_ant, hC_w]⟩
    have hA_le_C : weight (P.downset Astar) ≤ weight (P.downset C) := hA_min C hC_mem
    have hcostB' : weight (P.downset B) ≤ weight (P.downset Astar) := hcostB
    have hC_le_A : weight (P.downset C) ≤ weight (P.downset Astar) := weight_le_of_subsetLe hC_subA
    have hC_le_B : weight (P.downset C) ≤ weight (P.downset B) := weight_le_of_subsetLe hC_subB
    have heq_CA : P.downset C = P.downset Astar :=
      eq_of_subsetLe_of_weight_eq hC_subA (by omega)
    have heq_CB : P.downset C = P.downset B :=
      eq_of_subsetLe_of_weight_eq hC_subB (by omega)
    exact P.eq_of_downset_eq hB hA_filt.1 (heq_CB.symm.trans heq_CA)
  refine ⟨Astar, hA_filt.1, hA_filt.2, ?_⟩
  intro σ hσ
  apply huniq (actPerm σ Astar)
  · exact P.isAntichainBool_actPerm hσ hA_filt.1
  · rw [weight_actPerm]; exact hA_filt.2
  · dsimp [cost]
    rw [P.downset_actPerm hσ, weight_actPerm]
    exact Nat.le_refl _

end DecPoset

/-! ## 2. Faithful `S_n`-Poset Family `P(n)` Refuting Clause 1 (`n ≥ 2`) -/

/-- Elements of the bounded graded Sperner poset `P(n)` of size `4n + 6`. -/
inductive PnElem (n : Nat) where
  | bot : PnElem n
  | a   : Bool → PnElem n
  | c1  : Fin n → PnElem n
  | c2  : Fin n → PnElem n
  | b   : Bool → PnElem n
  | d1  : Fin n → PnElem n
  | d2  : Fin n → PnElem n
  | top : PnElem n
  deriving DecidableEq

/-- Rank function `0..3` on `PnElem n`. -/
def pnRank {n : Nat} : PnElem n → Nat
  | .bot => 0
  | .a _ | .c1 _ | .c2 _ => 1
  | .b _ | .d1 _ | .d2 _ => 2
  | .top => 3

/-- Decidable partial order relation on `PnElem n`. -/
def pnLeBool {n : Nat} : PnElem n → PnElem n → Bool
  | .bot, _ => true
  | _, .top => true
  | .a s, .a t => s == t
  | .a _, .d2 _ => true
  | .c1 i, .c1 k => i == k
  | .c1 _, .b _ => true
  | .c1 _, .d1 _ => true
  | .c1 _, .d2 _ => true
  | .c2 i, .c2 k => i == k
  | .c2 _, .b _ => true
  | .c2 _, .d1 _ => true
  | .c2 _, .d2 _ => true
  | .b s, .b t => s == t
  | .d1 j, .d1 k => j == k
  | .d2 j, .d2 k => j == k
  | _, _ => false

def pnLe {n : Nat} (x y : PnElem n) : Prop :=
  pnLeBool x y = true

/-- `PnElem n` as a `Poset`. -/
def pnPoset (n : Nat) : Poset (PnElem n) where
  le := pnLe
  le_refl := fun x => by cases x <;> simp [pnLe, pnLeBool]
  le_antisymm := by
    intro x y hxy hyx
    cases x <;> cases y <;> simp [pnLe, pnLeBool] at hxy hyx <;> subst_vars <;> rfl
  le_trans := by
    intro x y z hxy hyz
    cases x <;> cases y <;> cases z <;> simp [pnLe, pnLeBool] at hxy hyz ⊢ <;>
      subst_vars <;> trivial

/-- Raw chain index `< 2 * n + 2` for `PnElem n`. -/
def pnChainVal {n : Nat} : PnElem n → Nat
  | .bot => 0
  | .top => 0
  | .a false => 0
  | .a true  => 1
  | .d2 j => if j.val = 0 then 0 else if j.val = 1 then 1 else 2 + j.val
  | .b false => 2
  | .b true  => 3
  | .c2 i => if i.val = 0 then 2 else if i.val = 1 then 3 else 2 + i.val
  | .c1 i => n + 2 + i.val
  | .d1 j => n + 2 + j.val

theorem pnChainVal_lt {n : Nat} (hn : 2 ≤ n) (x : PnElem n) :
    pnChainVal x < 2 * n + 2 := by
  cases x with
  | bot | top => simp [pnChainVal]
  | a s => cases s <;> (dsimp [pnChainVal]; omega)
  | b s => cases s <;> (dsimp [pnChainVal]; omega)
  | c1 i => have := i.isLt; simp [pnChainVal]; omega
  | d1 j => have := j.isLt; simp [pnChainVal]; omega
  | c2 i =>
    have := i.isLt
    unfold pnChainVal
    by_cases h0 : i.val = 0
    · simp [h0]; omega
    · by_cases h1 : i.val = 1 <;> simp [h0, h1] <;> omega
  | d2 j =>
    have := j.isLt
    unfold pnChainVal
    by_cases h0 : j.val = 0
    · simp [h0]
    · by_cases h1 : j.val = 1 <;> simp [h0, h1] <;> omega

def pnChainIdx {n : Nat} (hn : 2 ≤ n) (x : PnElem n) : Fin (2 * n + 2) :=
  ⟨pnChainVal x, pnChainVal_lt hn x⟩

/-- Elements sharing the same `pnChainVal` are comparable in `pnPoset n`. -/
theorem pnChainVal_comparable {n : Nat} (_hn : 2 ≤ n) (x y : PnElem n)
    (hv : pnChainVal x = pnChainVal y) :
    pnLe x y ∨ pnLe y x := by
  cases x with
  | bot => exact Or.inl (by cases y <;> rfl)
  | top => exact Or.inr (by cases y <;> rfl)
  | a s =>
    cases y with
    | bot => exact Or.inr rfl
    | top => exact Or.inl rfl
    | d2 _ => exact Or.inl rfl
    | a t =>
      cases s <;> cases t <;> simp [pnChainVal] at hv <;> exact Or.inl rfl
    | b t =>
      cases s <;> cases t <;> simp [pnChainVal] at hv
    | c1 k =>
      cases s <;> (simp [pnChainVal] at hv; omega)
    | d1 k =>
      cases s <;> (simp [pnChainVal] at hv; omega)
    | c2 k =>
      cases s <;> unfold pnChainVal at hv <;>
        by_cases h0 : k.val = 0 <;> by_cases h1 : k.val = 1 <;>
        simp [h0, h1] at hv <;> omega
  | c1 i =>
    cases y with
    | bot => exact Or.inr rfl
    | top | b _ | d1 _ | d2 _ => exact Or.inl rfl
    | a t => cases t <;> (dsimp [pnChainVal] at hv; omega)
    | c1 k =>
      simp [pnChainVal] at hv
      have heq : i = k := Fin.ext hv
      subst heq
      exact Or.inl (by simp [pnLe, pnLeBool])
    | c2 k =>
      have hk := k.isLt
      unfold pnChainVal at hv
      by_cases h0 : k.val = 0 <;> by_cases h1 : k.val = 1 <;>
        simp [h0, h1] at hv <;> omega
  | c2 i =>
    cases y with
    | bot => exact Or.inr rfl
    | top | b _ | d1 _ | d2 _ => exact Or.inl rfl
    | a t =>
      cases t <;> unfold pnChainVal at hv <;>
        by_cases h0 : i.val = 0 <;> by_cases h1 : i.val = 1 <;>
        simp [h0, h1] at hv <;> omega
    | c1 k =>
      have hi := i.isLt
      unfold pnChainVal at hv
      by_cases h0 : i.val = 0 <;> by_cases h1 : i.val = 1 <;>
        simp [h0, h1] at hv <;> omega
    | c2 k =>
      unfold pnChainVal at hv
      by_cases hi0 : i.val = 0 <;> by_cases hk0 : k.val = 0 <;>
        by_cases hi1 : i.val = 1 <;> by_cases hk1 : k.val = 1 <;>
        simp [hi0, hk0, hi1, hk1] at hv <;>
        (have hik : i = k := Fin.ext (by omega); subst hik; exact Or.inl (by simp [pnLe, pnLeBool]))
  | b s =>
    cases y with
    | bot | c1 _ | c2 _ => exact Or.inr rfl
    | top => exact Or.inl rfl
    | a t => cases s <;> cases t <;> simp [pnChainVal] at hv
    | b t => cases s <;> cases t <;> simp [pnChainVal] at hv <;> exact Or.inl rfl
    | d1 k => cases s <;> (simp [pnChainVal] at hv; omega)
    | d2 k =>
      cases s <;> unfold pnChainVal at hv <;>
        by_cases h0 : k.val = 0 <;> by_cases h1 : k.val = 1 <;>
        simp [h0, h1] at hv <;> omega
  | d1 j =>
    cases y with
    | bot | c1 _ | c2 _ => exact Or.inr rfl
    | top => exact Or.inl rfl
    | a t => cases t <;> (dsimp [pnChainVal] at hv; omega)
    | b t => cases t <;> (simp [pnChainVal] at hv; omega)
    | d1 k =>
      simp [pnChainVal] at hv
      have heq : j = k := Fin.ext hv
      subst heq
      exact Or.inl (by simp [pnLe, pnLeBool])
    | d2 k =>
      have hk := k.isLt
      unfold pnChainVal at hv
      by_cases h0 : k.val = 0 <;> by_cases h1 : k.val = 1 <;>
        simp [h0, h1] at hv <;> omega
  | d2 j =>
    cases y with
    | bot | a _ | c1 _ | c2 _ => exact Or.inr rfl
    | top => exact Or.inl rfl
    | b t =>
      cases t <;> unfold pnChainVal at hv <;>
        by_cases h0 : j.val = 0 <;> by_cases h1 : j.val = 1 <;>
        simp [h0, h1] at hv <;> omega
    | d1 k =>
      have hj := j.isLt
      unfold pnChainVal at hv
      by_cases h0 : j.val = 0 <;> by_cases h1 : j.val = 1 <;>
        simp [h0, h1] at hv <;> omega
    | d2 k =>
      unfold pnChainVal at hv
      by_cases hj0 : j.val = 0 <;> by_cases hk0 : k.val = 0 <;>
        by_cases hj1 : j.val = 1 <;> by_cases hk1 : k.val = 1 <;>
        simp [hj0, hk0, hj1, hk1] at hv <;>
        (have hjk : j = k := Fin.ext (by omega); subst hjk; exact Or.inl (by simp [pnLe, pnLeBool]))

theorem pairwise_get_incomp {α : Type} {R : α → α → Prop}
    (hsym : ∀ u v, R u v → R v u) :
    ∀ {L : List α}, List.Pairwise R L →
      ∀ (i j : Fin L.length), i ≠ j → R (L.get i) (L.get j)
  | [], _, i, _, _ => Fin.elim0 i
  | _ :: _, List.Pairwise.cons _ _, ⟨0, _⟩, ⟨0, _⟩, hne => False.elim (hne rfl)
  | _ :: as, List.Pairwise.cons ha _, ⟨0, _⟩, ⟨k + 1, hk⟩, _ =>
    ha (as.get ⟨k, by simp at hk; omega⟩) (List.get_mem as _)
  | _ :: as, List.Pairwise.cons ha _, ⟨k + 1, hk⟩, ⟨0, _⟩, _ =>
    hsym _ _ (ha (as.get ⟨k, by simp at hk; omega⟩) (List.get_mem as _))
  | _ :: as, List.Pairwise.cons _ has, ⟨k₁ + 1, hk₁⟩, ⟨k₂ + 1, hk₂⟩, hne => by
    apply pairwise_get_incomp hsym has ⟨k₁, by simp at hk₁; omega⟩ ⟨k₂, by simp at hk₂; omega⟩
    intro heq
    have hv : k₁ = k₂ := congrArg Fin.val heq
    subst hv
    exact hne rfl

/-- **Sperner Property of `P(n)` (`n ≥ 2`)**:
    Every antichain list `L` in `pnPoset n` has length at most `2 * n + 2`. -/
theorem pnPoset_antichain_le {n : Nat} (hn : 2 ≤ n) {L : List (PnElem n)}
    (hpw : List.Pairwise (fun x y => (pnPoset n).Incomp x y) L) :
    L.length ≤ 2 * n + 2 := by
  exact Classical.byContradiction fun hgt => by
    have hge : 2 * n + 3 ≤ L.length := by omega
    let f : Fin (2 * n + 3) → Fin (2 * n + 2) :=
      fun i => pnChainIdx hn (L.get ⟨i.val, by omega⟩)
    apply not_injective_fin_succ (2 * n + 2) f
    intro i j hij
    exact Classical.byContradiction fun hne => by
      have hne_fin : (⟨i.val, by omega⟩ : Fin L.length) ≠ ⟨j.val, by omega⟩ := by
        intro heq
        have hv : (⟨i.val, by omega⟩ : Fin L.length).val = (⟨j.val, by omega⟩ : Fin L.length).val :=
          congrArg Fin.val heq
        dsimp at hv
        exact hne (Fin.ext hv)
      have hinc := pairwise_get_incomp (fun _ _ h => ⟨h.2, h.1⟩) hpw _ _ hne_fin
      have hval : pnChainVal (L.get ⟨i.val, by omega⟩) = pnChainVal (L.get ⟨j.val, by omega⟩) :=
        congrArg Fin.val hij
      rcases pnChainVal_comparable hn _ _ hval with hle | hge_elem
      · exact hinc.1 hle
      · exact hinc.2 hge_elem

/-- Faithful `S_n`-action (`Perm n`) on `PnElem n`. -/
def actPn {n : Nat} (σ : Perm n) : PnElem n → PnElem n
  | .bot => .bot
  | .a s => .a s
  | .c1 i => .c1 (σ.toFun i)
  | .c2 i => .c2 (σ.toFun i)
  | .b s => .b s
  | .d1 j => .d1 (σ.toFun j)
  | .d2 j => .d2 (σ.toFun j)
  | .top => .top

/-- Faithfulness: if `actPn σ = actPn τ` on `PnElem n`, then `σ = τ` in `Perm n`. -/
theorem actPn_faithful {n : Nat} {σ τ : Perm n}
    (h : ∀ x : PnElem n, actPn σ x = actPn τ x) : σ = τ := by
  apply Perm.ext
  intro i
  have hi := h (.c1 i)
  injection hi

theorem iter_actPn_c1 {n : Nat} (σ : Perm n) (m : Nat) (i : Fin n) :
    iterFun (actPn σ) m (.c1 i) = .c1 (iterFun σ.toFun m i) := by
  induction m with
  | zero => rfl
  | succ m ih => simp only [iterFun, ih]; rfl

theorem iter_actPn_c2 {n : Nat} (σ : Perm n) (m : Nat) (i : Fin n) :
    iterFun (actPn σ) m (.c2 i) = .c2 (iterFun σ.toFun m i) := by
  induction m with
  | zero => rfl
  | succ m ih => simp only [iterFun, ih]; rfl

theorem iter_actPn_d1 {n : Nat} (σ : Perm n) (m : Nat) (j : Fin n) :
    iterFun (actPn σ) m (.d1 j) = .d1 (iterFun σ.toFun m j) := by
  induction m with
  | zero => rfl
  | succ m ih => simp only [iterFun, ih]; rfl

theorem iter_actPn_d2 {n : Nat} (σ : Perm n) (m : Nat) (j : Fin n) :
    iterFun (actPn σ) m (.d2 j) = .d2 (iterFun σ.toFun m j) := by
  induction m with
  | zero => rfl
  | succ m ih => simp only [iterFun, ih]; rfl

/-- `pnAction n` is a valid `PosetGroupAction` of `Perm n` (`S_n`) on `pnPoset n`. -/
def pnAction (n : Nat) : PosetGroupAction (pnPoset n) (Perm n) where
  one := Perm.id n
  mul := Perm.comp
  inv := Perm.inv
  act := actPn
  act_one := fun x => by cases x <;> rfl
  act_mul := fun _ _ x => by cases x <;> rfl
  act_inv_left := fun σ x => by cases x <;> simp [actPn, Perm.inv, σ.left_inv]
  act_inv_right := fun σ x => by cases x <;> simp [actPn, Perm.inv, σ.right_inv]
  act_le := by
    intro σ x y hxy
    cases x <;> cases y <;> simp [pnPoset, pnLe, pnLeBool] at hxy <;>
      subst_vars <;> simp [actPn, pnPoset, pnLe, pnLeBool]
  finite_period := by
    intro σ x
    cases x with
    | bot => exact ⟨1, by omega, rfl⟩
    | top => exact ⟨1, by omega, rfl⟩
    | a _ => exact ⟨1, by omega, rfl⟩
    | b _ => exact ⟨1, by omega, rfl⟩
    | c1 i =>
      rcases exists_pos_period_fin σ.toFun (fun _ _ h => σ.injective h) i with ⟨m, hm, hp⟩
      exact ⟨m, hm, by rw [iter_actPn_c1, hp]⟩
    | c2 i =>
      rcases exists_pos_period_fin σ.toFun (fun _ _ h => σ.injective h) i with ⟨m, hm, hp⟩
      exact ⟨m, hm, by rw [iter_actPn_c2, hp]⟩
    | d1 j =>
      rcases exists_pos_period_fin σ.toFun (fun _ _ h => σ.injective h) j with ⟨m, hm, hp⟩
      exact ⟨m, hm, by rw [iter_actPn_d1, hp]⟩
    | d2 j =>
      rcases exists_pos_period_fin σ.toFun (fun _ _ h => σ.injective h) j with ⟨m, hm, hp⟩
      exact ⟨m, hm, by rw [iter_actPn_d2, hp]⟩

/-- Orbit-rank profile `(1, 4, 4, 1)` on `P(n) / S_n` (`n ≥ 2`), showing that every rank of
    `P(n) / S_n` has at most `4` orbits (symmetrized Sperner number = `4`). -/
theorem pn_orbit_representatives_per_rank {n : Nat} (hn : 2 ≤ n) (x : PnElem n) :
    let z0 : Fin n := ⟨0, by omega⟩
    (pnRank x = 0 → (pnAction n).OrbitEq .bot x) ∧
    (pnRank x = 1 → (pnAction n).OrbitEq (.a false) x ∨ (pnAction n).OrbitEq (.a true) x ∨
                     (pnAction n).OrbitEq (.c1 z0) x ∨ (pnAction n).OrbitEq (.c2 z0) x) ∧
    (pnRank x = 2 → (pnAction n).OrbitEq (.b false) x ∨ (pnAction n).OrbitEq (.b true) x ∨
                     (pnAction n).OrbitEq (.d1 z0) x ∨ (pnAction n).OrbitEq (.d2 z0) x) ∧
    (pnRank x = 3 → (pnAction n).OrbitEq .top x) := by
  intro z0
  have htrans : ∀ i : Fin n, (Perm.swap z0 i).toFun z0 = i := by
    intro i; unfold Perm.swap; simp
  cases x with
  | bot => simp [pnRank]; exact ⟨Perm.id n, rfl⟩
  | top => simp [pnRank]; exact ⟨Perm.id n, rfl⟩
  | a s =>
    simp [pnRank]
    cases s
    · exact Or.inl ⟨Perm.id n, rfl⟩
    · exact Or.inr (Or.inl ⟨Perm.id n, rfl⟩)
  | c1 i =>
    simp [pnRank]
    exact Or.inr (Or.inr (Or.inl ⟨Perm.swap z0 i, by simp [pnAction, actPn, htrans i]⟩))
  | c2 i =>
    simp [pnRank]
    exact Or.inr (Or.inr (Or.inr ⟨Perm.swap z0 i, by simp [pnAction, actPn, htrans i]⟩))
  | b s =>
    simp [pnRank]
    cases s
    · exact Or.inl ⟨Perm.id n, rfl⟩
    · exact Or.inr (Or.inl ⟨Perm.id n, rfl⟩)
  | d1 j =>
    simp [pnRank]
    exact Or.inr (Or.inr (Or.inl ⟨Perm.swap z0 j, by simp [pnAction, actPn, htrans j]⟩))
  | d2 j =>
    simp [pnRank]
    exact Or.inr (Or.inr (Or.inr ⟨Perm.swap z0 j, by simp [pnAction, actPn, htrans j]⟩))

/-- Explicit `5`-element orbit antichain in `P(n) / S_n` (`n ≥ 2`), strictly exceeding `4`. -/
def pnFiveOrbitAntichain {n : Nat} (hn : 2 ≤ n) : List (PnElem n) :=
  [.a false, .a true, .b false, .b true, .d1 ⟨0, by omega⟩]

theorem pn_not_orbitLe_helper {n : Nat} {x y : PnElem n}
    (h : ∀ σ : Perm n, pnLeBool x (actPn σ y) = false) :
    ¬ (pnAction n).OrbitLe x y := by
  rintro ⟨σ, hle⟩
  dsimp [pnAction, pnPoset, pnLe] at hle
  rw [h σ] at hle
  cases hle

theorem pnFiveOrbitAntichain_valid {n : Nat} (hn : 2 ≤ n) :
    List.Pairwise
      (fun x y => ¬ (pnAction n).OrbitLe x y ∧ ¬ (pnAction n).OrbitLe y x)
      (pnFiveOrbitAntichain hn) ∧
    (pnFiveOrbitAntichain hn).length = 5 := by
  refine ⟨?_, rfl⟩
  unfold pnFiveOrbitAntichain
  apply List.Pairwise.cons
  · intro y hy
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hy
    rcases hy with rfl | rfl | rfl | rfl <;>
      exact ⟨pn_not_orbitLe_helper (fun _ => rfl), pn_not_orbitLe_helper (fun _ => rfl)⟩
  · apply List.Pairwise.cons
    · intro y hy
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hy
      rcases hy with rfl | rfl | rfl <;>
        exact ⟨pn_not_orbitLe_helper (fun _ => rfl), pn_not_orbitLe_helper (fun _ => rfl)⟩
    · apply List.Pairwise.cons
      · intro y hy
        simp only [List.mem_cons, List.not_mem_nil, or_false] at hy
        rcases hy with rfl | rfl <;>
          exact ⟨pn_not_orbitLe_helper (fun _ => rfl), pn_not_orbitLe_helper (fun _ => rfl)⟩
      · apply List.Pairwise.cons
        · intro y hy
          simp only [List.mem_singleton] at hy
          subst hy
          exact ⟨pn_not_orbitLe_helper (fun _ => rfl), pn_not_orbitLe_helper (fun _ => rfl)⟩
        · exact List.Pairwise.cons (fun _ h => nomatch h) List.Pairwise.nil

/-! ## 3. Asymptotic Refutation of Logarithmic Order `Θ(log n)` -/

/-- Multiplicative integer formulation of logarithmic order `Θ(log n)`:
    `∃ c₁ > 0, ∃ c₂ > 0, ∃ N₀, ∀ n ≥ max N₀ 2, ⌊log₂ n⌋ ≤ c₁ * D(n) ∧ D(n) ≤ c₂ * ⌊log₂ n⌋`. -/
def IsLogOrder (D : Nat → Nat) : Prop :=
  ∃ c₁ : Nat, 0 < c₁ ∧ ∃ c₂ : Nat, 0 < c₂ ∧ ∃ N₀ : Nat,
    ∀ n : Nat, max N₀ 2 ≤ n → Nat.log2 n ≤ c₁ * D n ∧ D n ≤ c₂ * Nat.log2 n

theorem nat_log2_pos_of_ge_two {n : Nat} (hn : 2 ≤ n) : 1 ≤ Nat.log2 n := by
  have hne : n ≠ 0 := by omega
  have hlt : 2 ^ 1 ≤ n := by omega
  exact (Nat.le_log2 hne).mpr hlt

theorem lt_two_pow : ∀ k : Nat, k < 2 ^ k
  | 0 => by decide
  | k + 1 => by
    have ih := lt_two_pow k
    rw [Nat.pow_succ]
    omega

theorem nat_log2_le_self (n : Nat) : Nat.log2 n ≤ n := by
  by_cases hn : n = 0
  · subst hn; simp [Nat.log2_zero]
  · have hpow : 2 ^ Nat.log2 n ≤ n := Nat.log2_self_le hn
    have hlt := lt_two_pow (Nat.log2 n)
    omega

/-- **Refutation of Invariant-Antichain Deficit (`D(n) = 0`)**:
    The identically zero sequence is NOT of logarithmic order `Θ(log n)`. -/
theorem zero_deficit_not_logOrder : ¬ IsLogOrder (fun _ => 0) := by
  rintro ⟨c₁, _, _, _, N₀, hspec⟩
  let n := max N₀ 2
  have hn2 : 2 ≤ n := Nat.le_max_right N₀ 2
  have hlog : 1 ≤ Nat.log2 n := nat_log2_pos_of_ge_two hn2
  have hlo := (hspec n (Nat.le_refl n)).1
  simp only [Nat.mul_zero] at hlo
  omega

/-- Elementary linear-step induction: `4 * r < 2 ^ r` for all `r ≥ 5`. -/
theorem four_mul_lt_pow_two : ∀ r : Nat, 5 ≤ r → 4 * r < 2 ^ r := by
  intro r hr
  have hstep : ∀ d : Nat, 4 * (5 + d) < 2 ^ (5 + d) := by
    intro d
    induction d with
    | zero => decide
    | succ d ih =>
      have heq : 5 + (d + 1) = (5 + d) + 1 := by omega
      rw [heq, Nat.pow_succ]
      omega
  have hr_eq : r = 5 + (r - 5) := by omega
  rw [hr_eq]
  exact hstep (r - 5)

theorem binom_self : ∀ n : Nat, binom n n = 1
  | 0 => rfl
  | n + 1 => by
    change binom n n + binom n (n + 1) = 1
    rw [binom_self n, binom_gt_zero (by omega)]

theorem binom_symm : ∀ (n j : Nat), j ≤ n → binom n j = binom n (n - j)
  | 0, j, hj => by
    have hj0 : j = 0 := by omega
    subst hj0; rfl
  | n + 1, 0, _ => by
    simp only [Nat.sub_zero]
    rw [binom_self (n + 1)]
    rfl
  | n + 1, j + 1, hj => by
    if hjn : j + 1 = n + 1 then
      rw [hjn, Nat.sub_self, binom_self (n + 1)]
      rfl
    else
      have hj_le : j + 1 ≤ n := by omega
      have hsub : n + 1 - (j + 1) = (n - (j + 1)) + 1 := by omega
      have hsub0 : (n - (j + 1)) + 1 = n - j := by omega
      rw [hsub]
      change binom n j + binom n (j + 1) = binom n (n - (j + 1)) + binom n ((n - (j + 1)) + 1)
      rw [hsub0, binom_symm n j (by omega), binom_symm n (j + 1) hj_le]
      omega

/-- Exact identity on even dimensions: `spernerNum (2 * k) = 2 * spernerNum (2 * k - 1)` (`k ≥ 1`). -/
theorem spernerNum_even_split (k : Nat) (hk : 1 ≤ k) :
    spernerNum (2 * k) = 2 * spernerNum (2 * k - 1) := by
  cases k with
  | zero => omega
  | succ m =>
    have hdiv1 : (2 * (m + 1)) / 2 = m + 1 := by omega
    have hsub : 2 * (m + 1) - 1 = 2 * m + 1 := by omega
    have hdiv2 : (2 * m + 1) / 2 = m := by omega
    unfold spernerNum
    rw [hdiv1, hsub, hdiv2]
    have heq2 : 2 * (m + 1) = (2 * m + 1) + 1 := by omega
    rw [heq2]
    change binom (2 * m + 1) m + binom (2 * m + 1) (m + 1) = 2 * binom (2 * m + 1) m
    have hsym_mid := binom_symm (2 * m + 1) m (by omega)
    have hsub_mid : 2 * m + 1 - m = m + 1 := by omega
    rw [hsub_mid] at hsym_mid
    omega

/-- **Refutation of Exponential Deficit for ALL Nontrivial Subgroup Families**:
    Whenever an orbit-antichain width sequence `W : Nat → Nat` satisfies the universal
    nontrivial-subgroup bound `2 * W n ≤ spernerNum n + spernerNum (n - 1)` for `n ≥ 2`,
    its deficit `D(n) = spernerNum n - W n` is NOT of logarithmic order `Θ(log n)`. -/
theorem nontrivial_subgroup_deficit_not_logOrder (W : Nat → Nat)
    (hbound : ∀ n : Nat, 2 ≤ n → 2 * W n ≤ spernerNum n + spernerNum (n - 1)) :
    ¬ IsLogOrder (fun n => spernerNum n - W n) := by
  rintro ⟨_, _, c₂, _, N₀, hspec⟩
  -- Set `m = 4 * c₂ + N₀ + 3 ≥ 3`, `r = 2 * m ≥ 6 ≥ 5`, and even `n = 6 * m = 2 * (3 * m)`!
  let m := 4 * c₂ + N₀ + 3
  let r := 2 * m
  let n := 6 * m
  have hn_even : n = 2 * (3 * m) := by omega
  have h3m : 1 ≤ 3 * m := by omega
  have hn_ge_max : max N₀ 2 ≤ n := by omega
  have hup : spernerNum n - W n ≤ c₂ * Nat.log2 n := (hspec n hn_ge_max).2
  have hup_n : spernerNum n - W n ≤ c₂ * n :=
    Nat.le_trans hup (Nat.mul_le_mul_left c₂ (nat_log2_le_self n))
  have hsplit : spernerNum n = 2 * spernerNum (n - 1) := by
    rw [hn_even]
    exact spernerNum_even_split (3 * m) h3m
  have hb := hbound n (by omega)
  have hdef4 : spernerNum n ≤ 4 * (spernerNum n - W n) := by omega
  have hsp_le : spernerNum n ≤ (4 * c₂) * n := by
    have hm4 := Nat.mul_le_mul_left 4 hup_n
    rw [← Nat.mul_assoc 4 c₂ n] at hm4
    omega
  have hexp : 2 ^ n ≤ (n + 1) * spernerNum n := spernerNum_exp_lower n
  have hchain : 2 ^ n ≤ (n + 1) * ((4 * c₂) * n) :=
    Nat.le_trans hexp (Nat.mul_le_mul_left (n + 1) hsp_le)
  -- Use `4 * r = 8 * m < 2 ^ r` (`r = 2 * m ≥ 6`) to bound all three factors strictly below `2 ^ r`!
  have hpow_r : 4 * r < 2 ^ r := four_mul_lt_pow_two r (by omega)
  have hf1 : n + 1 ≤ 2 ^ r := by omega
  have hf2 : 4 * c₂ ≤ 2 ^ r := by omega
  have hf3 : n < 2 ^ r := by omega
  have hm23 : (4 * c₂) * n < 2 ^ r * 2 ^ r := by
    have hle1 : (4 * c₂) * n ≤ 2 ^ r * n := Nat.mul_le_mul_right n hf2
    have hlt2 : 2 ^ r * n < 2 ^ r * 2 ^ r :=
      Nat.mul_lt_mul_of_pos_left hf3 (by have := lt_two_pow r; omega)
    omega
  have hm123 : (n + 1) * ((4 * c₂) * n) < 2 ^ r * (2 ^ r * 2 ^ r) := by
    have hle1 : (n + 1) * ((4 * c₂) * n) ≤ 2 ^ r * ((4 * c₂) * n) :=
      Nat.mul_le_mul_right _ hf1
    have hlt2 : 2 ^ r * ((4 * c₂) * n) < 2 ^ r * (2 ^ r * 2 ^ r) :=
      Nat.mul_lt_mul_of_pos_left hm23 (by have := lt_two_pow r; omega)
    omega
  have hpow_eq : 2 ^ r * (2 ^ r * 2 ^ r) = 2 ^ n := by
    rw [← Nat.pow_add, ← Nat.pow_add]
    have hsum : r + (r + r) = n := by omega
    rw [hsum]
  rw [hpow_eq] at hm123
  omega

/-- **Corollary**: The canonical `(B_n, S_n)` orbit-antichain deficit `spernerNum n - 1`
    is NOT of logarithmic order `Θ(log n)`. -/
theorem sn_orbit_deficit_not_logOrder : ¬ IsLogOrder (fun n => spernerNum n - 1) := by
  apply nontrivial_subgroup_deficit_not_logOrder (fun _ => 1)
  intro n hn
  have hge2 : 2 ≤ spernerNum n := by
    have hexp := spernerNum_exp_lower n
    have hlin_lt : ∀ m : Nat, 2 ≤ m → m + 1 < 2 ^ m := by
      intro m hm
      have hstep : ∀ d : Nat, (2 + d) + 1 < 2 ^ (2 + d) := by
        intro d
        induction d with
        | zero => decide
        | succ d ih =>
          have heq : 2 + (d + 1) = (2 + d) + 1 := by omega
          rw [heq, Nat.pow_succ]
          omega
      have hm_eq : m = 2 + (m - 2) := by omega
      rw [hm_eq]
      exact hstep (m - 2)
    have hlt := hlin_lt n hn
    by_cases hs : 2 ≤ spernerNum n
    · exact hs
    · have hs1 : spernerNum n ≤ 1 := by omega
      have hmul : (n + 1) * spernerNum n ≤ (n + 1) * 1 := Nat.mul_le_mul_left (n + 1) hs1
      omega
  have hpos_prev : 1 ≤ spernerNum (n - 1) := by
    have hexp := spernerNum_exp_lower (n - 1)
    have hpow : 1 ≤ 2 ^ (n - 1) := Nat.one_le_two_pow
    by_cases hs : 1 ≤ spernerNum (n - 1)
    · exact hs
    · have hs0 : spernerNum (n - 1) = 0 := by omega
      rw [hs0, Nat.mul_zero] at hexp
      omega
  omega

/-! ## 4. Master Theorem Summarizing the Complete Disproof of Conjecture 00000008546 -/

/-- **Master Disproof of Conjecture 00000008546**:
    1. *(Boolean Lattice `S_n`-Invariant Antichains)*: The middle layer `midLayer n` is an
       `S_n`-invariant antichain of exact Sperner size `spernerNum n`, and its deficit `0`
       fails `IsLogOrder`.
    2. *(Boolean Lattice `S_n`-Orbit Antichains)*: Every orbit antichain in `B_n / S_n` has
       size `≤ 1` (achieved by `[falseBVec n]`), and its deficit `spernerNum n - 1` fails `IsLogOrder`.
    3. *(Universal Subgroup Dichotomy on `B_n`)*: Every nontrivial permutation subgroup family
       forces an exponential orbit-Sperner deficit that fails `IsLogOrder`.
    4. *(Clause 1 Counterexample on Bounded Graded Sperner Posets)*: For every `n ≥ 2`, the
       bounded graded Sperner poset `pnPoset n` has a faithful `S_n`-action with maximum
       orbit-rank size `4` yet possesses a `5`-element orbit antichain. -/
theorem conjecture_00000008546_disproved :
    (∀ n : Nat,
      (snPosetAction n).IsInvariantPred (fun x => midLayer n x = true) ∧
      (booleanPoset n).IsAntichainPred (fun x => midLayer n x = true) ∧
      setCard (midLayer n) = spernerNum n) ∧
    ¬ IsLogOrder (fun _ => 0) ∧
    (∀ (n : Nat) (reps : List (BVec n)),
      List.Pairwise
        (fun x y => ¬ (snPosetAction n).OrbitLe x y ∧ ¬ (snPosetAction n).OrbitLe y x) reps →
      reps.length ≤ 1) ∧
    ¬ IsLogOrder (fun n => spernerNum n - 1) ∧
    (∀ (n : Nat) (hn : 2 ≤ n),
      (∀ L : List (PnElem n),
        List.Pairwise (fun x y => (pnPoset n).Incomp x y) L → L.length ≤ 2 * n + 2) ∧
      List.Pairwise
        (fun x y => ¬ (pnAction n).OrbitLe x y ∧ ¬ (pnAction n).OrbitLe y x)
        (pnFiveOrbitAntichain hn) ∧
      (pnFiveOrbitAntichain hn).length = 5) :=
  ⟨fun n => ⟨midLayer_sn_invariant n, midLayer_isAntichain n, midLayer_card_eq_spernerNum n⟩,
   zero_deficit_not_logOrder,
   fun _ _ h => bn_sn_orbit_antichain_le_one h,
   sn_orbit_deficit_not_logOrder,
   fun _ hn => ⟨fun _ hL => pnPoset_antichain_le hn hL,
                (pnFiveOrbitAntichain_valid hn).1,
                (pnFiveOrbitAntichain_valid hn).2⟩⟩

end OrbitSperner
