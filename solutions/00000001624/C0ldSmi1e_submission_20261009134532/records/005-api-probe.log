def Lean.ConstantInfo.isUnsafe : Lean.ConstantInfo → Bool :=
fun x =>
  match x with
  | Lean.ConstantInfo.defnInfo v => v.safety == Lean.DefinitionSafety.unsafe
  | Lean.ConstantInfo.axiomInfo v => v.isUnsafe
  | Lean.ConstantInfo.thmInfo val => false
  | Lean.ConstantInfo.opaqueInfo v => v.isUnsafe
  | Lean.ConstantInfo.quotInfo val => false
  | Lean.ConstantInfo.inductInfo v => v.isUnsafe
  | Lean.ConstantInfo.ctorInfo v => v.isUnsafe
  | Lean.ConstantInfo.recInfo v => v.isUnsafe
def Lean.ConstantInfo.value? : Lean.ConstantInfo → optParam Bool false → Option Lean.Expr :=
fun info allowOpaque =>
  match info with
  |
  Lean.ConstantInfo.defnInfo
      { name := name, levelParams := levelParams, type := type, value := value, hints := hints, safety := safety,
        all := all } =>
    some value
  | Lean.ConstantInfo.thmInfo { name := name, levelParams := levelParams, type := type, value := value, all := all } =>
    some value
  |
  Lean.ConstantInfo.opaqueInfo
      { name := name, levelParams := levelParams, type := type, value := value, isUnsafe := isUnsafe, all := all } =>
    if allowOpaque = true then some value else none
  | x => none
def Lean.collectAxioms : {m : Type → Type} →
  [inst : Monad m] → [inst : Lean.MonadEnv m] → Lean.Name → m (Array Lean.Name) :=
fun {m} [Monad m] [Lean.MonadEnv m] constName => do
  let env ← Lean.getEnv
  match StateT.run (ReaderT.run (Lean.CollectAxioms.collect constName) env) { } with
    | (fst, s) => pure s.axioms
