Mathlib/Algebra/Order/Archimedean/Basic.lean:lemma exists_nat_gt (x : R) : ∃ n : ℕ, x < n :=
Mathlib/Algebra/Order/Archimedean/Basic.lean:  let ⟨n, h⟩ := exists_nat_gt x
Mathlib/Algebra/Order/Archimedean/Basic.lean:  obtain ⟨n, hn⟩ := exists_nat_gt (1 / ε)
Mathlib/Algebra/Order/Archimedean/Basic.lean:  ⟨@exists_nat_gt K _ _ _, fun H =>
Mathlib/Algebra/Order/Archimedean/Basic.lean:    let ⟨n, h⟩ := exists_nat_gt x
Mathlib/Algebra/Order/Archimedean/Basic.lean:  obtain ⟨n, nh⟩ := exists_nat_gt (y - x)⁻¹
