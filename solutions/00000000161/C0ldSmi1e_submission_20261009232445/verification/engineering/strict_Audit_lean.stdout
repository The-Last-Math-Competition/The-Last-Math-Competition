@[reducible] def Conjecture161.PrimeIndex : Type :=
@Subtype Nat fun p => Nat.Prime p
@[reducible] def Conjecture161.GeneralLinear : Nat → Conjecture161.PrimeIndex → Type :=
fun n p =>
  @Matrix.GeneralLinearGroup (Fin n) (ZMod (@Subtype.val Nat (fun p => Nat.Prime p) p)) (instDecidableEqFin n)
    (Fin.fintype n) (ZMod.commRing (@Subtype.val Nat (fun p => Nat.Prime p) p))
def Conjecture161.LargePrimeFactor : (n : Nat) →
  Real → (p : Conjecture161.PrimeIndex) → Conjecture161.GeneralLinear n p → Prop :=
fun n C p A =>
  ∃ r,
    And (Nat.Prime r)
      (And
        (@Dvd.dvd Nat Nat.instDvd r
          (@orderOf (Conjecture161.GeneralLinear n p)
            (@Units.instMonoid (Matrix (Fin n) (Fin n) (ZMod (@Subtype.val Nat (fun p => Nat.Prime p) p)))
              (@MonoidWithZero.toMonoid (Matrix (Fin n) (Fin n) (ZMod (@Subtype.val Nat (fun p => Nat.Prime p) p)))
                (@Semiring.toMonoidWithZero (Matrix (Fin n) (Fin n) (ZMod (@Subtype.val Nat (fun p => Nat.Prime p) p)))
                  (@Matrix.semiring (Fin n) (ZMod (@Subtype.val Nat (fun p => Nat.Prime p) p))
                    (@CommSemiring.toSemiring (ZMod (@Subtype.val Nat (fun p => Nat.Prime p) p))
                      (@CommRing.toCommSemiring (ZMod (@Subtype.val Nat (fun p => Nat.Prime p) p))
                        (ZMod.commRing (@Subtype.val Nat (fun p => Nat.Prime p) p))))
                    (Fin.fintype n) (instDecidableEqFin n)))))
            A))
        (@LT.lt Real Real.instLT
          (@HDiv.hDiv Real Real Real (@instHDiv Real (@DivInvMonoid.toDiv Real Real.instDivInvMonoid))
            (@HPow.hPow Real Nat Real (@instHPow Real Nat (@Monoid.toNatPow Real Real.instMonoid))
              (@Nat.cast Real Real.instNatCast (@Subtype.val Nat (fun p => Nat.Prime p) p))
              (@HSub.hSub Nat Nat Nat (@instHSub Nat instSubNat) n (@OfNat.ofNat Nat 1 (instOfNatNat 1))))
            C)
          (@Nat.cast Real Real.instNatCast r)))
def Conjecture161.successProbability : Nat → Real → Conjecture161.PrimeIndex → Real :=
fun n C p =>
  @HDiv.hDiv Real Real Real (@instHDiv Real (@DivInvMonoid.toDiv Real Real.instDivInvMonoid))
    (@Nat.cast Real Real.instNatCast
      (Nat.card (@Subtype (Conjecture161.GeneralLinear n p) fun A => Conjecture161.LargePrimeFactor n C p A)))
    (@Nat.cast Real Real.instNatCast (Nat.card (Conjecture161.GeneralLinear n p)))
def Conjecture161.OriginalClaim : Prop :=
∃ P,
  And
    (∀ (n : Nat),
      @LE.le Nat instLENat (@OfNat.ofNat Nat 2 (instOfNatNat 2)) n →
        @LT.lt Real Real.instLT (@OfNat.ofNat Real 0 (@Zero.toOfNat0 Real Real.instZero))
          (@Polynomial.eval Real Real.semiring (@Nat.cast Real Real.instNatCast n) P))
    (∀ (n : Nat),
      @LE.le Nat instLENat (@OfNat.ofNat Nat 2 (instOfNatNat 2)) n →
        @Filter.Tendsto Conjecture161.PrimeIndex Real
          (Conjecture161.successProbability n
            (@Polynomial.eval Real Real.semiring (@Nat.cast Real Real.instNatCast n) P))
          (@Filter.atTop Conjecture161.PrimeIndex (@Subtype.preorder Nat Nat.instPreorder fun p => Nat.Prime p))
          (@nhds Real
            (@UniformSpace.toTopologicalSpace Real (@PseudoMetricSpace.toUniformSpace Real Real.pseudoMetricSpace))
            (@OfNat.ofNat Real 1 (@One.toOfNat1 Real Real.instOne))))
