namespace Conjecture00000001288

/-! ## Section 1: Arithmetic & Bitwise Foundations -/

theorem two_pow_pos (n : Nat) : 0 < 2 ^ n := by
  induction n with
  | zero => decide
  | succ k ih =>
    have h : 2 ^ (k + 1) = 2 ^ k * 2 := Nat.pow_succ 2 k
    omega

theorem lt_two_pow_self (n : Nat) : n < 2 ^ n := by
  induction n with
  | zero => decide
  | succ k ih =>
    have h : 2 ^ (k + 1) = 2 ^ k * 2 := Nat.pow_succ 2 k
    omega

theorem ge_two_pow_of_testBit {x i : Nat} (h : x.testBit i = true) : 2 ^ i ≤ x := by
  apply Nat.le_of_not_lt
  intro hlt
  have hf : x.testBit i = false := Nat.testBit_lt_two_pow hlt
  rw [h] at hf
  contradiction

theorem xor_eq_zero_iff {a b : Nat} : (a ^^^ b) = 0 ↔ a = b := by
  constructor
  · intro h
    apply Nat.eq_of_testBit_eq
    intro i
    have hi : (a ^^^ b).testBit i = (0 : Nat).testBit i := by rw [h]
    rw [Nat.testBit_xor, Nat.zero_testBit] at hi
    cases ha : a.testBit i <;> cases hb : b.testBit i <;> simp_all
  · intro h
    subst h
    exact Nat.xor_self a

theorem xor_cancel_left (a b : Nat) : a ^^^ (a ^^^ b) = b := by
  rw [← Nat.xor_assoc, Nat.xor_self, Nat.zero_xor]

theorem xor_cancel_right (a b : Nat) : (a ^^^ b) ^^^ b = a := by
  rw [Nat.xor_assoc, Nat.xor_self, Nat.xor_zero]

theorem testBit_mul_two_zero (x : Nat) : (x * 2).testBit 0 = false := by
  rw [Nat.testBit_zero]
  simp

theorem testBit_mul_two_succ (x k : Nat) : (x * 2).testBit (k + 1) = x.testBit k := by
  rw [Nat.testBit_succ]
  have h : x * 2 / 2 = x := by omega
  rw [h]

theorem xor_mod_two (a b : Nat) : (a ^^^ b) % 2 = (if (a % 2 == 1) ^^ (b % 2 == 1) then 1 else 0) := by
  have h := Nat.testBit_xor a b 0
  rw [Nat.testBit_zero, Nat.testBit_zero, Nat.testBit_zero] at h
  have ha : a % 2 = 0 ∨ a % 2 = 1 := by omega
  have hb : b % 2 = 0 ∨ b % 2 = 1 := by omega
  have hab : (a ^^^ b) % 2 = 0 ∨ (a ^^^ b) % 2 = 1 := by omega
  rcases ha with ha | ha <;> rcases hb with hb | hb <;> rcases hab with hab | hab <;> simp_all

theorem xor_div_two (a b : Nat) : (a ^^^ b) / 2 = (a / 2) ^^^ (b / 2) := by
  apply Nat.eq_of_testBit_eq
  intro i
  rw [Nat.testBit_xor, ← Nat.testBit_succ, ← Nat.testBit_succ, ← Nat.testBit_succ, Nat.testBit_xor]

theorem xor_mul_two (a b : Nat) : (a ^^^ b) * 2 = (a * 2) ^^^ (b * 2) := by
  apply Nat.eq_of_testBit_eq
  intro i
  cases i with
  | zero =>
    rw [Nat.testBit_xor, testBit_mul_two_zero, testBit_mul_two_zero, testBit_mul_two_zero]
    rfl
  | succ k =>
    rw [Nat.testBit_xor, testBit_mul_two_succ, testBit_mul_two_succ, testBit_mul_two_succ,
      Nat.testBit_xor]

/-- Comparison via the most significant differing bit: if `x` has `0` and `y` has `1` at bit `b`,
    and `x, y` agree at all higher bits `j > b`, then `x < y`. -/
theorem lt_of_msb_diff {x y : Nat} (b : Nat)
    (hy : y.testBit b = true) (hx : x.testBit b = false)
    (hhi : ∀ j, b < j → x.testBit j = y.testBit j) : x < y := by
  induction b generalizing x y with
  | zero =>
    have hdiv : x / 2 = y / 2 := by
      apply Nat.eq_of_testBit_eq
      intro k
      rw [← Nat.testBit_succ, ← Nat.testBit_succ]
      exact hhi (k + 1) (by omega)
    rw [Nat.testBit_zero] at hx hy
    have hx2 : x % 2 = 0 := by
      have : ¬(x % 2 = 1) := of_decide_eq_false hx
      omega
    have hy2 : y % 2 = 1 := of_decide_eq_true hy
    omega
  | succ b' ih =>
    rw [Nat.testBit_succ] at hx hy
    have hlt : x / 2 < y / 2 := by
      apply ih hy hx
      intro j hj
      rw [← Nat.testBit_succ, ← Nat.testBit_succ]
      exact hhi (j + 1) (by omega)
    omega

/-- Conversely, whenever `m < g`, there exists a most significant differing bit `b` where
    `g` has `1`, `m` has `0`, and `m, g` agree on all higher bits `j > b`. -/
theorem exists_msb_diff {m g : Nat} (h : m < g) :
    ∃ b : Nat, g.testBit b = true ∧ m.testBit b = false ∧
      ∀ j, b < j → m.testBit j = g.testBit j := by
  have hstrong : ∀ k : Nat, ∀ m g : Nat, g ≤ k → m < g →
      ∃ b : Nat, g.testBit b = true ∧ m.testBit b = false ∧
        ∀ j, b < j → m.testBit j = g.testBit j := by
    intro k
    induction k with
    | zero =>
      intro m g hg hlt
      omega
    | succ k' ih =>
      intro m g hg hlt
      by_cases hdiv : m / 2 < g / 2
      · obtain ⟨b', hgb', hmb', hhi'⟩ := ih (m / 2) (g / 2) (by omega) hdiv
        refine ⟨b' + 1, ?_, ?_, ?_⟩
        · rw [Nat.testBit_succ]; exact hgb'
        · rw [Nat.testBit_succ]; exact hmb'
        · intro j hj
          cases j with
          | zero => omega
          | succ j' =>
            rw [Nat.testBit_succ, Nat.testBit_succ]
            exact hhi' j' (by omega)
      · have heq : m / 2 = g / 2 := by omega
        have hm0 : m % 2 = 0 := by omega
        have hg1 : g % 2 = 1 := by omega
        refine ⟨0, ?_, ?_, ?_⟩
        · rw [Nat.testBit_zero]; exact decide_eq_true hg1
        · rw [Nat.testBit_zero]; exact decide_eq_false (by omega)
        · intro j hj
          cases j with
          | zero => omega
          | succ j' =>
            rw [Nat.testBit_succ, Nat.testBit_succ, heq]
  exact hstrong g m g (Nat.le_refl g) h

/-- Most significant set bit of a positive natural number. -/
def msb (x : Nat) : Nat :=
  if h : x ≤ 1 then 0
  else msb (x / 2) + 1
termination_by x

theorem msb_spec {x : Nat} (hx : x ≠ 0) :
    x.testBit (msb x) = true ∧ ∀ j, msb x < j → x.testBit j = false := by
  have hstrong : ∀ k : Nat, ∀ x : Nat, x ≤ k → x ≠ 0 →
      x.testBit (msb x) = true ∧ ∀ j, msb x < j → x.testBit j = false := by
    intro k
    induction k with
    | zero =>
      intro x hle hne
      omega
    | succ k' ih =>
      intro x hle hne
      by_cases hx1 : x ≤ 1
      · have hx_eq : x = 1 := by omega
        subst hx_eq
        have hmsb1 : msb 1 = 0 := by unfold msb; decide
        rw [hmsb1]
        refine ⟨by decide, ?_⟩
        intro j hj
        apply Nat.testBit_lt_two_pow
        have h2 : 2 ^ 1 ≤ 2 ^ j := Nat.pow_le_pow_right (by decide) hj
        omega
      · have hmsb : msb x = msb (x / 2) + 1 := by
          conv => lhs; unfold msb
          simp [hx1]
        obtain ⟨ht, hhi⟩ := ih (x / 2) (by omega) (by omega)
        rw [hmsb]
        refine ⟨?_, ?_⟩
        · rw [Nat.testBit_succ]; exact ht
        · intro j hj
          cases j with
          | zero => omega
          | succ j' =>
            rw [Nat.testBit_succ]
            exact hhi j' (by omega)
  exact hstrong x x (Nat.le_refl x) hx

/-! ## Section 2: The Polynomial Ring `ℤ₂[x]` (`PolyF2`) -/

/-- Elements of the polynomial ring `ℤ₂[x]`, canonically represented via their finite
    support bitmask, with `coeff p k : Bool` giving the coefficient `[x^k] p` in `ℤ₂`. -/
structure PolyF2 where
  bits : Nat
  deriving DecidableEq, Repr

namespace PolyF2

/-- Coefficient of `x^k` in `p ∈ ℤ₂[x]` (`false` = `0`, `true` = `1`). -/
def coeff (p : PolyF2) (k : Nat) : Bool :=
  p.bits.testBit k

theorem ext {p q : PolyF2} (h : ∀ k : Nat, p.coeff k = q.coeff k) : p = q := by
  cases p; cases q
  simp only [mk.injEq]
  exact Nat.eq_of_testBit_eq h

instance : OfNat PolyF2 0 := ⟨⟨0⟩⟩
instance : OfNat PolyF2 1 := ⟨⟨1⟩⟩

@[simp] theorem zero_bits : (0 : PolyF2).bits = 0 := rfl
@[simp] theorem one_bits : (1 : PolyF2).bits = 1 := rfl

/-- The indeterminate `x ∈ ℤ₂[x]`. -/
def X : PolyF2 := ⟨2⟩

/-- The monomial `x^n ∈ ℤ₂[x]`. -/
def monomial (n : Nat) : PolyF2 := ⟨2 ^ n⟩

def add (p q : PolyF2) : PolyF2 := ⟨p.bits ^^^ q.bits⟩

instance : Add PolyF2 := ⟨add⟩

@[simp] theorem add_bits (p q : PolyF2) : (p + q).bits = p.bits ^^^ q.bits := rfl

/-- Carryless binary multiplication implementing multiplication in `ℤ₂[x]`. -/
def mulBits (a b : Nat) : Nat :=
  if _ : a = 0 then 0
  else (if a % 2 = 1 then b else 0) ^^^ (mulBits (a / 2) b * 2)
termination_by a

def mul (p q : PolyF2) : PolyF2 := ⟨mulBits p.bits q.bits⟩

instance : Mul PolyF2 := ⟨mul⟩

def npow (p : PolyF2) : Nat → PolyF2
  | 0 => 1
  | n + 1 => npow p n * p

instance : Pow PolyF2 Nat := ⟨npow⟩

@[simp] theorem pow_zero (p : PolyF2) : p ^ 0 = 1 := rfl
@[simp] theorem pow_succ (p : PolyF2) (n : Nat) : p ^ (n + 1) = p ^ n * p := rfl

@[simp] theorem coeff_zero (k : Nat) : (0 : PolyF2).coeff k = false :=
  Nat.zero_testBit k

theorem coeff_monomial (n k : Nat) : (monomial n).coeff k = decide (n = k) :=
  Nat.testBit_two_pow

theorem coeff_one (k : Nat) : (1 : PolyF2).coeff k = decide (0 = k) := by
  change (monomial 0).coeff k = decide (0 = k)
  exact coeff_monomial 0 k

theorem coeff_X (k : Nat) : X.coeff k = decide (1 = k) := by
  change (monomial 1).coeff k = decide (1 = k)
  exact coeff_monomial 1 k

@[simp] theorem coeff_add (p q : PolyF2) (k : Nat) :
    (p + q).coeff k = (p.coeff k ^^ q.coeff k) :=
  Nat.testBit_xor p.bits q.bits k

theorem coeff_eq_false_of_le {p : PolyF2} {k : Nat} (h : p.bits ≤ k) : p.coeff k = false := by
  apply Nat.testBit_lt_two_pow
  have hk : k < 2 ^ k := lt_two_pow_self k
  omega

/-- Construct the unique polynomial of degree `< N` with prescribed coefficients `f`. -/
def ofCoeff : Nat → (Nat → Bool) → PolyF2
  | 0, _ => 0
  | n + 1, f => if f n then ofCoeff n f + monomial n else ofCoeff n f

theorem coeff_ofCoeff (N : Nat) (f : Nat → Bool) (k : Nat) :
    (ofCoeff N f).coeff k = (decide (k < N) && f k) := by
  induction N with
  | zero =>
    simp [ofCoeff]
  | succ n ih =>
    simp only [ofCoeff]
    by_cases hfn : f n = true
    · rw [if_pos hfn, coeff_add, ih, coeff_monomial]
      by_cases hkn : k < n
      · have hne : ¬(n = k) := by omega
        have hklt : k < n + 1 := by omega
        simp [hkn, hne, hklt]
      · by_cases heq : n = k
        · subst heq
          simp [hfn]
        · have hk1 : ¬(k < n + 1) := by omega
          simp [hkn, heq, hk1]
    · rw [if_neg hfn, ih]
      have hff : f n = false := Bool.eq_false_iff.mpr hfn
      by_cases heq : k = n
      · subst heq
        simp [hff]
      · have hiff : decide (k < n) = decide (k < n + 1) := by
          by_cases h1 : k < n
          · have h2 : k < n + 1 := by omega
            simp [h1, h2]
          · have h2 : ¬(k < n + 1) := by omega
            simp [h1, h2]
        rw [hiff]

theorem ofCoeff_self {N : Nat} (p : PolyF2) (hN : p.bits ≤ N) :
    ofCoeff N p.coeff = p := by
  apply ext
  intro k
  rw [coeff_ofCoeff]
  by_cases hk : k < N
  · simp [hk]
  · have hf : p.coeff k = false := coeff_eq_false_of_le (by omega)
    simp [hk, hf]

/-- Universal finite-support correspondence: every finitely supported sequence `f : Nat → Bool`
    corresponds to a unique element of `PolyF2`. -/
theorem existsUnique_of_finiteSupport (f : Nat → Bool) (N : Nat)
    (hsupp : ∀ k, N ≤ k → f k = false) :
    (∀ k, (ofCoeff N f).coeff k = f k) ∧
      ∀ q : PolyF2, (∀ k, q.coeff k = f k) → q = ofCoeff N f := by
  have hc : ∀ k, (ofCoeff N f).coeff k = f k := by
    intro k
    rw [coeff_ofCoeff]
    by_cases hk : k < N
    · simp [hk]
    · have hf : f k = false := hsupp k (by omega)
      simp [hk, hf]
  refine ⟨hc, ?_⟩
  intro q hq
  apply ext
  intro k
  rw [hq k, hc k]

/-- Textbook Cauchy convolution of coefficients in `ℤ₂`:
    `∑_{i=0}^k p_i · q_{k-i} (mod 2)`. -/
def cauchyAux (p q : PolyF2) (k : Nat) : Nat → Bool
  | 0 => false
  | m + 1 => cauchyAux p q k m ^^ (p.coeff m && q.coeff (k - m))

def cauchyCoeff (p q : PolyF2) (k : Nat) : Bool :=
  cauchyAux p q k (k + 1)

theorem mulBits_zero_left (b : Nat) : mulBits 0 b = 0 := by
  unfold mulBits
  simp

theorem mulBits_step {a : Nat} (ha : a ≠ 0) (b : Nat) :
    mulBits a b = (if a % 2 = 1 then b else 0) ^^^ (mulBits (a / 2) b * 2) := by
  conv => lhs; unfold mulBits
  simp [ha]

theorem mulBits_zero_right (a : Nat) : mulBits a 0 = 0 := by
  have hstrong : ∀ m : Nat, ∀ a : Nat, a ≤ m → mulBits a 0 = 0 := by
    intro m
    induction m with
    | zero =>
      intro a ha
      have : a = 0 := by omega
      subst this
      exact mulBits_zero_left 0
    | succ m' ih =>
      intro a ha
      by_cases ha0 : a = 0
      · subst ha0; exact mulBits_zero_left 0
      · rw [mulBits_step ha0, ih (a / 2) (by omega)]
        simp
  exact hstrong a a (Nat.le_refl a)

theorem mulBits_one_left (b : Nat) : mulBits 1 b = b := by
  rw [mulBits_step (by decide), mulBits_zero_left]
  simp

theorem mulBits_one_right (a : Nat) : mulBits a 1 = a := by
  have hstrong : ∀ m : Nat, ∀ a : Nat, a ≤ m → mulBits a 1 = a := by
    intro m
    induction m with
    | zero =>
      intro a ha
      have : a = 0 := by omega
      subst this
      exact mulBits_zero_left 1
    | succ m' ih =>
      intro a ha
      by_cases ha0 : a = 0
      · subst ha0; exact mulBits_zero_left 1
      · rw [mulBits_step ha0, ih (a / 2) (by omega)]
        apply Nat.eq_of_testBit_eq
        intro i
        cases i with
        | zero =>
          rw [Nat.testBit_xor, testBit_mul_two_zero, Bool.xor_false, Nat.testBit_zero]
          by_cases h1 : a % 2 = 1 <;> simp [h1]
        | succ k =>
          rw [Nat.testBit_xor, testBit_mul_two_succ, ← Nat.testBit_succ]
          by_cases h1 : a % 2 = 1
          · rw [if_pos h1]
            have hf : (1 : Nat).testBit (k + 1) = false := by
              apply Nat.testBit_lt_two_pow
              have : 2 ^ 1 ≤ 2 ^ (k + 1) := Nat.pow_le_pow_right (by decide) (by omega)
              omega
            rw [hf, Bool.false_xor]
          · rw [if_neg h1, Nat.zero_testBit, Bool.false_xor]
  exact hstrong a a (Nat.le_refl a)

theorem mulBits_xor_right (a b c : Nat) :
    mulBits a (b ^^^ c) = mulBits a b ^^^ mulBits a c := by
  have hstrong : ∀ m : Nat, ∀ a : Nat, a ≤ m →
      mulBits a (b ^^^ c) = mulBits a b ^^^ mulBits a c := by
    intro m
    induction m with
    | zero =>
      intro a ha
      have : a = 0 := by omega
      subst this
      simp [mulBits_zero_left]
    | succ m' ih =>
      intro a ha
      by_cases ha0 : a = 0
      · subst ha0; simp [mulBits_zero_left]
      · rw [mulBits_step ha0, mulBits_step ha0, mulBits_step ha0,
          ih (a / 2) (by omega), xor_mul_two]
        by_cases h1 : a % 2 = 1
        · simp only [if_pos h1]
          apply Nat.eq_of_testBit_eq
          intro i
          simp only [Nat.testBit_xor]
          cases (b.testBit i) <;> cases (c.testBit i) <;>
            cases ((mulBits (a / 2) b * 2).testBit i) <;>
            cases ((mulBits (a / 2) c * 2).testBit i) <;> rfl
        · simp [if_neg h1]
  exact hstrong a a (Nat.le_refl a)

theorem mulBits_xor_left (a b c : Nat) :
    mulBits (a ^^^ b) c = mulBits a c ^^^ mulBits b c := by
  have hstrong : ∀ m : Nat, ∀ a b : Nat, a + b ≤ m →
      mulBits (a ^^^ b) c = mulBits a c ^^^ mulBits b c := by
    intro m
    induction m with
    | zero =>
      intro a b hab
      have ha : a = 0 := by omega
      have hb : b = 0 := by omega
      subst ha; subst hb
      simp [mulBits_zero_left]
    | succ m' ih =>
      intro a b hab
      by_cases ha0 : a = 0
      · subst ha0; simp [mulBits_zero_left]
      · by_cases hb0 : b = 0
        · subst hb0; simp [mulBits_zero_left]
        · by_cases hab0 : (a ^^^ b) = 0
          · have heq : a = b := xor_eq_zero_iff.mp hab0
            subst heq
            rw [hab0, mulBits_zero_left, Nat.xor_self]
          · rw [mulBits_step hab0, mulBits_step ha0, mulBits_step hb0,
              xor_div_two, ih (a / 2) (b / 2) (by omega), xor_mul_two]
            have hmod := xor_mod_two a b
            have ha2 : a % 2 = 0 ∨ a % 2 = 1 := by omega
            have hb2 : b % 2 = 0 ∨ b % 2 = 1 := by omega
            have hhead : (if (a ^^^ b) % 2 = 1 then c else 0) =
                (if a % 2 = 1 then c else 0) ^^^ (if b % 2 = 1 then c else 0) := by
              rcases ha2 with ha2 | ha2 <;> rcases hb2 with hb2 | hb2 <;>
                simp [ha2, hb2, Nat.xor_self] at hmod ⊢ <;> simp [hmod, Nat.xor_self]
            rw [hhead]
            apply Nat.eq_of_testBit_eq
            intro i
            simp only [Nat.testBit_xor]
            cases ((if a % 2 = 1 then c else 0).testBit i) <;>
              cases ((if b % 2 = 1 then c else 0).testBit i) <;>
              cases ((mulBits (a / 2) c * 2).testBit i) <;>
              cases ((mulBits (b / 2) c * 2).testBit i) <;> rfl
  exact hstrong (a + b) a b (Nat.le_refl _)

theorem mulBits_mul_two_left (a b : Nat) : mulBits (a * 2) b = mulBits a b * 2 := by
  by_cases ha0 : a = 0
  · subst ha0; simp [mulBits_zero_left]
  · rw [mulBits_step (by omega)]
    have hm : a * 2 % 2 = 0 := by omega
    have hd : a * 2 / 2 = a := by omega
    rw [hm, hd]
    simp

theorem mulBits_mul_two_right (a b : Nat) : mulBits a (b * 2) = mulBits a b * 2 := by
  have hstrong : ∀ m : Nat, ∀ a : Nat, a ≤ m → mulBits a (b * 2) = mulBits a b * 2 := by
    intro m
    induction m with
    | zero =>
      intro a ha
      have : a = 0 := by omega
      subst this
      simp [mulBits_zero_left]
    | succ m' ih =>
      intro a ha
      by_cases ha0 : a = 0
      · subst ha0; simp [mulBits_zero_left]
      · rw [mulBits_step ha0, mulBits_step ha0, ih (a / 2) (by omega), xor_mul_two]
        by_cases h1 : a % 2 = 1 <;> simp [h1]
  exact hstrong a a (Nat.le_refl a)

theorem mulBits_comm (a b : Nat) : mulBits a b = mulBits b a := by
  have hstrong : ∀ m : Nat, ∀ a : Nat, a ≤ m → mulBits a b = mulBits b a := by
    intro m
    induction m with
    | zero =>
      intro a ha
      have : a = 0 := by omega
      subst this
      rw [mulBits_zero_left, mulBits_zero_right]
    | succ m' ih =>
      intro a ha
      by_cases ha0 : a = 0
      · subst ha0; rw [mulBits_zero_left, mulBits_zero_right]
      · have hdecomp : a = (if a % 2 = 1 then 1 else 0) ^^^ ((a / 2) * 2) := by
          apply Nat.eq_of_testBit_eq
          intro i
          cases i with
          | zero =>
            rw [Nat.testBit_xor, testBit_mul_two_zero, Bool.xor_false, Nat.testBit_zero]
            by_cases h1 : a % 2 = 1 <;> simp [h1]
          | succ k =>
            rw [Nat.testBit_xor, testBit_mul_two_succ, ← Nat.testBit_succ]
            by_cases h1 : a % 2 = 1
            · rw [if_pos h1]
              have hf : (1 : Nat).testBit (k + 1) = false := by
                apply Nat.testBit_lt_two_pow
                have : 2 ^ 1 ≤ 2 ^ (k + 1) := Nat.pow_le_pow_right (by decide) (by omega)
                omega
              rw [hf, Bool.false_xor]
            · rw [if_neg h1, Nat.zero_testBit, Bool.false_xor]
        conv => rhs; rw [hdecomp]
        rw [mulBits_xor_right, mulBits_mul_two_right, ← ih (a / 2) (by omega), mulBits_step ha0]
        by_cases h1 : a % 2 = 1
        · simp [h1, mulBits_one_right]
        · simp [h1, mulBits_zero_right]
  exact hstrong a a (Nat.le_refl a)

theorem mulBits_assoc (a b c : Nat) : mulBits (mulBits a b) c = mulBits a (mulBits b c) := by
  have hstrong : ∀ m : Nat, ∀ a : Nat, a ≤ m →
      mulBits (mulBits a b) c = mulBits a (mulBits b c) := by
    intro m
    induction m with
    | zero =>
      intro a ha
      have : a = 0 := by omega
      subst this
      simp [mulBits_zero_left]
    | succ m' ih =>
      intro a ha
      by_cases ha0 : a = 0
      · subst ha0; simp [mulBits_zero_left]
      · rw [mulBits_step ha0, mulBits_xor_left, mulBits_mul_two_left,
          ih (a / 2) (by omega), mulBits_step ha0]
        by_cases h1 : a % 2 = 1 <;> simp [h1, mulBits_zero_left]
  exact hstrong a a (Nat.le_refl a)

/-- Commutative Ring + Characteristic-2 laws for `PolyF2`. -/
theorem add_assoc (p q r : PolyF2) : p + q + r = p + (q + r) := by
  apply ext; intro k; simp [Bool.xor_assoc]

theorem add_comm (p q : PolyF2) : p + q = q + p := by
  apply ext; intro k; simp [Bool.xor_comm]

theorem zero_add (p : PolyF2) : 0 + p = p := by
  apply ext; intro k; simp

theorem add_zero (p : PolyF2) : p + 0 = p := by
  apply ext; intro k; simp

theorem add_self (p : PolyF2) : p + p = 0 := by
  apply ext; intro k; simp

theorem zero_mul (p : PolyF2) : 0 * p = 0 :=
  congrArg PolyF2.mk (mulBits_zero_left p.bits)

theorem mul_zero (p : PolyF2) : p * 0 = 0 :=
  congrArg PolyF2.mk (mulBits_zero_right p.bits)

theorem one_mul (p : PolyF2) : 1 * p = p := by
  cases p
  exact congrArg PolyF2.mk (mulBits_one_left _)

theorem mul_one (p : PolyF2) : p * 1 = p := by
  cases p
  exact congrArg PolyF2.mk (mulBits_one_right _)

theorem mul_comm (p q : PolyF2) : p * q = q * p :=
  congrArg PolyF2.mk (mulBits_comm p.bits q.bits)

theorem mul_assoc (p q r : PolyF2) : p * q * r = p * (q * r) :=
  congrArg PolyF2.mk (mulBits_assoc p.bits q.bits r.bits)

theorem left_distrib (p q r : PolyF2) : p * (q + r) = p * q + p * r :=
  congrArg PolyF2.mk (mulBits_xor_right p.bits q.bits r.bits)

theorem right_distrib (p q r : PolyF2) : (p + q) * r = p * r + q * r :=
  congrArg PolyF2.mk (mulBits_xor_left p.bits q.bits r.bits)

/-- Exact textbook Cauchy product theorem: `[x^k](p * q) = ∑_{i=0}^k p_i · q_{k-i} (mod 2)`. -/
theorem cauchyAux_zero_left (q : PolyF2) (k m : Nat) : cauchyAux 0 q k m = false := by
  induction m with
  | zero => rfl
  | succ m' ih => simp [cauchyAux, ih]

theorem cauchyAux_shift (a : Nat) (q : PolyF2) (k m : Nat) :
    cauchyAux ⟨a⟩ q (k + 1) (m + 1) =
      ((Nat.testBit a 0 && q.coeff (k + 1)) ^^ cauchyAux ⟨a / 2⟩ q k m) := by
  induction m with
  | zero =>
    simp [cauchyAux, PolyF2.coeff]
  | succ m' ih =>
    have hstep1 : cauchyAux ⟨a⟩ q (k + 1) (m' + 1 + 1) =
        (cauchyAux ⟨a⟩ q (k + 1) (m' + 1) ^^
          ((⟨a⟩ : PolyF2).coeff (m' + 1) && q.coeff (k + 1 - (m' + 1)))) := rfl
    have hstep2 : cauchyAux ⟨a / 2⟩ q k (m' + 1) =
        (cauchyAux ⟨a / 2⟩ q k m' ^^
          ((⟨a / 2⟩ : PolyF2).coeff m' && q.coeff (k - m'))) := rfl
    have hsub : k + 1 - (m' + 1) = k - m' := by omega
    have hbit : (⟨a⟩ : PolyF2).coeff (m' + 1) = (⟨a / 2⟩ : PolyF2).coeff m' :=
      Nat.testBit_succ a m'
    rw [hstep1, hstep2, ih, hsub, hbit, Bool.xor_assoc]

theorem coeff_mul (p q : PolyF2) (k : Nat) : (p * q).coeff k = cauchyCoeff p q k := by
  have hstrong : ∀ m : Nat, ∀ a : Nat, a ≤ m → ∀ k : Nat,
      (PolyF2.mk a * q).coeff k = cauchyCoeff ⟨a⟩ q k := by
    intro m
    induction m with
    | zero =>
      intro a ha k
      have : a = 0 := by omega
      subst this
      change (0 * q).coeff k = cauchyAux 0 q k (k + 1)
      rw [zero_mul, coeff_zero, cauchyAux_zero_left]
    | succ m' ih =>
      intro a ha k
      by_cases ha0 : a = 0
      · subst ha0
        change (0 * q).coeff k = cauchyAux 0 q k (k + 1)
        rw [zero_mul, coeff_zero, cauchyAux_zero_left]
      · change (mulBits a q.bits).testBit k = cauchyCoeff ⟨a⟩ q k
        rw [mulBits_step ha0]
        cases k with
        | zero =>
          rw [Nat.testBit_xor, testBit_mul_two_zero, Bool.xor_false]
          simp only [cauchyCoeff, cauchyAux, Bool.false_xor, Nat.sub_zero]
          change (if a % 2 = 1 then q.bits else 0).testBit 0 = (a.testBit 0 && q.coeff 0)
          rw [Nat.testBit_zero]
          by_cases h1 : a % 2 = 1 <;> simp [h1, PolyF2.coeff]
        | succ k' =>
          rw [Nat.testBit_xor, testBit_mul_two_succ]
          have hih := ih (a / 2) (by omega) k'
          change (mulBits (a / 2) q.bits).testBit k' = cauchyCoeff ⟨a / 2⟩ q k' at hih
          rw [hih]
          simp only [cauchyCoeff]
          rw [cauchyAux_shift]
          have hhead : (if a % 2 = 1 then q.bits else 0).testBit (k' + 1) =
              (a.testBit 0 && q.coeff (k' + 1)) := by
            rw [Nat.testBit_zero]
            by_cases h1 : a % 2 = 1 <;> simp [h1, PolyF2.coeff]
          rw [hhead]
  exact hstrong p.bits p.bits (Nat.le_refl _) k

theorem mulBits_two_pow_left (n b : Nat) : mulBits (2 ^ n) b = b * 2 ^ n := by
  induction n with
  | zero =>
    simp [mulBits_one_left]
  | succ k ih =>
    have hpow : 2 ^ (k + 1) = 2 ^ k * 2 := Nat.pow_succ 2 k
    rw [hpow, mulBits_mul_two_left, ih, Nat.mul_assoc]

theorem monomial_mul (n : Nat) (p : PolyF2) : monomial n * p = ⟨p.bits * 2 ^ n⟩ :=
  congrArg PolyF2.mk (mulBits_two_pow_left n p.bits)

theorem monomial_add_exp (a b : Nat) : monomial a * monomial b = monomial (a + b) := by
  rw [monomial_mul]
  change PolyF2.mk (2 ^ b * 2 ^ a) = PolyF2.mk (2 ^ (a + b))
  rw [Nat.mul_comm, ← Nat.pow_add]

theorem X_pow_eq_monomial (n : Nat) : X ^ n = monomial n := by
  induction n with
  | zero =>
    apply ext
    intro k
    rw [pow_zero, coeff_one, coeff_monomial]
  | succ k ih =>
    rw [pow_succ, ih]
    exact monomial_add_exp k 1

theorem coeff_X_pow_mul (k : Nat) (p : PolyF2) (idx : Nat) :
    (X ^ k * p).coeff idx = (decide (k ≤ idx) && p.coeff (idx - k)) := by
  rw [X_pow_eq_monomial, monomial_mul]
  change (p.bits * 2 ^ k).testBit idx = (decide (k ≤ idx) && p.bits.testBit (idx - k))
  rw [← Nat.shiftLeft_eq]
  exact Nat.testBit_shiftLeft p.bits

/-- The maximal ideal `x · ℤ₂[x]` of polynomials with zero constant term (representing
    strictly `1`-indexed Turning Turtles configurations). -/
def InPosIdeal (p : PolyF2) : Prop :=
  p.coeff 0 = false

theorem inPosIdeal_zero : InPosIdeal 0 := rfl

theorem inPosIdeal_add {p q : PolyF2} (hp : InPosIdeal p) (hq : InPosIdeal q) :
    InPosIdeal (p + q) := by
  unfold InPosIdeal at hp hq ⊢
  rw [coeff_add, hp, hq]
  rfl

theorem inPosIdeal_mul_left (p : PolyF2) {q : PolyF2} (hq : InPosIdeal q) :
    InPosIdeal (p * q) := by
  unfold InPosIdeal at hq ⊢
  rw [coeff_mul]
  simp [cauchyCoeff, cauchyAux, hq]

theorem inPosIdeal_mul_right {p : PolyF2} (hp : InPosIdeal p) (q : PolyF2) :
    InPosIdeal (p * q) := by
  rw [mul_comm]
  exact inPosIdeal_mul_left q hp

theorem inPosIdeal_X_pow {n : Nat} (hn : 1 ≤ n) : InPosIdeal (X ^ n) := by
  rw [InPosIdeal, X_pow_eq_monomial, coeff_monomial]
  have : ¬(n = 0) := by omega
  simp [this]

end PolyF2

/-! ## Section 3: Minimum Excludant (`mexList`) -/

def mexAux (l : List Nat) (cur fuel : Nat) : Nat :=
  match fuel with
  | 0 => cur
  | fuel' + 1 => if cur ∈ l then mexAux l (cur + 1) fuel' else cur

/-- Minimum excludant (`mex`) of a finite list of natural numbers. -/
def mexList (l : List Nat) : Nat :=
  mexAux l 0 (l.length + 1)

theorem mexAux_ge (l : List Nat) (cur fuel : Nat) : cur ≤ mexAux l cur fuel := by
  induction fuel generalizing cur with
  | zero => exact Nat.le_refl cur
  | succ f' ih =>
    simp only [mexAux]
    split
    · have := ih (cur + 1); omega
    · exact Nat.le_refl cur

theorem filter_ne_length_lt {l : List Nat} {x : Nat} (hx : x ∈ l) :
    (l.filter (· != x)).length < l.length := by
  induction l with
  | nil => contradiction
  | cons hd tl ih =>
    simp only [List.filter]
    by_cases h : (hd != x) = true
    · simp only [h, List.length_cons]
      have hne : hd ≠ x := by simpa using h
      cases hx with
      | head => exact absurd rfl hne
      | tail _ htl =>
        have := ih htl
        omega
    · simp only [h]
      have hle : (tl.filter (· != x)).length ≤ tl.length := List.length_filter_le _ _
      simp only [List.length_cons]
      omega

theorem mexAux_congr (l₁ l₂ : List Nat) (c k : Nat)
    (heqv : ∀ z, c ≤ z → (z ∈ l₁ ↔ z ∈ l₂)) :
    mexAux l₁ c k = mexAux l₂ c k := by
  induction k generalizing c with
  | zero => rfl
  | succ k' ihk =>
    simp only [mexAux]
    have hc : c ∈ l₁ ↔ c ∈ l₂ := heqv c (Nat.le_refl c)
    by_cases hc1 : c ∈ l₁
    · have hc2 : c ∈ l₂ := hc.mp hc1
      rw [if_pos hc1, if_pos hc2]
      apply ihk
      intro z hz
      exact heqv z (by omega)
    · have hc2 : c ∉ l₂ := fun h => hc1 (hc.mpr h)
      rw [if_neg hc1, if_neg hc2]

theorem mexAux_not_mem (l : List Nat) (cur fuel : Nat)
    (hsub : ∀ y, y ∈ l → cur ≤ y)
    (hfuel : l.length < fuel) : mexAux l cur fuel ∉ l := by
  induction fuel generalizing l cur with
  | zero => omega
  | succ f' ih =>
    simp only [mexAux]
    by_cases hmem : cur ∈ l
    · rw [if_pos hmem]
      have hlen : (l.filter (· != cur)).length < f' := by
        have := filter_ne_length_lt hmem
        omega
      have hsub' : ∀ y, y ∈ l.filter (· != cur) → cur + 1 ≤ y := by
        intro y hy
        rw [List.mem_filter] at hy
        have h1 : cur ≤ y := hsub y hy.1
        have h2 : y ≠ cur := by simpa using hy.2
        omega
      have hsame : mexAux l (cur + 1) f' = mexAux (l.filter (· != cur)) (cur + 1) f' := by
        apply mexAux_congr
        intro z hz
        simp only [List.mem_filter]
        constructor
        · intro hzl
          refine ⟨hzl, ?_⟩
          have : z ≠ cur := by omega
          simpa using this
        · intro hzl; exact hzl.1
      rw [hsame]
      have hnot' := ih (l.filter (· != cur)) (cur + 1) hsub' hlen
      have hge := mexAux_ge (l.filter (· != cur)) (cur + 1) f'
      intro hcontra
      apply hnot'
      rw [List.mem_filter]
      refine ⟨hcontra, ?_⟩
      have : mexAux (l.filter (· != cur)) (cur + 1) f' ≠ cur := by omega
      simpa using this
    · rw [if_neg hmem]
      exact hmem

theorem mexAux_lt_mem (l : List Nat) (cur fuel m : Nat)
    (hcur : cur ≤ m) (hlt : m < mexAux l cur fuel) : m ∈ l := by
  induction fuel generalizing cur with
  | zero =>
    simp [mexAux] at hlt
    omega
  | succ f' ih =>
    simp only [mexAux] at hlt
    by_cases hmem : cur ∈ l
    · rw [if_pos hmem] at hlt
      by_cases heq : m = cur
      · subst heq; exact hmem
      · exact ih (cur + 1) (by omega) hlt
    · rw [if_neg hmem] at hlt
      omega

theorem mexList_not_mem (l : List Nat) : mexList l ∉ l :=
  mexAux_not_mem l 0 (l.length + 1) (fun _ _ => Nat.zero_le _) (by omega)

theorem mexList_lt {l : List Nat} {m : Nat} (h : m < mexList l) : m ∈ l :=
  mexAux_lt_mem l 0 (l.length + 1) m (Nat.zero_le _) h

theorem mexList_eq_iff (l : List Nat) (g : Nat) :
    mexList l = g ↔ g ∉ l ∧ ∀ m, m < g → m ∈ l := by
  constructor
  · intro h
    subst h
    exact ⟨mexList_not_mem l, fun _ hm => mexList_lt hm⟩
  · rintro ⟨hnot, hall⟩
    have h1 : ¬(mexList l < g) := fun hlt => mexList_not_mem l (hall _ hlt)
    have h2 : ¬(g < mexList l) := fun hlt => hnot (mexList_lt hlt)
    omega

/-! ## Section 4: Turning Turtles Rules & Exact Sprague–Grundy Theorems -/

/-- `0`-indexed Turning Turtles legal move relation (`Move0 p q`):
    choose a Heads coin at `n ≥ 0` (`p.coeff n = true`), flip it to Tails, and optionally
    flip at most one coin at `0 ≤ i < n`. -/
inductive Move0 (p : PolyF2) : PolyF2 → Prop where
  | flipSingle (n : Nat) (h : p.coeff n = true) :
      Move0 p (p + PolyF2.monomial n)
  | flipPair (n i : Nat) (h : p.coeff n = true) (hi : i < n) :
      Move0 p (p + PolyF2.monomial n + PolyF2.monomial i)

/-- `1`-indexed Turning Turtles legal move relation (`Move1 p q`, *Winning Ways*, Ch. 14):
    choose a Heads coin at `n ≥ 1` (`p.coeff n = true`), flip it to Tails, and optionally
    flip at most one coin at `1 ≤ i < n`. -/
inductive Move1 (p : PolyF2) : PolyF2 → Prop where
  | flipSingle (n : Nat) (hn : 1 ≤ n) (h : p.coeff n = true) :
      Move1 p (p + PolyF2.monomial n)
  | flipPair (n i : Nat) (hi1 : 1 ≤ i) (hin : i < n) (h : p.coeff n = true) :
      Move1 p (p + PolyF2.monomial n + PolyF2.monomial i)

theorem Move0.bits_lt {p q : PolyF2} (hm : Move0 p q) : q.bits < p.bits := by
  cases hm with
  | flipSingle n h =>
    apply lt_of_msb_diff n h
    · change (p + PolyF2.monomial n).coeff n = false
      rw [PolyF2.coeff_add, PolyF2.coeff_monomial, h]
      simp
    · intro j hj
      change (p + PolyF2.monomial n).coeff j = p.coeff j
      rw [PolyF2.coeff_add, PolyF2.coeff_monomial]
      have hne : ¬(n = j) := by omega
      simp [hne]
  | flipPair n i h hi =>
    apply lt_of_msb_diff n h
    · change (p + PolyF2.monomial n + PolyF2.monomial i).coeff n = false
      rw [PolyF2.coeff_add, PolyF2.coeff_add, PolyF2.coeff_monomial, PolyF2.coeff_monomial, h]
      have hne : ¬(i = n) := by omega
      simp [hne]
    · intro j hj
      change (p + PolyF2.monomial n + PolyF2.monomial i).coeff j = p.coeff j
      rw [PolyF2.coeff_add, PolyF2.coeff_add, PolyF2.coeff_monomial, PolyF2.coeff_monomial]
      have hne1 : ¬(n = j) := by omega
      have hne2 : ¬(i = j) := by omega
      simp [hne1, hne2]

theorem Move1.bits_lt {p q : PolyF2} (hm : Move1 p q) : q.bits < p.bits := by
  cases hm with
  | flipSingle n _ h =>
    exact Move0.bits_lt (Move0.flipSingle n h)
  | flipPair n i _ hin h =>
    exact Move0.bits_lt (Move0.flipPair n i h hin)

/-- Computable enumeration of all `0`-indexed Turning Turtles options from `p`. -/
def moves0 (p : PolyF2) : List PolyF2 :=
  (List.range p.bits).flatMap fun n =>
    if p.coeff n then
      (p + PolyF2.monomial n) ::
        (List.range n).map (fun i => p + PolyF2.monomial n + PolyF2.monomial i)
    else []

/-- Computable enumeration of all `1`-indexed Turning Turtles options from `p`. -/
def moves1 (p : PolyF2) : List PolyF2 :=
  (List.range p.bits).flatMap fun n =>
    if decide (1 ≤ n) && p.coeff n then
      (p + PolyF2.monomial n) ::
        ((List.range n).filter (fun i => decide (1 ≤ i))).map
          (fun i => p + PolyF2.monomial n + PolyF2.monomial i)
    else []

theorem coeff_true_lt_bits {p : PolyF2} {n : Nat} (h : p.coeff n = true) : n < p.bits := by
  have h2 : 2 ^ n ≤ p.bits := ge_two_pow_of_testBit h
  have hn : n < 2 ^ n := lt_two_pow_self n
  omega

theorem mem_moves0_iff (p q : PolyF2) : q ∈ moves0 p ↔ Move0 p q := by
  simp only [moves0, List.mem_flatMap, List.mem_range]
  constructor
  · rintro ⟨n, _, hmem⟩
    by_cases hc : p.coeff n = true
    · rw [if_pos hc, List.mem_cons, List.mem_map] at hmem
      rcases hmem with rfl | ⟨i, hi, rfl⟩
      · exact Move0.flipSingle n hc
      · rw [List.mem_range] at hi
        exact Move0.flipPair n i hc hi
    · rw [if_neg hc] at hmem
      contradiction
  · intro hm
    cases hm with
    | flipSingle n hc =>
      refine ⟨n, coeff_true_lt_bits hc, ?_⟩
      rw [if_pos hc]
      exact List.Mem.head _
    | flipPair n i hc hi =>
      refine ⟨n, coeff_true_lt_bits hc, ?_⟩
      rw [if_pos hc, List.mem_cons]
      right
      rw [List.mem_map]
      exact ⟨i, List.mem_range.mpr hi, rfl⟩

theorem mem_moves1_iff (p q : PolyF2) : q ∈ moves1 p ↔ Move1 p q := by
  simp only [moves1, List.mem_flatMap, List.mem_range]
  constructor
  · rintro ⟨n, _, hmem⟩
    by_cases hc : (decide (1 ≤ n) && p.coeff n) = true
    · rw [if_pos hc, List.mem_cons, List.mem_map] at hmem
      simp only [Bool.and_eq_true, decide_eq_true_eq] at hc
      rcases hmem with rfl | ⟨i, hi, rfl⟩
      · exact Move1.flipSingle n hc.1 hc.2
      · rw [List.mem_filter, List.mem_range, decide_eq_true_eq] at hi
        exact Move1.flipPair n i hi.2 hi.1 hc.2
    · rw [if_neg hc] at hmem
      contradiction
  · intro hm
    cases hm with
    | flipSingle n hn hc =>
      refine ⟨n, coeff_true_lt_bits hc, ?_⟩
      have hcond : (decide (1 ≤ n) && p.coeff n) = true := by simp [hn, hc]
      rw [if_pos hcond]
      exact List.Mem.head _
    | flipPair n i hi1 hin hc =>
      refine ⟨n, coeff_true_lt_bits hc, ?_⟩
      have hn1 : 1 ≤ n := by omega
      have hcond : (decide (1 ≤ n) && p.coeff n) = true := by simp [hn1, hc]
      rw [if_pos hcond, List.mem_cons]
      right
      rw [List.mem_map]
      refine ⟨i, ?_, rfl⟩
      rw [List.mem_filter, List.mem_range]
      exact ⟨hin, decide_eq_true hi1⟩

/-- True Sprague–Grundy function of `0`-indexed Turning Turtles, defined directly by
    well-founded recursion via `mex` over all legal game moves. -/
def sg0 (p : PolyF2) : Nat :=
  mexList ((moves0 p).attach.map fun ⟨q, hq⟩ =>
    have : q.bits < p.bits := Move0.bits_lt ((mem_moves0_iff p q).mp hq)
    sg0 q)
termination_by p.bits

/-- True Sprague–Grundy function of `1`-indexed Turning Turtles, defined directly by
    well-founded recursion via `mex` over all legal game moves. -/
def sg1 (p : PolyF2) : Nat :=
  mexList ((moves1 p).attach.map fun ⟨q, hq⟩ =>
    have : q.bits < p.bits := Move1.bits_lt ((mem_moves1_iff p q).mp hq)
    sg1 q)
termination_by p.bits

theorem mem_attach_map_iff {α β : Type} (l : List α) (f : α → β) (v : β) :
    (v ∈ l.attach.map fun ⟨x, _⟩ => f x) ↔ ∃ x, x ∈ l ∧ f x = v := by
  simp only [List.mem_map, List.mem_attach, true_and, Subtype.exists]
  constructor
  · rintro ⟨x, hx, hv⟩; exact ⟨x, hx, hv⟩
  · rintro ⟨x, hx, hv⟩; exact ⟨x, hx, hv⟩

theorem sg0_spec (p : PolyF2) :
    (∀ q, Move0 p q → sg0 q ≠ sg0 p) ∧
    (∀ m, m < sg0 p → ∃ q, Move0 p q ∧ sg0 q = m) := by
  have hdef : sg0 p = mexList ((moves0 p).attach.map fun ⟨q, _⟩ => sg0 q) := by
    conv => lhs; unfold sg0
  have hmem : ∀ v : Nat,
      (v ∈ (moves0 p).attach.map fun ⟨q, _⟩ => sg0 q) ↔ ∃ q, Move0 p q ∧ sg0 q = v := by
    intro v
    rw [mem_attach_map_iff]
    constructor
    · rintro ⟨q, hq, hsg⟩; exact ⟨q, (mem_moves0_iff p q).mp hq, hsg⟩
    · rintro ⟨q, hq, hsg⟩; exact ⟨q, (mem_moves0_iff p q).mpr hq, hsg⟩
  constructor
  · intro q hmq heq
    have hnot := mexList_not_mem ((moves0 p).attach.map fun ⟨q, _⟩ => sg0 q)
    rw [← hdef] at hnot
    exact hnot ((hmem (sg0 p)).mpr ⟨q, hmq, heq⟩)
  · intro m hm
    rw [hdef] at hm
    exact (hmem m).mp (mexList_lt hm)

theorem sg1_spec (p : PolyF2) :
    (∀ q, Move1 p q → sg1 q ≠ sg1 p) ∧
    (∀ m, m < sg1 p → ∃ q, Move1 p q ∧ sg1 q = m) := by
  have hdef : sg1 p = mexList ((moves1 p).attach.map fun ⟨q, _⟩ => sg1 q) := by
    conv => lhs; unfold sg1
  have hmem : ∀ v : Nat,
      (v ∈ (moves1 p).attach.map fun ⟨q, _⟩ => sg1 q) ↔ ∃ q, Move1 p q ∧ sg1 q = v := by
    intro v
    rw [mem_attach_map_iff]
    constructor
    · rintro ⟨q, hq, hsg⟩; exact ⟨q, (mem_moves1_iff p q).mp hq, hsg⟩
    · rintro ⟨q, hq, hsg⟩; exact ⟨q, (mem_moves1_iff p q).mpr hq, hsg⟩
  constructor
  · intro q hmq heq
    have hnot := mexList_not_mem ((moves1 p).attach.map fun ⟨q, _⟩ => sg1 q)
    rw [← hdef] at hnot
    exact hnot ((hmem (sg1 p)).mpr ⟨q, hmq, heq⟩)
  · intro m hm
    rw [hdef] at hm
    exact (hmem m).mp (mexList_lt hm)

/-- Closed-form XOR sum `⨁_{p_k = 1} w(k)` for an arbitrary coin-weight function `w`. -/
def xorWeightAux (w : Nat → Nat) (p : PolyF2) : Nat → Nat
  | 0 => 0
  | m + 1 => xorWeightAux w p m ^^^ (if p.coeff m then w m else 0)

def xorWeight (w : Nat → Nat) (p : PolyF2) : Nat :=
  xorWeightAux w p p.bits

theorem xorWeightAux_stable (w : Nat → Nat) (p : PolyF2) {m N : Nat}
    (hm : p.bits ≤ m) (hN : m ≤ N) :
    xorWeightAux w p N = xorWeightAux w p m := by
  induction N with
  | zero =>
    have : m = 0 := by omega
    subst this; rfl
  | succ n ih =>
    by_cases heq : m = n + 1
    · subst heq; rfl
    · simp only [xorWeightAux]
      have hf : p.coeff n = false := PolyF2.coeff_eq_false_of_le (by omega)
      simp only [hf, Bool.false_eq_true, ↓reduceIte, Nat.xor_zero]
      exact ih (by omega)

theorem xorWeight_eq_aux (w : Nat → Nat) (p : PolyF2) {N : Nat} (hN : p.bits ≤ N) :
    xorWeight w p = xorWeightAux w p N :=
  (xorWeightAux_stable w p (Nat.le_refl p.bits) hN).symm

theorem xorWeight_zero (w : Nat → Nat) : xorWeight w 0 = 0 := rfl

theorem xorWeightAux_add (w : Nat → Nat) (p q : PolyF2) (N : Nat) :
    xorWeightAux w (p + q) N = xorWeightAux w p N ^^^ xorWeightAux w q N := by
  induction N with
  | zero => simp [xorWeightAux]
  | succ n ih =>
    simp only [xorWeightAux, ih, PolyF2.coeff_add]
    have hterm : (if (p.coeff n ^^ q.coeff n) = true then w n else 0) =
        (if p.coeff n = true then w n else 0) ^^^ (if q.coeff n = true then w n else 0) := by
      cases p.coeff n <;> cases q.coeff n <;> simp [Nat.xor_self]
    rw [hterm]
    apply Nat.eq_of_testBit_eq
    intro i
    simp only [Nat.testBit_xor]
    cases ((xorWeightAux w p n).testBit i) <;>
      cases ((xorWeightAux w q n).testBit i) <;>
      cases ((if p.coeff n = true then w n else 0).testBit i) <;>
      cases ((if q.coeff n = true then w n else 0).testBit i) <;> rfl

theorem xorWeight_add (w : Nat → Nat) (p q : PolyF2) :
    xorWeight w (p + q) = xorWeight w p ^^^ xorWeight w q := by
  let N := (p + q).bits + p.bits + q.bits
  rw [xorWeight_eq_aux w (p + q) (N := N) (by omega),
    xorWeight_eq_aux w p (N := N) (by omega),
    xorWeight_eq_aux w q (N := N) (by omega)]
  exact xorWeightAux_add w p q N

theorem xorWeight_monomial (w : Nat → Nat) (n : Nat) :
    xorWeight w (PolyF2.monomial n) = w n := by
  have hN : (PolyF2.monomial n).bits ≤ 2 ^ n + 1 := by
    change 2 ^ n ≤ 2 ^ n + 1
    omega
  have hn : n < 2 ^ n := lt_two_pow_self n
  rw [xorWeight_eq_aux w (PolyF2.monomial n) hN]
  have haux : ∀ m : Nat, xorWeightAux w (PolyF2.monomial n) m = (if n < m then w n else 0) := by
    intro m
    induction m with
    | zero => simp [xorWeightAux]
    | succ k ih =>
      simp only [xorWeightAux, ih, PolyF2.coeff_monomial]
      by_cases heq : n = k
      · subst heq
        simp
      · have hiff : (n < k) ↔ (n < k + 1) := by omega
        by_cases hlt : n < k
        · have hlt2 : n < k + 1 := hiff.mp hlt
          simp [heq, hlt, hlt2]
        · have hlt2 : ¬(n < k + 1) := fun h => hlt (hiff.mpr h)
          simp [heq, hlt, hlt2]
  rw [haux (2 ^ n + 1)]
  have hlt : n < 2 ^ n + 1 := by omega
  simp [hlt]

theorem exists_coeff_of_xorWeight_testBit {w : Nat → Nat} {p : PolyF2} {b : Nat}
    (hb : (xorWeight w p).testBit b = true) :
    ∃ n : Nat, p.coeff n = true ∧ (w n).testBit b = true := by
  have haux : ∀ N : Nat, (xorWeightAux w p N).testBit b = true →
      ∃ n : Nat, p.coeff n = true ∧ (w n).testBit b = true := by
    intro N
    induction N with
    | zero =>
      simp [xorWeightAux]
    | succ k ih =>
      simp only [xorWeightAux, Nat.testBit_xor]
      intro hx
      by_cases hcur : (if p.coeff k = true then w k else 0).testBit b = true
      · by_cases hpk : p.coeff k = true
        · rw [if_pos hpk] at hcur
          exact ⟨k, hpk, hcur⟩
        · rw [if_neg hpk, Nat.zero_testBit] at hcur
          contradiction
      · have hcf : (if p.coeff k = true then w k else 0).testBit b = false :=
          Bool.eq_false_iff.mpr hcur
        rw [hcf, Bool.xor_false] at hx
        exact ih hx
  exact haux p.bits hb

/-- If `idx0` is the unique active index in `p` whose weight `w(idx0)` has bit `r` set,
    then `xorWeight w p` also has bit `r` set. -/
theorem xorWeight_testBit_eq_true_of_unique (w : Nat → Nat) (p : PolyF2) (idx0 r : Nat)
    (hidx0 : p.coeff idx0 = true)
    (hbit0 : (w idx0).testBit r = true)
    (huniq : ∀ idx, p.coeff idx = true → idx ≠ idx0 → (w idx).testBit r = false) :
    (xorWeight w p).testBit r = true := by
  have haux : ∀ N : Nat, (xorWeightAux w p N).testBit r = decide (idx0 < N) := by
    intro N
    induction N with
    | zero => simp [xorWeightAux]
    | succ n ih =>
      simp only [xorWeightAux, Nat.testBit_xor, ih]
      by_cases heq : n = idx0
      · subst heq
        simp [hidx0, hbit0]
      · have hterm : (if p.coeff n = true then w n else 0).testBit r = false := by
          by_cases hpn : p.coeff n = true
          · rw [if_pos hpn]
            exact huniq n hpn heq
          · rw [if_neg hpn]
            exact Nat.zero_testBit r
        rw [hterm, Bool.xor_false]
        by_cases hlt : idx0 < n
        · have hlt2 : idx0 < n + 1 := by omega
          simp [hlt, hlt2]
        · have hlt2 : ¬(idx0 < n + 1) := by omega
          simp [hlt, hlt2]
  unfold xorWeight
  rw [haux p.bits]
  exact decide_eq_true (coeff_true_lt_bits hidx0)

/-- Closed-form XOR formula for `0`-indexed Turning Turtles: `⨁_{p_k = 1} (k + 1)`. -/
def xorSum0 (p : PolyF2) : Nat :=
  xorWeight (fun k => k + 1) p

/-- Closed-form XOR formula for `1`-indexed Turning Turtles: `⨁_{k ≥ 1, p_k = 1} k`. -/
def xorSum1 (p : PolyF2) : Nat :=
  xorWeight (fun k => k) p

/-- **Exact Sprague–Grundy Theorem (`0`-indexed Turning Turtles):**
    For every configuration `p ∈ ℤ₂[x]`, `sg0 p = ⨁_{p_k = 1} (k + 1)`. -/
theorem sg0_eq_xorSum0 (p : PolyF2) : sg0 p = xorSum0 p := by
  have hstrong : ∀ B : Nat, ∀ p : PolyF2, p.bits ≤ B → sg0 p = xorSum0 p := by
    intro B
    induction B with
    | zero =>
      intro p hp
      have hp0 : p = 0 := by
        cases p
        have : _ = 0 := Nat.eq_zero_of_le_zero hp
        subst this; rfl
      subst hp0
      have hspec := (sg0_spec 0).2
      by_cases hgt : 0 < sg0 0
      · obtain ⟨q, hmq, _⟩ := hspec 0 hgt
        cases hmq with
        | flipSingle n hc => simp at hc
        | flipPair n i hc _ => simp at hc
      · have : sg0 0 = 0 := by omega
        exact this
    | succ B' ih =>
      intro p hp
      have hdef : sg0 p = mexList ((moves0 p).attach.map fun ⟨q, _⟩ => sg0 q) := by
        conv => lhs; unfold sg0
      rw [hdef, mexList_eq_iff]
      have hmem : ∀ v : Nat,
          (v ∈ (moves0 p).attach.map fun ⟨q, _⟩ => sg0 q) ↔
            ∃ q, Move0 p q ∧ xorSum0 q = v := by
        intro v
        rw [mem_attach_map_iff]
        constructor
        · rintro ⟨q, hq, rfl⟩
          have hmq := (mem_moves0_iff p q).mp hq
          have hlt := Move0.bits_lt hmq
          exact ⟨q, hmq, (ih q (by omega)).symm⟩
        · rintro ⟨q, hmq, rfl⟩
          have hlt := Move0.bits_lt hmq
          exact ⟨q, (mem_moves0_iff p q).mpr hmq, ih q (by omega)⟩
      constructor
      · intro hcontra
        obtain ⟨q, hmq, heq⟩ := (hmem (xorSum0 p)).mp hcontra
        cases hmq with
        | flipSingle n hc =>
          unfold xorSum0 at heq
          rw [xorWeight_add, xorWeight_monomial] at heq
          have : (xorWeight (fun k => k + 1) p ^^^ (n + 1)) ^^^ xorWeight (fun k => k + 1) p = 0 := by
            rw [heq, Nat.xor_self]
          rw [Nat.xor_comm, xor_cancel_left] at this
          omega
        | flipPair n i hc hi =>
          unfold xorSum0 at heq
          rw [xorWeight_add, xorWeight_add, xorWeight_monomial, xorWeight_monomial,
            Nat.xor_assoc] at heq
          have : (xorWeight (fun k => k + 1) p ^^^ ((n + 1) ^^^ (i + 1))) ^^^
              xorWeight (fun k => k + 1) p = 0 := by
            rw [heq, Nat.xor_self]
          rw [Nat.xor_comm, xor_cancel_left, xor_eq_zero_iff] at this
          omega
      · intro m hm
        rw [hmem]
        obtain ⟨b, hgb, hmb, hhi⟩ := exists_msb_diff hm
        obtain ⟨n, hpn, hnb⟩ := exists_coeff_of_xorWeight_testBit hgb
        have hvlt : ((n + 1) ^^^ (xorSum0 p ^^^ m)) < n + 1 := by
          apply lt_of_msb_diff b hnb
          · rw [Nat.testBit_xor, Nat.testBit_xor, hnb, hgb, hmb]
            rfl
          · intro j hj
            rw [Nat.testBit_xor, Nat.testBit_xor, hhi j hj, Bool.xor_self, Bool.xor_false]
        cases hv : ((n + 1) ^^^ (xorSum0 p ^^^ m)) with
        | zero =>
          have hnd : n + 1 = xorSum0 p ^^^ m := xor_eq_zero_iff.mp hv
          refine ⟨p + PolyF2.monomial n, Move0.flipSingle n hpn, ?_⟩
          change xorWeight (fun k => k + 1) (p + PolyF2.monomial n) = m
          rw [xorWeight_add, xorWeight_monomial]
          change xorSum0 p ^^^ (n + 1) = m
          rw [hnd]
          exact xor_cancel_left (xorSum0 p) m
        | succ i =>
          rw [hv] at hvlt
          have hin : i < n := by omega
          refine ⟨p + PolyF2.monomial n + PolyF2.monomial i, Move0.flipPair n i hpn hin, ?_⟩
          change xorWeight (fun k => k + 1) (p + PolyF2.monomial n + PolyF2.monomial i) = m
          rw [xorWeight_add, xorWeight_add, xorWeight_monomial, xorWeight_monomial]
          change xorSum0 p ^^^ (n + 1) ^^^ (i + 1) = m
          rw [← hv, Nat.xor_assoc, ← Nat.xor_assoc (n + 1), Nat.xor_self, Nat.zero_xor]
          exact xor_cancel_left (xorSum0 p) m
  exact hstrong p.bits p (Nat.le_refl _)

/-- **Exact Sprague–Grundy Theorem (`1`-indexed Turning Turtles):**
    For every configuration `p ∈ ℤ₂[x]`, `sg1 p = ⨁_{k ≥ 1, p_k = 1} k`. -/
theorem sg1_eq_xorSum1 (p : PolyF2) : sg1 p = xorSum1 p := by
  have hstrong : ∀ B : Nat, ∀ p : PolyF2, p.bits ≤ B → sg1 p = xorSum1 p := by
    intro B
    induction B with
    | zero =>
      intro p hp
      have hp0 : p = 0 := by
        cases p
        have : _ = 0 := Nat.eq_zero_of_le_zero hp
        subst this; rfl
      subst hp0
      have hspec := (sg1_spec 0).2
      by_cases hgt : 0 < sg1 0
      · obtain ⟨q, hmq, _⟩ := hspec 0 hgt
        cases hmq with
        | flipSingle n _ hc => simp at hc
        | flipPair n i _ _ hc => simp at hc
      · have : sg1 0 = 0 := by omega
        exact this
    | succ B' ih =>
      intro p hp
      have hdef : sg1 p = mexList ((moves1 p).attach.map fun ⟨q, _⟩ => sg1 q) := by
        conv => lhs; unfold sg1
      rw [hdef, mexList_eq_iff]
      have hmem : ∀ v : Nat,
          (v ∈ (moves1 p).attach.map fun ⟨q, _⟩ => sg1 q) ↔
            ∃ q, Move1 p q ∧ xorSum1 q = v := by
        intro v
        rw [mem_attach_map_iff]
        constructor
        · rintro ⟨q, hq, rfl⟩
          have hmq := (mem_moves1_iff p q).mp hq
          have hlt := Move1.bits_lt hmq
          exact ⟨q, hmq, (ih q (by omega)).symm⟩
        · rintro ⟨q, hmq, rfl⟩
          have hlt := Move1.bits_lt hmq
          exact ⟨q, (mem_moves1_iff p q).mpr hmq, ih q (by omega)⟩
      constructor
      · intro hcontra
        obtain ⟨q, hmq, heq⟩ := (hmem (xorSum1 p)).mp hcontra
        cases hmq with
        | flipSingle n hn hc =>
          unfold xorSum1 at heq
          rw [xorWeight_add, xorWeight_monomial] at heq
          have : (xorWeight (fun k => k) p ^^^ n) ^^^ xorWeight (fun k => k) p = 0 := by
            rw [heq, Nat.xor_self]
          rw [Nat.xor_comm, xor_cancel_left] at this
          omega
        | flipPair n i hi1 hin hc =>
          unfold xorSum1 at heq
          rw [xorWeight_add, xorWeight_add, xorWeight_monomial, xorWeight_monomial,
            Nat.xor_assoc] at heq
          have : (xorWeight (fun k => k) p ^^^ (n ^^^ i)) ^^^
              xorWeight (fun k => k) p = 0 := by
            rw [heq, Nat.xor_self]
          rw [Nat.xor_comm, xor_cancel_left, xor_eq_zero_iff] at this
          omega
      · intro m hm
        rw [hmem]
        obtain ⟨b, hgb, hmb, hhi⟩ := exists_msb_diff hm
        obtain ⟨n, hpn, hnb⟩ := exists_coeff_of_xorWeight_testBit hgb
        have hn1 : 1 ≤ n := by
          by_cases hn0 : n = 0
          · subst hn0
            rw [Nat.zero_testBit] at hnb
            contradiction
          · omega
        have hvlt : (n ^^^ (xorSum1 p ^^^ m)) < n := by
          apply lt_of_msb_diff b hnb
          · rw [Nat.testBit_xor, Nat.testBit_xor, hnb, hgb, hmb]
            rfl
          · intro j hj
            rw [Nat.testBit_xor, Nat.testBit_xor, hhi j hj, Bool.xor_self, Bool.xor_false]
        cases hv : (n ^^^ (xorSum1 p ^^^ m)) with
        | zero =>
          have hnd : n = xorSum1 p ^^^ m := xor_eq_zero_iff.mp hv
          refine ⟨p + PolyF2.monomial n, Move1.flipSingle n hn1 hpn, ?_⟩
          change xorWeight (fun k => k) (p + PolyF2.monomial n) = m
          rw [xorWeight_add, xorWeight_monomial]
          change xorSum1 p ^^^ n = m
          rw [hnd]
          exact xor_cancel_left (xorSum1 p) m
        | succ i' =>
          rw [hv] at hvlt
          refine ⟨p + PolyF2.monomial n + PolyF2.monomial (i' + 1),
            Move1.flipPair n (i' + 1) (by omega) hvlt hpn, ?_⟩
          change xorWeight (fun k => k) (p + PolyF2.monomial n + PolyF2.monomial (i' + 1)) = m
          rw [xorWeight_add, xorWeight_add, xorWeight_monomial, xorWeight_monomial]
          change xorSum1 p ^^^ n ^^^ (i' + 1) = m
          rw [← hv, Nat.xor_assoc, ← Nat.xor_assoc n, Nat.xor_self, Nat.zero_xor]
          exact xor_cancel_left (xorSum1 p) m
  exact hstrong p.bits p (Nat.le_refl _)

theorem sg0_zero : sg0 0 = 0 := sg0_eq_xorSum0 0

theorem sg0_add (p q : PolyF2) : sg0 (p + q) = sg0 p ^^^ sg0 q := by
  rw [sg0_eq_xorSum0, sg0_eq_xorSum0, sg0_eq_xorSum0]
  exact xorWeight_add (fun k => k + 1) p q

theorem sg0_X_pow (n : Nat) : sg0 (PolyF2.X ^ n) = n + 1 := by
  rw [PolyF2.X_pow_eq_monomial, sg0_eq_xorSum0]
  exact xorWeight_monomial (fun k => k + 1) n

theorem sg0_one : sg0 1 = 1 := by
  have h := sg0_X_pow 0
  simpa using h

theorem sg0_X : sg0 PolyF2.X = 2 := by
  change sg0 (PolyF2.monomial 1) = 2
  rw [sg0_eq_xorSum0]
  exact xorWeight_monomial (fun k => k + 1) 1

theorem sg1_zero : sg1 0 = 0 := sg1_eq_xorSum1 0

theorem sg1_add (p q : PolyF2) : sg1 (p + q) = sg1 p ^^^ sg1 q := by
  rw [sg1_eq_xorSum1, sg1_eq_xorSum1, sg1_eq_xorSum1]
  exact xorWeight_add (fun k => k) p q

theorem sg1_X_pow (n : Nat) : sg1 (PolyF2.X ^ n) = n := by
  rw [PolyF2.X_pow_eq_monomial, sg1_eq_xorSum1]
  exact xorWeight_monomial (fun k => k) n

theorem sg1_one : sg1 1 = 0 := sg1_X_pow 0

theorem sg1_X : sg1 PolyF2.X = 1 := by
  change sg1 (PolyF2.monomial 1) = 1
  rw [sg1_eq_xorSum1]
  exact xorWeight_monomial (fun k => k) 1

/-! ## Section 5: Positive Structural Theorems
    (`𝔽₂`-Linearity & Degree-`≤ 2` Coincidence with Conway's Nimber Homomorphism `ev₂`) -/

/-- **Positive Theorem 1 (`0`-indexed):** `sg0` is a surjective `𝔽₂`-linear (additive group)
    homomorphism from `(ℤ₂[x], +, 0)` onto `(ℕ, ⊕, 0)`. -/
theorem sg0_is_F2_linear_surjective :
    sg0 0 = 0 ∧
    (∀ p q : PolyF2, sg0 (p + q) = sg0 p ^^^ sg0 q) ∧
    (∀ g : Nat, ∃ p : PolyF2, sg0 p = g) := by
  refine ⟨sg0_zero, sg0_add, ?_⟩
  intro g
  cases g with
  | zero => exact ⟨0, sg0_zero⟩
  | succ n => exact ⟨PolyF2.X ^ n, sg0_X_pow n⟩

/-- **Positive Theorem 2 (`1`-indexed):** `sg1` is a surjective `𝔽₂`-linear (additive group)
    homomorphism from `(ℤ₂[x], +, 0)` (and already from `x·ℤ₂[x]`) onto `(ℕ, ⊕, 0)`. -/
theorem sg1_is_F2_linear_surjective :
    sg1 0 = 0 ∧
    (∀ p q : PolyF2, sg1 (p + q) = sg1 p ^^^ sg1 q) ∧
    (∀ g : Nat, ∃ p : PolyF2, PolyF2.InPosIdeal p ∧ sg1 p = g) := by
  refine ⟨sg1_zero, sg1_add, ?_⟩
  intro g
  cases g with
  | zero => exact ⟨0, PolyF2.inPosIdeal_zero, sg1_zero⟩
  | succ n =>
    exact ⟨PolyF2.X ^ (n + 1), PolyF2.inPosIdeal_X_pow (by omega), sg1_X_pow (n + 1)⟩

/-- Fuel-indexed structural helper for Conway's nim-multiplication `a ⊗ b`. -/
def nimMulAux : Nat → Nat → Nat → Nat
  | 0, _, _ => 0
  | fuel + 1, a, b =>
    mexList ((List.range a).flatMap fun a' =>
      (List.range b).map fun b' =>
        nimMulAux fuel a' b ^^^ nimMulAux fuel a b' ^^^ nimMulAux fuel a' b')

/-- Conway's nim-multiplication `a ⊗ b` on `ℕ`. -/
def nimMul (a b : Nat) : Nat :=
  nimMulAux (a + b + 1) a b

theorem map_congr_mem {α β : Type} (l : List α) {f g : α → β}
    (h : ∀ x, x ∈ l → f x = g x) : l.map f = l.map g := by
  induction l with
  | nil => rfl
  | cons hd tl ih =>
    simp only [List.map]
    rw [h hd (List.Mem.head _), ih (fun x hx => h x (List.Mem.tail _ hx))]

theorem flatMap_congr_mem {α β : Type} (l : List α) {f g : α → List β}
    (h : ∀ x, x ∈ l → f x = g x) : l.flatMap f = l.flatMap g := by
  induction l with
  | nil => rfl
  | cons hd tl ih =>
    simp only [List.flatMap_cons]
    rw [h hd (List.Mem.head _), ih (fun x hx => h x (List.Mem.tail _ hx))]

theorem nimMulAux_fuel_irrel :
    ∀ f₁ f₂ a b : Nat, a + b < f₁ → a + b < f₂ → nimMulAux f₁ a b = nimMulAux f₂ a b := by
  intro f₁
  induction f₁ with
  | zero => intro _ _ _ h; omega
  | succ n₁ ih =>
    intro f₂ a b h₁ h₂
    cases f₂ with
    | zero => omega
    | succ n₂ =>
      simp only [nimMulAux]
      congr 1
      apply flatMap_congr_mem
      intro a' ha'
      rw [List.mem_range] at ha'
      apply map_congr_mem
      intro b' hb'
      rw [List.mem_range] at hb'
      rw [ih n₂ a' b (by omega) (by omega),
        ih n₂ a b' (by omega) (by omega),
        ih n₂ a' b' (by omega) (by omega)]

/-- Conway's exact recursive `mex` characterization of `nimMul` (`a ⊗ b`) for all `a, b ∈ ℕ`. -/
theorem nimMul_eq_mex (a b : Nat) :
    nimMul a b = mexList ((List.range a).flatMap fun a' =>
      (List.range b).map fun b' =>
        nimMul a' b ^^^ nimMul a b' ^^^ nimMul a' b') := by
  conv => lhs; unfold nimMul; simp only [nimMulAux]
  congr 1
  apply flatMap_congr_mem
  intro a' ha'
  rw [List.mem_range] at ha'
  apply map_congr_mem
  intro b' hb'
  rw [List.mem_range] at hb'
  change nimMulAux (a + b) a' b ^^^ nimMulAux (a + b) a b' ^^^ nimMulAux (a + b) a' b' =
    nimMulAux (a' + b + 1) a' b ^^^ nimMulAux (a + b' + 1) a b' ^^^ nimMulAux (a' + b' + 1) a' b'
  rw [nimMulAux_fuel_irrel (a + b) (a' + b + 1) a' b (by omega) (by omega),
    nimMulAux_fuel_irrel (a + b) (a + b' + 1) a b' (by omega) (by omega),
    nimMulAux_fuel_irrel (a + b) (a' + b' + 1) a' b' (by omega) (by omega)]

/-- Iterated nim-power `a^{\otimes n}` in `(ℕ, ⊕, ⊗)`. -/
def nimPow (a : Nat) : Nat → Nat
  | 0 => 1
  | k + 1 => nimMul (nimPow a k) a

theorem nimMul_zero_left (b : Nat) : nimMul 0 b = 0 := rfl

theorem nimMul_zero_right (a : Nat) : nimMul a 0 = 0 := by
  rw [nimMul_eq_mex]
  have h : ((List.range a).flatMap fun a' =>
      (List.range 0).map fun b' =>
        nimMul a' 0 ^^^ nimMul a b' ^^^ nimMul a' b') = [] := by
    induction List.range a with
    | nil => rfl
    | cons _ tl ih => exact ih
  rw [h]
  rfl

theorem nimMul_one_right_small :
    nimMul 0 1 = 0 ∧ nimMul 1 1 = 1 ∧ nimMul 2 1 = 2 ∧ nimMul 3 1 = 3 := by
  decide

theorem nimMul_two_powers :
    nimPow 2 0 = 1 ∧ nimPow 2 1 = 2 ∧ nimPow 2 2 = 3 ∧ nimPow 2 3 = 1 := by
  decide

/-- Arithmetic on the Fermat subfield `𝔽₄ = {0, 1, 2, 3} ⊂ (ℕ, ⊕, ⊗)`. -/
theorem xor_lt_four {a b : Nat} (ha : a < 4) (hb : b < 4) : (a ^^^ b) < 4 := by
  rcases (by omega : a = 0 ∨ a = 1 ∨ a = 2 ∨ a = 3) with rfl | rfl | rfl | rfl <;>
    rcases (by omega : b = 0 ∨ b = 1 ∨ b = 2 ∨ b = 3) with rfl | rfl | rfl | rfl <;> decide

theorem nimMul_lt_four {a b : Nat} (ha : a < 4) (hb : b < 4) : nimMul a b < 4 := by
  rcases (by omega : a = 0 ∨ a = 1 ∨ a = 2 ∨ a = 3) with rfl | rfl | rfl | rfl <;>
    rcases (by omega : b = 0 ∨ b = 1 ∨ b = 2 ∨ b = 3) with rfl | rfl | rfl | rfl <;> decide

theorem nimMul_f4_assoc {a b c : Nat} (ha : a < 4) (hb : b < 4) (hc : c < 4) :
    nimMul (nimMul a b) c = nimMul a (nimMul b c) := by
  rcases (by omega : a = 0 ∨ a = 1 ∨ a = 2 ∨ a = 3) with rfl | rfl | rfl | rfl <;>
    rcases (by omega : b = 0 ∨ b = 1 ∨ b = 2 ∨ b = 3) with rfl | rfl | rfl | rfl <;>
    rcases (by omega : c = 0 ∨ c = 1 ∨ c = 2 ∨ c = 3) with rfl | rfl | rfl | rfl <;> decide

theorem nimMul_f4_distrib_left {a b c : Nat} (ha : a < 4) (hb : b < 4) (hc : c < 4) :
    nimMul a (b ^^^ c) = nimMul a b ^^^ nimMul a c := by
  rcases (by omega : a = 0 ∨ a = 1 ∨ a = 2 ∨ a = 3) with rfl | rfl | rfl | rfl <;>
    rcases (by omega : b = 0 ∨ b = 1 ∨ b = 2 ∨ b = 3) with rfl | rfl | rfl | rfl <;>
    rcases (by omega : c = 0 ∨ c = 1 ∨ c = 2 ∨ c = 3) with rfl | rfl | rfl | rfl <;> decide

theorem nimMul_f4_distrib_right {a b c : Nat} (ha : a < 4) (hb : b < 4) (hc : c < 4) :
    nimMul (a ^^^ b) c = nimMul a c ^^^ nimMul b c := by
  rcases (by omega : a = 0 ∨ a = 1 ∨ a = 2 ∨ a = 3) with rfl | rfl | rfl | rfl <;>
    rcases (by omega : b = 0 ∨ b = 1 ∨ b = 2 ∨ b = 3) with rfl | rfl | rfl | rfl <;>
    rcases (by omega : c = 0 ∨ c = 1 ∨ c = 2 ∨ c = 3) with rfl | rfl | rfl | rfl <;> decide

theorem nimPow_two_lt_four (k : Nat) : nimPow 2 k < 4 := by
  induction k with
  | zero => decide
  | succ n ih => exact nimMul_lt_four ih (by decide)

theorem nimPow_two_add (i j : Nat) :
    nimPow 2 (i + j) = nimMul (nimPow 2 i) (nimPow 2 j) := by
  induction j with
  | zero =>
    have h1 : nimPow 2 0 = 1 := rfl
    rw [Nat.add_zero, h1]
    have hi := nimPow_two_lt_four i
    rcases (by omega : nimPow 2 i = 0 ∨ nimPow 2 i = 1 ∨ nimPow 2 i = 2 ∨ nimPow 2 i = 3) with
      hv | hv | hv | hv <;> rw [hv] <;> decide
  | succ n ih =>
    have hstep1 : nimPow 2 (i + (n + 1)) = nimMul (nimPow 2 (i + n)) 2 := rfl
    have hstep2 : nimPow 2 (n + 1) = nimMul (nimPow 2 n) 2 := rfl
    rw [hstep1, hstep2, ih]
    exact nimMul_f4_assoc (nimPow_two_lt_four i) (nimPow_two_lt_four n) (by decide)

/-- Evaluation map `ev₂ : ℤ₂[x] → (ℕ, ⊕, ⊗)` sending `x ↦ 2`:
    `ev₂(∑_{k∈S} x^k) = ⨁_{k∈S} 2^{\otimes k}`. -/
def ev2 (p : PolyF2) : Nat :=
  xorWeight (nimPow 2) p

theorem ev2_lt_four (p : PolyF2) : ev2 p < 4 := by
  have haux : ∀ N : Nat, xorWeightAux (nimPow 2) p N < 4 := by
    intro N
    induction N with
    | zero =>
      change 0 < 4
      decide
    | succ n ih =>
      simp only [xorWeightAux]
      apply xor_lt_four ih
      by_cases h : p.coeff n = true
      · rw [if_pos h]; exact nimPow_two_lt_four n
      · rw [if_neg h]; decide
  exact haux p.bits

/-- Predicate asserting that `Φ : ℤ₂[x] → ℕ` is a rng homomorphism into Conway's nimbers
    `(ℕ, ⊕, ⊗)`. -/
def IsNimberRngHom (Φ : PolyF2 → Nat) : Prop :=
  (∀ p q : PolyF2, Φ (p + q) = Φ p ^^^ Φ q) ∧
  (∀ p q : PolyF2, Φ (p * q) = nimMul (Φ p) (Φ q))

/-- Predicate asserting that `Φ : ℤ₂[x] → ℕ` is a unital ring homomorphism into `(ℕ, ⊕, ⊗)`. -/
def IsNimberRingHom (Φ : PolyF2 → Nat) : Prop :=
  Φ 1 = 1 ∧ IsNimberRngHom Φ

theorem ev2_zero : ev2 0 = 0 := rfl

theorem ev2_add (p q : PolyF2) : ev2 (p + q) = ev2 p ^^^ ev2 q :=
  xorWeight_add (nimPow 2) p q

theorem ev2_monomial (n : Nat) : ev2 (PolyF2.monomial n) = nimPow 2 n :=
  xorWeight_monomial (nimPow 2) n

theorem ev2_one : ev2 1 = 1 := by
  change ev2 (PolyF2.monomial 0) = 1
  rw [ev2_monomial]
  rfl

theorem ev2_mul_monomial_left (n : Nat) (q : PolyF2) :
    ev2 (PolyF2.monomial n * q) = nimMul (nimPow 2 n) (ev2 q) := by
  have hdecomp : q = PolyF2.ofCoeff q.bits q.coeff :=
    (PolyF2.ofCoeff_self q (Nat.le_refl _)).symm
  rw [hdecomp]
  generalize q.bits = N
  generalize q.coeff = g
  induction N with
  | zero =>
    simp only [PolyF2.ofCoeff, PolyF2.mul_zero, ev2_zero, nimMul_zero_right]
  | succ m ih =>
    simp only [PolyF2.ofCoeff]
    by_cases hgm : g m = true
    · rw [if_pos hgm, PolyF2.left_distrib, PolyF2.monomial_add_exp, ev2_add, ev2_add,
        ih, ev2_monomial, ev2_monomial, nimPow_two_add]
      exact (nimMul_f4_distrib_left (nimPow_two_lt_four n)
        (ev2_lt_four _) (nimPow_two_lt_four m)).symm
    · rw [if_neg hgm, ih]

/-- **Positive Non-Vacuity Theorem 3:** `ev₂ : ℤ₂[x] → (ℕ, ⊕, ⊗)` is a genuine unital
    ring homomorphism from `ℤ₂[x]` into Conway's nimber field. -/
theorem ev2_is_nimber_ring_hom : IsNimberRingHom ev2 := by
  refine ⟨ev2_one, ev2_add, ?_⟩
  intro p q
  have hdecomp : p = PolyF2.ofCoeff p.bits p.coeff :=
    (PolyF2.ofCoeff_self p (Nat.le_refl _)).symm
  rw [hdecomp]
  generalize p.bits = M
  generalize p.coeff = f
  induction M with
  | zero =>
    simp only [PolyF2.ofCoeff, PolyF2.zero_mul, ev2_zero, nimMul_zero_left]
  | succ m ih =>
    simp only [PolyF2.ofCoeff]
    by_cases hfm : f m = true
    · rw [if_pos hfm, PolyF2.right_distrib, ev2_add, ev2_add, ih,
        ev2_mul_monomial_left, ev2_monomial]
      exact (nimMul_f4_distrib_right (ev2_lt_four _)
        (nimPow_two_lt_four m) (ev2_lt_four q)).symm
    · rw [if_neg hfm, ih]

/-- **Positive Coincidence & Breakdown Theorem 4:**
    On all `8` polynomials `p ∈ ℤ₂[x]` of degree `≤ 2` (`∀ k ≥ 3, [x^k]p = 0`), the
    `0`-indexed Turning Turtles SG function `sg0 p` coincides identically with the nimber
    ring homomorphism `ev₂ p`, and diverges for the first time at `x³` (`4 ≠ 1`). -/
theorem sg0_coincides_with_ev2_deg_le_two_and_breaks_at_three :
    (∀ p : PolyF2, (∀ k : Nat, 3 ≤ k → p.coeff k = false) → sg0 p = ev2 p) ∧
    sg0 (PolyF2.X ^ 3) = 4 ∧
    ev2 (PolyF2.X ^ 3) = 1 ∧
    sg0 (PolyF2.X ^ 3) ≠ ev2 (PolyF2.X ^ 3) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro p hdeg
    have hp3 : p = PolyF2.ofCoeff 3 p.coeff := by
      apply PolyF2.ext
      intro k
      rw [PolyF2.coeff_ofCoeff]
      by_cases hk : k < 3
      · simp [hk]
      · simp [hk, hdeg k (by omega)]
    rw [hp3]
    have h012 : nimPow 2 0 = 1 ∧ nimPow 2 1 = 2 ∧ nimPow 2 2 = 3 :=
      ⟨nimMul_two_powers.1, nimMul_two_powers.2.1, nimMul_two_powers.2.2.1⟩
    simp only [PolyF2.ofCoeff]
    cases p.coeff 0 <;> cases p.coeff 1 <;> cases p.coeff 2 <;>
      simp only [ ↓reduceIte, Bool.false_eq_true, sg0_eq_xorSum0, xorSum0,
        xorWeight_zero, xorWeight_add, xorWeight_monomial,
        ev2_zero, ev2_add, ev2_monomial, h012] <;> decide
  · exact sg0_X_pow 3
  · rw [PolyF2.X_pow_eq_monomial, ev2_monomial]
    exact nimMul_two_powers.2.2.2
  · rw [sg0_X_pow 3, PolyF2.X_pow_eq_monomial, ev2_monomial, nimMul_two_powers.2.2.2]
    decide

/-! ## Section 6: Complete Impossibility Theorems (Disproof of Conjecture 00000001288) -/

/-- **Theorem 5A (Refutation into Conway's Nimbers `(ℕ, ⊕, ⊗)`):**
    Neither `sg0` nor `sg1` is a ring (or even non-unital rng) homomorphism from `ℤ₂[x]`
    into Conway's nimber structure `(ℕ, ⊕, ⊗)`. -/
theorem not_nimber_rng_hom_sg0 : ¬ IsNimberRngHom sg0 := by
  rintro ⟨_, hmul⟩
  have h := hmul PolyF2.X (PolyF2.X ^ 2)
  have hx1 : PolyF2.X * (PolyF2.X ^ 2) = PolyF2.X ^ 3 := by
    rw [PolyF2.mul_comm]
    rfl
  have hsg1 : sg0 PolyF2.X = 2 := sg0_X
  have hsg2 : sg0 (PolyF2.X ^ 2) = 3 := sg0_X_pow 2
  have hsg3 : sg0 (PolyF2.X ^ 3) = 4 := sg0_X_pow 3
  have hnm : nimMul 2 3 = 1 := by decide
  rw [hx1, hsg1, hsg2, hsg3, hnm] at h
  omega

theorem not_nimber_rng_hom_sg1 : ¬ IsNimberRngHom sg1 := by
  rintro ⟨_, hmul⟩
  have h := hmul PolyF2.X PolyF2.X
  have hx2 : PolyF2.X * PolyF2.X = PolyF2.X ^ 2 := by
    change PolyF2.monomial 1 * PolyF2.monomial 1 = PolyF2.X ^ 2
    rw [PolyF2.X_pow_eq_monomial, PolyF2.monomial_add_exp]
  have hsg1 : sg1 PolyF2.X = 1 := sg1_X
  have hsg2 : sg1 (PolyF2.X ^ 2) = 2 := sg1_X_pow 2
  have hnm : nimMul 1 1 = 1 := nimMul_one_right_small.2.1
  rw [hx2, hsg1, hsg2, hnm] at h
  omega

/-- Abstract (not necessarily commutative, not necessarily unital) ring ("rng") structure
    in an arbitrary universe `u`. Every unital ring `Ring R` is in particular a `Rng R`. -/
structure Rng (R : Type u) where
  add : R → R → R
  zero : R
  neg : R → R
  mul : R → R → R
  add_assoc : ∀ a b c, add (add a b) c = add a (add b c)
  zero_add : ∀ a, add zero a = a
  add_zero : ∀ a, add a zero = a
  neg_add_cancel : ∀ a, add (neg a) a = zero
  mul_assoc : ∀ a b c, mul (mul a b) c = mul a (mul b c)
  left_distrib : ∀ a b c, mul a (add b c) = add (mul a b) (mul a c)
  right_distrib : ∀ a b c, mul (add a b) c = add (mul a c) (mul b c)

/-- Abstract unital ring structure extending `Rng R`. -/
structure Ring (R : Type u) extends Rng R where
  one : R
  one_mul : ∀ a, mul one a = a
  mul_one : ∀ a, mul a one = a

theorem Rng.eq_zero_of_add_self {R : Type u} (inst : Rng R) {a : R}
    (h : inst.add a a = a) : a = inst.zero := by
  have h1 : inst.add (inst.neg a) (inst.add a a) = inst.add (inst.neg a) a :=
    congrArg (inst.add (inst.neg a)) h
  rw [← inst.add_assoc, inst.neg_add_cancel, inst.zero_add] at h1
  exact h1

theorem Rng.mul_zero {R : Type u} (inst : Rng R) (r : R) :
    inst.mul r inst.zero = inst.zero := by
  apply inst.eq_zero_of_add_self
  rw [← inst.left_distrib, inst.add_zero]

/-- Rng homomorphism from `ℤ₂[x]` into `(R, +, ·)`. -/
def IsRngHom {R : Type u} (inst : Rng R) (Φ : PolyF2 → R) : Prop :=
  (∀ p q : PolyF2, Φ (p + q) = inst.add (Φ p) (Φ q)) ∧
  (∀ p q : PolyF2, Φ (p * q) = inst.mul (Φ p) (Φ q))

/-- Unital ring homomorphism from `ℤ₂[x]` into `(R, +, ·, 1)`. -/
def IsRingHom {R : Type u} (inst : Ring R) (Φ : PolyF2 → R) : Prop :=
  Φ 1 = inst.one ∧ IsRngHom inst.toRng Φ

/-- Rng homomorphism restricted to the positive-degree sub-rng `x · ℤ₂[x]`. -/
def IsPosIdealRngHom {R : Type u} (inst : Rng R) (Φ : PolyF2 → R) : Prop :=
  (∀ p q : PolyF2, PolyF2.InPosIdeal p → PolyF2.InPosIdeal q →
    Φ (p + q) = inst.add (Φ p) (Φ q)) ∧
  (∀ p q : PolyF2, PolyF2.InPosIdeal p → PolyF2.InPosIdeal q →
    Φ (p * q) = inst.mul (Φ p) (Φ q))

theorem IsRngHom.map_zero {R : Type u} {inst : Rng R} {Φ : PolyF2 → R}
    (hΦ : IsRngHom inst Φ) : Φ 0 = inst.zero := by
  apply inst.eq_zero_of_add_self
  rw [← hΦ.1 0 0, PolyF2.add_zero]

theorem IsPosIdealRngHom.map_zero {R : Type u} {inst : Rng R} {Φ : PolyF2 → R}
    (hΦ : IsPosIdealRngHom inst Φ) : Φ 0 = inst.zero := by
  apply inst.eq_zero_of_add_self
  rw [← hΦ.1 0 0 PolyF2.inPosIdeal_zero PolyF2.inPosIdeal_zero, PolyF2.add_zero]

/-- Explicit kernel-ideal counterexample for `sg0`:
    `f₀ = 1 + x + x²` satisfies `sg0(f₀) = 0`, yet `sg0(x · f₀) = sg0(x + x² + x³) = 5 ≠ 0`. -/
theorem sg0_kernel_not_ideal :
    let f0 : PolyF2 := 1 + PolyF2.X + PolyF2.X ^ 2
    sg0 f0 = 0 ∧ sg0 (PolyF2.X * f0) = 5 := by
  dsimp only
  have h1 : sg0 (1 + PolyF2.X + PolyF2.X ^ 2) = 0 := by
    rw [sg0_add, sg0_add, sg0_one, sg0_X, sg0_X_pow 2]
    decide
  have hprod : PolyF2.X * (1 + PolyF2.X + PolyF2.X ^ 2) =
      PolyF2.X + PolyF2.X ^ 2 + PolyF2.X ^ 3 := by
    rw [PolyF2.left_distrib, PolyF2.left_distrib, PolyF2.mul_one]
    have hx2 : PolyF2.X * PolyF2.X = PolyF2.X ^ 2 := by simp [PolyF2.one_mul]
    have hx3 : PolyF2.X * (PolyF2.X ^ 2) = PolyF2.X ^ 3 := by rw [PolyF2.mul_comm]; rfl
    rw [hx2, hx3]
  have h2 : sg0 (PolyF2.X * (1 + PolyF2.X + PolyF2.X ^ 2)) = 5 := by
    rw [hprod, sg0_add, sg0_add, sg0_X, sg0_X_pow 2, sg0_X_pow 3]
    decide
  exact ⟨h1, h2⟩

/-- Explicit kernel-ideal counterexample for `sg1` inside `x · ℤ₂[x]`:
    `f₁ = x + x² + x³` satisfies `sg1(f₁) = 0`, yet `sg1(x · f₁) = sg1(x² + x³ + x⁴) = 5 ≠ 0`. -/
theorem sg1_kernel_not_ideal :
    let f1 : PolyF2 := PolyF2.X ^ 1 + PolyF2.X ^ 2 + PolyF2.X ^ 3
    PolyF2.InPosIdeal f1 ∧ PolyF2.InPosIdeal (PolyF2.X ^ 1) ∧
    sg1 f1 = 0 ∧ sg1 (PolyF2.X ^ 1 * f1) = 5 := by
  dsimp only
  have hposX : PolyF2.InPosIdeal (PolyF2.X ^ 1) := PolyF2.inPosIdeal_X_pow (by decide)
  have hposF : PolyF2.InPosIdeal (PolyF2.X ^ 1 + PolyF2.X ^ 2 + PolyF2.X ^ 3) :=
    PolyF2.inPosIdeal_add
      (PolyF2.inPosIdeal_add hposX (PolyF2.inPosIdeal_X_pow (by decide)))
      (PolyF2.inPosIdeal_X_pow (by decide))
  have h1 : sg1 (PolyF2.X ^ 1 + PolyF2.X ^ 2 + PolyF2.X ^ 3) = 0 := by
    rw [sg1_add, sg1_add, sg1_X_pow 1, sg1_X_pow 2, sg1_X_pow 3]
    decide
  have hprod : PolyF2.X ^ 1 * (PolyF2.X ^ 1 + PolyF2.X ^ 2 + PolyF2.X ^ 3) =
      PolyF2.X ^ 2 + PolyF2.X ^ 3 + PolyF2.X ^ 4 := by
    rw [PolyF2.left_distrib, PolyF2.left_distrib]
    simp only [PolyF2.X_pow_eq_monomial, PolyF2.monomial_add_exp]
  have h2 : sg1 (PolyF2.X ^ 1 * (PolyF2.X ^ 1 + PolyF2.X ^ 2 + PolyF2.X ^ 3)) = 5 := by
    rw [hprod, sg1_add, sg1_add, sg1_X_pow 2, sg1_X_pow 3, sg1_X_pow 4]
    decide
  exact ⟨hposF, hposX, h1, h2⟩

/-- **Theorem 5B (Universal Ring/Rng Obstruction — `0`-indexed Turning Turtles):**
    For **any** rng `(R, +, ·)` and **any** map `ι : ℕ → R` distinguishing nonzero nimbers
    from `0` (`∀ n, ι n = ι 0 → n = 0`, in particular any injective `ι`), `ι ∘ sg0` cannot
    be a rng homomorphism (hence also cannot be a unital ring homomorphism). -/
theorem no_rng_hom_generates_sg0 {R : Type u} (inst : Rng R) (ι : Nat → R)
    (hι : ∀ n : Nat, ι n = ι 0 → n = 0) :
    ¬ IsRngHom inst (fun p => ι (sg0 p)) := by
  intro hhom
  have hz0 : ι 0 = inst.zero := by
    have hm := hhom.map_zero
    simpa [sg0_zero] using hm
  obtain ⟨hf0, hxf0⟩ := sg0_kernel_not_ideal
  let f0 : PolyF2 := 1 + PolyF2.X + PolyF2.X ^ 2
  have hmul := hhom.2 PolyF2.X f0
  change ι (sg0 (PolyF2.X * f0)) = inst.mul (ι (sg0 PolyF2.X)) (ι (sg0 f0)) at hmul
  rw [hf0, hz0, inst.mul_zero, ← hz0] at hmul
  have hzero : sg0 (PolyF2.X * f0) = 0 := hι _ hmul
  rw [hxf0] at hzero
  omega

/-- **Theorem 5B' (Universal Ring/Rng Obstruction — `1`-indexed Turning Turtles):**
    Even on the positive-degree sub-rng `x · ℤ₂[x]` (and a fortiori on all of `ℤ₂[x]`),
    for **any** rng `(R, +, ·)` and **any** zero-reflecting map `ι : ℕ → R`, `ι ∘ sg1`
    cannot be a rng homomorphism. -/
theorem no_pos_ideal_rng_hom_generates_sg1 {R : Type u} (inst : Rng R) (ι : Nat → R)
    (hι : ∀ n : Nat, ι n = ι 0 → n = 0) :
    ¬ IsPosIdealRngHom inst (fun p => ι (sg1 p)) := by
  intro hhom
  have hz0 : ι 0 = inst.zero := by
    have hm := hhom.map_zero
    simpa [sg1_zero] using hm
  obtain ⟨hposF, hposX, hf1, hxf1⟩ := sg1_kernel_not_ideal
  let f1 : PolyF2 := PolyF2.X ^ 1 + PolyF2.X ^ 2 + PolyF2.X ^ 3
  have hmul := hhom.2 (PolyF2.X ^ 1) f1 hposX hposF
  change ι (sg1 (PolyF2.X ^ 1 * f1)) = inst.mul (ι (sg1 (PolyF2.X ^ 1))) (ι (sg1 f1)) at hmul
  rw [hf1, hz0, inst.mul_zero, ← hz0] at hmul
  have hzero : sg1 (PolyF2.X ^ 1 * f1) = 0 := hι _ hmul
  rw [hxf1] at hzero
  omega

theorem no_rng_hom_generates_sg1 {R : Type u} (inst : Rng R) (ι : Nat → R)
    (hι : ∀ n : Nat, ι n = ι 0 → n = 0) :
    ¬ IsRngHom inst (fun p => ι (sg1 p)) := by
  intro hhom
  apply no_pos_ideal_rng_hom_generates_sg1 inst ι hι
  exact ⟨fun p q _ _ => hhom.1 p q, fun p q _ _ => hhom.2 p q⟩

/-- **Theorem 5C (Zero-Conductor Theorem for `sg0`):**
    No nonzero ideal of `ℤ₂[x]` lies in `ker(sg0)`: for every `m ≠ 0` in `ℤ₂[x]`, there
    exists `k ∈ ℕ` such that `sg0(x^k · m) ≠ 0`. -/
theorem sg0_zero_conductor (m : PolyF2) (hm : m ≠ 0) :
    ∃ k : Nat, sg0 (PolyF2.X ^ k * m) ≠ 0 := by
  have hmbits : m.bits ≠ 0 := by
    intro h0
    apply hm
    cases m
    subst h0
    rfl
  obtain ⟨hd_true, hd_max⟩ := msb_spec hmbits
  let d := msb m.bits
  let r := d + 2
  have hpow : d + 2 < 2 ^ r := lt_two_pow_self (d + 2)
  let k := 2 ^ r - 1 - d
  refine ⟨k, ?_⟩
  have hsum : d + k + 1 = 2 ^ r := by omega
  have hbit : (sg0 (PolyF2.X ^ k * m)).testBit r = true := by
    rw [sg0_eq_xorSum0]
    apply xorWeight_testBit_eq_true_of_unique (fun idx => idx + 1) (PolyF2.X ^ k * m) (d + k) r
    · rw [PolyF2.coeff_X_pow_mul]
      have hle : k ≤ d + k := by omega
      have hsub : d + k - k = d := by omega
      rw [decide_eq_true hle, Bool.true_and, hsub]
      exact hd_true
    · rw [hsum, Nat.testBit_two_pow]
      simp
    · intro idx hidx hne
      rw [PolyF2.coeff_X_pow_mul, Bool.and_eq_true, decide_eq_true_eq] at hidx
      have hle_d : idx - k ≤ d := by
        apply Nat.le_of_not_lt
        intro hgt
        have hf := hd_max (idx - k) hgt
        change m.coeff (idx - k) = false at hf
        rw [hidx.2] at hf
        contradiction
      have hlt_2r : idx + 1 < 2 ^ r := by omega
      exact Nat.testBit_lt_two_pow hlt_2r
  intro hzero
  rw [hzero, Nat.zero_testBit] at hbit
  contradiction

/-- **Theorem 5C' (Zero-Conductor Theorem for `sg1`):**
    For every `m ≠ 0` in `ℤ₂[x]`, there exists `k ≥ 1` such that `sg1(x^k · m) ≠ 0`. -/
theorem sg1_zero_conductor (m : PolyF2) (hm : m ≠ 0) :
    ∃ k : Nat, 1 ≤ k ∧ sg1 (PolyF2.X ^ k * m) ≠ 0 := by
  have hmbits : m.bits ≠ 0 := by
    intro h0
    apply hm
    cases m
    subst h0
    rfl
  obtain ⟨hd_true, hd_max⟩ := msb_spec hmbits
  let d := msb m.bits
  let r := d + 2
  have hpow : d + 2 < 2 ^ r := lt_two_pow_self (d + 2)
  let k := 2 ^ r - d
  refine ⟨k, by omega, ?_⟩
  have hsum : d + k = 2 ^ r := by omega
  have hbit : (sg1 (PolyF2.X ^ k * m)).testBit r = true := by
    rw [sg1_eq_xorSum1]
    apply xorWeight_testBit_eq_true_of_unique (fun idx => idx) (PolyF2.X ^ k * m) (d + k) r
    · rw [PolyF2.coeff_X_pow_mul]
      have hle : k ≤ d + k := by omega
      have hsub : d + k - k = d := by omega
      rw [decide_eq_true hle, Bool.true_and, hsub]
      exact hd_true
    · rw [hsum, Nat.testBit_two_pow]
      simp
    · intro idx hidx hne
      rw [PolyF2.coeff_X_pow_mul, Bool.and_eq_true, decide_eq_true_eq] at hidx
      have hle_d : idx - k ≤ d := by
        apply Nat.le_of_not_lt
        intro hgt
        have hf := hd_max (idx - k) hgt
        change m.coeff (idx - k) = false at hf
        rw [hidx.2] at hf
        contradiction
      have hlt_2r : idx < 2 ^ r := by omega
      exact Nat.testBit_lt_two_pow hlt_2r
  intro hzero
  rw [hzero, Nat.zero_testBit] at hbit
  contradiction

/-- Standard injectivity predicate `∀ x y, f x = f y → x = y`. -/
def Injective {α : Type u} {β : Type v} (f : α → β) : Prop :=
  ∀ ⦃x y : α⦄, f x = f y → x = y

/-- **Factorization Injectivity Theorem (`sg0`):**
    If `sg0` factors as `ψ ∘ Φ` through **any** rng homomorphism `Φ : ℤ₂[x] → R` and
    **any** set map `ψ : R → ℕ` (with no algebraic conditions on `ψ`), then `ker(Φ) = {0}`
    and `Φ` is injective (no nontrivial quotient of `ℤ₂[x]` can compute `sg0`). -/
theorem sg0_factorization_injective {R : Type u} (inst : Rng R) (Φ : PolyF2 → R)
    (hΦ : IsRngHom inst Φ) (ψ : R → Nat) (hfac : ∀ p : PolyF2, sg0 p = ψ (Φ p)) :
    (∀ m : PolyF2, Φ m = inst.zero → m = 0) ∧ Injective Φ := by
  have hker : ∀ m : PolyF2, Φ m = inst.zero → m = 0 := by
    intro m hm0
    by_cases hne : m = 0
    · exact hne
    · obtain ⟨k, hk⟩ := sg0_zero_conductor m hne
      have hmul : Φ (PolyF2.X ^ k * m) = Φ 0 := by
        rw [hΦ.2, hm0, inst.mul_zero, hΦ.map_zero]
      have hsg : sg0 (PolyF2.X ^ k * m) = 0 := by
        rw [hfac, hmul, ← hfac 0, sg0_zero]
      exact absurd hsg hk
  refine ⟨hker, ?_⟩
  intro p q hpq
  have hsum : Φ (p + q) = inst.zero := by
    rw [hΦ.1, hpq, ← hΦ.1 q q, PolyF2.add_self, hΦ.map_zero]
  have hpq0 : p + q = 0 := hker (p + q) hsum
  calc
    p = p + 0 := (PolyF2.add_zero p).symm
    _ = p + (q + q) := by rw [PolyF2.add_self]
    _ = (p + q) + q := (PolyF2.add_assoc p q q).symm
    _ = 0 + q := by rw [hpq0]
    _ = q := PolyF2.zero_add q

/-- **Factorization Injectivity Theorem (`sg1`):**
    If `sg1` factors as `ψ ∘ Φ` through **any** rng homomorphism `Φ : ℤ₂[x] → R` and
    **any** set map `ψ : R → ℕ`, then `ker(Φ) = {0}` and `Φ` is injective. -/
theorem sg1_factorization_injective {R : Type u} (inst : Rng R) (Φ : PolyF2 → R)
    (hΦ : IsRngHom inst Φ) (ψ : R → Nat) (hfac : ∀ p : PolyF2, sg1 p = ψ (Φ p)) :
    (∀ m : PolyF2, Φ m = inst.zero → m = 0) ∧ Injective Φ := by
  have hker : ∀ m : PolyF2, Φ m = inst.zero → m = 0 := by
    intro m hm0
    by_cases hne : m = 0
    · exact hne
    · obtain ⟨k, _, hk⟩ := sg1_zero_conductor m hne
      have hmul : Φ (PolyF2.X ^ k * m) = Φ 0 := by
        rw [hΦ.2, hm0, inst.mul_zero, hΦ.map_zero]
      have hsg : sg1 (PolyF2.X ^ k * m) = 0 := by
        rw [hfac, hmul, ← hfac 0, sg1_zero]
      exact absurd hsg hk
  refine ⟨hker, ?_⟩
  intro p q hpq
  have hsum : Φ (p + q) = inst.zero := by
    rw [hΦ.1, hpq, ← hΦ.1 q q, PolyF2.add_self, hΦ.map_zero]
  have hpq0 : p + q = 0 := hker (p + q) hsum
  calc
    p = p + 0 := (PolyF2.add_zero p).symm
    _ = p + (q + q) := by rw [PolyF2.add_self]
    _ = (p + q) + q := (PolyF2.add_assoc p q q).symm
    _ = 0 + q := by rw [hpq0]
    _ = q := PolyF2.zero_add q

/-- **Algebraic / Non-Injective Ring Homomorphism Impossibility Corollary:**
    Whenever a rng homomorphism `Φ : ℤ₂[x] → R` has a nontrivial kernel (`∃ m ≠ 0, Φ m = 0_R`
    — as holds for **every** homomorphism into a finite ring, a quotient `ℤ₂[x]/(m)`, or an
    algebraic `𝔽₂`-algebra such as Conway's nimber field `𝔽̄₂ = (ℕ, ⊕, ⊗)`), neither `sg0`
    nor `sg1` can even factor through `Φ` via an arbitrary set map `ψ : R → ℕ`. -/
theorem no_nontrivial_kernel_hom_factors_sg {R : Type u} (inst : Rng R) (Φ : PolyF2 → R)
    (hΦ : IsRngHom inst Φ) (hker : ∃ m : PolyF2, m ≠ 0 ∧ Φ m = inst.zero) :
    (¬ ∃ ψ : R → Nat, ∀ p : PolyF2, sg0 p = ψ (Φ p)) ∧
    (¬ ∃ ψ : R → Nat, ∀ p : PolyF2, sg1 p = ψ (Φ p)) := by
  obtain ⟨m, hmne, hm0⟩ := hker
  constructor
  · rintro ⟨ψ, hfac⟩
    exact hmne ((sg0_factorization_injective inst Φ hΦ ψ hfac).1 m hm0)
  · rintro ⟨ψ, hfac⟩
    exact hmne ((sg1_factorization_injective inst Φ hΦ ψ hfac).1 m hm0)

/-- **Theorem 5D (Characteristic-2 Obstruction into `(ℤ, +, ·)`):**
    No unital additive homomorphism `Φ : ℤ₂[x] → ℤ` exists (`0 = Φ(1 + 1) ≠ 2`). -/
theorem no_unital_hom_to_int :
    ¬ ∃ Φ : PolyF2 → Int, Φ 1 = 1 ∧ ∀ p q : PolyF2, Φ (p + q) = Φ p + Φ q := by
  rintro ⟨Φ, h1, hadd⟩
  have h0 : Φ 0 = 0 := by
    have h := hadd 0 0
    rw [PolyF2.add_zero] at h
    omega
  have htwo : Φ (1 + 1) = 2 := by
    rw [hadd, h1]
    rfl
  rw [PolyF2.add_self 1, h0] at htwo
  omega

/-! ## Section 7: Master Resolution Theorem & Axiom Audit -/

/-- **Complete Resolution of Conjecture 00000001288:**
    1. (`sg0` & `sg1` Exact Mex Evaluation): The recursive `mex`-defined Sprague–Grundy
       functions of `0`-indexed and `1`-indexed Turning Turtles satisfy
       `sg0 p = xorSum0 p` (`sg0(x^n) = n + 1`) and `sg1 p = xorSum1 p` (`sg1(x^n) = n`).
    2. (Positive Additive Linearity & Small-Board Trap): Both `sg0` and `sg1` are surjective
       `𝔽₂`-linear homomorphisms `(ℤ₂[x], +) → (ℕ, ⊕)`. Moreover, the unital nimber ring
       homomorphism `ev₂ : ℤ₂[x] → (ℕ, ⊕, ⊗)` (`x ↦ 2`) agrees with `sg0` on all `8`
       polynomials of degree `≤ 2`, failing first at `x³` (`sg0(x³) = 4 ≠ 1 = ev₂(x³)`).
    3. (Refutation as a Polynomial Ring Homomorphism): Neither `sg0` nor `sg1` is a rng
       homomorphism into Conway's nimbers `(ℕ, ⊕, ⊗)`, nor into **any** ring or rng `R`
       under any zero-reflecting encoding `ι : ℕ → R`, nor can either factor through any
       rng homomorphism with nonzero kernel. -/
theorem conjecture_00000001288_resolution :
    (∀ p : PolyF2, sg0 p = xorSum0 p ∧ sg1 p = xorSum1 p) ∧
    (∀ p q : PolyF2, sg0 (p + q) = sg0 p ^^^ sg0 q ∧ sg1 (p + q) = sg1 p ^^^ sg1 q) ∧
    IsNimberRingHom ev2 ∧
    (∀ p : PolyF2, (∀ k : Nat, 3 ≤ k → p.coeff k = false) → sg0 p = ev2 p) ∧
    sg0 (PolyF2.X ^ 3) ≠ ev2 (PolyF2.X ^ 3) ∧
    ¬ IsNimberRngHom sg0 ∧
    ¬ IsNimberRngHom sg1 ∧
    (∀ (R : Type) (inst : Rng R) (ι : Nat → R),
      (∀ n : Nat, ι n = ι 0 → n = 0) →
      ¬ IsRngHom inst (fun p => ι (sg0 p)) ∧
      ¬ IsPosIdealRngHom inst (fun p => ι (sg1 p))) ∧
    (∀ (R : Type) (inst : Rng R) (Φ : PolyF2 → R),
      IsRngHom inst Φ →
      (∀ ψ : R → Nat, (∀ p : PolyF2, sg0 p = ψ (Φ p)) → Injective Φ) ∧
      (∀ ψ : R → Nat, (∀ p : PolyF2, sg1 p = ψ (Φ p)) → Injective Φ)) := by
  refine ⟨fun p => ⟨sg0_eq_xorSum0 p, sg1_eq_xorSum1 p⟩,
    fun p q => ⟨sg0_add p q, sg1_add p q⟩,
    ev2_is_nimber_ring_hom,
    sg0_coincides_with_ev2_deg_le_two_and_breaks_at_three.1,
    sg0_coincides_with_ev2_deg_le_two_and_breaks_at_three.2.2.2,
    not_nimber_rng_hom_sg0,
    not_nimber_rng_hom_sg1,
    fun R inst ι hι => ⟨no_rng_hom_generates_sg0 inst ι hι,
      no_pos_ideal_rng_hom_generates_sg1 inst ι hι⟩,
    fun R inst Φ hΦ =>
      ⟨fun ψ hfac => (sg0_factorization_injective inst Φ hΦ ψ hfac).2,
       fun ψ hfac => (sg1_factorization_injective inst Φ hΦ ψ hfac).2⟩⟩

