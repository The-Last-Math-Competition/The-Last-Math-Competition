def Conjecture302.II : ℝ → Set ℝ :=
fun α => {x | ∃ c, 0 < c ∧ ∀ (p : ℤ) (q : ℕ), 0 < q → c / ↑q ^ (2 + α) < |x - ↑p / ↑q|}
@Conjecture302.mem_II_of_not_liouvilleWith : ∀ {α x : ℝ},
  0 < α → Irrational x → ¬LiouvilleWith (2 + α) x → x ∈ Conjecture302.II α
Conjecture302.ae_irrational : ∀ᵐ (x : ℝ), Irrational x
@Conjecture302.ae_mem_II : ∀ {α : ℝ}, 0 < α → ∀ᵐ (x : ℝ), x ∈ Conjecture302.II α
@Conjecture302.dimH_eq_one_of_ae_mem : ∀ {s : Set ℝ}, (∀ᵐ (x : ℝ), x ∈ s) → dimH s = 1
@Conjecture302.dimH_II : ∀ {α : ℝ}, 0 < α → dimH (Conjecture302.II α) = 1
@Conjecture302.dimH_inter_II : ∀ {α β : ℝ}, 0 < α → 0 < β → dimH (Conjecture302.II α ∩ Conjecture302.II β) = 1
Conjecture302.conjecture : dimH (Conjecture302.II (1 / 3) ∩ Conjecture302.II (1 / 2)) = dimH (Conjecture302.II (1 / 2))
'Conjecture302.mem_II_of_not_liouvilleWith' depends on axioms: [propext, Classical.choice, Quot.sound]
'Conjecture302.ae_irrational' depends on axioms: [propext, Classical.choice, Quot.sound]
'Conjecture302.ae_mem_II' depends on axioms: [propext, Classical.choice, Quot.sound]
'Conjecture302.dimH_eq_one_of_ae_mem' depends on axioms: [propext, Classical.choice, Quot.sound]
'Conjecture302.dimH_II' depends on axioms: [propext, Classical.choice, Quot.sound]
'Conjecture302.dimH_inter_II' depends on axioms: [propext, Classical.choice, Quot.sound]
'Conjecture302.conjecture' depends on axioms: [propext, Classical.choice, Quot.sound]
