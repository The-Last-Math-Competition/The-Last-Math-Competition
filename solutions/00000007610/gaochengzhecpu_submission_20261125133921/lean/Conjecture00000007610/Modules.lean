/-
  Conjecture 00000007610 — Genuine Modules, Submodules, Simple Modules,
  Irreducible-Representation Spectrum, and Classification for M_2(K) and Field Extensions
-/

import Conjecture00000007610.Algebra

namespace Conjecture00000007610

universe u v w z

/-! ### Part 1: Left A-Modules, Submodules, Simple Modules, and Module Isomorphisms -/

/-- Left action carrier class without ring parameter on projections. -/
class LAct (A : Type u) (M : Type v) where
  act : A → M → M

/-- Genuine left module over a unital ring A. -/
class LeftModule (A : Type u) [UnitalRing A] (M : Type v)
    extends AddCommGrp M, LAct A M where
  one_act : ∀ m : M, act 1 m = m
  mul_act : ∀ a b : A, ∀ m : M, act (a * b) m = act a (act b m)
  act_zero : ∀ a : A, act a 0 = 0
  act_add : ∀ a : A, ∀ m1 m2 : M, act a (m1 + m2) = act a m1 + act a m2
  add_act : ∀ a b : A, ∀ m : M, act (a + b) m = act a m + act b m
  zero_act : ∀ m : M, act 0 m = 0

theorem act_neg_mod {A : Type u} [UnitalRing A] {M : Type v} [LeftModule A M]
    (a : A) (m : M) : LAct.act a (-m) = -(LAct.act a m) := by
  symm
  apply neg_eq_of_add_eq_zero
  rw [← LeftModule.act_add, add_neg_cancel_grp, LeftModule.act_zero]

theorem neg_act_mod {A : Type u} [UnitalRing A] {M : Type v} [LeftModule A M]
    (a : A) (m : M) : LAct.act (-a) m = -(LAct.act a m) := by
  symm
  apply neg_eq_of_add_eq_zero
  rw [← LeftModule.add_act, add_neg_cancel_grp, LeftModule.zero_act]

/-- Left module over a K-algebra A with compatible K-vector space action. -/
class KModule (K : Type u) [FieldStructure K] (A : Type v) [KAlgebra K A] (M : Type w)
    extends KVectorSpace K M, LeftModule A M where
  smul_act : ∀ c : K, ∀ a : A, ∀ m : M,
    LAct.act (KSMul.smul c a) m = KSMul.smul c (LAct.act a m)

/-- Every left A-module over a K-algebra A canonically carries a compatible K-vector space
    structure via c • m := (c • 1_A) • m. -/
def kModuleOfLeftModule (K : Type u) [FieldStructure K] (A : Type v) [KAlgebra K A]
    (M : Type w) [LeftModule A M] : KModule K A M where
  smul c m := LAct.act (algebraMap K c) m
  one_smul m := by
    unfold algebraMap
    rw [KAlgebra.one_smul, LeftModule.one_act]
  mul_smul a b m := by
    unfold algebraMap
    have hmul : KSMul.smul (a * b) (1 : A) =
        KSMul.smul a (1 : A) * KSMul.smul b (1 : A) := by
      rw [KAlgebra.smul_mul_assoc, KAlgebra.mul_smul_comm, UnitalRing.one_mul, KAlgebra.mul_smul]
    rw [hmul, LeftModule.mul_act]
  smul_zero a := LeftModule.act_zero _
  smul_add a v w := LeftModule.act_add _ v w
  add_smul a b v := by
    unfold algebraMap
    rw [KAlgebra.add_smul, LeftModule.add_act]
  zero_smul v := by
    unfold algebraMap
    rw [KAlgebra.zero_smul, LeftModule.zero_act]
  smul_act c a m := by
    unfold algebraMap
    have hca : KSMul.smul c a = KSMul.smul c (1 : A) * a := by
      rw [KAlgebra.smul_mul_assoc, UnitalRing.one_mul]
    conv => lhs; rw [hca]
    exact LeftModule.mul_act _ a m

/-- Genuine A-submodule of M: additive subgroup closed under left A-action. -/
structure Submodule (A : Type u) [UnitalRing A] (M : Type v) [LeftModule A M] where
  carrier : M → Prop
  zero_mem : carrier 0
  add_mem : ∀ {m1 m2 : M}, carrier m1 → carrier m2 → carrier (m1 + m2)
  act_mem : ∀ (a : A) {m : M}, carrier m → carrier (LAct.act a m)

/-- Genuine simple (irreducible) left A-module:
    M ≠ {0} and every A-submodule N ⊆ M is either {0} or M. -/
structure IsSimpleModule (A : Type u) [UnitalRing A] (M : Type v) [LeftModule A M] : Prop where
  nontrivial : ∃ m : M, m ≠ 0
  eq_bot_or_top : ∀ N : Submodule A M, (∀ m : M, N.carrier m → m = 0) ∨ (∀ m : M, N.carrier m)

/-- Cyclic submodule A • m0 generated by m0 ∈ M. -/
def cyclicSubmodule (A : Type u) [UnitalRing A] {M : Type v} [LeftModule A M] (m0 : M) :
    Submodule A M where
  carrier x := ∃ a : A, LAct.act a m0 = x
  zero_mem := ⟨0, LeftModule.zero_act m0⟩
  add_mem := by
    intro x y ⟨a, ha⟩ ⟨b, hb⟩
    exact ⟨a + b, by rw [LeftModule.add_act, ha, hb]⟩
  act_mem := by
    intro c x ⟨a, ha⟩
    exact ⟨c * a, by rw [LeftModule.mul_act, ha]⟩

/-- Criterion: if M ≠ {0} and every nonzero m0 ∈ M generates M (∀ x, ∃ a, a • m0 = x),
    then M is simple. -/
theorem isSimple_of_cyclic (A : Type u) [UnitalRing A] {M : Type v} [LeftModule A M]
    (hne : ∃ m : M, m ≠ 0)
    (hgen : ∀ m0 : M, m0 ≠ 0 → ∀ x : M, ∃ a : A, LAct.act a m0 = x) :
    IsSimpleModule A M where
  nontrivial := hne
  eq_bot_or_top N := by
    by_cases hbot : ∀ m : M, N.carrier m → m = 0
    · exact Or.inl hbot
    · apply Or.inr
      have hex : ∃ m0 : M, N.carrier m0 ∧ m0 ≠ 0 := by
        apply Classical.byContradiction
        intro hno
        apply hbot
        intro m hm
        apply Classical.byContradiction
        intro hm0
        exact hno ⟨m, hm, hm0⟩
      rcases hex with ⟨m0, hm0_in, hm0_ne⟩
      intro x
      rcases hgen m0 hm0_ne x with ⟨a, rfl⟩
      exact N.act_mem a hm0_in

/-- Converse: in any simple left A-module M, every nonzero element m0 generates M. -/
theorem simple_generates {A : Type u} [UnitalRing A] {M : Type v} [LeftModule A M]
    (hS : IsSimpleModule A M) {m0 : M} (hm0 : m0 ≠ 0) (x : M) :
    ∃ a : A, LAct.act a m0 = x := by
  let N := cyclicSubmodule A m0
  have hm0_mem : N.carrier m0 := ⟨1, LeftModule.one_act m0⟩
  cases hS.eq_bot_or_top N with
  | inl hbot =>
    exfalso
    exact hm0 (hbot m0 hm0_mem)
  | inr htop =>
    exact htop x

/-- Genuine left A-module homomorphism. -/
structure ModuleHom (A : Type u) [UnitalRing A]
    (M1 : Type v) (M2 : Type w) [LeftModule A M1] [LeftModule A M2] where
  toFun : M1 → M2
  map_add : ∀ x y : M1, toFun (x + y) = toFun x + toFun y
  map_act : ∀ a : A, ∀ x : M1, toFun (LAct.act a x) = LAct.act a (toFun x)

theorem ModuleHom.map_zero {A : Type u} [UnitalRing A]
    {M1 : Type v} {M2 : Type w} [LeftModule A M1] [LeftModule A M2]
    (f : ModuleHom A M1 M2) : f.toFun 0 = 0 := by
  calc
    f.toFun 0 = f.toFun (LAct.act (0 : A) 0) := by rw [LeftModule.zero_act]
    _ = LAct.act (0 : A) (f.toFun 0) := f.map_act 0 0
    _ = 0 := LeftModule.zero_act _

/-- Image of a ModuleHom is a genuine A-submodule of the codomain. -/
def ModuleHom.rangeSubmodule {A : Type u} [UnitalRing A]
    {M1 : Type v} {M2 : Type w} [LeftModule A M1] [LeftModule A M2]
    (f : ModuleHom A M1 M2) : Submodule A M2 where
  carrier y := ∃ x : M1, f.toFun x = y
  zero_mem := ⟨0, f.map_zero⟩
  add_mem := by
    intro y1 y2 ⟨x1, hx1⟩ ⟨x2, hx2⟩
    exact ⟨x1 + x2, by rw [f.map_add, hx1, hx2]⟩
  act_mem := by
    intro a y ⟨x, hx⟩
    exact ⟨LAct.act a x, by rw [f.map_act, hx]⟩

/-- Genuine bijective left A-module isomorphism. -/
structure ModuleIso (A : Type u) [UnitalRing A]
    (M1 : Type v) (M2 : Type w) [LeftModule A M1] [LeftModule A M2]
    extends ModuleHom A M1 M2 where
  invFun : M2 → M1
  left_inv : ∀ x : M1, invFun (toFun x) = x
  right_inv : ∀ y : M2, toFun (invFun y) = y

def ModuleIso.refl (A : Type u) [UnitalRing A] (M : Type v) [LeftModule A M] :
    ModuleIso A M M where
  toFun x := x
  invFun x := x
  map_add _ _ := rfl
  map_act _ _ := rfl
  left_inv _ := rfl
  right_inv _ := rfl

def ModuleIso.symm {A : Type u} [UnitalRing A]
    {M1 : Type v} {M2 : Type w} [LeftModule A M1] [LeftModule A M2]
    (e : ModuleIso A M1 M2) : ModuleIso A M2 M1 where
  toFun := e.invFun
  invFun := e.toFun
  map_add y1 y2 := by
    calc
      e.invFun (y1 + y2) = e.invFun (e.toFun (e.invFun y1) + e.toFun (e.invFun y2)) := by
        rw [e.right_inv y1, e.right_inv y2]
      _ = e.invFun (e.toFun (e.invFun y1 + e.invFun y2)) := by rw [← e.map_add]
      _ = e.invFun y1 + e.invFun y2 := e.left_inv _
  map_act a y := by
    calc
      e.invFun (LAct.act a y) = e.invFun (LAct.act a (e.toFun (e.invFun y))) := by
        rw [e.right_inv y]
      _ = e.invFun (e.toFun (LAct.act a (e.invFun y))) := by rw [← e.map_act]
      _ = LAct.act a (e.invFun y) := e.left_inv _
  left_inv := e.right_inv
  right_inv := e.left_inv

def ModuleIso.trans {A : Type u} [UnitalRing A]
    {M1 : Type u} {M2 : Type v} {M3 : Type w}
    [LeftModule A M1] [LeftModule A M2] [LeftModule A M3]
    (e1 : ModuleIso A M1 M2) (e2 : ModuleIso A M2 M3) : ModuleIso A M1 M3 where
  toFun x := e2.toFun (e1.toFun x)
  invFun z := e1.invFun (e2.invFun z)
  map_add x y := by rw [e1.map_add, e2.map_add]
  map_act a x := by rw [e1.map_act, e2.map_act]
  left_inv x := by rw [e2.left_inv, e1.left_inv]
  right_inv z := by rw [e1.right_inv, e2.right_inv]

/-- Every A-module isomorphism between compatible K-modules is automatically K-linear. -/
def ModuleIso.toKLinearIso (K : Type u) [FieldStructure K]
    {A : Type v} [KAlgebra K A]
    {M1 : Type w} {M2 : Type z} [KModule K A M1] [KModule K A M2]
    (e : ModuleIso A M1 M2) : KLinearIso K M1 M2 where
  toFun := e.toFun
  invFun := e.invFun
  map_add := e.map_add
  map_smul c m := by
    calc
      e.toFun (KSMul.smul c m)
        = e.toFun (KSMul.smul c (LAct.act (1 : A) m)) := by rw [LeftModule.one_act]
      _ = e.toFun (LAct.act (KSMul.smul c (1 : A)) m) := by rw [← KModule.smul_act]
      _ = LAct.act (KSMul.smul c (1 : A)) (e.toFun m) := e.map_act _ m
      _ = KSMul.smul c (LAct.act (1 : A) (e.toFun m)) := KModule.smul_act c 1 _
      _ = KSMul.smul c (e.toFun m) := by rw [LeftModule.one_act]
  left_inv := e.left_inv
  right_inv := e.right_inv

/-! ### Part 2: Genuine Irreducible-Representation Spectrum Predicate `(1; [m])` -/

/-- `HasUniqueSimpleModuleOfDim K A m` asserts the full irreducible-representation spectrum
    `Spec_rep^K(A) = (1; [m])`:
    1. There exists a concrete simple K-A-module `Model` of exact K-dimension `m`, AND
    2. EVERY simple left A-module `M` (in the universe) is A-linearly isomorphic to `Model`
       (so there is exactly ONE isomorphism class of simple A-modules, and every simple
       K-A-module automatically has exact K-dimension `m`). -/
structure HasUniqueSimpleModuleOfDim (K : Type u) [FieldStructure K]
    (A : Type u) [KAlgebra K A] (m : Nat) : Prop where
  exists_model :
    ∃ (Model : Type u) (_ : KModule K A Model),
      IsSimpleModule A Model ∧
      HasKDim K Model m ∧
      (∀ (M : Type u) [LeftModule A M], IsSimpleModule A M → Nonempty (ModuleIso A Model M))

/-- Consequence 1: Any two simple A-modules M1, M2 are A-linearly isomorphic. -/
theorem HasUniqueSimpleModuleOfDim.all_simple_iso
    {K : Type u} [FieldStructure K] {A : Type u} [KAlgebra K A] {m : Nat}
    (h : HasUniqueSimpleModuleOfDim K A m)
    (M1 M2 : Type u) [LeftModule A M1] [LeftModule A M2]
    (h1 : IsSimpleModule A M1) (h2 : IsSimpleModule A M2) :
    Nonempty (ModuleIso A M1 M2) := by
  rcases h.exists_model with ⟨Model, _, _, _, huniq⟩
  rcases huniq M1 h1 with ⟨e1⟩
  rcases huniq M2 h2 with ⟨e2⟩
  exact ⟨ModuleIso.trans e1.symm e2⟩

/-- Consequence 2: Every simple K-A-module M automatically has exact K-dimension `m`. -/
theorem HasUniqueSimpleModuleOfDim.every_simple_hasDim
    {K : Type u} [FieldStructure K] {A : Type u} [KAlgebra K A] {m : Nat}
    (h : HasUniqueSimpleModuleOfDim K A m)
    (M : Type u) [KModule K A M] (hM : IsSimpleModule A M) :
    HasKDim K M m := by
  rcases h.exists_model with ⟨Model, instModel, _, ⟨eDim⟩, huniq⟩
  let _ := instModel
  rcases huniq M hM with ⟨eMod⟩
  exact ⟨KLinearIso.trans eDim (eMod.toKLinearIso K)⟩

/-! ### Part 3: Transport of Representation Spectrum Along K-Algebra Isomorphisms -/

/-- Pullback of a LeftModule B M along a RingHom A → B. -/
def pullbackLeftModule {A : Type u} {B : Type v} [UnitalRing A] [UnitalRing B]
    (f : RingHom A B) (M : Type w) [LeftModule B M] : LeftModule A M where
  act a m := LAct.act (f.toFun a) m
  one_act m := by rw [f.map_one, LeftModule.one_act]
  mul_act a b m := by rw [f.map_mul, LeftModule.mul_act]
  act_zero a := LeftModule.act_zero (f.toFun a)
  act_add a m1 m2 := LeftModule.act_add (f.toFun a) m1 m2
  add_act a b m := by rw [f.map_add, LeftModule.add_act]
  zero_act m := by rw [f.map_zero, LeftModule.zero_act]

/-- Transport of `HasUniqueSimpleModuleOfDim` along any K-algebra isomorphism `A ≃ₐ[K] B`. -/
theorem HasUniqueSimpleModuleOfDim.ofAlgIso
    {K : Type u} [FieldStructure K] {A B : Type u} [KAlgebra K A] [KAlgebra K B] {m : Nat}
    (e : AlgIso K A B) (hB : HasUniqueSimpleModuleOfDim K B m) :
    HasUniqueSimpleModuleOfDim K A m := by
  rcases hB.exists_model with ⟨Model, instB, hSimpleB, hDimB, hUniqB⟩
  let _ : KModule K B Model := instB
  -- Pull Model back along e : A → B
  let instA : KModule K A Model := {
    toKVectorSpace := instB.toKVectorSpace
    act := fun a x => LAct.act (e.toFun a) x
    one_act := fun x => by rw [e.map_one, LeftModule.one_act]
    mul_act := fun a1 a2 x => by rw [e.map_mul, LeftModule.mul_act]
    act_zero := fun a => LeftModule.act_zero (e.toFun a)
    act_add := fun a x1 x2 => LeftModule.act_add (e.toFun a) x1 x2
    add_act := fun a1 a2 x => by rw [e.map_add, LeftModule.add_act]
    zero_act := fun x => by rw [e.map_zero, LeftModule.zero_act]
    smul_act := fun c a x => by rw [e.map_smul, KModule.smul_act]
  }
  refine ⟨⟨Model, instA, ?_, hDimB, ?_⟩⟩
  · -- Prove Model is simple as an A-module
    let _ : KModule K A Model := instA
    refine ⟨hSimpleB.nontrivial, fun N => ?_⟩
    let NB : Submodule B Model := {
      carrier := N.carrier
      zero_mem := N.zero_mem
      add_mem := N.add_mem
      act_mem := fun b {x} hx => by
        have hact : LAct.act b x = @LAct.act A Model ⟨fun a y => LAct.act (e.toFun a) y⟩ (e.invFun b) x := by
          change LAct.act b x = LAct.act (e.toFun (e.invFun b)) x
          rw [e.right_inv]
        rw [hact]
        exact N.act_mem (e.invFun b) hx
    }
    exact hSimpleB.eq_bot_or_top NB
  · -- Prove every simple A-module M is A-isomorphic to Model
    intro M instMA hSimpleA
    let instMB : LeftModule B M := pullbackLeftModule e.symm.toRingHom M
    have hSimpleMB : @IsSimpleModule B _ M instMB := by
      refine ⟨hSimpleA.nontrivial, fun NB => ?_⟩
      let NA : @Submodule A _ M instMA := {
        carrier := NB.carrier
        zero_mem := NB.zero_mem
        add_mem := NB.add_mem
        act_mem := fun a {x} hx => by
          have ha : @LAct.act A M instMA.toLAct a x =
              @LAct.act B M instMB.toLAct (e.toFun a) x := by
            change @LAct.act A M instMA.toLAct a x =
              @LAct.act A M instMA.toLAct (e.invFun (e.toFun a)) x
            rw [e.left_inv]
          rw [ha]
          exact NB.act_mem (e.toFun a) hx
      }
      exact hSimpleA.eq_bot_or_top NA
    rcases @hUniqB M instMB hSimpleMB with ⟨isoB⟩
    let _ : KModule K A Model := instA
    exact ⟨{
      toFun := isoB.toFun
      invFun := isoB.invFun
      map_add := isoB.map_add
      map_act := fun a x => by
        have hstep := isoB.map_act (e.toFun a) x
        change isoB.toFun (LAct.act (e.toFun a) x) =
          @LAct.act A M instMA.toLAct (e.invFun (e.toFun a)) (isoB.toFun x) at hstep
        rw [e.left_inv] at hstep
        exact hstep
      left_inv := isoB.left_inv
      right_inv := isoB.right_inv
    }⟩

/-! ### Part 4: Simple Module Classification for Fields -/

/-- Every unital ring R is canonically a left R-module over itself (regular module). -/
instance regularLeftModule (R : Type u) [UnitalRing R] : LeftModule R R where
  act a x := a * x
  one_act := UnitalRing.one_mul
  mul_act := UnitalRing.mul_assoc
  act_zero := mul_zero_ring
  act_add := UnitalRing.left_distrib
  add_act := UnitalRing.right_distrib
  zero_act := zero_mul_ring

/-- Every K-algebra A is canonically a left K-A-module over itself (regular module). -/
instance regularKModule (K : Type u) [FieldStructure K] (A : Type v) [KAlgebra K A] :
    KModule K A A where
  smul_act := KAlgebra.smul_mul_assoc

/-- Every field L is simple as a regular left L-module, and EVERY simple left L-module M
    is L-linearly isomorphic to L! -/
theorem field_simple_module_unique (L : Type u) [FieldStructure L] :
    IsSimpleModule L L ∧
    (∀ (M : Type u) [LeftModule L M], IsSimpleModule L M → Nonempty (ModuleIso L L M)) := by
  constructor
  · apply isSimple_of_cyclic L ⟨1, one_ne_zero_field⟩
    intro z0 hz0 x
    refine ⟨x * FieldStructure.inv z0, ?_⟩
    change (x * FieldStructure.inv z0) * z0 = x
    rw [UnitalRing.mul_assoc, inv_mul_cancel_field hz0, UnitalRing.mul_one]
  · intro M _ hSimpleM
    rcases hSimpleM.nontrivial with ⟨m0, hm0⟩
    let phi : ModuleHom L L M := {
      toFun := fun z => LAct.act z m0
      map_add := fun z1 z2 => LeftModule.add_act z1 z2 m0
      map_act := fun a z => LeftModule.mul_act a z m0
    }
    have hsurj : ∀ y : M, ∃ z : L, phi.toFun z = y := by
      cases hSimpleM.eq_bot_or_top phi.rangeSubmodule with
      | inl hbot =>
        exfalso
        have hm0_in : phi.rangeSubmodule.carrier m0 := ⟨1, LeftModule.one_act m0⟩
        exact hm0 (hbot m0 hm0_in)
      | inr htop =>
        exact htop
    have hinj : ∀ z1 z2 : L, phi.toFun z1 = phi.toFun z2 → z1 = z2 := by
      intro z1 z2 heq
      have hdiff : LAct.act (z1 + -z2) m0 = 0 := by
        rw [LeftModule.add_act, neg_act_mod]
        change phi.toFun z1 + -(phi.toFun z2) = 0
        rw [heq, add_neg_cancel_grp]
      by_cases hz : z1 + -z2 = 0
      · have hneg : -z1 = -z2 := neg_eq_of_add_eq_zero hz
        calc
          z1 = -(-z1) := (neg_neg_grp z1).symm
          _ = -(-z2) := by rw [hneg]
          _ = z2 := neg_neg_grp z2
      · exfalso
        have hm0_zero : m0 = 0 := by
          calc
            m0 = LAct.act (1 : L) m0 := (LeftModule.one_act m0).symm
            _ = LAct.act (FieldStructure.inv (z1 + -z2) * (z1 + -z2)) m0 := by
              rw [inv_mul_cancel_field hz]
            _ = LAct.act (FieldStructure.inv (z1 + -z2)) (LAct.act (z1 + -z2) m0) :=
              LeftModule.mul_act _ _ m0
            _ = LAct.act (FieldStructure.inv (z1 + -z2)) 0 := by rw [hdiff]
            _ = 0 := LeftModule.act_zero _
        exact hm0 hm0_zero
    let invF : M → L := fun y => Classical.choose (hsurj y)
    have hinv_spec : ∀ y : M, phi.toFun (invF y) = y :=
      fun y => Classical.choose_spec (hsurj y)
    exact ⟨{
      toModuleHom := phi
      invFun := invF
      left_inv := fun z => hinj (invF (phi.toFun z)) z (hinv_spec (phi.toFun z))
      right_inv := hinv_spec
    }⟩

/-! ### Part 5: 2×2 Matrix Algebra `Mat2 K`, Its Center `K`, and Unique Simple Module `K^2` -/

/-- Explicit 2×2 matrix algebra M_2(K). -/
structure Mat2 (K : Type u) where
  m11 : K
  m12 : K
  m21 : K
  m22 : K

theorem Mat2.ext {K : Type u} {A B : Mat2 K}
    (h11 : A.m11 = B.m11) (h12 : A.m12 = B.m12)
    (h21 : A.m21 = B.m21) (h22 : A.m22 = B.m22) : A = B := by
  cases A
  cases B
  cases h11; cases h12; cases h21; cases h22
  rfl

section Mat2Theory

variable {K : Type u} [FieldStructure K]

private theorem add_four_k (a b c d : K) : (a + b) + (c + d) = (a + c) + (b + d) := by
  rw [AddCommGrp.add_assoc a b, ← AddCommGrp.add_assoc b c d,
      AddCommGrp.add_comm b c, AddCommGrp.add_assoc c b d, ← AddCommGrp.add_assoc a c]

private theorem mat_entry_assoc (a1 a2 b1 b2 c1 c2 c3 c4 : K) :
    (a1 * b1 + a2 * b2) * c1 + (a1 * c2 + a2 * c3) * c4 =
      a1 * (b1 * c1 + c2 * c4) + a2 * (b2 * c1 + c3 * c4) := by
  rw [UnitalRing.right_distrib, UnitalRing.right_distrib,
      UnitalRing.left_distrib, UnitalRing.left_distrib]
  rw [UnitalRing.mul_assoc, UnitalRing.mul_assoc, UnitalRing.mul_assoc, UnitalRing.mul_assoc]
  exact add_four_k _ _ _ _

instance mat2KAlgebra (K : Type u) [FieldStructure K] : KAlgebra K (Mat2 K) where
  zero := ⟨0, 0, 0, 0⟩
  one := ⟨1, 0, 0, 1⟩
  add A B := ⟨A.m11 + B.m11, A.m12 + B.m12, A.m21 + B.m21, A.m22 + B.m22⟩
  neg A := ⟨-A.m11, -A.m12, -A.m21, -A.m22⟩
  mul A B := ⟨A.m11 * B.m11 + A.m12 * B.m21, A.m11 * B.m12 + A.m12 * B.m22,
              A.m21 * B.m11 + A.m22 * B.m21, A.m21 * B.m12 + A.m22 * B.m22⟩
  smul c A := ⟨c * A.m11, c * A.m12, c * A.m21, c * A.m22⟩
  add_assoc A B C := Mat2.ext
    (AddCommGrp.add_assoc _ _ _) (AddCommGrp.add_assoc _ _ _)
    (AddCommGrp.add_assoc _ _ _) (AddCommGrp.add_assoc _ _ _)
  add_comm A B := Mat2.ext
    (AddCommGrp.add_comm _ _) (AddCommGrp.add_comm _ _)
    (AddCommGrp.add_comm _ _) (AddCommGrp.add_comm _ _)
  zero_add A := Mat2.ext
    (AddCommGrp.zero_add _) (AddCommGrp.zero_add _)
    (AddCommGrp.zero_add _) (AddCommGrp.zero_add _)
  neg_add_cancel A := Mat2.ext
    (AddCommGrp.neg_add_cancel _) (AddCommGrp.neg_add_cancel _)
    (AddCommGrp.neg_add_cancel _) (AddCommGrp.neg_add_cancel _)
  mul_assoc A B C := Mat2.ext
    (mat_entry_assoc A.m11 A.m12 B.m11 B.m21 C.m11 B.m12 B.m22 C.m21)
    (mat_entry_assoc A.m11 A.m12 B.m11 B.m21 C.m12 B.m12 B.m22 C.m22)
    (mat_entry_assoc A.m21 A.m22 B.m11 B.m21 C.m11 B.m12 B.m22 C.m21)
    (mat_entry_assoc A.m21 A.m22 B.m11 B.m21 C.m12 B.m12 B.m22 C.m22)
  one_mul A := Mat2.ext
    (by change 1 * A.m11 + 0 * A.m21 = A.m11; rw [UnitalRing.one_mul, zero_mul_ring, add_zero_grp])
    (by change 1 * A.m12 + 0 * A.m22 = A.m12; rw [UnitalRing.one_mul, zero_mul_ring, add_zero_grp])
    (by change 0 * A.m11 + 1 * A.m21 = A.m21; rw [zero_mul_ring, UnitalRing.one_mul, AddCommGrp.zero_add])
    (by change 0 * A.m12 + 1 * A.m22 = A.m22; rw [zero_mul_ring, UnitalRing.one_mul, AddCommGrp.zero_add])
  mul_one A := Mat2.ext
    (by change A.m11 * 1 + A.m12 * 0 = A.m11; rw [UnitalRing.mul_one, mul_zero_ring, add_zero_grp])
    (by change A.m11 * 0 + A.m12 * 1 = A.m12; rw [mul_zero_ring, UnitalRing.mul_one, AddCommGrp.zero_add])
    (by change A.m21 * 1 + A.m22 * 0 = A.m21; rw [UnitalRing.mul_one, mul_zero_ring, add_zero_grp])
    (by change A.m21 * 0 + A.m22 * 1 = A.m22; rw [mul_zero_ring, UnitalRing.mul_one, AddCommGrp.zero_add])
  left_distrib A B C := Mat2.ext
    (by change A.m11 * (B.m11 + C.m11) + A.m12 * (B.m21 + C.m21) = _; rw [UnitalRing.left_distrib, UnitalRing.left_distrib]; exact add_four_k _ _ _ _)
    (by change A.m11 * (B.m12 + C.m12) + A.m12 * (B.m22 + C.m22) = _; rw [UnitalRing.left_distrib, UnitalRing.left_distrib]; exact add_four_k _ _ _ _)
    (by change A.m21 * (B.m11 + C.m11) + A.m22 * (B.m21 + C.m21) = _; rw [UnitalRing.left_distrib, UnitalRing.left_distrib]; exact add_four_k _ _ _ _)
    (by change A.m21 * (B.m12 + C.m12) + A.m22 * (B.m22 + C.m22) = _; rw [UnitalRing.left_distrib, UnitalRing.left_distrib]; exact add_four_k _ _ _ _)
  right_distrib A B C := Mat2.ext
    (by change (A.m11 + B.m11) * C.m11 + (A.m12 + B.m12) * C.m21 = _; rw [UnitalRing.right_distrib, UnitalRing.right_distrib]; exact add_four_k _ _ _ _)
    (by change (A.m11 + B.m11) * C.m12 + (A.m12 + B.m12) * C.m22 = _; rw [UnitalRing.right_distrib, UnitalRing.right_distrib]; exact add_four_k _ _ _ _)
    (by change (A.m21 + B.m21) * C.m11 + (A.m22 + B.m22) * C.m21 = _; rw [UnitalRing.right_distrib, UnitalRing.right_distrib]; exact add_four_k _ _ _ _)
    (by change (A.m21 + B.m21) * C.m12 + (A.m22 + B.m22) * C.m22 = _; rw [UnitalRing.right_distrib, UnitalRing.right_distrib]; exact add_four_k _ _ _ _)
  one_smul A := Mat2.ext
    (UnitalRing.one_mul _) (UnitalRing.one_mul _) (UnitalRing.one_mul _) (UnitalRing.one_mul _)
  mul_smul a b A := Mat2.ext
    (UnitalRing.mul_assoc _ _ _) (UnitalRing.mul_assoc _ _ _)
    (UnitalRing.mul_assoc _ _ _) (UnitalRing.mul_assoc _ _ _)
  smul_zero a := Mat2.ext
    (mul_zero_ring a) (mul_zero_ring a) (mul_zero_ring a) (mul_zero_ring a)
  smul_add a A B := Mat2.ext
    (UnitalRing.left_distrib _ _ _) (UnitalRing.left_distrib _ _ _)
    (UnitalRing.left_distrib _ _ _) (UnitalRing.left_distrib _ _ _)
  add_smul a b A := Mat2.ext
    (UnitalRing.right_distrib _ _ _) (UnitalRing.right_distrib _ _ _)
    (UnitalRing.right_distrib _ _ _) (UnitalRing.right_distrib _ _ _)
  zero_smul A := Mat2.ext
    (zero_mul_ring _) (zero_mul_ring _) (zero_mul_ring _) (zero_mul_ring _)
  smul_mul_assoc a A B := Mat2.ext
    (by change (a * A.m11) * B.m11 + (a * A.m12) * B.m21 = a * (A.m11 * B.m11 + A.m12 * B.m21); rw [UnitalRing.left_distrib, UnitalRing.mul_assoc, UnitalRing.mul_assoc])
    (by change (a * A.m11) * B.m12 + (a * A.m12) * B.m22 = a * (A.m11 * B.m12 + A.m12 * B.m22); rw [UnitalRing.left_distrib, UnitalRing.mul_assoc, UnitalRing.mul_assoc])
    (by change (a * A.m21) * B.m11 + (a * A.m22) * B.m21 = a * (A.m21 * B.m11 + A.m22 * B.m21); rw [UnitalRing.left_distrib, UnitalRing.mul_assoc, UnitalRing.mul_assoc])
    (by change (a * A.m21) * B.m12 + (a * A.m22) * B.m22 = a * (A.m21 * B.m12 + A.m22 * B.m22); rw [UnitalRing.left_distrib, UnitalRing.mul_assoc, UnitalRing.mul_assoc])
  mul_smul_comm a A B := Mat2.ext
    (by change A.m11 * (a * B.m11) + A.m12 * (a * B.m21) = a * (A.m11 * B.m11 + A.m12 * B.m21);
        rw [UnitalRing.left_distrib, ← UnitalRing.mul_assoc A.m11 a, FieldStructure.mul_comm A.m11 a, UnitalRing.mul_assoc a A.m11,
            ← UnitalRing.mul_assoc A.m12 a, FieldStructure.mul_comm A.m12 a, UnitalRing.mul_assoc a A.m12])
    (by change A.m11 * (a * B.m12) + A.m12 * (a * B.m22) = a * (A.m11 * B.m12 + A.m12 * B.m22);
        rw [UnitalRing.left_distrib, ← UnitalRing.mul_assoc A.m11 a, FieldStructure.mul_comm A.m11 a, UnitalRing.mul_assoc a A.m11,
            ← UnitalRing.mul_assoc A.m12 a, FieldStructure.mul_comm A.m12 a, UnitalRing.mul_assoc a A.m12])
    (by change A.m21 * (a * B.m11) + A.m22 * (a * B.m21) = a * (A.m21 * B.m11 + A.m22 * B.m21);
        rw [UnitalRing.left_distrib, ← UnitalRing.mul_assoc A.m21 a, FieldStructure.mul_comm A.m21 a, UnitalRing.mul_assoc a A.m21,
            ← UnitalRing.mul_assoc A.m22 a, FieldStructure.mul_comm A.m22 a, UnitalRing.mul_assoc a A.m22])
    (by change A.m21 * (a * B.m12) + A.m22 * (a * B.m22) = a * (A.m21 * B.m12 + A.m22 * B.m22);
        rw [UnitalRing.left_distrib, ← UnitalRing.mul_assoc A.m21 a, FieldStructure.mul_comm A.m21 a, UnitalRing.mul_assoc a A.m21,
            ← UnitalRing.mul_assoc A.m22 a, FieldStructure.mul_comm A.m22 a, UnitalRing.mul_assoc a A.m22])

def Mat2.e11 : Mat2 K := ⟨1, 0, 0, 0⟩
def Mat2.e12 : Mat2 K := ⟨0, 1, 0, 0⟩
def Mat2.e21 : Mat2 K := ⟨0, 0, 1, 0⟩
def Mat2.e22 : Mat2 K := ⟨0, 0, 0, 1⟩

/-- Exact characterization of Z(M_2(K)): every central matrix is scalar c * I_2. -/
theorem Mat2.isCentral_iff_scalar (Z : Mat2 K) :
    IsCentral Z ↔ Z = KSMul.smul Z.m11 (1 : Mat2 K) := by
  constructor
  · intro hz
    have hc11 := hz Mat2.e11
    have hc12 := hz Mat2.e12
    -- From Z * e11 = e11 * Z:
    -- (Z.m11, 0; Z.m21, 0) = (Z.m11, Z.m12; 0, 0) => Z.m12 = 0 and Z.m21 = 0
    have hm12 : Z.m12 = 0 := by
      have h := (congrArg Mat2.m12 hc11).symm
      change 1 * Z.m12 + 0 * Z.m22 = Z.m11 * 0 + Z.m12 * 0 at h
      rw [UnitalRing.one_mul, zero_mul_ring, add_zero_grp, mul_zero_ring, mul_zero_ring, add_zero_grp] at h
      exact h
    have hm21 : Z.m21 = 0 := by
      have h := congrArg Mat2.m21 hc11
      change Z.m21 * 1 + Z.m22 * 0 = 0 * Z.m11 + 0 * Z.m21 at h
      rw [UnitalRing.mul_one, mul_zero_ring, add_zero_grp, zero_mul_ring, zero_mul_ring, add_zero_grp] at h
      exact h
    -- From Z * e12 = e12 * Z: m12 entry is Z.m11 * 1 + Z.m12 * 0 = 0 * Z.m12 + 1 * Z.m22 => Z.m11 = Z.m22
    have hm22 : Z.m22 = Z.m11 := by
      have h := (congrArg Mat2.m12 hc12).symm
      change 0 * Z.m12 + 1 * Z.m22 = Z.m11 * 1 + Z.m12 * 0 at h
      rw [zero_mul_ring, UnitalRing.one_mul, AddCommGrp.zero_add,
          UnitalRing.mul_one, mul_zero_ring, add_zero_grp] at h
      exact h
    apply Mat2.ext
    · change Z.m11 = Z.m11 * 1
      exact (UnitalRing.mul_one Z.m11).symm
    · rw [hm12]
      change (0 : K) = Z.m11 * 0
      exact (mul_zero_ring Z.m11).symm
    · rw [hm21]
      change (0 : K) = Z.m11 * 0
      exact (mul_zero_ring Z.m11).symm
    · rw [hm22]
      change Z.m11 = Z.m11 * 1
      exact (UnitalRing.mul_one Z.m11).symm
  · intro hscalar B
    rw [hscalar]
    exact algebraMap_commutes K Z.m11 B

/-- Canonical K-algebra isomorphism Z(M_2(K)) ≃ₐ[K] K. -/
def mat2CenterAlgIso (K : Type u) [FieldStructure K] : AlgIso K (Center (Mat2 K)) K where
  toFun z := z.val.m11
  invFun c := ⟨KSMul.smul c 1, fun B => algebraMap_commutes K c B⟩
  map_zero := rfl
  map_one := rfl
  map_add _ _ := rfl
  map_mul z1 z2 := by
    have hz1 := (Mat2.isCentral_iff_scalar z1.val).mp z1.property
    have hm12 : z1.val.m12 = 0 := by
      have h := congrArg Mat2.m12 hz1
      change z1.val.m12 = z1.val.m11 * 0 at h
      rw [mul_zero_ring] at h
      exact h
    change z1.val.m11 * z2.val.m11 + z1.val.m12 * z2.val.m21 = z1.val.m11 * z2.val.m11
    rw [hm12, zero_mul_ring, add_zero_grp]
  map_smul _ _ := rfl
  left_inv z := Center.ext ((Mat2.isCentral_iff_scalar z.val).mp z.property).symm
  right_inv c := UnitalRing.mul_one c

/-- Standard 2-dimensional column space Col2 K = K × K as a left M_2(K)-module. -/
structure Col2 (K : Type u) where
  x : K
  y : K

theorem Col2.ext {K : Type u} {u v : Col2 K} (hx : u.x = v.x) (hy : u.y = v.y) : u = v := by
  cases u; cases v; cases hx; cases hy; rfl

instance col2KModule (K : Type u) [FieldStructure K] : KModule K (Mat2 K) (Col2 K) where
  zero := ⟨0, 0⟩
  add u v := ⟨u.x + v.x, u.y + v.y⟩
  neg u := ⟨-u.x, -u.y⟩
  add_assoc u v w := Col2.ext (AddCommGrp.add_assoc _ _ _) (AddCommGrp.add_assoc _ _ _)
  add_comm u v := Col2.ext (AddCommGrp.add_comm _ _) (AddCommGrp.add_comm _ _)
  zero_add u := Col2.ext (AddCommGrp.zero_add _) (AddCommGrp.zero_add _)
  neg_add_cancel u := Col2.ext (AddCommGrp.neg_add_cancel _) (AddCommGrp.neg_add_cancel _)
  smul c u := ⟨c * u.x, c * u.y⟩
  one_smul u := Col2.ext (UnitalRing.one_mul _) (UnitalRing.one_mul _)
  mul_smul a b u := Col2.ext (UnitalRing.mul_assoc _ _ _) (UnitalRing.mul_assoc _ _ _)
  smul_zero a := Col2.ext (mul_zero_ring a) (mul_zero_ring a)
  smul_add a u v := Col2.ext (UnitalRing.left_distrib _ _ _) (UnitalRing.left_distrib _ _ _)
  add_smul a b u := Col2.ext (UnitalRing.right_distrib _ _ _) (UnitalRing.right_distrib _ _ _)
  zero_smul u := Col2.ext (zero_mul_ring _) (zero_mul_ring _)
  act A u := ⟨A.m11 * u.x + A.m12 * u.y, A.m21 * u.x + A.m22 * u.y⟩
  one_act u := Col2.ext
    (by change 1 * u.x + 0 * u.y = u.x; rw [UnitalRing.one_mul, zero_mul_ring, add_zero_grp])
    (by change 0 * u.x + 1 * u.y = u.y; rw [zero_mul_ring, UnitalRing.one_mul, AddCommGrp.zero_add])
  mul_act A B u := Col2.ext
    (mat_entry_assoc A.m11 A.m12 B.m11 B.m21 u.x B.m12 B.m22 u.y)
    (mat_entry_assoc A.m21 A.m22 B.m11 B.m21 u.x B.m12 B.m22 u.y)
  act_zero A := Col2.ext
    (by change A.m11 * 0 + A.m12 * 0 = 0; rw [mul_zero_ring, mul_zero_ring, AddCommGrp.zero_add])
    (by change A.m21 * 0 + A.m22 * 0 = 0; rw [mul_zero_ring, mul_zero_ring, AddCommGrp.zero_add])
  act_add A u v := Col2.ext
    (by change A.m11 * (u.x + v.x) + A.m12 * (u.y + v.y) = _; rw [UnitalRing.left_distrib, UnitalRing.left_distrib]; exact add_four_k _ _ _ _)
    (by change A.m21 * (u.x + v.x) + A.m22 * (u.y + v.y) = _; rw [UnitalRing.left_distrib, UnitalRing.left_distrib]; exact add_four_k _ _ _ _)
  add_act A B u := Col2.ext
    (by change (A.m11 + B.m11) * u.x + (A.m12 + B.m12) * u.y = _; rw [UnitalRing.right_distrib, UnitalRing.right_distrib]; exact add_four_k _ _ _ _)
    (by change (A.m21 + B.m21) * u.x + (A.m22 + B.m22) * u.y = _; rw [UnitalRing.right_distrib, UnitalRing.right_distrib]; exact add_four_k _ _ _ _)
  zero_act u := Col2.ext
    (by change 0 * u.x + 0 * u.y = 0; rw [zero_mul_ring, zero_mul_ring, AddCommGrp.zero_add])
    (by change 0 * u.x + 0 * u.y = 0; rw [zero_mul_ring, zero_mul_ring, AddCommGrp.zero_add])
  smul_act c A u := Col2.ext
    (by change (c * A.m11) * u.x + (c * A.m12) * u.y = c * (A.m11 * u.x + A.m12 * u.y); rw [UnitalRing.left_distrib, UnitalRing.mul_assoc, UnitalRing.mul_assoc])
    (by change (c * A.m21) * u.x + (c * A.m22) * u.y = c * (A.m21 * u.x + A.m22 * u.y); rw [UnitalRing.left_distrib, UnitalRing.mul_assoc, UnitalRing.mul_assoc])

/-- Col2 K has exact K-dimension 2. -/
def col2CoordIso (K : Type u) [FieldStructure K] : KLinearIso K (Fin 2 → K) (Col2 K) where
  toFun f := ⟨f ⟨0, by omega⟩, f ⟨1, by omega⟩⟩
  invFun u := fun i => if i.val = 0 then u.x else u.y
  map_add _ _ := rfl
  map_smul _ _ := rfl
  left_inv f := by
    funext i
    match i with
    | ⟨0, _⟩ => rfl
    | ⟨1, _⟩ => rfl
  right_inv u := Col2.ext rfl rfl

theorem col2_hasKDim (K : Type u) [FieldStructure K] : HasKDim K (Col2 K) 2 :=
  ⟨col2CoordIso K⟩

/-- Col2 K is a genuine simple M_2(K)-module. -/
theorem col2_isSimple (K : Type u) [FieldStructure K] :
    IsSimpleModule (Mat2 K) (Col2 K) := by
  apply isSimple_of_cyclic (Mat2 K)
    ⟨⟨1, 0⟩, fun h => one_ne_zero_field (congrArg Col2.x h)⟩
  intro u hu w
  by_cases hx : u.x = 0
  · have hy : u.y ≠ 0 := fun hy0 => hu (Col2.ext hx hy0)
    refine ⟨⟨0, w.x * FieldStructure.inv u.y, 0, w.y * FieldStructure.inv u.y⟩, ?_⟩
    apply Col2.ext
    · change 0 * u.x + (w.x * FieldStructure.inv u.y) * u.y = w.x
      rw [zero_mul_ring, AddCommGrp.zero_add, UnitalRing.mul_assoc,
          inv_mul_cancel_field hy, UnitalRing.mul_one]
    · change 0 * u.x + (w.y * FieldStructure.inv u.y) * u.y = w.y
      rw [zero_mul_ring, AddCommGrp.zero_add, UnitalRing.mul_assoc,
          inv_mul_cancel_field hy, UnitalRing.mul_one]
  · refine ⟨⟨w.x * FieldStructure.inv u.x, 0, w.y * FieldStructure.inv u.x, 0⟩, ?_⟩
    apply Col2.ext
    · change (w.x * FieldStructure.inv u.x) * u.x + 0 * u.y = w.x
      rw [zero_mul_ring, add_zero_grp, UnitalRing.mul_assoc,
          inv_mul_cancel_field hx, UnitalRing.mul_one]
    · change (w.y * FieldStructure.inv u.x) * u.x + 0 * u.y = w.y
      rw [zero_mul_ring, add_zero_grp, UnitalRing.mul_assoc,
          inv_mul_cancel_field hx, UnitalRing.mul_one]

/-- Column-embedding matrix colMat(x, y) = [[x, 0], [y, 0]] ∈ M_2(K), satisfying the
    exact intertwining identity `A * colMat u = colMat (A • u)`! -/
private def colMat (u : Col2 K) : Mat2 K := ⟨u.x, 0, u.y, 0⟩

private theorem mul_colMat (A : Mat2 K) (u : Col2 K) :
    A * colMat u = colMat (LAct.act A u) :=
  Mat2.ext rfl
    (by change A.m11 * 0 + A.m12 * 0 = 0; rw [mul_zero_ring, mul_zero_ring, AddCommGrp.zero_add])
    rfl
    (by change A.m21 * 0 + A.m22 * 0 = 0; rw [mul_zero_ring, mul_zero_ring, AddCommGrp.zero_add])

/-- Full Morita / Wedderburn uniqueness for M_2(K):
    M_2(K) has a unique simple left module up to M_2(K)-isomorphism (`Col2 K`),
    so `Spec_rep^K(M_2(K)) = (1; [2])`! -/
theorem mat2_hasUniqueSimpleModuleOfDim (K : Type u) [FieldStructure K] :
    HasUniqueSimpleModuleOfDim K (Mat2 K) 2 := by
  refine ⟨⟨Col2 K, inferInstance, col2_isSimple K, col2_hasKDim K, ?_⟩⟩
  intro M _ hSimpleM
  rcases hSimpleM.nontrivial with ⟨m0, hm0⟩
  -- Construct nonzero v1 ∈ M with e11 • v1 = v1
  have hv1_exists : ∃ v1 : M, v1 ≠ 0 ∧ LAct.act (Mat2.e11 (K := K)) v1 = v1 := by
    by_cases h11 : LAct.act (Mat2.e11 (K := K)) m0 = 0
    · -- Since (e11 + e22) m0 = 1 m0 = m0 ≠ 0, e22 m0 = m0 ≠ 0, so v1 := e12 m0 ≠ 0
      let v1 := LAct.act (Mat2.e12 (K := K)) m0
      have he11_e22 : (Mat2.e11 (K := K)) + Mat2.e22 = 1 :=
        Mat2.ext (add_zero_grp 1) (AddCommGrp.zero_add 0) (AddCommGrp.zero_add 0) (AddCommGrp.zero_add 1)
      have he21_e12 : (Mat2.e21 (K := K)) * Mat2.e12 = Mat2.e22 :=
        Mat2.ext
          (by change (0 : K) * 0 + (0 : K) * 0 = 0; rw [zero_mul_ring, AddCommGrp.zero_add])
          (by change (0 : K) * 1 + (0 : K) * 0 = 0; rw [zero_mul_ring, zero_mul_ring, AddCommGrp.zero_add])
          (by change (1 : K) * 0 + (0 : K) * 0 = 0; rw [mul_zero_ring, zero_mul_ring, AddCommGrp.zero_add])
          (by change (1 : K) * 1 + (0 : K) * 0 = 1; rw [UnitalRing.one_mul, zero_mul_ring, add_zero_grp])
      have he11_e12 : (Mat2.e11 (K := K)) * Mat2.e12 = Mat2.e12 :=
        Mat2.ext
          (by change (1 : K) * 0 + (0 : K) * 0 = 0; rw [mul_zero_ring, zero_mul_ring, AddCommGrp.zero_add])
          (by change (1 : K) * 1 + (0 : K) * 0 = 1; rw [UnitalRing.one_mul, zero_mul_ring, add_zero_grp])
          (by change (0 : K) * 0 + (0 : K) * 0 = 0; rw [zero_mul_ring, AddCommGrp.zero_add])
          (by change (0 : K) * 1 + (0 : K) * 0 = 0; rw [zero_mul_ring, zero_mul_ring, AddCommGrp.zero_add])
      have he22_m0 : LAct.act (Mat2.e22 (K := K)) m0 = m0 := by
        calc
          LAct.act (Mat2.e22 (K := K)) m0
            = 0 + LAct.act (Mat2.e22 (K := K)) m0 := (AddCommGrp.zero_add _).symm
          _ = LAct.act (Mat2.e11 (K := K)) m0 + LAct.act (Mat2.e22 (K := K)) m0 := by
            rw [h11]
          _ = LAct.act ((Mat2.e11 (K := K)) + Mat2.e22) m0 := (LeftModule.add_act _ _ m0).symm
          _ = LAct.act (1 : Mat2 K) m0 := by rw [he11_e22]
          _ = m0 := LeftModule.one_act m0
      refine ⟨v1, ?_, ?_⟩
      · intro hv1_0
        have : m0 = 0 := by
          calc
            m0 = LAct.act (Mat2.e22 (K := K)) m0 := he22_m0.symm
            _ = LAct.act ((Mat2.e21 (K := K)) * Mat2.e12) m0 := by rw [he21_e12]
            _ = LAct.act (Mat2.e21 (K := K)) v1 := LeftModule.mul_act _ _ m0
            _ = LAct.act (Mat2.e21 (K := K)) 0 := by rw [hv1_0]
            _ = 0 := LeftModule.act_zero _
        exact hm0 this
      · calc
          LAct.act (Mat2.e11 (K := K)) v1
            = LAct.act ((Mat2.e11 (K := K)) * Mat2.e12) m0 := (LeftModule.mul_act _ _ m0).symm
          _ = v1 := by rw [he11_e12]
    · have he11_idem : (Mat2.e11 (K := K)) * Mat2.e11 = Mat2.e11 :=
        Mat2.ext
          (by change (1 : K) * 1 + (0 : K) * 0 = 1; rw [UnitalRing.one_mul, zero_mul_ring, add_zero_grp])
          (by change (1 : K) * 0 + (0 : K) * 0 = 0; rw [mul_zero_ring, zero_mul_ring, AddCommGrp.zero_add])
          (by change (0 : K) * 1 + (0 : K) * 0 = 0; rw [zero_mul_ring, zero_mul_ring, AddCommGrp.zero_add])
          (by change (0 : K) * 0 + (0 : K) * 0 = 0; rw [zero_mul_ring, AddCommGrp.zero_add])
      refine ⟨LAct.act (Mat2.e11 (K := K)) m0, h11, ?_⟩
      rw [← LeftModule.mul_act, he11_idem]
  rcases hv1_exists with ⟨v1, hv1_ne, hv1_e11⟩
  -- Define Psi : Col2 K → M by Psi(u) = colMat(u) • v1
  let psi : ModuleHom (Mat2 K) (Col2 K) M := {
    toFun := fun u => LAct.act (colMat u) v1
    map_add := fun u w => by
      have hadd : colMat (u + w) = colMat u + colMat w :=
        Mat2.ext rfl (AddCommGrp.zero_add 0).symm rfl (AddCommGrp.zero_add 0).symm
      rw [hadd, LeftModule.add_act]
    map_act := fun A u => by
      change LAct.act (colMat (LAct.act A u)) v1 =
        LAct.act A (LAct.act (colMat u) v1)
      rw [← mul_colMat A u, LeftModule.mul_act]
  }
  -- Surjectivity of psi via simplicity of M
  have hpsi_10 : psi.toFun ⟨1, 0⟩ = v1 := hv1_e11
  have hsurj : ∀ y : M, ∃ u : Col2 K, psi.toFun u = y := by
    cases hSimpleM.eq_bot_or_top psi.rangeSubmodule with
    | inl hbot =>
      exfalso
      exact hv1_ne (hbot v1 ⟨⟨1, 0⟩, hpsi_10⟩)
    | inr htop =>
      exact htop
  -- Helper: c • e11 acting on v1 = 0 implies c = 0
  have hscalar_v1 : ∀ c : K, LAct.act (colMat ⟨c, 0⟩) v1 = 0 → c = 0 := by
    intro c hc
    by_cases hc0 : c = 0
    · exact hc0
    · exfalso
      have hinv_mat : (⟨FieldStructure.inv c, 0, 0, 0⟩ : Mat2 K) * colMat ⟨c, 0⟩ = Mat2.e11 :=
        Mat2.ext
          (by change FieldStructure.inv c * c + (0 : K) * 0 = 1; rw [inv_mul_cancel_field hc0, zero_mul_ring, add_zero_grp])
          (by change FieldStructure.inv c * 0 + (0 : K) * 0 = 0; rw [mul_zero_ring, zero_mul_ring, AddCommGrp.zero_add])
          (by change (0 : K) * c + (0 : K) * 0 = 0; rw [zero_mul_ring, zero_mul_ring, AddCommGrp.zero_add])
          (by change (0 : K) * 0 + (0 : K) * 0 = 0; rw [zero_mul_ring, AddCommGrp.zero_add])
      have : v1 = 0 := by
        calc
          v1 = LAct.act (Mat2.e11 (K := K)) v1 := hv1_e11.symm
          _ = LAct.act ((⟨FieldStructure.inv c, 0, 0, 0⟩ : Mat2 K) * colMat ⟨c, 0⟩) v1 := by
            rw [hinv_mat]
          _ = LAct.act (⟨FieldStructure.inv c, 0, 0, 0⟩ : Mat2 K) (LAct.act (colMat ⟨c, 0⟩) v1) :=
            LeftModule.mul_act _ _ v1
          _ = LAct.act (⟨FieldStructure.inv c, 0, 0, 0⟩ : Mat2 K) 0 := by rw [hc]
          _ = 0 := LeftModule.act_zero _
      exact hv1_ne this
  -- Injectivity of psi
  have hinj : ∀ u1 u2 : Col2 K, psi.toFun u1 = psi.toFun u2 → u1 = u2 := by
    intro u1 u2 heq
    let diff : Col2 K := u1 + -u2
    have hdiff0 : psi.toFun diff = 0 := by
      have hneg : psi.toFun (-u2) = -(psi.toFun u2) := by
        have hcol_neg : colMat (-u2) = -(colMat u2) :=
          Mat2.ext rfl neg_zero_grp.symm rfl neg_zero_grp.symm
        change LAct.act (colMat (-u2)) v1 = -(psi.toFun u2)
        rw [hcol_neg, neg_act_mod]
      unfold diff
      rw [psi.map_add, hneg, heq, add_neg_cancel_grp]
    have hx0 : diff.x = 0 := by
      have h1 : LAct.act (Mat2.e11 (K := K)) (psi.toFun diff) = 0 := by
        rw [hdiff0, LeftModule.act_zero]
      rw [← psi.map_act] at h1
      have he11_diff : LAct.act (Mat2.e11 (K := K)) diff = ⟨diff.x, 0⟩ :=
        Col2.ext
          (by change 1 * diff.x + 0 * diff.y = diff.x; rw [UnitalRing.one_mul, zero_mul_ring, add_zero_grp])
          (by change 0 * diff.x + 0 * diff.y = 0; rw [zero_mul_ring, zero_mul_ring, AddCommGrp.zero_add])
      rw [he11_diff] at h1
      exact hscalar_v1 diff.x h1
    have hy0 : diff.y = 0 := by
      have h2 : LAct.act (Mat2.e12 (K := K)) (psi.toFun diff) = 0 := by
        rw [hdiff0, LeftModule.act_zero]
      rw [← psi.map_act] at h2
      have he12_diff : LAct.act (Mat2.e12 (K := K)) diff = ⟨diff.y, 0⟩ :=
        Col2.ext
          (by change 0 * diff.x + 1 * diff.y = diff.y; rw [zero_mul_ring, UnitalRing.one_mul, AddCommGrp.zero_add])
          (by change 0 * diff.x + 0 * diff.y = 0; rw [zero_mul_ring, zero_mul_ring, AddCommGrp.zero_add])
      rw [he12_diff] at h2
      exact hscalar_v1 diff.y h2
    apply Col2.ext
    · have hnx : -u1.x = -u2.x := neg_eq_of_add_eq_zero hx0
      calc u1.x = -(-u1.x) := (neg_neg_grp _).symm
        _ = -(-u2.x) := by rw [hnx]
        _ = u2.x := neg_neg_grp _
    · have hny : -u1.y = -u2.y := neg_eq_of_add_eq_zero hy0
      calc u1.y = -(-u1.y) := (neg_neg_grp _).symm
        _ = -(-u2.y) := by rw [hny]
        _ = u2.y := neg_neg_grp _
  let invF : M → Col2 K := fun y => Classical.choose (hsurj y)
  have hinv_spec : ∀ y : M, psi.toFun (invF y) = y :=
    fun y => Classical.choose_spec (hsurj y)
  exact ⟨{
    toModuleHom := psi
    invFun := invF
    left_inv := fun u => hinj (invF (psi.toFun u)) u (hinv_spec (psi.toFun u))
    right_inv := hinv_spec
  }⟩

end Mat2Theory

end Conjecture00000007610
