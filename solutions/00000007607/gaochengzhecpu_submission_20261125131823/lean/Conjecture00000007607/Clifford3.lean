import Conjecture00000007607.Clifford2

namespace Conjecture00000007607

/-!
# Three-Dimensional Clifford Algebra `Cl_{3,0}(R)`, `Spin(3)`, and Structural Refutations

Formalizes the 8-dimensional Euclidean Clifford algebra `Cl_{3,0}(R)` over an arbitrary
commutative ring `R`, proves its complete Spin(3) / Lie-algebraic structure, establishes
exact necessary-and-sufficient characterizations over any `StrictOrderedCommRing R`
(including `ℤ`, `ℚ`, and `ℝ`), and constructs explicit counterexamples refuting all three
clauses of Conjecture `00000007607` in dimension `n = 3`.
-/

/-- Element `s + v1·e₁ + v2·e₂ + v3·e₃ + b23·e₂₃ + b31·e₃₁ + b12·e₁₂ + p·e₁₂₃` of `Cl_{3,0}(R)`. -/
structure Cl3 (R : Type) where
  s : R
  v1 : R
  v2 : R
  v3 : R
  b23 : R
  b31 : R
  b12 : R
  p : R

namespace Cl3

@[ext]
theorem ext {R : Type} {x y : Cl3 R}
    (hs : x.s = y.s) (hv1 : x.v1 = y.v1) (hv2 : x.v2 = y.v2) (hv3 : x.v3 = y.v3)
    (hb23 : x.b23 = y.b23) (hb31 : x.b31 = y.b31) (hb12 : x.b12 = y.b12)
    (hp : x.p = y.p) : x = y := by
  cases x; cases y; simp_all

section RingOps
variable {R : Type} [CommRing R]

@[simp] def zero : Cl3 R := ⟨0, 0, 0, 0, 0, 0, 0, 0⟩
@[simp] def one : Cl3 R := ⟨1, 0, 0, 0, 0, 0, 0, 0⟩
@[simp] def scalar (c : R) : Cl3 R := ⟨c, 0, 0, 0, 0, 0, 0, 0⟩

@[simp] def e1 : Cl3 R := ⟨0, 1, 0, 0, 0, 0, 0, 0⟩
@[simp] def e2 : Cl3 R := ⟨0, 0, 1, 0, 0, 0, 0, 0⟩
@[simp] def e3 : Cl3 R := ⟨0, 0, 0, 1, 0, 0, 0, 0⟩
@[simp] def e23 : Cl3 R := ⟨0, 0, 0, 0, 1, 0, 0, 0⟩
@[simp] def e31 : Cl3 R := ⟨0, 0, 0, 0, 0, 1, 0, 0⟩
@[simp] def e12 : Cl3 R := ⟨0, 0, 0, 0, 0, 0, 1, 0⟩
@[simp] def e13 : Cl3 R := ⟨0, 0, 0, 0, 0, -1, 0, 0⟩
@[simp] def e123 : Cl3 R := ⟨0, 0, 0, 0, 0, 0, 0, 1⟩

@[simp] def vec (x y z : R) : Cl3 R := ⟨0, x, y, z, 0, 0, 0, 0⟩
@[simp] def bivec (x y z : R) : Cl3 R := ⟨0, 0, 0, 0, x, y, z, 0⟩

def add (x y : Cl3 R) : Cl3 R :=
  ⟨x.s + y.s, x.v1 + y.v1, x.v2 + y.v2, x.v3 + y.v3,
   x.b23 + y.b23, x.b31 + y.b31, x.b12 + y.b12, x.p + y.p⟩

def neg (x : Cl3 R) : Cl3 R :=
  ⟨-x.s, -x.v1, -x.v2, -x.v3, -x.b23, -x.b31, -x.b12, -x.p⟩

def sub (x y : Cl3 R) : Cl3 R :=
  ⟨x.s - y.s, x.v1 - y.v1, x.v2 - y.v2, x.v3 - y.v3,
   x.b23 - y.b23, x.b31 - y.b31, x.b12 - y.b12, x.p - y.p⟩

@[simp] def smul (c : R) (x : Cl3 R) : Cl3 R :=
  ⟨c * x.s, c * x.v1, c * x.v2, c * x.v3,
   c * x.b23, c * x.b31, c * x.b12, c * x.p⟩

def mul (x y : Cl3 R) : Cl3 R where
  s   := x.s * y.s   - x.p * y.p
       + x.v1 * y.v1 - x.b23 * y.b23
       + x.v2 * y.v2 - x.b31 * y.b31
       + x.v3 * y.v3 - x.b12 * y.b12
  v1  := x.s * y.v1  - x.p * y.b23 + x.v1 * y.s   - x.b23 * y.p
       - x.v2 * y.b12 - x.b31 * y.v3 + x.v3 * y.b31 + x.b12 * y.v2
  v2  := x.s * y.v2  - x.p * y.b31 + x.v2 * y.s   - x.b31 * y.p
       - x.v3 * y.b23 - x.b12 * y.v1 + x.v1 * y.b12 + x.b23 * y.v3
  v3  := x.s * y.v3  - x.p * y.b12 + x.v3 * y.s   - x.b12 * y.p
       - x.v1 * y.b31 - x.b23 * y.v2 + x.v2 * y.b23 + x.b31 * y.v1
  b23 := x.s * y.b23 + x.p * y.v1  + x.b23 * y.s  + x.v1 * y.p
       + x.v2 * y.v3 - x.v3 * y.v2 - x.b31 * y.b12 + x.b12 * y.b31
  b31 := x.s * y.b31 + x.p * y.v2  + x.b31 * y.s  + x.v2 * y.p
       + x.v3 * y.v1 - x.v1 * y.v3 - x.b12 * y.b23 + x.b23 * y.b12
  b12 := x.s * y.b12 + x.p * y.v3  + x.b12 * y.s  + x.v3 * y.p
       + x.v1 * y.v2 - x.v2 * y.v1 - x.b23 * y.b31 + x.b31 * y.b23
  p   := x.s * y.p   + x.p * y.s
       + x.v1 * y.b23 + x.b23 * y.v1
       + x.v2 * y.b31 + x.b31 * y.v2
       + x.v3 * y.b12 + x.b12 * y.v3

instance : OfNat (Cl3 R) 0 := ⟨zero⟩
instance : OfNat (Cl3 R) 1 := ⟨one⟩
instance : Add (Cl3 R) := ⟨add⟩
instance : Neg (Cl3 R) := ⟨neg⟩
instance : Sub (Cl3 R) := ⟨sub⟩
instance : Mul (Cl3 R) := ⟨mul⟩

/-- Clifford reversion `x̃` (fixes grades 0, 1; negates grades 2, 3). -/
@[simp] def rev (x : Cl3 R) : Cl3 R :=
  ⟨x.s, x.v1, x.v2, x.v3, -x.b23, -x.b31, -x.b12, -x.p⟩

/-- Grade-0 scalar projection `⟨x⟩₀`. -/
@[simp] def grade0 (x : Cl3 R) : R := x.s

/-- Grade-2 bivector projection `⟨x⟩₂`. -/
@[simp] def grade2 (x : Cl3 R) : Cl3 R := bivec x.b23 x.b31 x.b12

/-- Commutator Lie bracket `[x, y] = x y - y x`. -/
@[simp] def bracket (x y : Cl3 R) : Cl3 R := x * y - y * x

/-- Double-covering sandwich action `v ↦ R v R̃`. -/
@[simp] def act (r v : Cl3 R) : Cl3 R := (r * v) * rev r

/-- Adjoint Lie action `ad_B(v) = B v - v B`. -/
@[simp] def adAct (b v : Cl3 R) : Cl3 R := bracket b v

/-- Positive-definite Euclidean inner product on bivectors `⟨X, Y⟩_Euc = -⟨X Y⟩₀`. -/
@[simp] def bivecInner (x y : Cl3 R) : R :=
  x.b23 * y.b23 + x.b31 * y.b31 + x.b12 * y.b12

/-- Squared Euclidean norm of the bivector part `‖⟨x⟩₂‖²_Euc`. -/
@[simp] def bivecNormSq (x : Cl3 R) : R := bivecInner x x

/-- Squared Euclidean norm of the vector part `‖⟨x⟩₁‖²_Euc`. -/
@[simp] def vecNormSq (x : Cl3 R) : R := x.v1 * x.v1 + x.v2 * x.v2 + x.v3 * x.v3

/-- Rotor `c - s u` generated by half-angle cosine `c`, sine `s`, and bivector `u`. -/
@[simp] def rotor (c s : R) (u : Cl3 R) : Cl3 R := scalar c - smul s (grade2 u)

/-- Canonical injective Clifford algebra embedding `Cl_{2,0}(R) ↪ Cl_{3,0}(R)`. -/
@[simp] def ofCl2 (x : Cl2 R) : Cl3 R := ⟨x.s, x.v1, x.v2, 0, 0, 0, x.b12, 0⟩

@[simp] theorem zero_s : (0 : Cl3 R).s = 0 := rfl
@[simp] theorem zero_v1 : (0 : Cl3 R).v1 = 0 := rfl
@[simp] theorem zero_v2 : (0 : Cl3 R).v2 = 0 := rfl
@[simp] theorem zero_v3 : (0 : Cl3 R).v3 = 0 := rfl
@[simp] theorem zero_b23 : (0 : Cl3 R).b23 = 0 := rfl
@[simp] theorem zero_b31 : (0 : Cl3 R).b31 = 0 := rfl
@[simp] theorem zero_b12 : (0 : Cl3 R).b12 = 0 := rfl
@[simp] theorem zero_p : (0 : Cl3 R).p = 0 := rfl

@[simp] theorem one_s : (1 : Cl3 R).s = 1 := rfl
@[simp] theorem one_v1 : (1 : Cl3 R).v1 = 0 := rfl
@[simp] theorem one_v2 : (1 : Cl3 R).v2 = 0 := rfl
@[simp] theorem one_v3 : (1 : Cl3 R).v3 = 0 := rfl
@[simp] theorem one_b23 : (1 : Cl3 R).b23 = 0 := rfl
@[simp] theorem one_b31 : (1 : Cl3 R).b31 = 0 := rfl
@[simp] theorem one_b12 : (1 : Cl3 R).b12 = 0 := rfl
@[simp] theorem one_p : (1 : Cl3 R).p = 0 := rfl

@[simp] theorem add_s (x y : Cl3 R) : (x + y).s = x.s + y.s := rfl
@[simp] theorem add_v1 (x y : Cl3 R) : (x + y).v1 = x.v1 + y.v1 := rfl
@[simp] theorem add_v2 (x y : Cl3 R) : (x + y).v2 = x.v2 + y.v2 := rfl
@[simp] theorem add_v3 (x y : Cl3 R) : (x + y).v3 = x.v3 + y.v3 := rfl
@[simp] theorem add_b23 (x y : Cl3 R) : (x + y).b23 = x.b23 + y.b23 := rfl
@[simp] theorem add_b31 (x y : Cl3 R) : (x + y).b31 = x.b31 + y.b31 := rfl
@[simp] theorem add_b12 (x y : Cl3 R) : (x + y).b12 = x.b12 + y.b12 := rfl
@[simp] theorem add_p (x y : Cl3 R) : (x + y).p = x.p + y.p := rfl

@[simp] theorem neg_s (x : Cl3 R) : (-x).s = -x.s := rfl
@[simp] theorem neg_v1 (x : Cl3 R) : (-x).v1 = -x.v1 := rfl
@[simp] theorem neg_v2 (x : Cl3 R) : (-x).v2 = -x.v2 := rfl
@[simp] theorem neg_v3 (x : Cl3 R) : (-x).v3 = -x.v3 := rfl
@[simp] theorem neg_b23 (x : Cl3 R) : (-x).b23 = -x.b23 := rfl
@[simp] theorem neg_b31 (x : Cl3 R) : (-x).b31 = -x.b31 := rfl
@[simp] theorem neg_b12 (x : Cl3 R) : (-x).b12 = -x.b12 := rfl
@[simp] theorem neg_p (x : Cl3 R) : (-x).p = -x.p := rfl

@[simp] theorem sub_s (x y : Cl3 R) : (x - y).s = x.s - y.s := rfl
@[simp] theorem sub_v1 (x y : Cl3 R) : (x - y).v1 = x.v1 - y.v1 := rfl
@[simp] theorem sub_v2 (x y : Cl3 R) : (x - y).v2 = x.v2 - y.v2 := rfl
@[simp] theorem sub_v3 (x y : Cl3 R) : (x - y).v3 = x.v3 - y.v3 := rfl
@[simp] theorem sub_b23 (x y : Cl3 R) : (x - y).b23 = x.b23 - y.b23 := rfl
@[simp] theorem sub_b31 (x y : Cl3 R) : (x - y).b31 = x.b31 - y.b31 := rfl
@[simp] theorem sub_b12 (x y : Cl3 R) : (x - y).b12 = x.b12 - y.b12 := rfl
@[simp] theorem sub_p (x y : Cl3 R) : (x - y).p = x.p - y.p := rfl

@[simp] theorem mul_s (x y : Cl3 R) : (x * y).s =
    x.s * y.s - x.p * y.p + x.v1 * y.v1 - x.b23 * y.b23 +
    x.v2 * y.v2 - x.b31 * y.b31 + x.v3 * y.v3 - x.b12 * y.b12 := rfl
@[simp] theorem mul_v1 (x y : Cl3 R) : (x * y).v1 =
    x.s * y.v1 - x.p * y.b23 + x.v1 * y.s - x.b23 * y.p -
    x.v2 * y.b12 - x.b31 * y.v3 + x.v3 * y.b31 + x.b12 * y.v2 := rfl
@[simp] theorem mul_v2 (x y : Cl3 R) : (x * y).v2 =
    x.s * y.v2 - x.p * y.b31 + x.v2 * y.s - x.b31 * y.p -
    x.v3 * y.b23 - x.b12 * y.v1 + x.v1 * y.b12 + x.b23 * y.v3 := rfl
@[simp] theorem mul_v3 (x y : Cl3 R) : (x * y).v3 =
    x.s * y.v3 - x.p * y.b12 + x.v3 * y.s - x.b12 * y.p -
    x.v1 * y.b31 - x.b23 * y.v2 + x.v2 * y.b23 + x.b31 * y.v1 := rfl
@[simp] theorem mul_b23 (x y : Cl3 R) : (x * y).b23 =
    x.s * y.b23 + x.p * y.v1 + x.b23 * y.s + x.v1 * y.p +
    x.v2 * y.v3 - x.v3 * y.v2 - x.b31 * y.b12 + x.b12 * y.b31 := rfl
@[simp] theorem mul_b31 (x y : Cl3 R) : (x * y).b31 =
    x.s * y.b31 + x.p * y.v2 + x.b31 * y.s + x.v2 * y.p +
    x.v3 * y.v1 - x.v1 * y.v3 - x.b12 * y.b23 + x.b23 * y.b12 := rfl
@[simp] theorem mul_b12 (x y : Cl3 R) : (x * y).b12 =
    x.s * y.b12 + x.p * y.v3 + x.b12 * y.s + x.v3 * y.p +
    x.v1 * y.v2 - x.v2 * y.v1 - x.b23 * y.b31 + x.b31 * y.b23 := rfl
@[simp] theorem mul_p (x y : Cl3 R) : (x * y).p =
    x.s * y.p + x.p * y.s + x.v1 * y.b23 + x.b23 * y.v1 +
    x.v2 * y.b31 + x.b31 * y.v2 + x.v3 * y.b12 + x.b12 * y.v3 := rfl

/-! ### Clifford Algebra Axioms & Subalgebra Embedding -/

theorem mul_assoc (x y z : Cl3 R) : (x * y) * z = x * (y * z) := by
  ext <;> simp <;> comm_ring

theorem one_mul (x : Cl3 R) : (1 : Cl3 R) * x = x := by
  ext <;> simp <;> comm_ring

theorem mul_one (x : Cl3 R) : x * (1 : Cl3 R) = x := by
  ext <;> simp <;> comm_ring

theorem left_distrib (x y z : Cl3 R) : x * (y + z) = x * y + x * z := by
  ext <;> simp <;> comm_ring

theorem right_distrib (x y z : Cl3 R) : (x + y) * z = x * z + y * z := by
  ext <;> simp <;> comm_ring

theorem rev_mul (x y : Cl3 R) : rev (x * y) = rev y * rev x := by
  ext <;> simp <;> comm_ring

theorem ofCl2_mul (x y : Cl2 R) : ofCl2 (x * y) = ofCl2 x * ofCl2 y := by
  ext <;> simp <;> comm_ring

theorem ofCl2_injective {x y : Cl2 R} (h : ofCl2 x = ofCl2 y) : x = y := by
  ext
  · exact congrArg Cl3.s h
  · exact congrArg Cl3.v1 h
  · exact congrArg Cl3.v2 h
  · exact congrArg Cl3.b12 h

theorem act_mul (r1 r2 v : Cl3 R) : act (r1 * r2) v = act r1 (act r2 v) := by
  simp only [act, rev_mul, mul_assoc]

/-- Even-grade unit rotor `R` (`v₁ = v₂ = v₃ = p = 0`, `R R̃ = 1`) preserves vector norm on `R³`. -/
theorem even_rotor_preserves_vec_norm (s b23 b31 b12 x y z : R)
    (hunit : s * s + b23 * b23 + b31 * b31 + b12 * b12 = 1) :
    vecNormSq (act ⟨s, 0, 0, 0, b23, b31, b12, 0⟩ (vec x y z)) =
      vecNormSq (vec x y z) := by
  have hpoly :
      vecNormSq (act ⟨s, 0, 0, 0, b23, b31, b12, 0⟩ (vec x y z)) =
      (s * s + b23 * b23 + b31 * b31 + b12 * b12) *
      (s * s + b23 * b23 + b31 * b31 + b12 * b12) * vecNormSq (vec x y z) := by
    simp; comm_ring
  rw [hpoly, hunit]
  comm_ring

/-! ### Bivector Grade Decomposition, Lie Bracket Obstruction & Lagrange Identity -/

/-- Exact Clifford bivector product decomposition in `Cl_{3,0}(R)`:
    `2 B₁ B₂ = -2 ⟨B₁, B₂⟩_Euc · 1 + [B₁, B₂]`. -/
theorem bivec_mul_decomp (x1 y1 z1 x2 y2 z2 : R) :
    let b1 := bivec x1 y1 z1
    let b2 := bivec x2 y2 z2
    smul (1 + 1) (b1 * b2) =
      scalar (-((1 + 1) * bivecInner b1 b2)) + bracket b1 b2 := by
  ext <;> simp <;> comm_ring

/-- Basis commutator `[e₁₂, e₂₃] = 2 e₁₃ = -2 e₃₁`. -/
theorem bracket_e12_e23 :
    bracket (e12 : Cl3 R) e23 = smul (1 + 1) e13 := by
  ext <;> simp <;> comm_ring

/-- Universal Jacobi identity on `Cl_{3,0}(R)` (contrasted with non-commutativity). -/
theorem jacobi_identity (a b c : Cl3 R) :
    bracket a (bracket b c) + bracket b (bracket c a) + bracket c (bracket a b) = 0 := by
  ext <;> simp <;> comm_ring

/-- **Lagrange's Identity on `𝔰𝔭𝔦𝔫(3, R)`**:
    `‖[B₁, B₂]‖²_Euc = 4(‖B₁‖²_Euc ‖B₂‖²_Euc - ⟨B₁, B₂⟩²_Euc)`. -/
theorem bivec_bracket_normSq_lagrange (x1 y1 z1 x2 y2 z2 : R) :
    let b1 := bivec x1 y1 z1
    let b2 := bivec x2 y2 z2
    bivecNormSq (bracket b1 b2) =
      ((1 + 1) * (1 + 1)) * (bivecNormSq b1 * bivecNormSq b2 -
                             bivecInner b1 b2 * bivecInner b1 b2) := by
  simp; comm_ring

/-- Sum-of-squares form of `‖u₁ - u₂‖²_Euc` for unit bivectors:
    `‖u₁ - u₂‖²_Euc = 2(1 - ⟨u₁, u₂⟩_Euc)`. -/
theorem unit_bivec_diff_normSq {x1 y1 z1 x2 y2 z2 : R}
    (hu1 : bivecNormSq (bivec x1 y1 z1) = 1)
    (hu2 : bivecNormSq (bivec x2 y2 z2) = 1) :
    bivecNormSq (bivec x1 y1 z1 - bivec x2 y2 z2) =
      (1 + 1) * (1 - bivecInner (bivec x1 y1 z1) (bivec x2 y2 z2)) := by
  have hid : bivecNormSq (bivec x1 y1 z1 - bivec x2 y2 z2) =
      bivecNormSq (bivec x1 y1 z1) + bivecNormSq (bivec x2 y2 z2) -
      (1 + 1) * bivecInner (bivec x1 y1 z1) (bivec x2 y2 z2) := by
    simp; comm_ring
  rw [hid, hu1, hu2]
  comm_ring

theorem unit_bivec_sum_normSq {x1 y1 z1 x2 y2 z2 : R}
    (hu1 : bivecNormSq (bivec x1 y1 z1) = 1)
    (hu2 : bivecNormSq (bivec x2 y2 z2) = 1) :
    bivecNormSq (bivec x1 y1 z1 + bivec x2 y2 z2) =
      (1 + 1) * (1 + bivecInner (bivec x1 y1 z1) (bivec x2 y2 z2)) := by
  have hid : bivecNormSq (bivec x1 y1 z1 + bivec x2 y2 z2) =
      bivecNormSq (bivec x1 y1 z1) + bivecNormSq (bivec x2 y2 z2) +
      (1 + 1) * bivecInner (bivec x1 y1 z1) (bivec x2 y2 z2) := by
    simp; comm_ring
  rw [hid, hu1, hu2]
  comm_ring

/-! ### Master Rotor Composition, Subalgebra Obstruction & Spectral Identities -/

/-- **Master Rotor Scalar-Part Identity**: For unit bivectors `u₁, u₂` and `R_k = c_k - s_k u_k`,
    `2(⟨R₁ R₂⟩₀ - (c₁ c₂ - s₁ s₂)) = s₁ s₂ ‖u₁ - u₂‖²_Euc`. -/
theorem rotor_mul_scalar_master {x1 y1 z1 x2 y2 z2 : R} (c1 s1 c2 s2 : R)
    (hu1 : bivecNormSq (bivec x1 y1 z1) = 1)
    (hu2 : bivecNormSq (bivec x2 y2 z2) = 1) :
    let u1 := bivec x1 y1 z1
    let u2 := bivec x2 y2 z2
    (1 + 1) * (grade0 (rotor c1 s1 u1 * rotor c2 s2 u2) - (c1 * c2 - s1 * s2)) =
      s1 * s2 * bivecNormSq (u1 - u2) := by
  dsimp only []
  rw [unit_bivec_diff_normSq hu1 hu2]
  simp; comm_ring

/-- **Master Grade-2 Commutator Projection Identity**:
    `2⟨R₁ R₂⟩₂ = -2 s₁ c₂ u₁ - 2 c₁ s₂ u₂ + s₁ s₂ [u₁, u₂]`. -/
theorem rotor_mul_grade2_master (c1 s1 c2 s2 x1 y1 z1 x2 y2 z2 : R) :
    let u1 := bivec x1 y1 z1
    let u2 := bivec x2 y2 z2
    smul (1 + 1) (grade2 (rotor c1 s1 u1 * rotor c2 s2 u2)) =
      (smul (-((1 + 1) * s1 * c2)) u1 - smul ((1 + 1) * c1 * s2) u2) -
        smul (-(s1 * s2)) (bracket u1 u2) := by
  ext <;> simp <;> comm_ring

/-- Orthogonality of `[u₁, u₂]` to every linear combination `α · 1 + β u₁ + γ u₂`
    (which includes `exp(B₁ + B₂)` for `B_k = -a_k u_k`). -/
theorem span_bivec_orthog_bracket (α β γ x1 y1 z1 x2 y2 z2 : R) :
    let u1 := bivec x1 y1 z1
    let u2 := bivec x2 y2 z2
    bivecInner (scalar α + smul β u1 + smul γ u2) (bracket u1 u2) = 0 := by
  simp; comm_ring

/-- Projection of `2⟨R₁ R₂⟩₂` onto `[u₁, u₂]` equals `s₁ s₂ ‖[u₁, u₂]‖²_Euc`. -/
theorem rotor_mul_inner_bracket (c1 s1 c2 s2 x1 y1 z1 x2 y2 z2 : R) :
    let u1 := bivec x1 y1 z1
    let u2 := bivec x2 y2 z2
    (1 + 1) * bivecInner (rotor c1 s1 u1 * rotor c2 s2 u2) (bracket u1 u2) =
      s1 * s2 * bivecNormSq (bracket u1 u2) := by
  simp; comm_ring

/-- Every bivector `B ∈ 𝔰𝔭𝔦𝔫(3, R)` has purely scalar negative square `B² = -‖B‖²_Euc · 1`. -/
theorem bivec_sq_eq_neg_normSq (x y z : R) :
    bivec x y z * bivec x y z = scalar (-bivecNormSq (bivec x y z)) := by
  ext <;> simp <;> comm_ring

/-- **Master Spectral Norm Identity**: For `B_k = -a_k u_k` with unit bivectors `u₁, u₂`,
    `(a₁ + a₂)² - ‖B₁ + B₂‖²_Euc = a₁ a₂ ‖u₁ - u₂‖²_Euc`. -/
theorem gen_sum_normSq_master {x1 y1 z1 x2 y2 z2 : R} (a1 a2 : R)
    (hu1 : bivecNormSq (bivec x1 y1 z1) = 1)
    (hu2 : bivecNormSq (bivec x2 y2 z2) = 1) :
    let u1 := bivec x1 y1 z1
    let u2 := bivec x2 y2 z2
    let bsum := smul (-a1) u1 + smul (-a2) u2
    (a1 + a2) * (a1 + a2) - bivecNormSq bsum =
      a1 * a2 * bivecNormSq (u1 - u2) := by
  dsimp only []
  rw [unit_bivec_diff_normSq hu1 hu2]
  have hid :
      (a1 + a2) * (a1 + a2) -
      bivecNormSq (smul (-a1) (bivec x1 y1 z1) + smul (-a2) (bivec x2 y2 z2)) =
      a1 * a1 * (1 - bivecNormSq (bivec x1 y1 z1)) +
      a2 * a2 * (1 - bivecNormSq (bivec x2 y2 z2)) +
      a1 * a2 * ((1 + 1) * (1 - bivecInner (bivec x1 y1 z1) (bivec x2 y2 z2))) := by
    simp; comm_ring
  rw [hid, hu1, hu2]
  comm_ring

/-- **Adjoint Cayley–Hamilton / Spectral Identity on `R³`**:
    For any bivector `B ∈ 𝔰𝔭𝔦𝔫(3, R)` and vector `v ∈ R³`,
    `ad_B³(v) + 4‖B‖²_Euc ad_B(v) = 0`. -/
theorem adjoint_cayley_hamilton (bx by_ bz vx vy vz : R) :
    let b := bivec bx by_ bz
    let v := vec vx vy vz
    adAct b (adAct b (adAct b v)) +
      smul (((1 + 1) * (1 + 1)) * bivecNormSq b) (adAct b v) = 0 := by
  ext <;> simp <;> comm_ring

end RingOps

/-! ### Exact Necessary & Sufficient Characterizations over `StrictOrderedCommRing R` -/

section OrderedCharacterizations
variable {R : Type} [StrictOrderedCommRing R]

/-- On `𝔰𝔭𝔦𝔫(3, R)` over any ordered domain, `[e₁₂, e₂₃] ≠ 0` (refuting universal bracket vanishing). -/
theorem spin3_bracket_e12_e23_ne_zero :
    bracket (e12 : Cl3 R) e23 ≠ 0 := by
  intro h
  have hb31 : (bracket (e12 : Cl3 R) e23).b31 = (0 : Cl3 R).b31 := congrArg Cl3.b31 h
  rw [bracket_e12_e23] at hb31
  simp at hb31
  have htwo : ((1 : R) + 1) = 0 := by
    have hneg : -(((1 : R) + 1) * (-1)) = -(0 : R) := congrArg Neg.neg hb31
    have hid : -(((1 : R) + 1) * (-1)) = (1 : R) + 1 := by comm_ring
    rw [hid, CommRing.neg_zero] at hneg
    exact hneg
  exact StrictOrderedCommRing.two_ne_zero htwo

theorem bivec_eq_zero_iff_normSq_eq_zero {x y z : R} :
    bivecNormSq (bivec x y z) = 0 ↔ bivec x y z = 0 := by
  constructor
  · intro h
    simp only [bivecNormSq, bivecInner, bivec] at h
    obtain ⟨hx, hy, hz⟩ := StrictOrderedCommRing.sum3_sq_eq_zero_iff.mp h
    ext <;> simp [hx, hy, hz]
  · intro h
    rw [h]
    simp only [bivecNormSq, bivecInner, zero_b23, zero_b31, zero_b12]
    comm_ring

theorem bivec_diff_normSq_eq_zero_iff {x1 y1 z1 x2 y2 z2 : R} :
    bivecNormSq (bivec x1 y1 z1 - bivec x2 y2 z2) = 0 ↔
      bivec x1 y1 z1 = bivec x2 y2 z2 := by
  have hsub : bivec x1 y1 z1 - bivec x2 y2 z2 = bivec (x1 - x2) (y1 - y2) (z1 - z2) := by
    ext <;> simp <;> comm_ring
  rw [hsub, bivec_eq_zero_iff_normSq_eq_zero]
  constructor
  · intro h
    ext <;> simp
    · exact CommRing.sub_eq_zero_iff.mp (congrArg Cl3.b23 h)
    · exact CommRing.sub_eq_zero_iff.mp (congrArg Cl3.b31 h)
    · exact CommRing.sub_eq_zero_iff.mp (congrArg Cl3.b12 h)
  · intro h
    have hx : x1 = x2 := congrArg Cl3.b23 h
    have hy : y1 = y2 := congrArg Cl3.b31 h
    have hz : z1 = z2 := congrArg Cl3.b12 h
    ext <;> simp [hx, hy, hz, CommRing.sub_self]

/-- **Exact Characterization 1 (Commutativity in `𝔰𝔭𝔦𝔫(3, R)`)**:
    Two unit bivectors `u₁, u₂` commute (`[u₁, u₂] = 0`) **if and only if** `u₁ = u₂ ∨ u₁ = -u₂`. -/
theorem unit_bivec_commute_iff {x1 y1 z1 x2 y2 z2 : R}
    (hu1 : bivecNormSq (bivec x1 y1 z1) = 1)
    (hu2 : bivecNormSq (bivec x2 y2 z2) = 1) :
    bracket (bivec x1 y1 z1) (bivec x2 y2 z2) = 0 ↔
      bivec x1 y1 z1 = bivec x2 y2 z2 ∨ bivec x1 y1 z1 = -bivec x2 y2 z2 := by
  constructor
  · intro hbr
    have hnorm : bivecNormSq (bracket (bivec x1 y1 z1) (bivec x2 y2 z2)) = 0 := by
      rw [hbr]
      simp only [bivecNormSq, bivecInner, zero_b23, zero_b31, zero_b12]
      comm_ring
    have hlag := bivec_bracket_normSq_lagrange x1 y1 z1 x2 y2 z2
    dsimp only [] at hlag
    rw [hnorm, hu1, hu2] at hlag
    have hfour_ne : ((1 : R) + 1) * (1 + 1) ≠ 0 :=
      StrictOrderedCommRing.mul_ne_zero
        StrictOrderedCommRing.two_ne_zero StrictOrderedCommRing.two_ne_zero
    have hdiff : (1 : R) * 1 -
        bivecInner (bivec x1 y1 z1) (bivec x2 y2 z2) *
        bivecInner (bivec x1 y1 z1) (bivec x2 y2 z2) = 0 := by
      rcases StrictOrderedCommRing.mul_eq_zero_iff.mp hlag.symm with h4 | hd
      · exact absurd h4 hfour_ne
      · exact hd
    have hsq : bivecInner (bivec x1 y1 z1) (bivec x2 y2 z2) *
               bivecInner (bivec x1 y1 z1) (bivec x2 y2 z2) = 1 * 1 :=
      (CommRing.sub_eq_zero_iff.mp hdiff).symm
    rcases StrictOrderedCommRing.eq_or_eq_neg_of_sq_eq hsq with hpos | hneg
    · left
      have hdn := unit_bivec_diff_normSq hu1 hu2
      rw [hpos, CommRing.sub_self, CommRing.mul_zero] at hdn
      exact bivec_diff_normSq_eq_zero_iff.mp hdn
    · right
      have hsn := unit_bivec_sum_normSq hu1 hu2
      have hsum0 : (1 : R) + -1 = 0 := by comm_ring
      rw [hneg, hsum0, CommRing.mul_zero] at hsn
      have hsum_biv : bivec x1 y1 z1 + bivec x2 y2 z2 =
          bivec (x1 + x2) (y1 + y2) (z1 + z2) := by
        ext <;> simp <;> comm_ring
      rw [hsum_biv] at hsn
      have hb0 := bivec_eq_zero_iff_normSq_eq_zero.mp hsn
      have hx : x1 = -x2 := by
        have h1 : x1 - (-x2) = x1 + x2 := by comm_ring
        exact CommRing.sub_eq_zero_iff.mp (h1.trans (congrArg Cl3.b23 hb0))
      have hy : y1 = -y2 := by
        have h1 : y1 - (-y2) = y1 + y2 := by comm_ring
        exact CommRing.sub_eq_zero_iff.mp (h1.trans (congrArg Cl3.b31 hb0))
      have hz : z1 = -z2 := by
        have h1 : z1 - (-z2) = z1 + z2 := by comm_ring
        exact CommRing.sub_eq_zero_iff.mp (h1.trans (congrArg Cl3.b12 hb0))
      ext <;> simp [hx, hy, hz, CommRing.neg_zero]
  · rintro (heq | hneg)
    · rw [heq]; ext <;> simp <;> comm_ring
    · rw [hneg]; ext <;> simp <;> comm_ring

/-- **Exact Characterization 2 (Scalar Rotor Angle Additivity)**:
    For non-trivial half-angle sines `s₁ ≠ 0`, `s₂ ≠ 0` and unit bivectors `u₁, u₂`,
    `⟨R₁ R₂⟩₀ = c₁ c₂ - s₁ s₂` holds **if and only if** `u₁ = u₂`. -/
theorem rotor_scalar_angle_add_iff {x1 y1 z1 x2 y2 z2 c1 s1 c2 s2 : R}
    (hs1 : s1 ≠ 0) (hs2 : s2 ≠ 0)
    (hu1 : bivecNormSq (bivec x1 y1 z1) = 1)
    (hu2 : bivecNormSq (bivec x2 y2 z2) = 1) :
    let u1 := bivec x1 y1 z1
    let u2 := bivec x2 y2 z2
    grade0 (rotor c1 s1 u1 * rotor c2 s2 u2) = c1 * c2 - s1 * s2 ↔ u1 = u2 := by
  dsimp only []
  have hmaster := rotor_mul_scalar_master c1 s1 c2 s2 hu1 hu2
  dsimp only [] at hmaster
  constructor
  · intro heq
    rw [heq, CommRing.sub_self, CommRing.mul_zero] at hmaster
    have hs12 : s1 * s2 ≠ 0 := StrictOrderedCommRing.mul_ne_zero hs1 hs2
    rcases StrictOrderedCommRing.mul_eq_zero_iff.mp hmaster.symm with hs0 | hn0
    · exact absurd hs0 hs12
    · exact bivec_diff_normSq_eq_zero_iff.mp hn0
  · intro hu
    rw [hu]
    rw [hu, bivec_diff_normSq_eq_zero_iff.mpr rfl, CommRing.mul_zero] at hmaster
    rcases StrictOrderedCommRing.mul_eq_zero_iff.mp hmaster with h2 | hdiff
    · exact absurd h2 StrictOrderedCommRing.two_ne_zero
    · exact CommRing.sub_eq_zero_iff.mp hdiff

/-- **Subalgebra Obstruction to `exp(B₁) exp(B₂) = exp(B₁ + B₂)`**:
    Whenever `s₁ ≠ 0`, `s₂ ≠ 0`, and `[u₁, u₂] ≠ 0`, the composite rotor `R₁ R₂` does NOT
    belong to `R · 1 ⊕ span_R(u₁, u₂)` (which contains `exp(B₁ + B₂)` for `B_k = -a_k u_k`). -/
theorem rotor_mul_not_in_gen_span {x1 y1 z1 x2 y2 z2 c1 s1 c2 s2 : R}
    (hs1 : s1 ≠ 0) (hs2 : s2 ≠ 0)
    (hnc : bracket (bivec x1 y1 z1) (bivec x2 y2 z2) ≠ 0) :
    let u1 := bivec x1 y1 z1
    let u2 := bivec x2 y2 z2
    ∀ α β γ : R, rotor c1 s1 u1 * rotor c2 s2 u2 ≠ scalar α + smul β u1 + smul γ u2 := by
  dsimp only []
  intro α β γ heq
  have hproj := rotor_mul_inner_bracket c1 s1 c2 s2 x1 y1 z1 x2 y2 z2
  dsimp only [] at hproj
  rw [heq, span_bivec_orthog_bracket, CommRing.mul_zero] at hproj
  have hs12 : s1 * s2 ≠ 0 := StrictOrderedCommRing.mul_ne_zero hs1 hs2
  rcases StrictOrderedCommRing.mul_eq_zero_iff.mp hproj.symm with hs0 | hbn0
  · exact hs12 hs0
  · have hbr_biv : bracket (bivec x1 y1 z1) (bivec x2 y2 z2) =
        bivec (bracket (bivec x1 y1 z1) (bivec x2 y2 z2)).b23
              (bracket (bivec x1 y1 z1) (bivec x2 y2 z2)).b31
              (bracket (bivec x1 y1 z1) (bivec x2 y2 z2)).b12 := by
      ext <;> simp <;> comm_ring
    rw [hbr_biv] at hbn0
    have hb0 := bivec_eq_zero_iff_normSq_eq_zero.mp hbn0
    rw [← hbr_biv] at hb0
    exact hnc hb0

/-- **Exact Characterization 3 (Spectral Angle Additivity of Generator Sum)**:
    For `a₁ ≠ 0`, `a₂ ≠ 0` and unit bivectors `u₁, u₂`, the generator sum
    `B₁ + B₂ = -a₁ u₁ - a₂ u₂` satisfies `‖B₁ + B₂‖²_Euc = (a₁ + a₂)²` **iff** `u₁ = u₂`. -/
theorem gen_sum_spectral_angle_add_iff {x1 y1 z1 x2 y2 z2 a1 a2 : R}
    (ha1 : a1 ≠ 0) (ha2 : a2 ≠ 0)
    (hu1 : bivecNormSq (bivec x1 y1 z1) = 1)
    (hu2 : bivecNormSq (bivec x2 y2 z2) = 1) :
    let u1 := bivec x1 y1 z1
    let u2 := bivec x2 y2 z2
    bivecNormSq (smul (-a1) u1 + smul (-a2) u2) = (a1 + a2) * (a1 + a2) ↔ u1 = u2 := by
  dsimp only []
  have hmaster := gen_sum_normSq_master a1 a2 hu1 hu2
  dsimp only [] at hmaster
  constructor
  · intro heq
    rw [heq, CommRing.sub_self] at hmaster
    have ha12 : a1 * a2 ≠ 0 := StrictOrderedCommRing.mul_ne_zero ha1 ha2
    rcases StrictOrderedCommRing.mul_eq_zero_iff.mp hmaster.symm with ha0 | hn0
    · exact absurd ha0 ha12
    · exact bivec_diff_normSq_eq_zero_iff.mp hn0
  · intro hu
    rw [hu]
    rw [hu, bivec_diff_normSq_eq_zero_iff.mpr rfl, CommRing.mul_zero] at hmaster
    exact (CommRing.sub_eq_zero_iff.mp hmaster).symm

end OrderedCharacterizations

/-! ### Concrete Counterexamples in `Spin(3)` -/

/-- Exact `90°` (`θ₁ = π/2`) unit rotor `R₁ = (1 - e₁₂)/√2` in `Cl_{3,0}(ℚ[√2])`. -/
def rot90_e12 : Cl3 QSqrt2 := rotor QSqrt2.invSqrt2 QSqrt2.invSqrt2 e12

/-- Exact `90°` (`θ₂ = π/2`) unit rotor `R₂ = (1 - e₂₃)/√2` in `Cl_{3,0}(ℚ[√2])`. -/
def rot90_e23 : Cl3 QSqrt2 := rotor QSqrt2.invSqrt2 QSqrt2.invSqrt2 e23

/-- **Counterexample 1 (`90°` Orthogonal Rotors in `Spin(3, ℚ[√2])`)**:
    1. `R₁` and `R₂` are unit rotors (`R_k R̃_k = 1`).
    2. Their composite `R₁ R₂` has scalar part `1/2 = cos(π/3)` (`Θ = 2π/3 = 120°`), NOT `0 = cos(π/2)`.
    3. `(R₁ R₂)³ = -1` (exact order-3 rotation in `SO(3)`), whereas `(R₁ R₂)² ≠ -1`.
    4. Sandwich action permutes the standard basis cyclically: `e₁ ↦ e₂ ↦ e₃ ↦ e₁`.
    5. All three squared normalized angles `(Θ/π)² = 4/9`, `(2‖B₁+B₂‖/π)² = 1/2`, and
       `((θ₁+θ₂)/π)² = 1` are pairwise distinct in `ℚ`. -/
theorem counterexample_90deg_orthogonal :
    rot90_e12 * rev rot90_e12 = 1 ∧
    rot90_e23 * rev rot90_e23 = 1 ∧
    grade0 (rot90_e12 * rot90_e23) = ⟨QRat.mk 1 2, 0⟩ ∧
    grade0 (rot90_e12 * rot90_e23) ≠ 0 ∧
    (rot90_e12 * rot90_e23) * (rot90_e12 * rot90_e23) * (rot90_e12 * rot90_e23) = -1 ∧
    (rot90_e12 * rot90_e23) * (rot90_e12 * rot90_e23) ≠ -1 ∧
    act (rot90_e12 * rot90_e23) e1 = e2 ∧
    act (rot90_e12 * rot90_e23) e2 = e3 ∧
    act (rot90_e12 * rot90_e23) e3 = e1 ∧
    QRat.mk 4 9 ≠ QRat.mk 1 2 ∧
    QRat.mk 1 2 ≠ QRat.mk 1 1 ∧
    QRat.mk 4 9 ≠ QRat.mk 1 1 := by
  let h : QSqrt2 := ⟨QRat.mk 1 2, 0⟩
  let r12 : Cl3 QSqrt2 := ⟨h, 0, 0, 0, -h, -h, -h, 0⟩
  have hprod : rot90_e12 * rot90_e23 = r12 := by
    ext <;> simp [rot90_e12, rot90_e23, QSqrt2.invSqrt2, r12, h] <;> qrat_eq
  have hsq : r12 * r12 = ⟨-h, 0, 0, 0, -h, -h, -h, 0⟩ := by
    ext <;> simp [r12, h] <;> qrat_eq
  have he1 : r12 * e1 = ⟨0, h, h, -h, 0, 0, 0, -h⟩ := by
    ext <;> simp [r12, h] <;> qrat_eq
  have he2 : r12 * e2 = ⟨0, -h, h, h, 0, 0, 0, -h⟩ := by
    ext <;> simp [r12, h] <;> qrat_eq
  have he3 : r12 * e3 = ⟨0, h, -h, h, 0, 0, 0, -h⟩ := by
    ext <;> simp [r12, h] <;> qrat_eq
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · ext <;> simp [rot90_e12, QSqrt2.invSqrt2] <;> qrat_eq
  · ext <;> simp [rot90_e23, QSqrt2.invSqrt2] <;> qrat_eq
  · rw [hprod]; rfl
  · rw [hprod]
    intro hz
    have hre : (QRat.mk 1 2 : QRat) = 0 := congrArg QSqrt2.re hz
    exact QRat.ne_of_isZero_sub_false rfl hre
  · rw [hprod, hsq]
    ext <;> simp [r12, h] <;> qrat_eq
  · rw [hprod, hsq]
    intro hne
    have hs : (-h).re = (-1 : Cl3 QSqrt2).b23.re := congrArg (fun x => x.b23.re) hne
    exact QRat.ne_of_isZero_sub_false rfl hs
  · rw [hprod]; unfold act; rw [he1]
    ext <;> simp [r12, h] <;> qrat_eq
  · rw [hprod]; unfold act; rw [he2]
    ext <;> simp [r12, h] <;> qrat_eq
  · rw [hprod]; unfold act; rw [he3]
    ext <;> simp [r12, h] <;> qrat_eq
  · exact QRat.ne_of_isZero_sub_false rfl
  · exact QRat.ne_of_isZero_sub_false rfl
  · exact QRat.ne_of_isZero_sub_false rfl

/-- **Counterexample 2 (`180°` Orthogonal Rotors over `ℤ`)**:
    `R₁ = -e₁₂` (`θ₁ = π`) and `R₂ = -e₂₃` (`θ₂ = π`) satisfy `R₁ R₂ = e₁₃ ≠ ±1`
    (a `180°` rotation, NOT `π + π = 2π`). -/
theorem counterexample_180deg_int :
    let r1 : Cl3 Int := -e12
    let r2 : Cl3 Int := -e23
    r1 * rev r1 = 1 ∧
    r2 * rev r2 = 1 ∧
    r1 * r2 = e13 ∧
    r1 * r2 ≠ 1 ∧
    r1 * r2 ≠ -1 := by
  dsimp only []
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · ext <;> decide
  · ext <;> decide
  · ext <;> decide
  · intro h
    have hb : ((-e12 : Cl3 Int) * (-e23)).b31 = (1 : Cl3 Int).b31 := congrArg Cl3.b31 h
    cases hb
  · intro h
    have hb : ((-e12 : Cl3 Int) * (-e23)).b31 = (-1 : Cl3 Int).b31 := congrArg Cl3.b31 h
    cases hb

/-- **Counterexample 3 (Pythagorean Rational Spectral & Cayley Unit-Rotor Refutation over `ℚ`)**:
    1. Orthogonal generators `B₁ = -(3/2) e₁₂` (`θ₁ = 3`) and `B₂ = -2 e₂₃` (`θ₂ = 4`) have
       sum norm-squared `‖B₁ + B₂‖² = 25/4 = (5/2)²` (spectral angle `5`), NOT `(7/2)² = 49/4`
       (angle-additivity value `3 + 4 = 7`).
    2. Orthogonal Cayley unit rotors `R₁ = 4/5 - (3/5) e₁₂` and `R₂ = 12/13 - (5/13) e₂₃`
       satisfy `⟨R₁ R₂⟩₀ = 48/65 ≠ 33/65 = c₁ c₂ - s₁ s₂`. -/
theorem counterexample_pythagorean_rat :
    let b1 : Cl3 QRat := smul (-QRat.mk 3 2) e12
    let b2 : Cl3 QRat := smul (-QRat.mk 4 2) e23
    let r1 : Cl3 QRat := rotor (QRat.mk 4 5) (QRat.mk 3 5) e12
    let r2 : Cl3 QRat := rotor (QRat.mk 12 13) (QRat.mk 5 13) e23
    bivecNormSq (b1 + b2) = QRat.mk 25 4 ∧
    bivecNormSq (b1 + b2) ≠ QRat.mk 49 4 ∧
    grade0 (r1 * r2) = QRat.mk 48 65 ∧
    grade0 (r1 * r2) ≠ QRat.mk 4 5 * QRat.mk 12 13 - QRat.mk 3 5 * QRat.mk 5 13 := by
  dsimp only []
  refine ⟨?_, ?_, ?_, ?_⟩
  · simp; qrat_eq
  · exact QRat.ne_of_isZero_sub_false rfl
  · simp; qrat_eq
  · exact QRat.ne_of_isZero_sub_false rfl

end Cl3

end Conjecture00000007607
