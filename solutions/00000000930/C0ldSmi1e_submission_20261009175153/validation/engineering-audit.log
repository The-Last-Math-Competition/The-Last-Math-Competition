def Bergman930.space : Submodule ℂ (ℂ → ℂ) :=
{
  carrier :=
    {f |
      DifferentiableOn ℂ f Bergman930.disk ∧ MeasureTheory.MemLp f 2 Bergman930.area ∧ ∀ z ∉ Bergman930.disk, f z = 0},
