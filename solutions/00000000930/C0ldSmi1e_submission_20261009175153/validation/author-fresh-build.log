def Bergman930.space : Submodule ℂ (ℂ → ℂ) :=
{
  carrier :=
    {f |
      DifferentiableOn ℂ f Bergman930.disk ∧ MeasureTheory.MemLp f 2 Bergman930.area ∧ ∀ z ∉ Bergman930.disk, f z = 0},
  add_mem' := @Bergman930.space._proof_2, zero_mem' := Bergman930.space._proof_3,
  smul_mem' := Bergman930.space._proof_4 }
def Bergman930.area : MeasureTheory.Measure ℂ :=
MeasureTheory.volume.restrict Bergman930.disk
def Bergman930.toL2 : Bergman930.A2 →ₗ[ℂ] ↥(MeasureTheory.Lp ℂ 2 Bergman930.area) :=
{ toFun := fun f => MeasureTheory.MemLp.toLp ↑f ⋯, map_add' := Bergman930.toL2._proof_4,
  map_smul' := Bergman930.toL2._proof_6 }
def Bergman930.l2Space : Submodule ℂ ↥(MeasureTheory.Lp ℂ 2 Bergman930.area) :=
LinearMap.range Bergman930.toL2
def Bergman930.bergmanShift : ↥Bergman930.l2Space →L[ℂ] ↥Bergman930.l2Space :=
Bergman930.l2Shift.mkContinuous 1 Bergman930.bergmanShift._proof_3
def Bergman930.IsReducing : Submodule ℂ ↥Bergman930.l2Space → Prop :=
fun M => IsClosed ↑M ∧ (∀ f ∈ M, Bergman930.bergmanShift f ∈ M) ∧ ∀ f ∈ Mᗮ, Bergman930.bergmanShift f ∈ Mᗮ
Bergman930.square_integrable (f : Bergman930.A2) : MeasureTheory.MemLp (↑f) 2 Bergman930.area
Bergman930.toL2_injective : Function.Injective ⇑Bergman930.toL2
Bergman930.inner_toL2 (f g : Bergman930.A2) :
  inner (Bergman930.toL2 f) (Bergman930.toL2 g) = ∫ (z : ℂ), (starRingEnd ℂ) (↑f z) * ↑g z ∂Bergman930.area
Bergman930.isReducing_iff_adjoint (M : Submodule ℂ ↥Bergman930.l2Space) :
  Bergman930.IsReducing M ↔
    IsClosed ↑M ∧
      (∀ f ∈ M, Bergman930.bergmanShift f ∈ M) ∧ ∀ f ∈ M, (ContinuousLinearMap.adjoint Bergman930.bergmanShift) f ∈ M
Bergman930.reducing_eq_bot_or_top (M : Submodule ℂ ↥Bergman930.l2Space) (hM : Bergman930.IsReducing M) : M = ⊥ ∨ M = ⊤
Bergman930.reducing_cardinality : Cardinal.mk Bergman930.ReducingSubspace = 2
Bergman930.not_continuum : Cardinal.mk Bergman930.ReducingSubspace ≠ Cardinal.continuum
'Bergman930.dslope_memLp' depends on axioms: [propext, Classical.choice, Quot.sound]
