import Main

set_option linter.auxLemma false

run_cmd do
  let names := (← Lean.getEnv).constants.toList.filterMap fun (n, _) =>
    if (`TLMC1520).isPrefixOf n || (n.toString.splitOn ".").contains "TLMC1520" then
      some n else none
  let required := [`TLMC1520.Index,
    `TLMC1520.indexFintype,
    `TLMC1520.indexDecidableEq,
    `TLMC1520.index_card,
    `TLMC1520.matrixStep,
    `TLMC1520.matrixStep_apply,
    `TLMC1520.matrixStep_injective,
    `TLMC1520.FiniteGL,
    `TLMC1520.groupStep,
    `TLMC1520.groupStep_injective,
    `TLMC1520.det_groupStep,
    `TLMC1520.stableDiagram,
    `TLMC1520.StableGL,
    `TLMC1520.intoStable,
    `TLMC1520.determinantTransformation,
    `TLMC1520.determinantCocone,
    `TLMC1520.determinantStable,
    `TLMC1520.determinantStable_into,
    `TLMC1520.K1,
    `TLMC1520.unitsToK1,
    `TLMC1520.determinantK1,
    `TLMC1520.determinantK1_unit,
    `TLMC1520.CyclicFive,
    `TLMC1520.GroupRing,
    `TLMC1520.generator,
    `TLMC1520.cyclicFive_card,
    `TLMC1520.generator_ne_one,
    `TLMC1520.generator_pow_five,
    `TLMC1520.groupUnit,
    `TLMC1520.signedUnit,
    `TLMC1520.trivialUnits,
    `TLMC1520.signedUnit_one,
    `TLMC1520.signedUnit_minus,
    `TLMC1520.trivialUnits_generated,
    `TLMC1520.trivialK1,
    `TLMC1520.trivialK1_generated,
    `TLMC1520.Whitehead,
    `TLMC1520.whiteheadUnit,
    `TLMC1520.whiteheadDeterminant,
    `TLMC1520.whiteheadDeterminant_unit,
    `TLMC1520.inverse_generator_ne,
    `TLMC1520.unitValue,
    `TLMC1520.inverseValue,
    `TLMC1520.unitValue_inverseValue,
    `TLMC1520.inverseValue_unitValue,
    `TLMC1520.counterUnit,
    `TLMC1520.unitValue_generator,
    `TLMC1520.unitValue_inverse_generator,
    `TLMC1520.signedUnit_value,
    `TLMC1520.counterUnit_not_trivial,
    `TLMC1520.whitehead_counterUnit_ne_one,
    `TLMC1520.whitehead_nontrivial,
    `TLMC1520.generators,
    `TLMC1520.generators_card,
    `TLMC1520.generators_symmetric,
    `TLMC1520.generators_generate,
    `TLMC1520.cayley,
    `TLMC1520.cayley_eq_complete,
    `TLMC1520.cayley_connected,
    `TLMC1520.wordDistance,
    `TLMC1520.wordDistance_eq,
    `TLMC1520.shortest_word_exists,
    `TLMC1520.wordDistance_triangle,
    `TLMC1520.wordMetric,
    `TLMC1520.metric_is_word_length,
    `TLMC1520.wordMetric_left_invariant,
    `TLMC1520.wordMetric_bounded,
    `TLMC1520.FourPointHyperbolic,
    `TLMC1520.cayley_four_point_hyperbolic,
    `TLMC1520.complete_counterexample]
  unless required.all names.contains do
    throwError "required complete proof declarations are absent"
  for n in names do
    Lean.Elab.Command.elabCommand (← `(command| #print axioms $(Lean.mkIdent n)))
    Lean.logInfo m!"NAMESPACE_DECL {n}"
  Lean.logInfo m!"NAMESPACE_COVERAGE_OK {names.length}"
