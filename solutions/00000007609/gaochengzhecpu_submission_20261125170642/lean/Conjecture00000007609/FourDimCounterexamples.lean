theorem mulVec_e3 (A : Mat4 F) : A.mulVec (Vec4.e3 F) = A.c3 := by
  let env := envGet (0 : F) [A.c0.x0, A.c0.x1, A.c0.x2, A.c0.x3,
                              A.c1.x0, A.c1.x1, A.c1.x2, A.c1.x3,
                              A.c2.x0, A.c2.x1, A.c2.x2, A.c2.x3,
