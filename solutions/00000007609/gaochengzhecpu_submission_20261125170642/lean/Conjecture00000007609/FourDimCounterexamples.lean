import Conjecture00000007609.PlanarAndLorentz

namespace Conjecture00000007609

structure Vec4 (F : Type) where
  x0 : F
  x1 : F
  x2 : F
  x3 : F

theorem Vec4.ext {F : Type} {u v : Vec4 F}
    (h0 : u.x0 = v.x0) (h1 : u.x1 = v.x1) (h2 : u.x2 = v.x2) (h3 : u.x3 = v.x3) : u = v := by
  cases u; cases v; cases h0; cases h1; cases h2; cases h3; rfl

structure Mat4 (F : Type) where
  c0 : Vec4 F
  c1 : Vec4 F
  c2 : Vec4 F
  c3 : Vec4 F

theorem Mat4.ext {F : Type} {A B : Mat4 F}
    (h0 : A.c0 = B.c0) (h1 : A.c1 = B.c1) (h2 : A.c2 = B.c2) (h3 : A.c3 = B.c3) : A = B := by
  cases A; cases B; cases h0; cases h1; cases h2; cases h3; rfl

section FourDimTheory

variable {F : Type} [FormallyRealField F]

namespace Vec4

def zero (F : Type) [FormallyRealField F] : Vec4 F := ⟨0, 0, 0, 0⟩
def e0 (F : Type) [FormallyRealField F] : Vec4 F := ⟨1, 0, 0, 0⟩
def e1 (F : Type) [FormallyRealField F] : Vec4 F := ⟨0, 1, 0, 0⟩
def e2 (F : Type) [FormallyRealField F] : Vec4 F := ⟨0, 0, 1, 0⟩
def e3 (F : Type) [FormallyRealField F] : Vec4 F := ⟨0, 0, 0, 1⟩

def add (u v : Vec4 F) : Vec4 F :=
  ⟨u.x0 + v.x0, u.x1 + v.x1, u.x2 + v.x2, u.x3 + v.x3⟩

def sub (u v : Vec4 F) : Vec4 F :=
  ⟨u.x0 - v.x0, u.x1 - v.x1, u.x2 - v.x2, u.x3 - v.x3⟩

def neg (u : Vec4 F) : Vec4 F :=
  ⟨-u.x0, -u.x1, -u.x2, -u.x3⟩

def smul (s : F) (u : Vec4 F) : Vec4 F :=
  ⟨s * u.x0, s * u.x1, s * u.x2, s * u.x3⟩

def dot (u v : Vec4 F) : F :=
  u.x0 * v.x0 + u.x1 * v.x1 + u.x2 * v.x2 + u.x3 * v.x3

theorem sub_self (u : Vec4 F) : sub u u = zero F := by
  apply Vec4.ext <;> exact cr_sub_self _

theorem dot_sub_right (p u v : Vec4 F) :
    dot p (sub u v) = dot p u - dot p v := by
  let env := envGet (0 : F)
    [p.x0, p.x1, p.x2, p.x3, u.x0, u.x1, u.x2, u.x3, v.x0, v.x1, v.x2, v.x3]
  exact RExpr.eq_of_norm_eq env
    (e₁ := .add (.add (.add (.mul (.var 0) (.sub (.var 4) (.var 8)))
                            (.mul (.var 1) (.sub (.var 5) (.var 9))))
                      (.mul (.var 2) (.sub (.var 6) (.var 10))))
                (.mul (.var 3) (.sub (.var 7) (.var 11))))
    (e₂ := .sub (.add (.add (.add (.mul (.var 0) (.var 4)) (.mul (.var 1) (.var 5)))
                            (.mul (.var 2) (.var 6)))
                      (.mul (.var 3) (.var 7)))
                (.add (.add (.add (.mul (.var 0) (.var 8)) (.mul (.var 1) (.var 9)))
                            (.mul (.var 2) (.var 10)))
                      (.mul (.var 3) (.var 11)))) rfl

theorem dot_smul_right (s : F) (p u : Vec4 F) :
    dot p (smul s u) = s * dot p u := by
  let env := envGet (0 : F) [s, p.x0, p.x1, p.x2, p.x3, u.x0, u.x1, u.x2, u.x3]
  exact RExpr.eq_of_norm_eq env
    (e₁ := .add (.add (.add (.mul (.var 1) (.mul (.var 0) (.var 5)))
                            (.mul (.var 2) (.mul (.var 0) (.var 6))))
                      (.mul (.var 3) (.mul (.var 0) (.var 7))))
                (.mul (.var 4) (.mul (.var 0) (.var 8))))
    (e₂ := .mul (.var 0)
                (.add (.add (.add (.mul (.var 1) (.var 5)) (.mul (.var 2) (.var 6)))
                            (.mul (.var 3) (.var 7)))
                      (.mul (.var 4) (.var 8)))) rfl

end Vec4

namespace Mat4

def zero (F : Type) [FormallyRealField F] : Mat4 F :=
  ⟨Vec4.zero F, Vec4.zero F, Vec4.zero F, Vec4.zero F⟩

def one (F : Type) [FormallyRealField F] : Mat4 F :=
  ⟨Vec4.e0 F, Vec4.e1 F, Vec4.e2 F, Vec4.e3 F⟩

def negOne (F : Type) [FormallyRealField F] : Mat4 F :=
  ⟨Vec4.neg (Vec4.e0 F), Vec4.neg (Vec4.e1 F), Vec4.neg (Vec4.e2 F), Vec4.neg (Vec4.e3 F)⟩

def mulVec (A : Mat4 F) (v : Vec4 F) : Vec4 F :=
  Vec4.add (Vec4.add (Vec4.smul v.x0 A.c0) (Vec4.smul v.x1 A.c1))
           (Vec4.add (Vec4.smul v.x2 A.c2) (Vec4.smul v.x3 A.c3))

def mul (A B : Mat4 F) : Mat4 F :=
  ⟨A.mulVec B.c0, A.mulVec B.c1, A.mulVec B.c2, A.mulVec B.c3⟩

def sub (A B : Mat4 F) : Mat4 F :=
  ⟨Vec4.sub A.c0 B.c0, Vec4.sub A.c1 B.c1, Vec4.sub A.c2 B.c2, Vec4.sub A.c3 B.c3⟩

def tr (A : Mat4 F) : F :=
  A.c0.x0 + A.c1.x1 + A.c2.x2 + A.c3.x3

def frobDistSq (A B : Mat4 F) : F :=
  Vec4.dot (Vec4.sub A.c0 B.c0) (Vec4.sub A.c0 B.c0) +
  Vec4.dot (Vec4.sub A.c1 B.c1) (Vec4.sub A.c1 B.c1) +
  Vec4.dot (Vec4.sub A.c2 B.c2) (Vec4.sub A.c2 B.c2) +
  Vec4.dot (Vec4.sub A.c3 B.c3) (Vec4.sub A.c3 B.c3)

theorem mulVec_one (v : Vec4 F) : (one F).mulVec v = v := by
  let env := envGet (0 : F) [v.x0, v.x1, v.x2, v.x3]
  apply Vec4.ext
  · exact RExpr.eq_of_norm_eq env
      (e₁ := .add (.add (.mul (.var 0) .one) (.mul (.var 1) .zero))
                  (.add (.mul (.var 2) .zero) (.mul (.var 3) .zero)))
      (e₂ := .var 0) rfl
  · exact RExpr.eq_of_norm_eq env
      (e₁ := .add (.add (.mul (.var 0) .zero) (.mul (.var 1) .one))
                  (.add (.mul (.var 2) .zero) (.mul (.var 3) .zero)))
      (e₂ := .var 1) rfl
  · exact RExpr.eq_of_norm_eq env
      (e₁ := .add (.add (.mul (.var 0) .zero) (.mul (.var 1) .zero))
                  (.add (.mul (.var 2) .one) (.mul (.var 3) .zero)))
      (e₂ := .var 2) rfl
  · exact RExpr.eq_of_norm_eq env
      (e₁ := .add (.add (.mul (.var 0) .zero) (.mul (.var 1) .zero))
                  (.add (.mul (.var 2) .zero) (.mul (.var 3) .one)))
      (e₂ := .var 3) rfl

theorem mulVec_e0 (A : Mat4 F) : A.mulVec (Vec4.e0 F) = A.c0 := by
  let env := envGet (0 : F) [A.c0.x0, A.c0.x1, A.c0.x2, A.c0.x3,
                              A.c1.x0, A.c1.x1, A.c1.x2, A.c1.x3,
                              A.c2.x0, A.c2.x1, A.c2.x2, A.c2.x3,
                              A.c3.x0, A.c3.x1, A.c3.x2, A.c3.x3]
  apply Vec4.ext
  · exact RExpr.eq_of_norm_eq env
      (e₁ := .add (.add (.mul .one (.var 0)) (.mul .zero (.var 4)))
                  (.add (.mul .zero (.var 8)) (.mul .zero (.var 12))))
      (e₂ := .var 0) rfl
  · exact RExpr.eq_of_norm_eq env
      (e₁ := .add (.add (.mul .one (.var 1)) (.mul .zero (.var 5)))
                  (.add (.mul .zero (.var 9)) (.mul .zero (.var 13))))
      (e₂ := .var 1) rfl
  · exact RExpr.eq_of_norm_eq env
      (e₁ := .add (.add (.mul .one (.var 2)) (.mul .zero (.var 6)))
                  (.add (.mul .zero (.var 10)) (.mul .zero (.var 14))))
      (e₂ := .var 2) rfl
  · exact RExpr.eq_of_norm_eq env
      (e₁ := .add (.add (.mul .one (.var 3)) (.mul .zero (.var 7)))
                  (.add (.mul .zero (.var 11)) (.mul .zero (.var 15))))
      (e₂ := .var 3) rfl

theorem mulVec_e1 (A : Mat4 F) : A.mulVec (Vec4.e1 F) = A.c1 := by
  let env := envGet (0 : F) [A.c0.x0, A.c0.x1, A.c0.x2, A.c0.x3,
                              A.c1.x0, A.c1.x1, A.c1.x2, A.c1.x3,
                              A.c2.x0, A.c2.x1, A.c2.x2, A.c2.x3,
                              A.c3.x0, A.c3.x1, A.c3.x2, A.c3.x3]
