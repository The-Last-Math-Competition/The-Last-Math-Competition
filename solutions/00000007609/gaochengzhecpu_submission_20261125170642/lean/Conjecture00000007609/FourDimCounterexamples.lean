      (e₂ := .var 5) rfl
  · exact RExpr.eq_of_norm_eq env
      (e₁ := .add (.add (.mul .zero (.var 2)) (.mul .one (.var 6)))
                  (.add (.mul .zero (.var 10)) (.mul .zero (.var 14))))
      (e₂ := .var 6) rfl
  · exact RExpr.eq_of_norm_eq env
      (e₁ := .add (.add (.mul .zero (.var 3)) (.mul .one (.var 7)))
                  (.add (.mul .zero (.var 11)) (.mul .zero (.var 15))))
      (e₂ := .var 7) rfl

theorem mulVec_e2 (A : Mat4 F) : A.mulVec (Vec4.e2 F) = A.c2 := by
  let env := envGet (0 : F) [A.c0.x0, A.c0.x1, A.c0.x2, A.c0.x3,
                              A.c1.x0, A.c1.x1, A.c1.x2, A.c1.x3,
