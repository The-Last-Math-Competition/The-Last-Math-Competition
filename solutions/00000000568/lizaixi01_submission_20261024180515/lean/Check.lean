import Main

set_option linter.auxLemma false

run_cmd do
  let names := (← Lean.getEnv).constants.toList.filterMap fun (n, _) =>
    if (`TLMC568).isPrefixOf n || (n.toString.splitOn ".").contains "TLMC568" then
      some n else none
  let required := [`TLMC568.Index,
    `TLMC568.Polynomials,
    `TLMC568.Ambient,
    `TLMC568.initialCluster,
    `TLMC568.initial_independent,
    `TLMC568.initial_generates,
    `TLMC568.independent_of_generates,
    `TLMC568.markovMatrix,
    `TLMC568.triangleAdjacency,
    `TLMC568.twoTriangleAdjacency,
    `TLMC568.twoTriangleAdjacency_eq,
    `TLMC568.matrixMutation,
    `TLMC568.markov_skew,
    `TLMC568.mutation_markov,
    `TLMC568.mutation_neg_markov,
    `TLMC568.exchangeNumerator,
    `TLMC568.next_ne,
    `TLMC568.other_ne,
    `TLMC568.exchangeNumerator_ne_zero,
    `TLMC568.mutateCluster,
    `TLMC568.mutate_generates,
    `TLMC568.Seed,
    `TLMC568.Seed.exchangeMatrix,
    `TLMC568.initialSeed,
    `TLMC568.Seed.mutate,
    `TLMC568.Seed.matrix_mutation,
    `TLMC568.Seed.exchange_identity,
    `TLMC568.Seed.mutate_involutive,
    `TLMC568.reachableSeed,
    `TLMC568.clusterVariables,
    `TLMC568.clusterAlgebra,
    `TLMC568.clusterVariable_mem_algebra,
    `TLMC568.reachable_valid,
    `TLMC568.denominator,
    `TLMC568.LaurentModel,
    `TLMC568.localCoordinate,
    `TLMC568.toAmbient,
    `TLMC568.toAmbient_coordinate,
    `TLMC568.toAmbient_injective,
    `TLMC568.specialize,
    `TLMC568.specialize_coordinate,
    `TLMC568.linearCoefficient,
    `TLMC568.linearCoefficient_identity,
    `TLMC568.specialize_linearCoefficient,
    `TLMC568.localSequence,
    `TLMC568.localSequence_invariant,
    `TLMC568.localSequence_exchange,
    `TLMC568.positiveMonomial,
    `TLMC568.negativeMonomial,
    `TLMC568.markov_monomials,
    `TLMC568.neg_markov_monomials,
    `TLMC568.Seed.standard_exchange_relation,
    `TLMC568.Seed.skew_symmetric,
    `TLMC568.Seed.mutate_other,
    `TLMC568.Seed.mutate_same,
    `TLMC568.specializedSequence,
    `TLMC568.specialized_zero,
    `TLMC568.specialized_one,
    `TLMC568.specialized_step,
    `TLMC568.specialized_growth,
    `TLMC568.specialized_positive,
    `TLMC568.specialized_strict,
    `TLMC568.ambientSequence,
    `TLMC568.ambientSequence_zero,
    `TLMC568.ambientSequence_one,
    `TLMC568.ambientSequence_ne_zero,
    `TLMC568.ambientSequence_step,
    `TLMC568.alternatingWord,
    `TLMC568.alternating_cluster,
    `TLMC568.infiniteFamily,
    `TLMC568.infiniteFamily_mem,
    `TLMC568.infiniteFamily_injective,
    `TLMC568.clusterVariables_infinite,
    `TLMC568.printedFormula,
    `TLMC568.printedFormula_one,
    `TLMC568.no_finite_cluster_count,
    `TLMC568.printed_finite_formula_false,
    `TLMC568.complete_counterexample]
  unless required.all names.contains do
    throwError "required complete proof declarations are absent"
  for n in names do
    Lean.Elab.Command.elabCommand (← `(command| #print axioms $(Lean.mkIdent n)))
    Lean.logInfo m!"NAMESPACE_DECL {n}"
  Lean.logInfo m!"NAMESPACE_COVERAGE_OK {names.length}"
