def Conjecture2187.Contains.{u_1, u_2} : {V : Type u_1} → {W : Type u_2} → SimpleGraph V → SimpleGraph W → Prop :=
fun {V} {W} H G => ∃ f, Function.Injective ⇑f
def Conjecture2187.Attainable : {V : Type} → SimpleGraph V → ℕ → Prop :=
fun {V} H m => ∃ W G, Finite ↑G.edgeSet ∧ Conjecture2187.Contains H G ∧ Nat.card ↑G.edgeSet = m
def Conjecture2187.minimumEdges : {V : Type} → (H : SimpleGraph V) → [inst : Finite ↑H.edgeSet] → ℕ :=
fun {V} H [Finite ↑H.edgeSet] => Nat.find ⋯
def Conjecture2187.ClaimedAsymptotic : Prop :=
∃ ε,
  Filter.Tendsto ε Filter.atTop (nhds 0) ∧ ∀ᶠ (n : ℕ) in Filter.atTop, ↑(Conjecture2187.pathMinimum n) = (3 + ε n) * ↑n
Conjecture2187.minimumEdges_attained {V : Type} (H : SimpleGraph V) [Finite ↑H.edgeSet] :
  Conjecture2187.Attainable H (Conjecture2187.minimumEdges H)
Conjecture2187.minimumEdges_le {V : Type} (H : SimpleGraph V) [Finite ↑H.edgeSet] {m : ℕ}
  (hm : Conjecture2187.Attainable H m) : Conjecture2187.minimumEdges H ≤ m
Conjecture2187.minimumEdges_eq {V : Type} (H : SimpleGraph V) [Finite ↑H.edgeSet] :
  Conjecture2187.minimumEdges H = Nat.card ↑H.edgeSet
Conjecture2187.pathMinimum_eq (n : ℕ) : Conjecture2187.pathMinimum n = n - 1
Conjecture2187.pathMinimum_succ (n : ℕ) : Conjecture2187.pathMinimum (n + 1) = n
Conjecture2187.pathMinimum_ratio_tendsto_one :
  Filter.Tendsto (fun n => ↑(Conjecture2187.pathMinimum n) / ↑n) Filter.atTop (nhds 1)
Conjecture2187.pathMinimum_ratio_not_tendsto_three :
  ¬Filter.Tendsto (fun n => ↑(Conjecture2187.pathMinimum n) / ↑n) Filter.atTop (nhds 3)
Conjecture2187.conjecture_false : ¬Conjecture2187.ClaimedAsymptotic
