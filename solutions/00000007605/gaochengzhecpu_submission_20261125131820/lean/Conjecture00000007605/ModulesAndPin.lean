import Conjecture00000007605.FieldAndAlgebras

namespace Conjecture00000007605

section ModulesAndPin

variable {F : Type} [FormallyRealField F]

/-- An `F`-vector space structure on `S`. -/
structure VecSpace (F : Type) [FormallyRealField F] (S : Type) where
  zero : S
  add : S → S → S
  neg : S → S
  smul : F → S → S
  add_assoc : ∀ x y z : S, add (add x y) z = add x (add y z)
  add_comm : ∀ x y : S, add x y = add y x
  zero_add : ∀ x : S, add zero x = x
  neg_add_cancel : ∀ x : S, add (neg x) x = zero
  one_smul : ∀ x : S, smul 1 x = x
  mul_smul : ∀ c d : F, ∀ x : S, smul (c * d) x = smul c (smul d x)
  smul_add : ∀ c : F, ∀ x y : S, smul c (add x y) = add (smul c x) (smul c y)
  add_smul : ∀ c d : F, ∀ x : S, smul (c + d) x = add (smul c x) (smul d x)

theorem vs_add_zero {S : Type} (V : VecSpace F S) (x : S) : V.add x V.zero = x := by
  rw [V.add_comm, V.zero_add]

theorem vs_add_neg_cancel {S : Type} (V : VecSpace F S) (x : S) : V.add x (V.neg x) = V.zero := by
  rw [V.add_comm, V.neg_add_cancel]

theorem vs_add_left_cancel {S : Type} (V : VecSpace F S) {x y z : S}
    (h : V.add x y = V.add x z) : y = z := by
  have h1 := congrArg (V.add (V.neg x)) h
  rw [← V.add_assoc, ← V.add_assoc, V.neg_add_cancel, V.zero_add, V.zero_add] at h1
  exact h1

theorem vs_zero_smul {S : Type} (V : VecSpace F S) (x : S) : V.smul 0 x = V.zero := by
  apply vs_add_left_cancel V (x := V.smul 0 x)
  rw [← V.add_smul, cr_add_zero, vs_add_zero]

theorem vs_smul_zero {S : Type} (V : VecSpace F S) (c : F) : V.smul c V.zero = V.zero := by
  apply vs_add_left_cancel V (x := V.smul c V.zero)
  rw [← V.smul_add, vs_add_zero, vs_add_zero]

theorem vs_neg_one_smul {S : Type} (V : VecSpace F S) (x : S) : V.smul (-(1 : F)) x = V.neg x := by
  apply vs_add_left_cancel V (x := x)
  calc
    V.add x (V.smul (-(1 : F)) x)
        = V.add (V.smul 1 x) (V.smul (-(1 : F)) x) := by rw [V.one_smul]
    _ = V.smul ((1 : F) + -(1 : F)) x := (V.add_smul 1 (-(1 : F)) x).symm
    _ = V.smul 0 x := by rw [cr_add_neg_cancel]
    _ = V.zero := vs_zero_smul V x
    _ = V.add x (V.neg x) := (vs_add_neg_cancel V x).symm

/-- Every `F`-algebra `A` carries an underlying `F`-vector space structure. -/
def Alg.toVecSpace {A : Type} (alg : Alg F A) : VecSpace F A where
  zero := alg.zero
  add := alg.add
  neg := alg.neg
  smul := alg.smul
  add_assoc := alg.add_assoc
  add_comm := alg.add_comm
  zero_add := alg.zero_add
  neg_add_cancel := alg.neg_add_cancel
  one_smul := alg.one_smul
  mul_smul := alg.mul_smul
  smul_add := alg.smul_add
  add_smul := alg.add_smul

/-- Textbook `F`-linear subspace of `S`. -/
structure Subspace (F : Type) [FormallyRealField F] {S : Type} (V : VecSpace F S) where
  mem : S → Prop
  zero_mem : mem V.zero
  add_mem : ∀ x y : S, mem x → mem y → mem (V.add x y)
  smul_mem : ∀ c : F, ∀ x : S, mem x → mem (V.smul c x)

theorem subspace_neg_mem {S : Type} {V : VecSpace F S} (W : Subspace F V) {x : S}
    (hx : W.mem x) : W.mem (V.neg x) := by
  rw [← vs_neg_one_smul V x]
  exact W.smul_mem (-(1 : F)) x hx

/-- Unital `F`-algebra representation of `A` on an `F`-vector space `S`. -/
structure AlgRep (F : Type) [FormallyRealField F] {A S : Type}
    (alg : Alg F A) (V : VecSpace F S) where
  act : A → S → S
  act_one : ∀ s : S, act alg.one s = s
  act_mul : ∀ a b : A, ∀ s : S, act (alg.mul a b) s = act a (act b s)
  act_add_left : ∀ a b : A, ∀ s : S, act (alg.add a b) s = V.add (act a s) (act b s)
  act_smul_left : ∀ c : F, ∀ a : A, ∀ s : S, act (alg.smul c a) s = V.smul c (act a s)
  act_add_right : ∀ a : A, ∀ s t : S, act a (V.add s t) = V.add (act a s) (act a t)
  act_smul_right : ∀ a : A, ∀ c : F, ∀ s : S, act a (V.smul c s) = V.smul c (act a s)

theorem algRep_act_zero_left {A S : Type} {alg : Alg F A} {V : VecSpace F S}
    (ρ : AlgRep F alg V) (s : S) : ρ.act alg.zero s = V.zero := by
  conv => lhs; rw [← alg_zero_smul alg alg.zero]
  rw [ρ.act_smul_left, vs_zero_smul]

theorem algRep_act_zero_right {A S : Type} {alg : Alg F A} {V : VecSpace F S}
    (ρ : AlgRep F alg V) (a : A) : ρ.act a V.zero = V.zero := by
  conv => lhs; rw [← vs_zero_smul V V.zero]
  rw [ρ.act_smul_right, vs_zero_smul]

/-- Left regular representation of any `F`-algebra `A` on itself. -/
def leftRegRep {A : Type} (alg : Alg F A) : AlgRep F alg alg.toVecSpace where
  act := alg.mul
  act_one := alg.one_mul
  act_mul := alg.mul_assoc
  act_add_left := alg.right_distrib
  act_smul_left := alg.smul_mul_left
  act_add_right := alg.left_distrib
  act_smul_right a c s := alg.smul_mul_right c a s

/-- `A`-invariance of an `F`-subspace `W ⊆ S`. -/
def AlgInvariant {A S : Type} {alg : Alg F A} {V : VecSpace F S}
    (ρ : AlgRep F alg V) (W : Subspace F V) : Prop :=
  ∀ a : A, ∀ s : S, W.mem s → W.mem (ρ.act a s)

/-- Textbook irreducibility (simplicity) of an `A`-representation:
    `S` is nonzero and every `A`-invariant `F`-subspace is `{0}` or `S`. -/
def Irreducible {A S : Type} {alg : Alg F A} {V : VecSpace F S}
    (ρ : AlgRep F alg V) : Prop :=
  (∃ s : S, s ≠ V.zero) ∧
  ∀ W : Subspace F V, AlgInvariant ρ W →
    (∀ s : S, W.mem s → s = V.zero) ∨ (∀ s : S, W.mem s)

/-- Every division `F`-algebra is irreducible as a left module over itself. -/
theorem leftRegRep_irreducible_of_division {D : Type} {alg : Alg F D}
    (hdiv : IsDivisionAlg alg) : Irreducible (leftRegRep alg) := by
  refine ⟨⟨alg.one, hdiv.1⟩, fun W hinv => ?_⟩
  by_cases hex : ∃ s : D, W.mem s ∧ s ≠ alg.zero
  · right
    obtain ⟨s₀, hs₀mem, hs₀ne⟩ := hex
    obtain ⟨s₀inv, _, hleft⟩ := hdiv.2 s₀ hs₀ne
    intro x
    have hx : alg.mul (alg.mul x s₀inv) s₀ = x := by
      rw [alg.mul_assoc, hleft, alg.mul_one]
    rw [← hx]
    exact hinv (alg.mul x s₀inv) s₀ hs₀mem
  · left
    intro s hs
    by_cases hsz : s = alg.zero
    · exact hsz
    · exact False.elim (hex ⟨s, hs, hsz⟩)

/-- `A`-equivariant `F`-linear map (`Intertwiner`). -/
@[ext]
structure Intertwiner {A S₁ S₂ : Type} {alg : Alg F A}
    {V₁ : VecSpace F S₁} {V₂ : VecSpace F S₂}
    (ρ₁ : AlgRep F alg V₁) (ρ₂ : AlgRep F alg V₂) where
  toFun : S₁ → S₂
  map_add : ∀ x y : S₁, toFun (V₁.add x y) = V₂.add (toFun x) (toFun y)
  map_smul : ∀ c : F, ∀ x : S₁, toFun (V₁.smul c x) = V₂.smul c (toFun x)
  map_act : ∀ a : A, ∀ x : S₁, toFun (ρ₁.act a x) = ρ₂.act a (toFun x)

theorem intertwiner_map_zero {A S₁ S₂ : Type} {alg : Alg F A}
    {V₁ : VecSpace F S₁} {V₂ : VecSpace F S₂}
    {ρ₁ : AlgRep F alg V₁} {ρ₂ : AlgRep F alg V₂}
    (T : Intertwiner ρ₁ ρ₂) : T.toFun V₁.zero = V₂.zero := by
  rw [← vs_zero_smul V₁ V₁.zero, T.map_smul, vs_zero_smul]

/-- Isomorphism of `A`-representations (`RepIso`). -/
structure RepIso {A S₁ S₂ : Type} {alg : Alg F A}
    {V₁ : VecSpace F S₁} {V₂ : VecSpace F S₂}
    (ρ₁ : AlgRep F alg V₁) (ρ₂ : AlgRep F alg V₂) extends Intertwiner ρ₁ ρ₂ where
  invFun : S₂ → S₁
  left_inv : ∀ x : S₁, invFun (toFun x) = x
  right_inv : ∀ y : S₂, toFun (invFun y) = y

def RepIso.symm {A S₁ S₂ : Type} {alg : Alg F A}
    {V₁ : VecSpace F S₁} {V₂ : VecSpace F S₂}
    {ρ₁ : AlgRep F alg V₁} {ρ₂ : AlgRep F alg V₂}
    (e : RepIso ρ₁ ρ₂) : RepIso ρ₂ ρ₁ where
  toFun := e.invFun
  map_add x y := by
    have h : e.toFun (e.invFun (V₂.add x y)) = e.toFun (V₁.add (e.invFun x) (e.invFun y)) := by
      rw [e.right_inv, e.map_add, e.right_inv, e.right_inv]
    have h2 := congrArg e.invFun h
    rw [e.left_inv, e.left_inv] at h2
    exact h2
  map_smul c x := by
    have h : e.toFun (e.invFun (V₂.smul c x)) = e.toFun (V₁.smul c (e.invFun x)) := by
      rw [e.right_inv, e.map_smul, e.right_inv]
    have h2 := congrArg e.invFun h
    rw [e.left_inv, e.left_inv] at h2
    exact h2
  map_act a x := by
    have h : e.toFun (e.invFun (ρ₂.act a x)) = e.toFun (ρ₁.act a (e.invFun x)) := by
      rw [e.right_inv, e.map_act, e.right_inv]
    have h2 := congrArg e.invFun h
    rw [e.left_inv, e.left_inv] at h2
    exact h2
  invFun := e.toFun
  left_inv := e.right_inv
  right_inv := e.left_inv

/-- Uniqueness of irreducible modules over any division `F`-algebra `D`:
    every irreducible `D`-module is isomorphic to the left regular representation `D`. -/
theorem unique_irreducible_of_division {D S : Type} {alg : Alg F D} {V : VecSpace F S}
    (hdiv : IsDivisionAlg alg) (ρ : AlgRep F alg V) (hirr : Irreducible ρ) :
    Nonempty (RepIso (leftRegRep alg) ρ) := by
  obtain ⟨s₀, hs₀ne⟩ := hirr.1
  let W : Subspace F V := {
    mem := fun s => ∃ d : D, ρ.act d s₀ = s
    zero_mem := ⟨alg.zero, algRep_act_zero_left ρ s₀⟩
    add_mem := by
      rintro _ _ ⟨d₁, rfl⟩ ⟨d₂, rfl⟩
      exact ⟨alg.add d₁ d₂, ρ.act_add_left d₁ d₂ s₀⟩
    smul_mem := by
      rintro c _ ⟨d, rfl⟩
      exact ⟨alg.smul c d, ρ.act_smul_left c d s₀⟩
  }
  have hWinv : AlgInvariant ρ W := by
    rintro a _ ⟨d, rfl⟩
    exact ⟨alg.mul a d, ρ.act_mul a d s₀⟩
  have hWsurj : ∀ s : S, W.mem s := by
    cases hirr.2 W hWinv with
    | inl hzero =>
      exfalso
      apply hs₀ne
      exact hzero s₀ ⟨alg.one, ρ.act_one s₀⟩
    | inr hall => exact hall
  -- Injectivity of `d ↦ ρ.act d s₀`:
  have hinj : ∀ d₁ d₂ : D, ρ.act d₁ s₀ = ρ.act d₂ s₀ → d₁ = d₂ := by
    intro d₁ d₂ heq
    by_cases hdiff : alg.add d₁ (alg.neg d₂) = alg.zero
    · have h1 : alg.add (alg.add d₁ (alg.neg d₂)) d₂ = alg.add alg.zero d₂ :=
        congrArg (fun x => alg.add x d₂) hdiff
      rw [alg.add_assoc, alg.neg_add_cancel, alg_add_zero, alg.zero_add] at h1
      exact h1
    · exfalso
      obtain ⟨u, _, hleft⟩ := hdiv.2 (alg.add d₁ (alg.neg d₂)) hdiff
      have hact0 : ρ.act (alg.add d₁ (alg.neg d₂)) s₀ = V.zero := by
        rw [ρ.act_add_left, ← alg_neg_one_smul alg d₂, ρ.act_smul_left,
            vs_neg_one_smul V, heq, vs_add_neg_cancel]
      have hs0 : s₀ = V.zero := by
        calc
          s₀ = ρ.act alg.one s₀ := (ρ.act_one s₀).symm
          _ = ρ.act (alg.mul u (alg.add d₁ (alg.neg d₂))) s₀ := by rw [hleft]
          _ = ρ.act u (ρ.act (alg.add d₁ (alg.neg d₂)) s₀) := ρ.act_mul _ _ _
          _ = ρ.act u V.zero := by rw [hact0]
          _ = V.zero := algRep_act_zero_right ρ u
      exact hs₀ne hs0
  -- Using `Classical.choose` on `hWsurj` to construct the inverse map:
  let invF : S → D := fun s => Classical.choose (hWsurj s)
  have hinvF : ∀ s : S, ρ.act (invF s) s₀ = s := fun s => Classical.choose_spec (hWsurj s)
  refine ⟨{
    toFun := fun d => ρ.act d s₀
    map_add := fun d₁ d₂ => ρ.act_add_left d₁ d₂ s₀
    map_smul := fun c d => ρ.act_smul_left c d s₀
    map_act := fun a d => ρ.act_mul a d s₀
    invFun := invF
    left_inv := fun d => hinj (invF (ρ.act d s₀)) d (hinvF (ρ.act d s₀))
    right_inv := hinvF
  }⟩

/-- Algebra kernel of a representation: `{a ∈ A | ∀ s, ρ(a)s = 0}`. -/
def InRepKernel {A S : Type} {alg : Alg F A} {V : VecSpace F S}
    (ρ : AlgRep F alg V) (a : A) : Prop :=
  ∀ s : S, ρ.act a s = V.zero

/-- The commutant / endomorphism `F`-algebra `End_A(S)` of a representation `ρ`. -/
def endAlg {A S : Type} {alg : Alg F A} {V : VecSpace F S}
    (ρ : AlgRep F alg V) : Alg F (Intertwiner ρ ρ) where
  zero := {
    toFun := fun _ => V.zero
    map_add := fun _ _ => (vs_add_zero V V.zero).symm
    map_smul := fun c _ => (vs_smul_zero V c).symm
    map_act := fun a _ => (algRep_act_zero_right ρ a).symm
  }
  one := {
    toFun := id
    map_add := fun _ _ => rfl
    map_smul := fun _ _ => rfl
    map_act := fun _ _ => rfl
  }
  add T₁ T₂ := {
    toFun := fun s => V.add (T₁.toFun s) (T₂.toFun s)
    map_add := fun x y => by
      rw [T₁.map_add, T₂.map_add, V.add_assoc, V.add_assoc]
      congr 1
      rw [← V.add_assoc, V.add_comm (T₁.toFun y) (T₂.toFun x), V.add_assoc]
    map_smul := fun c x => by rw [T₁.map_smul, T₂.map_smul, V.smul_add]
    map_act := fun a x => by rw [T₁.map_act, T₂.map_act, ρ.act_add_right]
  }
  neg T := {
    toFun := fun s => V.neg (T.toFun s)
    map_add := fun x y => by
      rw [T.map_add, ← vs_neg_one_smul V, V.smul_add, vs_neg_one_smul, vs_neg_one_smul]
    map_smul := fun c x => by
      rw [T.map_smul, ← vs_neg_one_smul V, ← vs_neg_one_smul V,
          ← V.mul_smul, ← V.mul_smul, CommRingOps.mul_comm]
    map_act := fun a x => by
      rw [T.map_act, ← vs_neg_one_smul V, ← vs_neg_one_smul V, ρ.act_smul_right]
  }
  mul T₁ T₂ := {
    toFun := fun s => T₁.toFun (T₂.toFun s)
    map_add := fun x y => by rw [T₂.map_add, T₁.map_add]
    map_smul := fun c x => by rw [T₂.map_smul, T₁.map_smul]
    map_act := fun a x => by rw [T₂.map_act, T₁.map_act]
  }
  smul c T := {
    toFun := fun s => V.smul c (T.toFun s)
    map_add := fun x y => by rw [T.map_add, V.smul_add]
    map_smul := fun d x => by
      rw [T.map_smul, ← V.mul_smul, ← V.mul_smul, CommRingOps.mul_comm]
    map_act := fun a x => by rw [T.map_act, ρ.act_smul_right]
  }
  add_assoc _ _ _ := by ext; exact V.add_assoc _ _ _
  add_comm _ _ := by ext; exact V.add_comm _ _
  zero_add _ := by ext; exact V.zero_add _
  neg_add_cancel _ := by ext; exact V.neg_add_cancel _
  mul_assoc _ _ _ := by ext; rfl
  one_mul _ := by ext; rfl
  mul_one _ := by ext; rfl
  left_distrib T₁ T₂ T₃ := by ext s; exact T₁.map_add (T₂.toFun s) (T₃.toFun s)
  right_distrib _ _ _ := by ext; rfl
  one_smul _ := by ext; exact V.one_smul _
  mul_smul c d _ := by ext; exact V.mul_smul c d _
  smul_add c _ _ := by ext; exact V.smul_add c _ _
  add_smul c d _ := by ext; exact V.add_smul c d _
  smul_mul_left _ _ _ := by ext; rfl
  smul_mul_right c T₁ T₂ := by ext s; exact T₁.map_smul c (T₂.toFun s)

/-- Isomorphic `A`-representations have isomorphic endomorphism `F`-algebras. -/
def endAlgIsoOfRepIso {A S₁ S₂ : Type} {alg : Alg F A}
    {V₁ : VecSpace F S₁} {V₂ : VecSpace F S₂}
    {ρ₁ : AlgRep F alg V₁} {ρ₂ : AlgRep F alg V₂}
    (e : RepIso ρ₁ ρ₂) : AlgIso F (endAlg ρ₁) (endAlg ρ₂) where
  toFun T := {
    toFun := fun y => e.toFun (T.toFun (e.symm.toFun y))
    map_add := fun x y => by rw [e.symm.map_add, T.map_add, e.map_add]
    map_smul := fun c x => by rw [e.symm.map_smul, T.map_smul, e.map_smul]
    map_act := fun a x => by rw [e.symm.map_act, T.map_act, e.map_act]
  }
  map_one := by ext y; exact e.right_inv y
  map_add T₁ T₂ := by ext y; exact e.map_add _ _
  map_mul T₁ T₂ := by
    ext y
    change e.toFun (T₁.toFun (T₂.toFun (e.invFun y))) =
      e.toFun (T₁.toFun (e.invFun (e.toFun (T₂.toFun (e.invFun y)))))
    rw [e.left_inv]
  map_smul c T := by ext y; exact e.map_smul c _
  invFun U := {
    toFun := fun x => e.symm.toFun (U.toFun (e.toFun x))
    map_add := fun x y => by rw [e.map_add, U.map_add, e.symm.map_add]
    map_smul := fun c x => by rw [e.map_smul, U.map_smul, e.symm.map_smul]
    map_act := fun a x => by rw [e.map_act, U.map_act, e.symm.map_act]
  }
  left_inv T := by ext x; change e.invFun (e.toFun (T.toFun (e.invFun (e.toFun x)))) = T.toFun x; rw [e.left_inv, e.left_inv]
  right_inv U := by ext y; change e.toFun (e.invFun (U.toFun (e.toFun (e.invFun y)))) = U.toFun y; rw [e.right_inv, e.right_inv]

/-! ## The Pin Subgroup `InPin` Inside a Clifford Algebra and Pin–Clifford Equivalence -/

/-- Inductive subgroup of `A` generated by unit vectors `v ∈ V` with `Q(v) = 1 ∨ Q(v) = -1`. -/
inductive InPin {A V : Type} (alg : Alg F A) (ι : V → A) (Q : V → F) : A → Prop where
  | one : InPin alg ι Q alg.one
  | gen (v : V) : (Q v = 1 ∨ Q v = -(1 : F)) → InPin alg ι Q (ι v)
  | mul {x y : A} : InPin alg ι Q x → InPin alg ι Q y → InPin alg ι Q (alg.mul x y)

/-- Proof that `InPin` is a genuine multiplicative subgroup of units in `A`:
    every element of `InPin` has a two-sided inverse inside `InPin`, whenever `ι`
    is odd (`ι(-v) = -ι(v)`), `Q(-v) = Q(v)`, and `ι(v)² = ±Q(v)·1`. -/
theorem inPin_inv_mem {A V : Type} (alg : Alg F A) (vecV : VecSpace F V)
    (ι : V → A) (Q : V → F) (ε : F)
    (hε : ε = 1 ∨ ε = -(1 : F))
    (hι_neg : ∀ v : V, ι (vecV.neg v) = alg.neg (ι v))
    (hQ_neg : ∀ v : V, Q (vecV.neg v) = Q v)
    (hcliff : ∀ v : V, alg.mul (ι v) (ι v) = alg.smul (ε * Q v) alg.one)
    {g : A} (hg : InPin alg ι Q g) :
    ∃ g' : A, InPin alg ι Q g' ∧ alg.mul g g' = alg.one ∧ alg.mul g' g = alg.one := by
  induction hg with
  | one =>
    exact ⟨alg.one, InPin.one, alg.one_mul alg.one, alg.one_mul alg.one⟩
  | gen v hv =>
    have hpm : ε * Q v = 1 ∨ ε * Q v = -(1 : F) := by
      cases hε with
      | inl he1 =>
        rw [he1, CommRingOps.one_mul]
        exact hv
      | inr heneg =>
        rw [heneg]
        cases hv with
        | inl hv1 =>
          right
          rw [hv1, cr_mul_one]
        | inr hvneg =>
          left
          rw [hvneg, cr_neg_mul, cr_mul_neg, cr_neg_neg, cr_mul_one]
    cases hpm with
    | inl hpos =>
      refine ⟨ι v, InPin.gen v hv, ?_, ?_⟩ <;>
        rw [hcliff v, hpos, alg.one_smul]
    | inr hneg =>
      refine ⟨ι (vecV.neg v), InPin.gen (vecV.neg v) (by rw [hQ_neg]; exact hv), ?_, ?_⟩
      · rw [hι_neg, ← alg_neg_one_smul alg (ι v), alg.smul_mul_right,
            hcliff v, hneg, ← alg.mul_smul]
        have h1 : (-(1 : F)) * (-(1 : F)) = 1 := by
          rw [cr_neg_mul, cr_mul_neg, cr_neg_neg, cr_mul_one]
        rw [h1, alg.one_smul]
      · rw [hι_neg, ← alg_neg_one_smul alg (ι v), alg.smul_mul_left,
            hcliff v, hneg, ← alg.mul_smul]
        have h1 : (-(1 : F)) * (-(1 : F)) = 1 := by
          rw [cr_neg_mul, cr_mul_neg, cr_neg_neg, cr_mul_one]
        rw [h1, alg.one_smul]
  | mul hx hy ihx ihy =>
    rename_i x y
    obtain ⟨x', hx'pin, hxx', hx'x⟩ := ihx
    obtain ⟨y', hy'pin, hyy', hy'y⟩ := ihy
    refine ⟨alg.mul y' x', InPin.mul hy'pin hx'pin, ?_, ?_⟩
    · calc
        alg.mul (alg.mul x y) (alg.mul y' x')
            = alg.mul x (alg.mul (alg.mul y y') x') := by
                rw [alg.mul_assoc, ← alg.mul_assoc y y' x']
        _ = alg.mul x (alg.mul alg.one x') := by rw [hyy']
        _ = alg.mul x x' := by rw [alg.one_mul]
        _ = alg.one := hxx'
    · calc
        alg.mul (alg.mul y' x') (alg.mul x y)
            = alg.mul y' (alg.mul (alg.mul x' x) y) := by
                rw [alg.mul_assoc, ← alg.mul_assoc x' x y]
        _ = alg.mul y' (alg.mul alg.one y) := by rw [hx'x]
        _ = alg.mul y' y := by rw [alg.one_mul]
        _ = alg.one := hy'y

/-- `Pin`-invariance, `Pin`-irreducibility, `Pin`-intertwiners, `Pin`-isomorphisms,
    `Pin`-kernels, and `Pin`-endomorphism algebras for the restricted representation `ρ|_{Pin}`. -/
def PinInvariant {A V S : Type} {alg : Alg F A} {vecS : VecSpace F S}
    (ι : V → A) (Q : V → F) (ρ : AlgRep F alg vecS) (W : Subspace F vecS) : Prop :=
  ∀ g : A, InPin alg ι Q g → ∀ s : S, W.mem s → W.mem (ρ.act g s)

def PinIrreducible {A V S : Type} {alg : Alg F A} {vecS : VecSpace F S}
    (ι : V → A) (Q : V → F) (ρ : AlgRep F alg vecS) : Prop :=
  (∃ s : S, s ≠ vecS.zero) ∧
  ∀ W : Subspace F vecS, PinInvariant ι Q ρ W →
    (∀ s : S, W.mem s → s = vecS.zero) ∨ (∀ s : S, W.mem s)

@[ext]
structure PinIntertwiner {A V S₁ S₂ : Type} {alg : Alg F A}
    {V₁ : VecSpace F S₁} {V₂ : VecSpace F S₂}
    (ι : V → A) (Q : V → F)
    (ρ₁ : AlgRep F alg V₁) (ρ₂ : AlgRep F alg V₂) where
  toFun : S₁ → S₂
  map_add : ∀ x y : S₁, toFun (V₁.add x y) = V₂.add (toFun x) (toFun y)
  map_smul : ∀ c : F, ∀ x : S₁, toFun (V₁.smul c x) = V₂.smul c (toFun x)
  map_pin : ∀ g : A, InPin alg ι Q g → ∀ x : S₁, toFun (ρ₁.act g x) = ρ₂.act g (toFun x)

structure PinIso {A V S₁ S₂ : Type} {alg : Alg F A}
    {V₁ : VecSpace F S₁} {V₂ : VecSpace F S₂}
    (ι : V → A) (Q : V → F)
    (ρ₁ : AlgRep F alg V₁) (ρ₂ : AlgRep F alg V₂) extends PinIntertwiner ι Q ρ₁ ρ₂ where
  invFun : S₂ → S₁
  left_inv : ∀ x : S₁, invFun (toFun x) = x
  right_inv : ∀ y : S₂, toFun (invFun y) = y

def InPinKernel {A V S : Type} {alg : Alg F A} {vecS : VecSpace F S}
    (ι : V → A) (Q : V → F) (ρ : AlgRep F alg vecS) (g : A) : Prop :=
  InPin alg ι Q g ∧ ∀ s : S, ρ.act g s = s

def pinEndAlg {A V S : Type} {alg : Alg F A} {vecS : VecSpace F S}
    (ι : V → A) (Q : V → F) (ρ : AlgRep F alg vecS) : Alg F (PinIntertwiner ι Q ρ ρ) where
  zero := {
    toFun := fun _ => vecS.zero
    map_add := fun _ _ => (vs_add_zero vecS vecS.zero).symm
    map_smul := fun c _ => (vs_smul_zero vecS c).symm
    map_pin := fun g _ _ => (algRep_act_zero_right ρ g).symm
  }
  one := {
    toFun := id
    map_add := fun _ _ => rfl
    map_smul := fun _ _ => rfl
    map_pin := fun _ _ _ => rfl
  }
  add T₁ T₂ := {
    toFun := fun s => vecS.add (T₁.toFun s) (T₂.toFun s)
    map_add := fun x y => by
      rw [T₁.map_add, T₂.map_add, vecS.add_assoc, vecS.add_assoc]
      congr 1
      rw [← vecS.add_assoc, vecS.add_comm (T₁.toFun y) (T₂.toFun x), vecS.add_assoc]
    map_smul := fun c x => by rw [T₁.map_smul, T₂.map_smul, vecS.smul_add]
    map_pin := fun g hg x => by rw [T₁.map_pin g hg, T₂.map_pin g hg, ρ.act_add_right]
  }
  neg T := {
    toFun := fun s => vecS.neg (T.toFun s)
    map_add := fun x y => by
      rw [T.map_add, ← vs_neg_one_smul vecS, vecS.smul_add, vs_neg_one_smul, vs_neg_one_smul]
    map_smul := fun c x => by
      rw [T.map_smul, ← vs_neg_one_smul vecS, ← vs_neg_one_smul vecS,
          ← vecS.mul_smul, ← vecS.mul_smul, CommRingOps.mul_comm]
    map_pin := fun g hg x => by
      rw [T.map_pin g hg, ← vs_neg_one_smul vecS, ← vs_neg_one_smul vecS, ρ.act_smul_right]
  }
  mul T₁ T₂ := {
    toFun := fun s => T₁.toFun (T₂.toFun s)
    map_add := fun x y => by rw [T₂.map_add, T₁.map_add]
    map_smul := fun c x => by rw [T₂.map_smul, T₁.map_smul]
    map_pin := fun g hg x => by rw [T₂.map_pin g hg, T₁.map_pin g hg]
  }
  smul c T := {
    toFun := fun s => vecS.smul c (T.toFun s)
    map_add := fun x y => by rw [T.map_add, vecS.smul_add]
    map_smul := fun d x => by
      rw [T.map_smul, ← vecS.mul_smul, ← vecS.mul_smul, CommRingOps.mul_comm]
    map_pin := fun g hg x => by rw [T.map_pin g hg, ρ.act_smul_right]
  }
  add_assoc _ _ _ := by ext; exact vecS.add_assoc _ _ _
  add_comm _ _ := by ext; exact vecS.add_comm _ _
  zero_add _ := by ext; exact vecS.zero_add _
  neg_add_cancel _ := by ext; exact vecS.neg_add_cancel _
  mul_assoc _ _ _ := by ext; rfl
  one_mul _ := by ext; rfl
  mul_one _ := by ext; rfl
  left_distrib T₁ T₂ T₃ := by ext s; exact T₁.map_add (T₂.toFun s) (T₃.toFun s)
  right_distrib _ _ _ := by ext; rfl
  one_smul _ := by ext; exact vecS.one_smul _
  mul_smul c d _ := by ext; exact vecS.mul_smul c d _
  smul_add c _ _ := by ext; exact vecS.smul_add c _ _
  add_smul c d _ := by ext; exact vecS.add_smul c d _
  smul_mul_left _ _ _ := by ext; rfl
  smul_mul_right c T₁ T₂ := by ext s; exact T₁.map_smul c (T₂.toFun s)

/-- Inductive `F`-linear span of `InPin` inside `A`. -/
inductive InPinSpan {A V : Type} (alg : Alg F A) (ι : V → A) (Q : V → F) : A → Prop where
  | zero : InPinSpan alg ι Q alg.zero
  | pin {g : A} : InPin alg ι Q g → InPinSpan alg ι Q g
  | add {x y : A} : InPinSpan alg ι Q x → InPinSpan alg ι Q y → InPinSpan alg ι Q (alg.add x y)
  | smul (c : F) {x : A} : InPinSpan alg ι Q x → InPinSpan alg ι Q (alg.smul c x)

/-- Whenever `InPin` linearly spans `A` over `F` (which holds for every non-degenerate
    Clifford algebra `Cl_{p,q}(F)` since every Grassmann basis blade lies in `Pin(p,q)`),
    `Pin`-invariance, `Pin`-irreducibility, `Pin`-isomorphism, and `End_Pin(S)` coincide
    identically with `Clifford`-invariance, `Clifford`-irreducibility, `Clifford`-isomorphism,
    and `End_Cl(S)`. -/
theorem pinInvariant_iff_algInvariant {A V S : Type} {alg : Alg F A} {vecS : VecSpace F S}
    {ι : V → A} {Q : V → F} (hspan : ∀ a : A, InPinSpan alg ι Q a)
    (ρ : AlgRep F alg vecS) (W : Subspace F vecS) :
    PinInvariant ι Q ρ W ↔ AlgInvariant ρ W := by
  constructor
  · intro hpin a s hs
    induction hspan a with
    | zero =>
      rw [algRep_act_zero_left]
      exact W.zero_mem
    | pin hg => exact hpin _ hg s hs
    | add _ _ ihx ihy =>
      rw [ρ.act_add_left]
      exact W.add_mem _ _ ihx ihy
    | smul c _ ihx =>
      rw [ρ.act_smul_left]
      exact W.smul_mem c _ ihx
  · intro halg g _ s hs
    exact halg g s hs

theorem pinIrreducible_iff_irreducible {A V S : Type} {alg : Alg F A} {vecS : VecSpace F S}
    {ι : V → A} {Q : V → F} (hspan : ∀ a : A, InPinSpan alg ι Q a)
    (ρ : AlgRep F alg vecS) :
    PinIrreducible ι Q ρ ↔ Irreducible ρ := by
  unfold PinIrreducible Irreducible
  constructor
  · rintro ⟨hne, hW⟩
    exact ⟨hne, fun W hinv => hW W ((pinInvariant_iff_algInvariant hspan ρ W).mpr hinv)⟩
  · rintro ⟨hne, hW⟩
    exact ⟨hne, fun W hinv => hW W ((pinInvariant_iff_algInvariant hspan ρ W).mp hinv)⟩

theorem pinAct_eq_algAct_of_span {A V S₁ S₂ : Type} {alg : Alg F A}
    {V₁ : VecSpace F S₁} {V₂ : VecSpace F S₂}
    {ι : V → A} {Q : V → F} (hspan : ∀ a : A, InPinSpan alg ι Q a)
    {ρ₁ : AlgRep F alg V₁} {ρ₂ : AlgRep F alg V₂}
    (T : PinIntertwiner ι Q ρ₁ ρ₂) (a : A) (x : S₁) :
    T.toFun (ρ₁.act a x) = ρ₂.act a (T.toFun x) := by
  induction hspan a with
  | zero =>
    rw [algRep_act_zero_left, algRep_act_zero_left, ← vs_zero_smul V₁ V₁.zero,
        T.map_smul, vs_zero_smul]
  | pin hg => exact T.map_pin _ hg x
  | add _ _ ihx ihy =>
    rw [ρ₁.act_add_left, T.map_add, ihx, ihy, ρ₂.act_add_left]
  | smul c _ ih =>
    rw [ρ₁.act_smul_left, T.map_smul, ih, ρ₂.act_smul_left]

theorem pinIso_iff_repIso {A V S₁ S₂ : Type} {alg : Alg F A}
    {V₁ : VecSpace F S₁} {V₂ : VecSpace F S₂}
    {ι : V → A} {Q : V → F} (hspan : ∀ a : A, InPinSpan alg ι Q a)
    (ρ₁ : AlgRep F alg V₁) (ρ₂ : AlgRep F alg V₂) :
    Nonempty (PinIso ι Q ρ₁ ρ₂) ↔ Nonempty (RepIso ρ₁ ρ₂) := by
  constructor
  · rintro ⟨e⟩
    exact ⟨{
      toFun := e.toFun
      map_add := e.map_add
      map_smul := e.map_smul
      map_act := pinAct_eq_algAct_of_span hspan e.toPinIntertwiner
      invFun := e.invFun
      left_inv := e.left_inv
      right_inv := e.right_inv
    }⟩
  · rintro ⟨e⟩
    exact ⟨{
      toFun := e.toFun
      map_add := e.map_add
      map_smul := e.map_smul
      map_pin := fun g _ x => e.map_act g x
      invFun := e.invFun
      left_inv := e.left_inv
      right_inv := e.right_inv
    }⟩

def pinEndAlgIsoEndAlg {A V S : Type} {alg : Alg F A} {vecS : VecSpace F S}
    {ι : V → A} {Q : V → F} (hspan : ∀ a : A, InPinSpan alg ι Q a)
    (ρ : AlgRep F alg vecS) :
    AlgIso F (pinEndAlg ι Q ρ) (endAlg ρ) where
  toFun T := {
    toFun := T.toFun
    map_add := T.map_add
    map_smul := T.map_smul
    map_act := pinAct_eq_algAct_of_span hspan T
  }
  map_one := rfl
  map_add _ _ := rfl
  map_mul _ _ := rfl
  map_smul _ _ := rfl
  invFun U := {
    toFun := U.toFun
    map_add := U.map_add
    map_smul := U.map_smul
    map_pin := fun g _ x => U.map_act g x
  }
  left_inv _ := by ext; rfl
  right_inv _ := by ext; rfl

end ModulesAndPin

