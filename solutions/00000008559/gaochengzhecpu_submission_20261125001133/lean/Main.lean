/-
Conjecture 00000008559 — Formal Disproof and Complete Structural Analysis
Core Lean 4 (v4.19.0), zero external dependencies, self-contained kernel proofs.

Official Conjecture (00000008559):
  "Definition: The infinite distributive law for complete lattices.
   Conjecture: A complete lattice is completely distributive if and only if it is
   generated by complete chain products; and the smallest complete lattice failing
   complete distributivity is the dual of the three-element antichain construction.
   (complete distributivity chain product characterization)"
-/

namespace Conjecture00000008559

universe u v w

/-- Standard injectivity and surjectivity predicates in Core Lean 4. -/
def Injective {α : Type u} {β : Type v} (f : α → β) : Prop :=
  ∀ ⦃x y : α⦄, f x = f y → x = y

def Surjective {α : Type u} {β : Type v} (f : α → β) : Prop :=
  ∀ b : β, ∃ a : α, f a = b

/-! ## Section 1: Complete Lattices, Order Duals, Products, and Order Isomorphisms -/

/-- Textbook definition of a complete lattice `(L, le, sInf, sSup)` via universal
    greatest-lower-bound and least-upper-bound properties on all subsets `S : L → Prop`. -/
class CompleteLattice (L : Type u) where
  le : L → L → Prop
  le_refl : ∀ x : L, le x x
  le_trans : ∀ {x y z : L}, le x y → le y z → le x z
  le_antisymm : ∀ {x y : L}, le x y → le y x → x = y
  sInf : (L → Prop) → L
  sSup : (L → Prop) → L
  le_sInf_iff : ∀ (S : L → Prop) (z : L), le z (sInf S) ↔ ∀ x, S x → le z x
  sSup_le_iff : ∀ (S : L → Prop) (z : L), le (sSup S) z ↔ ∀ x, S x → le x z

section BasicLattice

variable {L : Type u} [CompleteLattice L]

theorem le_refl' (x : L) : CompleteLattice.le x x :=
  CompleteLattice.le_refl x

theorem le_trans' {x y z : L} (h1 : CompleteLattice.le x y) (h2 : CompleteLattice.le y z) :
    CompleteLattice.le x z :=
  CompleteLattice.le_trans h1 h2

theorem le_antisymm' {x y : L} (h1 : CompleteLattice.le x y) (h2 : CompleteLattice.le y x) :
    x = y :=
  CompleteLattice.le_antisymm h1 h2

theorem sInf_le {S : L → Prop} {x : L} (hx : S x) : CompleteLattice.le (CompleteLattice.sInf S) x :=
  (CompleteLattice.le_sInf_iff S (CompleteLattice.sInf S)).mp (le_refl' _) x hx

theorem le_sInf {S : L → Prop} {z : L} (h : ∀ x, S x → CompleteLattice.le z x) :
    CompleteLattice.le z (CompleteLattice.sInf S) :=
  (CompleteLattice.le_sInf_iff S z).mpr h

theorem le_sSup {S : L → Prop} {x : L} (hx : S x) : CompleteLattice.le x (CompleteLattice.sSup S) :=
  (CompleteLattice.sSup_le_iff S (CompleteLattice.sSup S)).mp (le_refl' _) x hx

theorem sSup_le {S : L → Prop} {z : L} (h : ∀ x, S x → CompleteLattice.le x z) :
    CompleteLattice.le (CompleteLattice.sSup S) z :=
  (CompleteLattice.sSup_le_iff S z).mpr h

/-- Indexed infimum over an arbitrary index type `I : Type v`. -/
def iInf {I : Type v} (f : I → L) : L :=
  CompleteLattice.sInf (fun y => ∃ i : I, f i = y)

/-- Indexed supremum over an arbitrary index type `I : Type v`. -/
def iSup {I : Type v} (f : I → L) : L :=
  CompleteLattice.sSup (fun y => ∃ i : I, f i = y)

theorem le_iInf_iff {I : Type v} (f : I → L) (z : L) :
    CompleteLattice.le z (iInf f) ↔ ∀ i : I, CompleteLattice.le z (f i) := by
  rw [iInf, CompleteLattice.le_sInf_iff]
  constructor
  · intro h i
    exact h (f i) ⟨i, rfl⟩
  · rintro h _ ⟨i, rfl⟩
    exact h i

theorem iSup_le_iff {I : Type v} (f : I → L) (z : L) :
    CompleteLattice.le (iSup f) z ↔ ∀ i : I, CompleteLattice.le (f i) z := by
  rw [iSup, CompleteLattice.sSup_le_iff]
  constructor
  · intro h i
    exact h (f i) ⟨i, rfl⟩
  · rintro h _ ⟨i, rfl⟩
    exact h i

theorem iInf_le {I : Type v} (f : I → L) (i : I) : CompleteLattice.le (iInf f) (f i) :=
  (le_iInf_iff f (iInf f)).mp (le_refl' _) i

theorem le_iSup {I : Type v} (f : I → L) (i : I) : CompleteLattice.le (f i) (iSup f) :=
  (iSup_le_iff f (iSup f)).mp (le_refl' _) i

theorem le_iInf {I : Type v} {f : I → L} {z : L} (h : ∀ i, CompleteLattice.le z (f i)) :
    CompleteLattice.le z (iInf f) :=
  (le_iInf_iff f z).mpr h

theorem iSup_le {I : Type v} {f : I → L} {z : L} (h : ∀ i, CompleteLattice.le (f i) z) :
    CompleteLattice.le (iSup f) z :=
  (iSup_le_iff f z).mpr h

/-- Bottom and top elements of a complete lattice. -/
def bot : L := CompleteLattice.sSup (fun _ => False)
def top : L := CompleteLattice.sInf (fun _ => False)

theorem bot_le (x : L) : CompleteLattice.le bot x :=
  sSup_le (fun _ h => False.elim h)

theorem le_top (x : L) : CompleteLattice.le x top :=
  le_sInf (fun _ h => False.elim h)

/-- Binary meet and binary join derived from `sInf` and `sSup`. -/
def inf (x y : L) : L := CompleteLattice.sInf (fun w => w = x ∨ w = y)
def sup (x y : L) : L := CompleteLattice.sSup (fun w => w = x ∨ w = y)

theorem le_inf_iff (z x y : L) :
    CompleteLattice.le z (inf x y) ↔ CompleteLattice.le z x ∧ CompleteLattice.le z y := by
  rw [inf, CompleteLattice.le_sInf_iff]
  constructor
  · intro h
    exact ⟨h x (Or.inl rfl), h y (Or.inr rfl)⟩
  · rintro ⟨hx, hy⟩ w (rfl | rfl)
    · exact hx
    · exact hy

theorem sup_le_iff (x y z : L) :
    CompleteLattice.le (sup x y) z ↔ CompleteLattice.le x z ∧ CompleteLattice.le y z := by
  rw [sup, CompleteLattice.sSup_le_iff]
  constructor
  · intro h
    exact ⟨h x (Or.inl rfl), h y (Or.inr rfl)⟩
  · rintro ⟨hx, hy⟩ w (rfl | rfl)
    · exact hx
    · exact hy

theorem inf_le_left (x y : L) : CompleteLattice.le (inf x y) x :=
  ((le_inf_iff (inf x y) x y).mp (le_refl' _)).1

theorem inf_le_right (x y : L) : CompleteLattice.le (inf x y) y :=
  ((le_inf_iff (inf x y) x y).mp (le_refl' _)).2

theorem le_inf {z x y : L} (hx : CompleteLattice.le z x) (hy : CompleteLattice.le z y) :
    CompleteLattice.le z (inf x y) :=
  (le_inf_iff z x y).mpr ⟨hx, hy⟩

theorem le_sup_left (x y : L) : CompleteLattice.le x (sup x y) :=
  ((sup_le_iff x y (sup x y)).mp (le_refl' _)).1

theorem le_sup_right (x y : L) : CompleteLattice.le y (sup x y) :=
  ((sup_le_iff x y (sup x y)).mp (le_refl' _)).2

theorem sup_le {x y z : L} (hx : CompleteLattice.le x z) (hy : CompleteLattice.le y z) :
    CompleteLattice.le (sup x y) z :=
  (sup_le_iff x y z).mpr ⟨hx, hy⟩

theorem inf_eq_left {x y : L} (h : CompleteLattice.le x y) : inf x y = x :=
  le_antisymm' (inf_le_left x y) (le_inf (le_refl' x) h)

theorem inf_eq_right {x y : L} (h : CompleteLattice.le y x) : inf x y = y :=
  le_antisymm' (inf_le_right x y) (le_inf h (le_refl' y))

theorem sup_eq_left {x y : L} (h : CompleteLattice.le y x) : sup x y = x :=
  le_antisymm' (sup_le (le_refl' x) h) (le_sup_left x y)

theorem sup_eq_right {x y : L} (h : CompleteLattice.le x y) : sup x y = y :=
  le_antisymm' (sup_le h (le_refl' y)) (le_sup_right x y)

theorem inf_idem (x : L) : inf x x = x := inf_eq_left (le_refl' x)
theorem sup_idem (x : L) : sup x x = x := sup_eq_left (le_refl' x)

theorem inf_bot_right (x : L) : inf x bot = bot := inf_eq_right (bot_le x)
theorem sup_bot_left (x : L) : sup bot x = x := sup_eq_right (bot_le x)
theorem sup_bot_right (x : L) : sup x bot = x := sup_eq_left (bot_le x)
theorem inf_top_left (x : L) : inf top x = x := inf_eq_right (le_top x)
theorem inf_top_right (x : L) : inf x top = x := inf_eq_left (le_top x)

end BasicLattice

/-- Bijection between two types (`Equiv`). -/
structure Equiv (α : Type u) (β : Type v) where
  toFun : α → β
  invFun : β → α
  left_inv : ∀ a : α, invFun (toFun a) = a
  right_inv : ∀ b : β, toFun (invFun b) = b

namespace Equiv

def refl (α : Type u) : Equiv α α where
  toFun := id
  invFun := id
  left_inv _ := rfl
  right_inv _ := rfl

def symm {α : Type u} {β : Type v} (e : Equiv α β) : Equiv β α where
  toFun := e.invFun
  invFun := e.toFun
  left_inv := e.right_inv
  right_inv := e.left_inv

def trans {α : Type u} {β : Type v} {γ : Type w} (e1 : Equiv α β) (e2 : Equiv β γ) : Equiv α γ where
  toFun a := e2.toFun (e1.toFun a)
  invFun c := e1.invFun (e2.invFun c)
  left_inv a := by rw [e2.left_inv, e1.left_inv]
  right_inv c := by rw [e1.right_inv, e2.right_inv]

theorem injective {α : Type u} {β : Type v} (e : Equiv α β) : Injective e.toFun := by
  intro x y h
  have := congrArg e.invFun h
  simpa [e.left_inv] using this

end Equiv

/-- Order isomorphism between complete lattices (bijective order-embedding). -/
structure OrderIso (L : Type u) (M : Type v) [CompleteLattice L] [CompleteLattice M]
    extends Equiv L M where
  map_le_iff : ∀ x y : L, CompleteLattice.le (toFun x) (toFun y) ↔ CompleteLattice.le x y

namespace OrderIso

def refl (L : Type u) [CompleteLattice L] : OrderIso L L where
  toEquiv := Equiv.refl L
  map_le_iff _ _ := Iff.rfl

def symm {L : Type u} {M : Type v} [CompleteLattice L] [CompleteLattice M]
    (e : OrderIso L M) : OrderIso M L where
  toEquiv := e.toEquiv.symm
  map_le_iff x y := by
    change CompleteLattice.le (e.invFun x) (e.invFun y) ↔ CompleteLattice.le x y
    rw [← e.map_le_iff (e.invFun x) (e.invFun y), e.right_inv, e.right_inv]

def trans {L : Type u} {M : Type v} {N : Type w}
    [CompleteLattice L] [CompleteLattice M] [CompleteLattice N]
    (e1 : OrderIso L M) (e2 : OrderIso M N) : OrderIso L N where
  toEquiv := e1.toEquiv.trans e2.toEquiv
  map_le_iff x y := by
    change CompleteLattice.le (e2.toFun (e1.toFun x)) (e2.toFun (e1.toFun y)) ↔ _
    rw [e2.map_le_iff, e1.map_le_iff]

theorem map_sInf {L : Type u} {M : Type v} [CompleteLattice L] [CompleteLattice M]
    (e : OrderIso L M) (S : L → Prop) :
    e.toFun (CompleteLattice.sInf S) = CompleteLattice.sInf (fun y => ∃ x, S x ∧ e.toFun x = y) := by
  apply le_antisymm'
  · apply le_sInf
    rintro _ ⟨x, hx, rfl⟩
    exact (e.map_le_iff _ _).mpr (sInf_le hx)
  · rw [← e.right_inv (CompleteLattice.sInf _), e.map_le_iff]
    apply le_sInf
    intro x hx
    rw [← e.map_le_iff, e.right_inv]
    exact sInf_le ⟨x, hx, rfl⟩

theorem map_sSup {L : Type u} {M : Type v} [CompleteLattice L] [CompleteLattice M]
    (e : OrderIso L M) (S : L → Prop) :
    e.toFun (CompleteLattice.sSup S) = CompleteLattice.sSup (fun y => ∃ x, S x ∧ e.toFun x = y) := by
  apply le_antisymm'
  · rw [← e.right_inv (CompleteLattice.sSup _), e.map_le_iff]
    apply sSup_le
    intro x hx
    rw [← e.map_le_iff, e.right_inv]
    exact le_sSup ⟨x, hx, rfl⟩
  · apply sSup_le
    rintro _ ⟨x, hx, rfl⟩
    exact (e.map_le_iff _ _).mpr (le_sSup hx)

theorem map_inf {L : Type u} {M : Type v} [CompleteLattice L] [CompleteLattice M]
    (e : OrderIso L M) (x y : L) :
    e.toFun (inf x y) = inf (e.toFun x) (e.toFun y) := by
  apply le_antisymm'
  · exact le_inf ((e.map_le_iff _ _).mpr (inf_le_left x y))
      ((e.map_le_iff _ _).mpr (inf_le_right x y))
  · rw [← e.right_inv (inf (e.toFun x) (e.toFun y)), e.map_le_iff]
    apply le_inf
    · rw [← e.map_le_iff, e.right_inv]; exact inf_le_left _ _
    · rw [← e.map_le_iff, e.right_inv]; exact inf_le_right _ _

theorem map_sup {L : Type u} {M : Type v} [CompleteLattice L] [CompleteLattice M]
    (e : OrderIso L M) (x y : L) :
    e.toFun (sup x y) = sup (e.toFun x) (e.toFun y) := by
  apply le_antisymm'
  · rw [← e.right_inv (sup (e.toFun x) (e.toFun y)), e.map_le_iff]
    apply sup_le
    · rw [← e.map_le_iff, e.right_inv]; exact le_sup_left _ _
    · rw [← e.map_le_iff, e.right_inv]; exact le_sup_right _ _
  · exact sup_le ((e.map_le_iff _ _).mpr (le_sup_left x y))
      ((e.map_le_iff _ _).mpr (le_sup_right x y))

end OrderIso

/-- Order dual `L^op` of a type `L`. -/
structure OrderDual (L : Type u) where
  ofDual : L

instance [CompleteLattice L] : CompleteLattice (OrderDual L) where
  le a b := CompleteLattice.le b.ofDual a.ofDual
  le_refl a := CompleteLattice.le_refl a.ofDual
  le_trans h1 h2 := CompleteLattice.le_trans h2 h1
  le_antisymm {a b} h1 h2 := by
    cases a; cases b
    congr
    exact CompleteLattice.le_antisymm h2 h1
  sInf S := ⟨CompleteLattice.sSup (fun x => S ⟨x⟩)⟩
  sSup S := ⟨CompleteLattice.sInf (fun x => S ⟨x⟩)⟩
  le_sInf_iff S z := by
    change CompleteLattice.le (CompleteLattice.sSup (fun x => S ⟨x⟩)) z.ofDual ↔ _
    rw [CompleteLattice.sSup_le_iff]
    exact ⟨fun h ⟨x⟩ hx => h x hx, fun h x hx => h ⟨x⟩ hx⟩
  sSup_le_iff S z := by
    change CompleteLattice.le z.ofDual (CompleteLattice.sInf (fun x => S ⟨x⟩)) ↔ _
    rw [CompleteLattice.le_sInf_iff]
    exact ⟨fun h ⟨x⟩ hx => h x hx, fun h x hx => h ⟨x⟩ hx⟩

theorem dual_iInf_ofDual {L : Type u} [CompleteLattice L] {I : Type v} (f : I → OrderDual L) :
    (iInf f).ofDual = iSup (fun i => (f i).ofDual) := by
  change CompleteLattice.sSup (fun y => ∃ i : I, f i = ⟨y⟩) =
      CompleteLattice.sSup (fun y => ∃ i : I, (f i).ofDual = y)
  apply le_antisymm'
  · apply sSup_le
    rintro y ⟨i, hi⟩
    exact le_sSup ⟨i, (congrArg OrderDual.ofDual hi)⟩
  · apply sSup_le
    rintro y ⟨i, hi⟩
    refine le_sSup ⟨i, ?_⟩
    cases hfi : f i
    rw [hfi] at hi
    dsimp at hi
    subst hi
    rfl

theorem dual_iSup_ofDual {L : Type u} [CompleteLattice L] {I : Type v} (f : I → OrderDual L) :
    (iSup f).ofDual = iInf (fun i => (f i).ofDual) := by
  change CompleteLattice.sInf (fun y => ∃ i : I, f i = ⟨y⟩) =
      CompleteLattice.sInf (fun y => ∃ i : I, (f i).ofDual = y)
  apply le_antisymm'
  · apply le_sInf
    rintro y ⟨i, hi⟩
    refine sInf_le ⟨i, ?_⟩
    cases hfi : f i
    rw [hfi] at hi
    dsimp at hi
    subst hi
    rfl
  · apply le_sInf
    rintro y ⟨i, hi⟩
    exact sInf_le ⟨i, (congrArg OrderDual.ofDual hi)⟩

/-- Direct product `(a : A) → C a` of a family of complete lattices. -/
instance piCompleteLattice {A : Type u} {C : A → Type v} [∀ a, CompleteLattice (C a)] :
    CompleteLattice ((a : A) → C a) where
  le f g := ∀ a, CompleteLattice.le (f a) (g a)
  le_refl f a := CompleteLattice.le_refl (f a)
  le_trans h1 h2 a := CompleteLattice.le_trans (h1 a) (h2 a)
  le_antisymm h1 h2 := funext (fun a => CompleteLattice.le_antisymm (h1 a) (h2 a))
  sInf S a := CompleteLattice.sInf (fun y => ∃ f, S f ∧ f a = y)
  sSup S a := CompleteLattice.sSup (fun y => ∃ f, S f ∧ f a = y)
  le_sInf_iff S z := by
    constructor
    · intro h f hf a
      exact (CompleteLattice.le_sInf_iff _ (z a)).mp (h a) (f a) ⟨f, hf, rfl⟩
    · intro h a
      rw [CompleteLattice.le_sInf_iff]
      rintro _ ⟨f, hf, rfl⟩
      exact h f hf a
  sSup_le_iff S z := by
    constructor
    · intro h f hf a
      exact (CompleteLattice.sSup_le_iff _ (z a)).mp (h a) (f a) ⟨f, hf, rfl⟩
    · intro h a
      rw [CompleteLattice.sSup_le_iff]
      rintro _ ⟨f, hf, rfl⟩
      exact h f hf a

theorem pi_iInf_apply {A : Type u} {C : A → Type v} [∀ a, CompleteLattice (C a)]
    {I : Type w} (g : I → (a : A) → C a) (a : A) :
    iInf g a = iInf (fun i => g i a) := by
  apply le_antisymm'
  · apply le_iInf
    intro i
    exact iInf_le g i a
  · change CompleteLattice.le _ (CompleteLattice.sInf _)
    apply le_sInf
    rintro _ ⟨f, ⟨i, rfl⟩, rfl⟩
    exact iInf_le (fun i => g i a) i

theorem pi_iSup_apply {A : Type u} {C : A → Type v} [∀ a, CompleteLattice (C a)]
    {I : Type w} (g : I → (a : A) → C a) (a : A) :
    iSup g a = iSup (fun i => g i a) := by
  apply le_antisymm'
  · change CompleteLattice.le (CompleteLattice.sSup _) _
    apply sSup_le
    rintro _ ⟨f, ⟨i, rfl⟩, rfl⟩
    exact le_iSup (fun i => g i a) i
  · apply iSup_le
    intro i
    exact le_iSup g i a

/-! ## Section 2: The Infinite Distributive Law (Complete Distributivity) & Self-Duality -/

/-- The meet-over-join infinite distributive law `(CD_∧)` on a complete lattice `L : Type u`. -/
def CDInfSup (L : Type u) [CompleteLattice L] : Prop :=
  ∀ (I : Type u) (J : I → Type u) (x : (i : I) → J i → L),
    iInf (fun i => iSup (fun j => x i j)) =
    iSup (fun (f : (i : I) → J i) => iInf (fun i => x i (f i)))

/-- The dual join-over-meet infinite distributive law `(CD_∨)` on a complete lattice `L : Type u`. -/
def CDSupInf (L : Type u) [CompleteLattice L] : Prop :=
  ∀ (I : Type u) (J : I → Type u) (x : (i : I) → J i → L),
    iSup (fun i => iInf (fun j => x i j)) =
    iInf (fun (f : (i : I) → J i) => iSup (fun i => x i (f i)))

/-- Full complete distributivity (Raney 1952; Davey–Priestley Ch. 10): both dual infinite
    distributive laws hold. -/
def IsCompletelyDistributive (L : Type u) [CompleteLattice L] : Prop :=
  CDInfSup L ∧ CDSupInf L

/-- One inequality `⋁_f ⋀_i x_{i,f(i)} ≤ ⋀_i ⋁_j x_{i,j}` holds in every complete lattice. -/
theorem iSup_iInf_le_iInf_iSup {L : Type u} [CompleteLattice L]
    {I : Type v} {J : I → Type w} (x : (i : I) → J i → L) :
    CompleteLattice.le
      (iSup (fun (f : (i : I) → J i) => iInf (fun i => x i (f i))))
      (iInf (fun i => iSup (fun j => x i j))) := by
  apply iSup_le
  intro f
  apply le_iInf
  intro i
  exact le_trans' (iInf_le (fun i' => x i' (f i')) i) (le_iSup (fun j => x i j) (f i))

/-- Dually, `⋁_i ⋀_j x_{i,j} ≤ ⋀_f ⋁_i x_{i,f(i)}` holds in every complete lattice. -/
theorem iSup_iInf_le_iInf_iSup_dual {L : Type u} [CompleteLattice L]
    {I : Type v} {J : I → Type w} (x : (i : I) → J i → L) :
    CompleteLattice.le
      (iSup (fun i => iInf (fun j => x i j)))
      (iInf (fun (f : (i : I) → J i) => iSup (fun i => x i (f i)))) := by
  apply iSup_le
  intro i
  apply le_iInf
  intro f
  exact le_trans' (iInf_le (fun j => x i j) (f i)) (le_iSup (fun i' => x i' (f i')) i)

/-- Raney's Self-Duality Lemma (1952): `(CD_∧)` implies `(CD_∨)` in any complete lattice. -/
theorem cdSupInf_of_cdInfSup {L : Type u} [CompleteLattice L] (h : CDInfSup L) : CDSupInf L := by
  intro I J x
  apply le_antisymm' (iSup_iInf_le_iInf_iSup_dual x)
  let F := (i : I) → J i
  rw [h F (fun _ => I) (fun f i => x i (f i))]
  apply iSup_le
  intro Φ
  apply Classical.byContradiction
  intro hnot
  have hex : ∀ i : I, ∃ j : J i,
      ¬ CompleteLattice.le (iInf (fun f : F => x (Φ f) (f (Φ f)))) (x i j) := by
    intro i
    apply Classical.byContradiction
    intro hi
    apply hnot
    apply le_trans' _ (le_iSup (fun i' => iInf (fun j => x i' j)) i)
    apply le_iInf
    intro j
    exact Classical.byContradiction (fun hj => hi ⟨j, hj⟩)
  let fStar : F := fun i => Classical.choose (hex i)
  have hfStar : ¬ CompleteLattice.le
      (iInf (fun f : F => x (Φ f) (f (Φ f)))) (x (Φ fStar) (fStar (Φ fStar))) :=
    Classical.choose_spec (hex (Φ fStar))
  exact hfStar (iInf_le (fun f : F => x (Φ f) (f (Φ f))) fStar)

/-- Duality correspondence between `L` and `OrderDual L` for `(CD_∧)` and `(CD_∨)`. -/
theorem cdInfSup_dual_iff {L : Type u} [CompleteLattice L] :
    CDInfSup (OrderDual L) ↔ CDSupInf L := by
  constructor
  · intro h I J x
    have h' := congrArg OrderDual.ofDual (h I J (fun i j => ⟨x i j⟩))
    rw [dual_iInf_ofDual, dual_iSup_ofDual] at h'
    have h1 : (fun i => (iSup (fun j => (⟨x i j⟩ : OrderDual L))).ofDual) =
        (fun i => iInf (fun j => x i j)) := by
      funext i; exact dual_iSup_ofDual (fun j => ⟨x i j⟩)
    have h2 : (fun (f : (i : I) → J i) => (iInf (fun i => (⟨x i (f i)⟩ : OrderDual L))).ofDual) =
        (fun (f : (i : I) → J i) => iSup (fun i => x i (f i))) := by
      funext f; exact dual_iInf_ofDual (fun i => ⟨x i (f i)⟩)
    rw [h1, h2] at h'
    exact h'
  · intro h I J x
    have h' := h I J (fun i j => (x i j).ofDual)
    cases h1 : iInf (fun i => iSup (fun j => x i j)) with | mk v1 =>
    cases h2 : iSup (fun (f : (i : I) → J i) => iInf (fun i => x i (f i))) with | mk v2 =>
    congr 1
    have hv1 : v1 = iSup (fun i => iInf (fun j => (x i j).ofDual)) := by
      have := congrArg OrderDual.ofDual h1
      dsimp at this
      rw [← this, dual_iInf_ofDual]
      have : (fun i => (iSup (fun j => x i j)).ofDual) =
          (fun i => iInf (fun j => (x i j).ofDual)) := by
        funext i; exact dual_iSup_ofDual (fun j => x i j)
      rw [this]
    have hv2 : v2 = iInf (fun (f : (i : I) → J i) => iSup (fun i => (x i (f i)).ofDual)) := by
      have := congrArg OrderDual.ofDual h2
      dsimp at this
      rw [← this, dual_iSup_ofDual]
      have : (fun (f : (i : I) → J i) => (iInf (fun i => x i (f i))).ofDual) =
          (fun (f : (i : I) → J i) => iSup (fun i => (x i (f i)).ofDual)) := by
        funext f; exact dual_iInf_ofDual (fun i => x i (f i))
      rw [this]
    rw [hv1, hv2, h']

theorem cdSupInf_dual_iff {L : Type u} [CompleteLattice L] :
    CDSupInf (OrderDual L) ↔ CDInfSup L := by
  constructor
  · intro h I J x
    have h' := congrArg OrderDual.ofDual (h I J (fun i j => ⟨x i j⟩))
    rw [dual_iSup_ofDual, dual_iInf_ofDual] at h'
    have h1 : (fun i => (iInf (fun j => (⟨x i j⟩ : OrderDual L))).ofDual) =
        (fun i => iSup (fun j => x i j)) := by
      funext i; exact dual_iInf_ofDual (fun j => ⟨x i j⟩)
    have h2 : (fun (f : (i : I) → J i) => (iSup (fun i => (⟨x i (f i)⟩ : OrderDual L))).ofDual) =
        (fun (f : (i : I) → J i) => iInf (fun i => x i (f i))) := by
      funext f; exact dual_iSup_ofDual (fun i => ⟨x i (f i)⟩)
    rw [h1, h2] at h'
    exact h'
  · intro h I J x
    have h' := h I J (fun i j => (x i j).ofDual)
    cases h1 : iSup (fun i => iInf (fun j => x i j)) with | mk v1 =>
    cases h2 : iInf (fun (f : (i : I) → J i) => iSup (fun i => x i (f i))) with | mk v2 =>
    congr 1
    have hv1 : v1 = iInf (fun i => iSup (fun j => (x i j).ofDual)) := by
      have := congrArg OrderDual.ofDual h1
      dsimp at this
      rw [← this, dual_iSup_ofDual]
      have : (fun i => (iInf (fun j => x i j)).ofDual) =
          (fun i => iSup (fun j => (x i j).ofDual)) := by
        funext i; exact dual_iInf_ofDual (fun j => x i j)
      rw [this]
    have hv2 : v2 = iSup (fun (f : (i : I) → J i) => iInf (fun i => (x i (f i)).ofDual)) := by
      have := congrArg OrderDual.ofDual h2
      dsimp at this
      rw [← this, dual_iInf_ofDual]
      have : (fun (f : (i : I) → J i) => (iSup (fun i => x i (f i))).ofDual) =
          (fun (f : (i : I) → J i) => iInf (fun i => (x i (f i)).ofDual)) := by
        funext f; exact dual_iSup_ofDual (fun i => x i (f i))
      rw [this]
    rw [hv1, hv2, h']

/-- Raney's Self-Duality Theorem: `(CD_∧)` and `(CD_∨)` are equivalent in every complete lattice. -/
theorem cdInfSup_iff_cdSupInf {L : Type u} [CompleteLattice L] :
    CDInfSup L ↔ CDSupInf L :=
  ⟨cdSupInf_of_cdInfSup,
   fun h => cdSupInf_dual_iff.mp (cdSupInf_of_cdInfSup (cdInfSup_dual_iff.mpr h))⟩

theorem isCompletelyDistributive_iff_cdInfSup {L : Type u} [CompleteLattice L] :
    IsCompletelyDistributive L ↔ CDInfSup L :=
  ⟨fun h => h.1, fun h => ⟨h, cdSupInf_of_cdInfSup h⟩⟩

theorem isCompletelyDistributive_dual_iff {L : Type u} [CompleteLattice L] :
    IsCompletelyDistributive (OrderDual L) ↔ IsCompletelyDistributive L := by
  rw [isCompletelyDistributive_iff_cdInfSup, cdInfSup_dual_iff,
      isCompletelyDistributive_iff_cdInfSup, cdInfSup_iff_cdSupInf]

/-- Universe-polymorphic infinite distributivity: if `L : Type u` satisfies `CDInfSup L`
    (quantified over `Type u`), then the infinite distributive law holds for index families
    in arbitrary universes `Type v` and `Type w`. -/
theorem IsCompletelyDistributive.iInf_iSup_univ {L : Type u} [CompleteLattice L]
    (hCD : IsCompletelyDistributive L)
    (I : Type v) (J : I → Type w) (x : (i : I) → J i → L) :
    iInf (fun i => iSup (fun j => x i j)) =
    iSup (fun (f : (i : I) → J i) => iInf (fun i => x i (f i))) := by
  apply le_antisymm' _ (iSup_iInf_le_iInf_iSup x)
  let S_of : I → (L → Prop) := fun i y => ∃ j : J i, x i j = y
  let A : Type u := { S : L → Prop // ∃ i : I, S = S_of i }
  let B : A → Type u := fun a => { y : L // a.1 y }
  have hL : CompleteLattice.le
      (iInf (fun i => iSup (fun j => x i j)))
      (iInf (fun (a : A) => iSup (fun (b : B a) => b.1))) := by
    apply le_iInf
    rintro ⟨S, ⟨i, rfl⟩⟩
    refine le_trans' (iInf_le (fun i' => iSup (fun j => x i' j)) i) ?_
    apply iSup_le
    intro j
    exact le_iSup (fun (b : B ⟨S_of i, ⟨i, rfl⟩⟩) => b.1) ⟨x i j, ⟨j, rfl⟩⟩
  refine le_trans' hL ?_
  rw [hCD.1 A B (fun a b => b.1)]
  apply iSup_le
  intro g
  have hex : ∀ i : I, ∃ j : J i, x i j = (g ⟨S_of i, ⟨i, rfl⟩⟩).1 :=
    fun i => (g ⟨S_of i, ⟨i, rfl⟩⟩).2
  let f : (i : I) → J i := fun i => Classical.choose (hex i)
  refine le_trans' ?_ (le_iSup (fun f' : (i : I) → J i => iInf (fun i => x i (f' i))) f)
  apply le_iInf
  intro i
  rw [Classical.choose_spec (hex i)]
  exact iInf_le (fun a : A => (g a).1) ⟨S_of i, ⟨i, rfl⟩⟩

/-- Ordinary finitary distributivity `x ∧ (y ∨ z) = (x ∧ y) ∨ (x ∧ z)`. -/
def IsDistributive (L : Type u) [CompleteLattice L] : Prop :=
  ∀ x y z : L, inf x (sup y z) = sup (inf x y) (inf x z)

def binaryFamIdx : Bool → Type 0
  | true => Unit
  | false => Bool

def binaryFam {L : Type u} (x y z : L) : (b : Bool) → binaryFamIdx b → L
  | true,  _     => x
  | false, true  => y
  | false, false => z

/-- Every completely distributive complete lattice is distributive. -/
theorem IsCompletelyDistributive.isDistributive {L : Type u} [CompleteLattice L]
    (hCD : IsCompletelyDistributive L) : IsDistributive L := by
  intro x y z
  let fam := binaryFam x y z
  have h := hCD.iInf_iSup_univ Bool binaryFamIdx fam
  have hLHS : inf x (sup y z) = iInf (fun b => iSup (fun j => fam b j)) := by
    apply le_antisymm'
    · apply le_iInf
      intro b
      cases b with
      | true =>
        exact le_trans' (inf_le_left x (sup y z)) (le_iSup (fam true) ())
      | false =>
        refine le_trans' (inf_le_right x (sup y z)) ?_
        apply sup_le
        · exact le_iSup (fam false) true
        · exact le_iSup (fam false) false
    · apply le_inf
      · refine le_trans' (iInf_le (fun b => iSup (fam b)) true) ?_
        apply iSup_le; intro _; exact le_refl' x
      · refine le_trans' (iInf_le (fun b => iSup (fam b)) false) ?_
        apply iSup_le
        intro c; cases c
        · exact le_sup_right y z
        · exact le_sup_left y z
  have hRHS : iSup (fun (f : (b : Bool) → binaryFamIdx b) => iInf (fun b => fam b (f b))) =
      sup (inf x y) (inf x z) := by
    apply le_antisymm'
    · apply iSup_le
      intro f
      have hx : CompleteLattice.le (iInf (fun b => fam b (f b))) x :=
        iInf_le (fun b => fam b (f b)) true
      have hyz : CompleteLattice.le (iInf (fun b => fam b (f b))) (fam false (f false)) :=
        iInf_le (fun b => fam b (f b)) false
      cases hf : f false with
      | true =>
        rw [hf] at hyz
        exact le_trans' (le_inf hx hyz) (le_sup_left (inf x y) (inf x z))
      | false =>
        rw [hf] at hyz
        exact le_trans' (le_inf hx hyz) (le_sup_right (inf x y) (inf x z))
    · apply sup_le
      · let f1 : (b : Bool) → binaryFamIdx b := fun b => match b with | true => () | false => true
        refine le_trans' ?_ (le_iSup (fun f : (b : Bool) → binaryFamIdx b => iInf (fun b => fam b (f b))) f1)
        apply le_iInf
        intro b; cases b
        · exact inf_le_right x y
        · exact inf_le_left x y
      · let f2 : (b : Bool) → binaryFamIdx b := fun b => match b with | true => () | false => false
        refine le_trans' ?_ (le_iSup (fun f : (b : Bool) → binaryFamIdx b => iInf (fun b => fam b (f b))) f2)
        apply le_iInf
        intro b; cases b
        · exact inf_le_right x z
        · exact inf_le_left x z
  rw [hLHS, h, hRHS]

/-! ## Section 3: Complete Chains, Chain Products, and Clause 1 Analysis -/

/-- A complete lattice `C` is a complete chain if its order is total. -/
def IsChain (C : Type u) [CompleteLattice C] : Prop :=
  ∀ x y : C, CompleteLattice.le x y ∨ CompleteLattice.le y x

/-- Every complete chain is completely distributive. -/
theorem isCompletelyDistributive_of_isChain {C : Type u} [CompleteLattice C]
    (hChain : IsChain C) : IsCompletelyDistributive C := by
  rw [isCompletelyDistributive_iff_cdInfSup]
  intro I J x
  apply le_antisymm' _ (iSup_iInf_le_iInf_iSup x)
  let lhs := iInf (fun i => iSup (fun j => x i j))
  let rhs := iSup (fun (f : (i : I) → J i) => iInf (fun i => x i (f i)))
  apply Classical.byContradiction
  intro hnot
  have hlt : CompleteLattice.le rhs lhs ∧ ¬ CompleteLattice.le lhs rhs := by
    cases hChain lhs rhs with
    | inl h => exact False.elim (hnot h)
    | inr h => exact ⟨h, hnot⟩
  by_cases hmid : ∃ m : C,
      CompleteLattice.le rhs m ∧ ¬ CompleteLattice.le m rhs ∧
      CompleteLattice.le m lhs ∧ ¬ CompleteLattice.le lhs m
  · rcases hmid with ⟨m, _, hmr, hml, hlm⟩
    have hex : ∀ i : I, ∃ j : J i, ¬ CompleteLattice.le (x i j) m := by
      intro i
      apply Classical.byContradiction
      intro hi
      apply hlm
      refine le_trans' (iInf_le (fun i' => iSup (fun j => x i' j)) i) ?_
      apply iSup_le
      intro j
      exact Classical.byContradiction (fun hj => hi ⟨j, hj⟩)
    let f : (i : I) → J i := fun i => Classical.choose (hex i)
    have hmf : CompleteLattice.le m rhs := by
      refine le_trans' ?_ (le_iSup (fun f' : (i : I) → J i => iInf (fun i => x i (f' i))) f)
      apply le_iInf
      intro i
      cases hChain (x i (f i)) m with
      | inl h => exact False.elim (Classical.choose_spec (hex i) h)
      | inr h => exact h
    exact hmr hmf
  · have hex : ∀ i : I, ∃ j : J i, ¬ CompleteLattice.le (x i j) rhs := by
      intro i
      apply Classical.byContradiction
      intro hi
      apply hlt.2
      refine le_trans' (iInf_le (fun i' => iSup (fun j => x i' j)) i) ?_
      apply iSup_le
      intro j
      exact Classical.byContradiction (fun hj => hi ⟨j, hj⟩)
    let f : (i : I) → J i := fun i => Classical.choose (hex i)
    have hlf : CompleteLattice.le lhs rhs := by
      refine le_trans' ?_ (le_iSup (fun f' : (i : I) → J i => iInf (fun i => x i (f' i))) f)
      apply le_iInf
      intro i
      have hxnot : ¬ CompleteLattice.le (x i (f i)) rhs := Classical.choose_spec (hex i)
      apply Classical.byContradiction
      intro hnot_lx
      have hxl : CompleteLattice.le (x i (f i)) lhs := by
        cases hChain lhs (x i (f i)) with
        | inl h => exact False.elim (hnot_lx h)
        | inr h => exact h
      have hrx : CompleteLattice.le rhs (x i (f i)) := by
        cases hChain (x i (f i)) rhs with
        | inl h => exact False.elim (hxnot h)
        | inr h => exact h
      exact hmid ⟨x i (f i), hrx, hxnot, hxl, hnot_lx⟩
    exact hlt.2 hlf

/-- Direct products of completely distributive complete lattices are completely distributive. -/
theorem isCompletelyDistributive_pi {A : Type u} {L : A → Type u}
    [∀ a, CompleteLattice (L a)] (hCD : ∀ a, IsCompletelyDistributive (L a)) :
    IsCompletelyDistributive ((a : A) → L a) := by
  rw [isCompletelyDistributive_iff_cdInfSup]
  intro I J x
  funext a
  rw [pi_iInf_apply]
  have h1 : (fun i => iSup (fun j => x i j) a) = (fun i => iSup (fun j => x i j a)) := by
    funext i; exact pi_iSup_apply (fun j => x i j) a
  rw [h1, (hCD a).1 I J (fun i j => x i j a), pi_iSup_apply]
  have h2 : (fun (f : (i : I) → J i) => iInf (fun i => x i (f i) a)) =
      (fun (f : (i : I) → J i) => iInf (fun i => x i (f i)) a) := by
    funext f; exact (pi_iInf_apply (fun i => x i (f i)) a).symm
  rw [h2]

/-- Direct products of complete chains are completely distributive. -/
theorem isCompletelyDistributive_chainProduct {A : Type u} {C : A → Type u}
    [∀ a, CompleteLattice (C a)] (hChain : ∀ a, IsChain (C a)) :
    IsCompletelyDistributive ((a : A) → C a) :=
  isCompletelyDistributive_pi (fun a => isCompletelyDistributive_of_isChain (hChain a))

/-- An injective complete-lattice homomorphism (`L` embeds as a complete sublattice into `P`). -/
structure CompleteLatticeEmbedding (L : Type u) (P : Type v)
    [CompleteLattice L] [CompleteLattice P] where
  toFun : L → P
  injective : Injective toFun
  map_sInf : ∀ S : L → Prop,
    toFun (CompleteLattice.sInf S) = CompleteLattice.sInf (fun p => ∃ x, S x ∧ toFun x = p)
  map_sSup : ∀ S : L → Prop,
    toFun (CompleteLattice.sSup S) = CompleteLattice.sSup (fun p => ∃ x, S x ∧ toFun x = p)

namespace CompleteLatticeEmbedding

theorem map_iInf {L : Type u} {P : Type v} [CompleteLattice L] [CompleteLattice P]
    (e : CompleteLatticeEmbedding L P) {I : Type w} (f : I → L) :
    e.toFun (iInf f) = iInf (fun i => e.toFun (f i)) := by
  rw [iInf, e.map_sInf, iInf]
  apply le_antisymm'
  · apply le_sInf
    rintro _ ⟨i, rfl⟩
    exact sInf_le ⟨f i, ⟨i, rfl⟩, rfl⟩
  · apply le_sInf
    rintro _ ⟨x, ⟨i, rfl⟩, rfl⟩
    exact sInf_le ⟨i, rfl⟩

theorem map_iSup {L : Type u} {P : Type v} [CompleteLattice L] [CompleteLattice P]
    (e : CompleteLatticeEmbedding L P) {I : Type w} (f : I → L) :
    e.toFun (iSup f) = iSup (fun i => e.toFun (f i)) := by
  rw [iSup, e.map_sSup, iSup]
  apply le_antisymm'
  · apply sSup_le
    rintro _ ⟨x, ⟨i, rfl⟩, rfl⟩
    exact le_sSup ⟨i, rfl⟩
  · apply sSup_le
    rintro _ ⟨i, rfl⟩
    exact le_sSup ⟨f i, ⟨i, rfl⟩, rfl⟩

end CompleteLatticeEmbedding

/-- Any complete sublattice of a completely distributive complete lattice is completely
    distributive. -/
theorem isCompletelyDistributive_of_completeSublattice
    {L : Type u} {P : Type v} [CompleteLattice L] [CompleteLattice P]
    (e : CompleteLatticeEmbedding L P) (hP : IsCompletelyDistributive P) :
    IsCompletelyDistributive L := by
  rw [isCompletelyDistributive_iff_cdInfSup]
  intro I J x
  apply e.injective
  rw [e.map_iInf]
  have h1 : (fun i => e.toFun (iSup (fun j => x i j))) =
      (fun i => iSup (fun j => e.toFun (x i j))) := by
    funext i; exact e.map_iSup (fun j => x i j)
  rw [h1, hP.iInf_iSup_univ I J (fun i j => e.toFun (x i j)), e.map_iSup]
  have h2 : (fun (f : (i : I) → J i) => iInf (fun i => e.toFun (x i (f i)))) =
      (fun (f : (i : I) → J i) => e.toFun (iInf (fun i => x i (f i)))) := by
    funext f; exact (e.map_iInf (fun i => x i (f i))).symm
  rw [h2]

/-- Raney's characterization predicate (charitable reading of Clause 1): `L` embeds as a
    complete sublattice into a direct product of complete chains. -/
def EmbedsInChainProduct (L : Type u) [CompleteLattice L] : Prop :=
  ∃ (A : Type u) (C : A → Type u) (_ : ∀ a, CompleteLattice (C a)),
    (∀ a, IsChain (C a)) ∧ Nonempty (CompleteLatticeEmbedding L ((a : A) → C a))

/-- Positive direction of Raney's Theorem (1953): every complete lattice that embeds as a
    complete sublattice into a direct product of complete chains is completely distributive. -/
theorem isCompletelyDistributive_of_embedsInChainProduct {L : Type u} [CompleteLattice L]
    (h : EmbedsInChainProduct L) : IsCompletelyDistributive L := by
  rcases h with ⟨A, C, _, hChain, ⟨e⟩⟩
  exact isCompletelyDistributive_of_completeSublattice e (isCompletelyDistributive_chainProduct hChain)

/-- Every `OrderIso` induces a `CompleteLatticeEmbedding`, so complete distributivity is
    invariant under order isomorphism across arbitrary universes. -/
def OrderIso.toCompleteLatticeEmbedding {L : Type u} {M : Type v}
    [CompleteLattice L] [CompleteLattice M] (e : OrderIso L M) :
    CompleteLatticeEmbedding L M where
  toFun := e.toFun
  injective := e.injective
  map_sInf := e.map_sInf
  map_sSup := e.map_sSup

theorem OrderIso.isCompletelyDistributive_iff {L : Type u} {M : Type v}
    [CompleteLattice L] [CompleteLattice M] (e : OrderIso L M) :
    IsCompletelyDistributive L ↔ IsCompletelyDistributive M :=
  ⟨isCompletelyDistributive_of_completeSublattice e.symm.toCompleteLatticeEmbedding,
   isCompletelyDistributive_of_completeSublattice e.toCompleteLatticeEmbedding⟩

/-! ## Section 4: Finite Complete Lattices & Sharp Minimum Cardinality `|L| = 5` -/

section FiniteDistributivity

variable {L : Type u} [CompleteLattice L]

def listSup : List L → L
  | [] => bot
  | a :: as => sup a (listSup as)

def listInf : List L → L
  | [] => top
  | a :: as => inf a (listInf as)

theorem listSup_le_iff (l : List L) (z : L) :
    CompleteLattice.le (listSup l) z ↔ ∀ a ∈ l, CompleteLattice.le a z := by
  induction l with
  | nil =>
    simp [listSup]
    exact bot_le z
  | cons a as ih =>
    simp only [listSup, sup_le_iff, ih, List.mem_cons]
    constructor
    · rintro ⟨ha, has⟩ x (rfl | hx)
      · exact ha
      · exact has x hx
    · intro h
      exact ⟨h a (Or.inl rfl), fun x hx => h x (Or.inr hx)⟩

theorem le_listInf_iff (l : List L) (z : L) :
    CompleteLattice.le z (listInf l) ↔ ∀ a ∈ l, CompleteLattice.le z a := by
  induction l with
  | nil =>
    simp [listInf]
    exact le_top z
  | cons a as ih =>
    simp only [listInf, le_inf_iff, ih, List.mem_cons]
    constructor
    · rintro ⟨ha, has⟩ x (rfl | hx)
      · exact ha
      · exact has x hx
    · intro h
      exact ⟨h a (Or.inl rfl), fun x hx => h x (Or.inr hx)⟩

theorem listSup_append (l1 l2 : List L) :
    listSup (l1 ++ l2) = sup (listSup l1) (listSup l2) := by
  apply le_antisymm'
  · rw [listSup_le_iff]
    intro a ha
    cases List.mem_append.mp ha with
    | inl h1 => exact le_trans' ((listSup_le_iff l1 _).mp (le_refl' _) a h1) (le_sup_left _ _)
    | inr h2 => exact le_trans' ((listSup_le_iff l2 _).mp (le_refl' _) a h2) (le_sup_right _ _)
  · rw [sup_le_iff, listSup_le_iff, listSup_le_iff]
    exact ⟨fun a ha => (listSup_le_iff _ _).mp (le_refl' _) a (List.mem_append_left l2 ha),
           fun a ha => (listSup_le_iff _ _).mp (le_refl' _) a (List.mem_append_right l1 ha)⟩

theorem inf_listSup_of_isDistributive (hD : IsDistributive L) (a : L) (l : List L) :
    inf a (listSup l) = listSup (l.map (inf a)) := by
  induction l with
  | nil => simp [listSup, inf_bot_right]
  | cons b bs ih =>
    simp only [List.map, listSup]
    rw [hD a b (listSup bs), ih]

theorem listSup_inf_of_isDistributive (hD : IsDistributive L) (l : List L) (b : L) :
    inf (listSup l) b = listSup (l.map (fun a => inf a b)) := by
  have hcomm : ∀ x y : L, inf x y = inf y x := fun x y =>
    le_antisymm' (le_inf (inf_le_right x y) (inf_le_left x y))
      (le_inf (inf_le_right y x) (inf_le_left y x))
  rw [hcomm (listSup l) b, inf_listSup_of_isDistributive hD b l]
  have : l.map (inf b) = l.map (fun a => inf a b) := by
    induction l with
    | nil => rfl
    | cons x xs ih => simp [hcomm b x, ih]
  rw [this]

theorem listSup_flatMap_inf (hD : IsDistributive L) (l1 l2 : List L) :
    inf (listSup l1) (listSup l2) = listSup (l1.flatMap (fun a => l2.map (inf a))) := by
  have hcomm : ∀ x y : L, inf x y = inf y x := fun x y =>
    le_antisymm' (le_inf (inf_le_right x y) (inf_le_left x y))
      (le_inf (inf_le_right y x) (inf_le_left y x))
  have hsup_inf : ∀ x y z : L, inf (sup x y) z = sup (inf x z) (inf y z) := fun x y z => by
    rw [hcomm (sup x y) z, hD z x y, hcomm z x, hcomm z y]
  induction l1 with
  | nil =>
    simp [listSup]
    exact le_antisymm' (inf_le_left bot _) (bot_le _)
  | cons a as ih =>
    simp only [listSup, List.flatMap_cons, listSup_append]
    rw [hsup_inf a (listSup as) (listSup l2), inf_listSup_of_isDistributive hD a l2, ih]

def choices : List (List L) → List (List L)
  | [] => [[]]
  | l :: ls => l.flatMap (fun a => (choices ls).map (fun c => a :: c))

theorem map_listInf_choices_step (a : L) (cs : List (List L)) :
    ((cs.map (fun c => a :: c)).map listInf) = (cs.map listInf).map (inf a) := by
  induction cs with
  | nil => rfl
  | cons c cs ih => simp [listInf, ih]

theorem flatMap_map_listInf (l : List L) (cs : List (List L)) :
    (l.flatMap (fun a => cs.map (fun c => a :: c))).map listInf =
    l.flatMap (fun a => (cs.map listInf).map (inf a)) := by
  induction l with
  | nil => rfl
  | cons a as ih =>
    simp only [List.flatMap_cons, List.map_append]
    rw [map_listInf_choices_step, ih]

theorem listInf_map_listSup_eq (hD : IsDistributive L) (ll : List (List L)) :
    listInf (ll.map listSup) = listSup ((choices ll).map listInf) := by
  induction ll with
  | nil =>
    simp [choices, listInf, listSup, sup_bot_right]
  | cons l ls ih =>
    simp only [List.map, listInf, choices]
    rw [ih, listSup_flatMap_inf hD l ((choices ls).map listInf), flatMap_map_listInf]

theorem mem_choices_witness (ll : List (List L)) (c : List L) (hc : c ∈ choices ll) :
    ∀ l ∈ ll, ∃ a ∈ l, CompleteLattice.le (listInf c) a := by
  induction ll generalizing c with
  | nil =>
    intro l hl; cases hl
  | cons l0 ls ih =>
    simp only [choices, List.mem_flatMap, List.mem_map] at hc
    rcases hc with ⟨a0, ha0, c', hc', rfl⟩
    intro l hl
    cases List.mem_cons.mp hl with
    | inl h =>
      subst h
      exact ⟨a0, ha0, inf_le_left a0 (listInf c')⟩
    | inr h =>
      rcases ih c' hc' l h with ⟨a, ha, hle⟩
      exact ⟨a, ha, le_trans' (inf_le_right a0 (listInf c')) hle⟩

def powerSublists {α : Type u} : List α → List (List α)
  | [] => [[]]
  | a :: as => powerSublists as ++ (powerSublists as).map (fun s => a :: s)

noncomputable def filterClassical {α : Type u} (elems : List α) (P : α → Prop) : List α :=
  @List.filter α (fun a => @decide (P a) (Classical.propDecidable (P a))) elems

theorem mem_filterClassical_iff {α : Type u} {elems : List α} (P : α → Prop)
    {a : α} (ha : a ∈ elems) :
    a ∈ filterClassical elems P ↔ P a := by
  unfold filterClassical
  rw [List.mem_filter]
  constructor
  · rintro ⟨_, hdec⟩
    exact @of_decide_eq_true (P a) (Classical.propDecidable (P a)) hdec
  · intro hp
    exact ⟨ha, @decide_eq_true (P a) (Classical.propDecidable (P a)) hp⟩

theorem filterClassical_mem_powerSublists {α : Type u} (elems : List α) (P : α → Prop) :
    filterClassical elems P ∈ powerSublists elems := by
  induction elems with
  | nil => simp [filterClassical, powerSublists]
  | cons a as ih =>
    unfold filterClassical
    simp only [List.filter, powerSublists, List.mem_append, List.mem_map]
    split
    · right
      exact ⟨filterClassical as P, ih, rfl⟩
    · left
      exact ih

/-- On any finite complete lattice, infinite complete distributivity is equivalent to
    ordinary finitary distributivity! -/
theorem finite_completelyDistributive_iff_distributive
    (hfin : ∃ elems : List L, ∀ a : L, a ∈ elems) :
    IsCompletelyDistributive L ↔ IsDistributive L := by
  constructor
  · exact IsCompletelyDistributive.isDistributive
  · intro hD
    rcases hfin with ⟨elems, helems⟩
    rw [isCompletelyDistributive_iff_cdInfSup]
    intro I J x
    apply le_antisymm' _ (iSup_iInf_le_iInf_iSup x)
    let rowList : I → List L := fun i => filterClassical elems (fun y => ∃ j : J i, x i j = y)
    let ll : List (List L) :=
      filterClassical (powerSublists elems) (fun l => ∃ i : I, l = rowList i)
    have hrow_sup : ∀ i : I, iSup (fun j => x i j) = listSup (rowList i) := by
      intro i
      apply le_antisymm'
      · apply iSup_le
        intro j
        have hmem : x i j ∈ rowList i :=
          (mem_filterClassical_iff _ (helems (x i j))).mpr ⟨j, rfl⟩
        exact (listSup_le_iff _ _).mp (le_refl' _) (x i j) hmem
      · rw [listSup_le_iff]
        intro y hy
        rcases (mem_filterClassical_iff _ (helems y)).mp hy with ⟨j, rfl⟩
        exact le_iSup (fun j' => x i j') j
    have hlhs : iInf (fun i => iSup (fun j => x i j)) = listInf (ll.map listSup) := by
      apply le_antisymm'
      · rw [le_listInf_iff]
        intro v hv
        rcases List.mem_map.mp hv with ⟨l, hl, rfl⟩
        have hl_sub : l ∈ powerSublists elems := (List.mem_filter.mp hl).1
        rcases (mem_filterClassical_iff _ hl_sub).mp hl with ⟨i, rfl⟩
        rw [← hrow_sup i]
        exact iInf_le (fun i' => iSup (fun j => x i' j)) i
      · apply le_iInf
        intro i
        rw [hrow_sup i]
        have hmem_ll : rowList i ∈ ll :=
          (mem_filterClassical_iff _ (filterClassical_mem_powerSublists elems _)).mpr ⟨i, rfl⟩
        exact (le_listInf_iff _ _).mp (le_refl' _) (listSup (rowList i))
          (List.mem_map.mpr ⟨rowList i, hmem_ll, rfl⟩)
    rw [hlhs, listInf_map_listSup_eq hD ll, listSup_le_iff]
    intro v hv
    rcases List.mem_map.mp hv with ⟨c, hc, rfl⟩
    have hex : ∀ i : I, ∃ j : J i, CompleteLattice.le (listInf c) (x i j) := by
      intro i
      have hmem_ll : rowList i ∈ ll :=
        (mem_filterClassical_iff _ (filterClassical_mem_powerSublists elems _)).mpr ⟨i, rfl⟩
      rcases mem_choices_witness ll c hc (rowList i) hmem_ll with ⟨a, ha, hle⟩
      rcases (mem_filterClassical_iff _ (helems a)).mp ha with ⟨j, rfl⟩
      exact ⟨j, hle⟩
    let f : (i : I) → J i := fun i => Classical.choose (hex i)
    refine le_trans' ?_ (le_iSup (fun f' : (i : I) → J i => iInf (fun i => x i (f' i))) f)
    apply le_iInf
    intro i
    exact Classical.choose_spec (hex i)

end FiniteDistributivity

/-- Key lattice-theoretic lemma: in ANY complete lattice `L` failing binary distributivity
    `x ∧ (y ∨ z) ≠ (x ∧ y) ∨ (x ∧ z)`, the five elements `(y ∧ z, y, z, y ∨ z, x)` are
    pairwise distinct, yielding an explicit injection `Fin 5 → L`. -/
theorem five_distinct_of_not_distributive {L : Type u} [CompleteLattice L]
    (hnot : ¬ IsDistributive L) :
    ∃ e : Fin 5 → L, Injective e := by
  have hex : ∃ x y z : L, inf x (sup y z) ≠ sup (inf x y) (inf x z) := by
    apply Classical.byContradiction
    intro h
    apply hnot
    intro x y z
    exact Classical.byContradiction (fun hne => h ⟨x, y, z, hne⟩)
  rcases hex with ⟨x, y, z, hne⟩
  have hnyz : ¬ CompleteLattice.le y z := by
    intro hyz
    apply hne
    rw [sup_eq_right hyz]
    have hxy_xz : CompleteLattice.le (inf x y) (inf x z) :=
      le_inf (inf_le_left x y) (le_trans' (inf_le_right x y) hyz)
    rw [sup_eq_right hxy_xz]
  have hnzy : ¬ CompleteLattice.le z y := by
    intro hzy
    apply hne
    rw [sup_eq_left hzy]
    have hxz_xy : CompleteLattice.le (inf x z) (inf x y) :=
      le_inf (inf_le_left x z) (le_trans' (inf_le_right x z) hzy)
    rw [sup_eq_left hxz_xy]
  -- Pairwise inequalities among m = y ∧ z, y, z, M = y ∨ z, and x
  have h01 : inf y z ≠ y := fun h => hnyz (h ▸ inf_le_right y z)
  have h02 : inf y z ≠ z := fun h => hnzy (h ▸ inf_le_left y z)
  have h03 : inf y z ≠ sup y z := fun h =>
    hnyz (le_trans' (le_sup_left y z) (h ▸ inf_le_right y z))
  have h12 : y ≠ z := fun h => hnyz (h ▸ le_refl' y)
  have h13 : y ≠ sup y z := fun h => hnzy (h ▸ le_sup_right y z)
  have h23 : z ≠ sup y z := fun h => hnyz (h ▸ le_sup_left y z)
  have h04 : inf y z ≠ x := by
    intro h; subst h; apply hne
    have h1 : inf (inf y z) (sup y z) = inf y z :=
      inf_eq_left (le_trans' (inf_le_left y z) (le_sup_left y z))
    have h2 : inf (inf y z) y = inf y z := inf_eq_left (inf_le_left y z)
    have h3 : inf (inf y z) z = inf y z := inf_eq_left (inf_le_right y z)
    rw [h1, h2, h3, sup_idem]
  have h14 : y ≠ x := by
    intro h; subst h; apply hne
    rw [inf_eq_left (le_sup_left y z), inf_idem, sup_eq_left (inf_le_left y z)]
  have h24 : z ≠ x := by
    intro h; subst h; apply hne
    rw [inf_eq_left (le_sup_right y z), inf_idem, sup_eq_right (inf_le_left z y)]
  have h34 : sup y z ≠ x := by
    intro h; subst h; apply hne
    rw [inf_idem, inf_eq_right (le_sup_left y z), inf_eq_right (le_sup_right y z)]
  let e : Fin 5 → L := fun i =>
    match i.val with
    | 0 => inf y z
    | 1 => y
    | 2 => z
    | 3 => sup y z
    | _ => x
  refine ⟨e, ?_⟩
  intro ⟨i, hi⟩ ⟨j, hj⟩ heq
  match i, j with
  | 0, 0 | 1, 1 | 2, 2 | 3, 3 | 4, 4 => rfl
  | 0, 1 => exact False.elim (h01 heq)
  | 1, 0 => exact False.elim (h01 heq.symm)
  | 0, 2 => exact False.elim (h02 heq)
  | 2, 0 => exact False.elim (h02 heq.symm)
  | 0, 3 => exact False.elim (h03 heq)
  | 3, 0 => exact False.elim (h03 heq.symm)
  | 0, 4 => exact False.elim (h04 heq)
  | 4, 0 => exact False.elim (h04 heq.symm)
  | 1, 2 => exact False.elim (h12 heq)
  | 2, 1 => exact False.elim (h12 heq.symm)
  | 1, 3 => exact False.elim (h13 heq)
  | 3, 1 => exact False.elim (h13 heq.symm)
  | 1, 4 => exact False.elim (h14 heq)
  | 4, 1 => exact False.elim (h14 heq.symm)
  | 2, 3 => exact False.elim (h23 heq)
  | 3, 2 => exact False.elim (h23 heq.symm)
  | 2, 4 => exact False.elim (h24 heq)
  | 4, 2 => exact False.elim (h24 heq.symm)
  | 3, 4 => exact False.elim (h34 heq)
  | 4, 3 => exact False.elim (h34 heq.symm)
  | n + 5, _ => omega
  | _, m + 5 => omega

/-- Elementary pigeonhole principle on `Fin`: there is no injection `Fin (n + 1) → Fin n`. -/
theorem not_injective_fin_succ (n : Nat) :
    ∀ g : Fin (n + 1) → Fin n, ¬ Injective g := by
  induction n with
  | zero =>
    intro g _
    exact Fin.elim0 (g ⟨0, Nat.zero_lt_succ 0⟩)
  | succ n ih =>
    intro g hg
    let lastVal : Fin (n + 1) := g ⟨n + 1, Nat.lt_succ_self (n + 1)⟩
    have hk_ne : ∀ k : Fin (n + 1), (g ⟨k.val, Nat.lt_succ_of_lt k.isLt⟩).val ≠ lastVal.val := by
      intro k hv
      have heq := hg (Fin.eq_of_val_eq hv)
      have : k.val = n + 1 := congrArg Fin.val heq
      have := k.isLt
      omega
    let g' : Fin (n + 1) → Fin n := fun k =>
      let gk := g ⟨k.val, Nat.lt_succ_of_lt k.isLt⟩
      if h : gk.val < lastVal.val then
        ⟨gk.val, by have := lastVal.isLt; omega⟩
      else
        ⟨gk.val - 1, by have := gk.isLt; have := hk_ne k; omega⟩
    apply ih g'
    intro a b hab
    have ha_val := hk_ne a
    have hb_val := hk_ne b
    dsimp only [g'] at hab
    split at hab <;> split at hab
    · have hv : (g ⟨a.val, Nat.lt_succ_of_lt a.isLt⟩).val =
          (g ⟨b.val, Nat.lt_succ_of_lt b.isLt⟩).val := by
        simpa using congrArg Fin.val hab
      have hgk := hg (Fin.eq_of_val_eq hv)
      exact Fin.eq_of_val_eq (by simpa using congrArg Fin.val hgk)
    · have hv : (g ⟨a.val, Nat.lt_succ_of_lt a.isLt⟩).val =
          (g ⟨b.val, Nat.lt_succ_of_lt b.isLt⟩).val - 1 := by
        simpa using congrArg Fin.val hab
      omega
    · have hv : (g ⟨a.val, Nat.lt_succ_of_lt a.isLt⟩).val - 1 =
          (g ⟨b.val, Nat.lt_succ_of_lt b.isLt⟩).val := by
        simpa using congrArg Fin.val hab
      omega
    · have hv : (g ⟨a.val, Nat.lt_succ_of_lt a.isLt⟩).val - 1 =
          (g ⟨b.val, Nat.lt_succ_of_lt b.isLt⟩).val - 1 := by
        simpa using congrArg Fin.val hab
      have hv2 : (g ⟨a.val, Nat.lt_succ_of_lt a.isLt⟩).val =
          (g ⟨b.val, Nat.lt_succ_of_lt b.isLt⟩).val := by omega
      have hgk := hg (Fin.eq_of_val_eq hv2)
      exact Fin.eq_of_val_eq (by simpa using congrArg Fin.val hgk)

/-- Any type injecting into `Fin n` is finite (admits an exhaustive `List`). -/
theorem finite_list_of_injective_fin :
    ∀ (n : Nat) {α : Type u} (f : α → Fin n), Injective f → ∃ elems : List α, ∀ a : α, a ∈ elems := by
  intro n
  induction n with
  | zero =>
    intro α f _
    exact ⟨[], fun a => Fin.elim0 (f a)⟩
  | succ n ih =>
    intro α f hf
    by_cases hex : ∃ a0 : α, (f a0).val = n
    · rcases hex with ⟨a0, ha0⟩
      let Sub := { a : α // a ≠ a0 }
      let fSub : Sub → Fin n := fun s =>
        ⟨(f s.1).val, by
          have hne : f s.1 ≠ f a0 := fun h => s.2 (hf h)
          have hval : (f s.1).val ≠ (f a0).val := fun hv => hne (Fin.eq_of_val_eq hv)
          have hlt := (f s.1).isLt
          omega⟩
      have hfSub : Injective fSub := by
        intro s1 s2 h
        have hv : (f s1.1).val = (f s2.1).val := by simpa [fSub] using congrArg Fin.val h
        have heq := hf (Fin.eq_of_val_eq hv)
        exact Subtype.ext heq
      rcases ih fSub hfSub with ⟨subElems, hsub⟩
      refine ⟨a0 :: subElems.map Subtype.val, ?_⟩
      intro a
      by_cases ha : a = a0
      · subst ha; exact List.mem_cons_self
      · exact List.mem_cons_of_mem a0 (List.mem_map.mpr ⟨⟨a, ha⟩, hsub ⟨a, ha⟩, rfl⟩)
    · let f' : α → Fin n := fun a =>
        ⟨(f a).val, by
          have hne : (f a).val ≠ n := fun hv => hex ⟨a, hv⟩
          have hlt := (f a).isLt
          omega⟩
      have hf' : Injective f' := by
        intro a1 a2 h
        have hv : (f a1).val = (f a2).val := by simpa [f'] using congrArg Fin.val h
        exact hf (Fin.eq_of_val_eq hv)
      exact ih f' hf'

/-- **Sharpness of Cardinality 5**: Every complete lattice `L` of cardinality at most `4`
    (i.e. admitting an injection `L → Fin n` with `n ≤ 4`) IS completely distributive! -/
theorem completelyDistributive_of_injective_fin_le_four
    {L : Type u} [CompleteLattice L] {n : Nat} (hn : n ≤ 4)
    (f : L → Fin n) (hf : Injective f) :
    IsCompletelyDistributive L := by
  have hfin := finite_list_of_injective_fin n f hf
  rw [finite_completelyDistributive_iff_distributive hfin]
  apply Classical.byContradiction
  intro hnotD
  rcases five_distinct_of_not_distributive hnotD with ⟨e, he⟩
  let g : Fin 5 → Fin 4 := fun i => ⟨(f (e i)).val, Nat.lt_of_lt_of_le (f (e i)).isLt hn⟩
  have hg : Injective g := by
    intro i j hij
    have hv : (f (e i)).val = (f (e j)).val := by simpa [g] using congrArg Fin.val hij
    exact he (hf (Fin.eq_of_val_eq hv))
  exact not_injective_fin_succ 4 g hg

/-! ## Section 5: Explicit Finite Complete Lattice Constructor & Concrete Lattices -/

/-- General constructor: any finite bounded lattice `(L, le, bot, top, inf, sup, elems)`
    is canonically a `CompleteLattice` over arbitrary predicates `S : L → Prop`.
    Marked `@[reducible]` so `CompleteLattice.le` unfolds transparently during `Decidable` synthesis. -/
@[reducible] noncomputable def completeLatticeOfFiniteLattice
    {L : Type u}
    (le : L → L → Prop)
    (bot top : L)
    (myInf mySup : L → L → L)
    (elems : List L)
    (helems : ∀ x : L, x ∈ elems)
    (le_refl : ∀ x, le x x)
    (le_trans : ∀ {x y z}, le x y → le y z → le x z)
    (le_antisymm : ∀ {x y}, le x y → le y x → x = y)
    (bot_le : ∀ x, le bot x)
    (le_top : ∀ x, le x top)
    (le_inf_iff : ∀ z x y, le z (myInf x y) ↔ le z x ∧ le z y)
    (sup_le_iff : ∀ x y z, le (mySup x y) z ↔ le x z ∧ le y z) :
    CompleteLattice L where
  le := le
  le_refl := le_refl
  le_trans := @le_trans
  le_antisymm := @le_antisymm
  sInf := fun S => (filterClassical elems S).foldr myInf top
  sSup := fun S => (filterClassical elems S).foldr mySup bot
  le_sInf_iff := fun S z => by
    have hfoldInf : ∀ (l : List L), le z (l.foldr myInf top) ↔ ∀ x ∈ l, le z x := by
      intro l
      induction l with
      | nil => simp [le_top z]
      | cons a as ih =>
        simp only [List.foldr, le_inf_iff, ih, List.mem_cons]
        exact ⟨fun ⟨ha, has⟩ x h => h.elim (fun e => e ▸ ha) (has x),
               fun h => ⟨h a (Or.inl rfl), fun x hx => h x (Or.inr hx)⟩⟩
    rw [hfoldInf]
    exact ⟨fun h x hx => h x ((mem_filterClassical_iff S (helems x)).mpr hx),
           fun h x hx => h x ((mem_filterClassical_iff S (helems x)).mp hx)⟩
  sSup_le_iff := fun S z => by
    have hfoldSup : ∀ (l : List L), le (l.foldr mySup bot) z ↔ ∀ x ∈ l, le x z := by
      intro l
      induction l with
      | nil => simp [bot_le z]
      | cons a as ih =>
        simp only [List.foldr, sup_le_iff, ih, List.mem_cons]
        exact ⟨fun ⟨ha, has⟩ x h => h.elim (fun e => e ▸ ha) (has x),
               fun h => ⟨h a (Or.inl rfl), fun x hx => h x (Or.inr hx)⟩⟩
    rw [hfoldSup]
    exact ⟨fun h x hx => h x ((mem_filterClassical_iff S (helems x)).mpr hx),
           fun h x hx => h x ((mem_filterClassical_iff S (helems x)).mp hx)⟩

/-! ### 5.1 Two-Element and Three-Element Complete Chains (`Chain2`, `Chain3`) -/

abbrev Chain2 := Bool

def chain2Le (x y : Chain2) : Bool := (!x) || y
def chain2Inf (x y : Chain2) : Chain2 := x && y
def chain2Sup (x y : Chain2) : Chain2 := x || y

@[reducible] noncomputable instance : CompleteLattice Chain2 :=
  completeLatticeOfFiniteLattice
    (fun x y => chain2Le x y = true)
    false true chain2Inf chain2Sup [false, true]
    (by intro x; cases x <;> decide)
    (by intro x; cases x <;> decide)
    (by intro x y z; cases x <;> cases y <;> cases z <;> decide)
    (by intro x y; cases x <;> cases y <;> decide)
    (by intro x; cases x <;> decide)
    (by intro x; cases x <;> decide)
    (by intro z x y; cases z <;> cases x <;> cases y <;> decide)
    (by intro x y z; cases x <;> cases y <;> cases z <;> decide)

instance (x y : Chain2) : Decidable (CompleteLattice.le x y) :=
  inferInstanceAs (Decidable (chain2Le x y = true))

theorem isChain_Chain2 : IsChain Chain2 := by
  intro x y; cases x <;> cases y <;> decide

inductive Chain3 : Type where
  | c0 | c1 | c2
  deriving DecidableEq

def chain3Idx : Chain3 → Nat
  | .c0 => 0 | .c1 => 1 | .c2 => 2

def chain3Le (x y : Chain3) : Bool := decide (chain3Idx x ≤ chain3Idx y)

def chain3Inf (x y : Chain3) : Chain3 := if chain3Le x y then x else y
def chain3Sup (x y : Chain3) : Chain3 := if chain3Le x y then y else x

@[reducible] noncomputable instance : CompleteLattice Chain3 :=
  completeLatticeOfFiniteLattice
    (fun x y => chain3Le x y = true)
    .c0 .c2 chain3Inf chain3Sup [.c0, .c1, .c2]
    (by intro x; cases x <;> decide)
    (by intro x; cases x <;> decide)
    (by intro x y z; cases x <;> cases y <;> cases z <;> decide)
    (by intro x y; cases x <;> cases y <;> decide)
    (by intro x; cases x <;> decide)
    (by intro x; cases x <;> decide)
    (by intro z x y; cases z <;> cases x <;> cases y <;> decide)
    (by intro x y z; cases x <;> cases y <;> cases z <;> decide)

instance (x y : Chain3) : Decidable (CompleteLattice.le x y) :=
  inferInstanceAs (Decidable (chain3Le x y = true))

theorem isChain_Chain3 : IsChain Chain3 := by
  intro x y; cases x <;> cases y <;> decide

/-! ### 5.2 The 5-Element Diamond Lattice `M3` (Bounded Completion of the 3-Antichain) -/

/-- `M3 = {bot, a, b, c, top}`, the Dedekind–MacNeille / bounded completion `0 ⊕ A_3 ⊕ 1`
    of the 3-element antichain `A_3 = {a, b, c}`. -/
inductive M3 : Type where
  | bot | a | b | c | top
  deriving DecidableEq

def m3Le (x y : M3) : Bool :=
  match x, y with
  | .bot, _ => true
  | _, .top => true
  | .a, .a | .b, .b | .c, .c => true
  | _, _ => false

def m3Inf (x y : M3) : M3 :=
  if m3Le x y then x else if m3Le y x then y else .bot

def m3Sup (x y : M3) : M3 :=
  if m3Le x y then y else if m3Le y x then x else .top

@[reducible] noncomputable instance : CompleteLattice M3 :=
  completeLatticeOfFiniteLattice
    (fun x y => m3Le x y = true)
    .bot .top m3Inf m3Sup [.bot, .a, .b, .c, .top]
    (by intro x; cases x <;> decide)
    (by intro x; cases x <;> decide)
    (by intro x y z; cases x <;> cases y <;> cases z <;> decide)
    (by intro x y; cases x <;> cases y <;> decide)
    (by intro x; cases x <;> decide)
    (by intro x; cases x <;> decide)
    (by intro z x y; cases z <;> cases x <;> cases y <;> decide)
    (by intro x y z; cases x <;> cases y <;> cases z <;> decide)

instance (x y : M3) : Decidable (CompleteLattice.le x y) :=
  inferInstanceAs (Decidable (m3Le x y = true))

theorem m3_inf_eq (x y : M3) : inf x y = m3Inf x y := by
  apply le_antisymm'
  · have h1 : CompleteLattice.le (inf x y) x := inf_le_left x y
    have h2 : CompleteLattice.le (inf x y) y := inf_le_right x y
    revert h1 h2
    generalize inf x y = z
    cases z <;> cases x <;> cases y <;> decide
  · apply le_inf
    · cases x <;> cases y <;> decide
    · cases x <;> cases y <;> decide

theorem m3_sup_eq (x y : M3) : sup x y = m3Sup x y := by
  apply le_antisymm'
  · apply sup_le
    · cases x <;> cases y <;> decide
    · cases x <;> cases y <;> decide
  · have h1 : CompleteLattice.le x (sup x y) := le_sup_left x y
    have h2 : CompleteLattice.le y (sup x y) := le_sup_right x y
    revert h1 h2
    generalize sup x y = z
    cases z <;> cases x <;> cases y <;> decide

def equivM3Fin5 : Equiv M3 (Fin 5) where
  toFun x := match x with | .bot => ⟨0, by omega⟩ | .a => ⟨1, by omega⟩
                          | .b => ⟨2, by omega⟩ | .c => ⟨3, by omega⟩ | .top => ⟨4, by omega⟩
  invFun i := match i.val with | 0 => .bot | 1 => .a | 2 => .b | 3 => .c | _ => .top
  left_inv x := by cases x <;> rfl
  right_inv i := by
    rcases i with ⟨n, hn⟩
    match n with
    | 0 | 1 | 2 | 3 | 4 => rfl
    | n + 5 => omega

/-- `M3` is self-dual: `(OrderDual M3) ≃o M3`. -/
def orderIsoDualM3 : OrderIso (OrderDual M3) M3 where
  toFun x := match x.ofDual with
    | .bot => .top | .a => .a | .b => .b | .c => .c | .top => .bot
  invFun y := ⟨match y with
    | .bot => .top | .a => .a | .b => .b | .c => .c | .top => .bot⟩
  left_inv x := by rcases x with ⟨v⟩; cases v <;> rfl
  right_inv y := by cases y <;> rfl
  map_le_iff x y := by
    rcases x with ⟨vx⟩; rcases y with ⟨vy⟩
    change m3Le _ _ = true ↔ m3Le vy vx = true
    cases vx <;> cases vy <;> decide

/-- `M3` fails complete distributivity (`a ∧ (b ∨ c) = a ≠ bot = (a ∧ b) ∨ (a ∧ c)`). -/
theorem not_isCompletelyDistributive_M3 : ¬ IsCompletelyDistributive M3 := by
  intro hCD
  have hD := hCD.isDistributive M3.a M3.b M3.c
  rw [m3_sup_eq, m3_inf_eq, m3_inf_eq, m3_inf_eq, m3_sup_eq] at hD
  revert hD; decide

theorem not_isCompletelyDistributive_dualM3 : ¬ IsCompletelyDistributive (OrderDual M3) := by
  rw [isCompletelyDistributive_dual_iff]
  exact not_isCompletelyDistributive_M3

/-! ### 5.3 The 5-Element Pentagon Lattice `N5` -/

/-- `N5 = {bot, u, v, w, top}` with `bot < u < v < top` and `bot < w < top` (`w` incomparable
    with `u` and `v`). -/
inductive N5 : Type where
  | bot | u | v | w | top
  deriving DecidableEq

def n5Le (x y : N5) : Bool :=
  match x, y with
  | .bot, _ => true
  | _, .top => true
  | .u, .u | .u, .v | .v, .v | .w, .w => true
  | _, _ => false

def n5Inf (x y : N5) : N5 :=
  if n5Le x y then x else if n5Le y x then y else .bot

def n5Sup (x y : N5) : N5 :=
  if n5Le x y then y else if n5Le y x then x else .top

@[reducible] noncomputable instance : CompleteLattice N5 :=
  completeLatticeOfFiniteLattice
    (fun x y => n5Le x y = true)
    .bot .top n5Inf n5Sup [.bot, .u, .v, .w, .top]
    (by intro x; cases x <;> decide)
    (by intro x; cases x <;> decide)
    (by intro x y z; cases x <;> cases y <;> cases z <;> decide)
    (by intro x y; cases x <;> cases y <;> decide)
    (by intro x; cases x <;> decide)
    (by intro x; cases x <;> decide)
    (by intro z x y; cases z <;> cases x <;> cases y <;> decide)
    (by intro x y z; cases x <;> cases y <;> cases z <;> decide)

instance (x y : N5) : Decidable (CompleteLattice.le x y) :=
  inferInstanceAs (Decidable (n5Le x y = true))

theorem n5_inf_eq (x y : N5) : inf x y = n5Inf x y := by
  apply le_antisymm'
  · have h1 : CompleteLattice.le (inf x y) x := inf_le_left x y
    have h2 : CompleteLattice.le (inf x y) y := inf_le_right x y
    revert h1 h2
    generalize inf x y = z
    cases z <;> cases x <;> cases y <;> decide
  · apply le_inf
    · cases x <;> cases y <;> decide
    · cases x <;> cases y <;> decide

theorem n5_sup_eq (x y : N5) : sup x y = n5Sup x y := by
  apply le_antisymm'
  · apply sup_le
    · cases x <;> cases y <;> decide
    · cases x <;> cases y <;> decide
  · have h1 : CompleteLattice.le x (sup x y) := le_sup_left x y
    have h2 : CompleteLattice.le y (sup x y) := le_sup_right x y
    revert h1 h2
    generalize sup x y = z
    cases z <;> cases x <;> cases y <;> decide

def equivN5Fin5 : Equiv N5 (Fin 5) where
  toFun x := match x with | .bot => ⟨0, by omega⟩ | .u => ⟨1, by omega⟩
                          | .v => ⟨2, by omega⟩ | .w => ⟨3, by omega⟩ | .top => ⟨4, by omega⟩
  invFun i := match i.val with | 0 => .bot | 1 => .u | 2 => .v | 3 => .w | _ => .top
  left_inv x := by cases x <;> rfl
  right_inv i := by
    rcases i with ⟨n, hn⟩
    match n with
    | 0 | 1 | 2 | 3 | 4 => rfl
    | n + 5 => omega

/-- `N5` fails complete distributivity (`v ∧ (u ∨ w) = v ≠ u = (v ∧ u) ∨ (v ∧ w)`). -/
theorem not_isCompletelyDistributive_N5 : ¬ IsCompletelyDistributive N5 := by
  intro hCD
  have hD := hCD.isDistributive N5.v N5.u N5.w
  rw [n5_sup_eq, n5_inf_eq, n5_inf_eq, n5_inf_eq, n5_sup_eq] at hD
  revert hD; decide

/-! ### 5.4 Modularity Invariant Distinguishing `M3` (and `OrderDual M3`) from `N5` -/

/-- Modularity law on a complete lattice: `x ≤ z → x ∨ (y ∧ z) = (x ∨ y) ∧ z`. -/
def IsModular (L : Type u) [CompleteLattice L] : Prop :=
  ∀ x y z : L, CompleteLattice.le x z → sup x (inf y z) = inf (sup x y) z

theorem OrderIso.isModular_iff {L : Type u} {M : Type v}
    [CompleteLattice L] [CompleteLattice M] (e : OrderIso L M) :
    IsModular L ↔ IsModular M := by
  suffices ∀ {A : Type u} {B : Type v} [CompleteLattice A] [CompleteLattice B],
      OrderIso A B → IsModular A → IsModular B by
    exact ⟨this e, fun h => by
      intro x y z hxz
      apply e.injective
      rw [e.map_sup, e.map_inf, e.map_inf, e.map_sup]
      exact h (e.toFun x) (e.toFun y) (e.toFun z) ((e.map_le_iff x z).mpr hxz)⟩
  intro A B _ _ iso hA x y z hxz
  have h' : CompleteLattice.le (iso.invFun x) (iso.invFun z) := by
    rw [← iso.map_le_iff, iso.right_inv, iso.right_inv]
    exact hxz
  have hm := congrArg iso.toFun (hA (iso.invFun x) (iso.invFun y) (iso.invFun z) h')
  simpa [iso.map_sup, iso.map_inf, iso.right_inv] using hm

theorem isModular_M3 : IsModular M3 := by
  intro x y z hxz
  simp only [m3_sup_eq, m3_inf_eq]
  revert hxz
  cases x <;> cases y <;> cases z <;> decide

theorem not_isModular_N5 : ¬ IsModular N5 := by
  intro hM
  have huv : CompleteLattice.le N5.u N5.v := by decide
  have h := hM N5.u N5.w N5.v huv
  rw [n5_inf_eq, n5_sup_eq, n5_sup_eq, n5_inf_eq] at h
  revert h; decide

/-- `M3` and `N5` are NOT order-isomorphic! -/
theorem not_orderIso_M3_N5 : ¬ Nonempty (OrderIso M3 N5) := by
  rintro ⟨e⟩
  exact not_isModular_N5 ((e.isModular_iff).mp isModular_M3)

/-- `OrderDual M3` and `N5` are NOT order-isomorphic! -/
theorem not_orderIso_dualM3_N5 : ¬ Nonempty (OrderIso (OrderDual M3) N5) := by
  rintro ⟨e⟩
  exact not_orderIso_M3_N5 ⟨orderIsoDualM3.symm.trans e⟩

/-! ### 5.5 Reading 2B: Dual of the Down-Set Completion of `A_3` (`O(A_3)^op ≅ B_3^op`) -/

/-- Since every subset of the 3-element antichain `A_3 = Fin 3` is a down-set, the dual
    of the down-set completion `O(A_3)^op` is `OrderDual (Fin 3 → Chain2)`. -/
abbrev DualDownSetA3 : Type := OrderDual (Fin 3 → Chain2)

/-- `O(A_3)^op` has cardinality `8` AND IS completely distributive (so it does not even
    fail complete distributivity!). -/
theorem isCompletelyDistributive_DualDownSetA3 : IsCompletelyDistributive DualDownSetA3 := by
  rw [isCompletelyDistributive_dual_iff]
  exact isCompletelyDistributive_chainProduct (fun _ => isChain_Chain2)

def bitsToFin8 : Bool → Bool → Bool → Fin 8
  | false, false, false => ⟨0, by omega⟩
  | true,  false, false => ⟨1, by omega⟩
  | false, true,  false => ⟨2, by omega⟩
  | true,  true,  false => ⟨3, by omega⟩
  | false, false, true  => ⟨4, by omega⟩
  | true,  false, true  => ⟨5, by omega⟩
  | false, true,  true  => ⟨6, by omega⟩
  | true,  true,  true  => ⟨7, by omega⟩

def fin8ToBits (n : Nat) (i : Nat) : Bool :=
  match n, i with
  | 1, 0 | 3, 0 | 5, 0 | 7, 0 => true
  | 2, 1 | 3, 1 | 6, 1 | 7, 1 => true
  | 4, 2 | 5, 2 | 6, 2 | 7, 2 => true
  | _, _ => false

def equivDualDownSetA3Fin8 : Equiv DualDownSetA3 (Fin 8) where
  toFun d := bitsToFin8 (d.ofDual 0) (d.ofDual 1) (d.ofDual 2)
  invFun k := ⟨fun i => fin8ToBits k.val i.val⟩
  left_inv d := by
    rcases d with ⟨f⟩
    congr 1
    funext ⟨i, hi⟩
    have h0 : f 0 = true ∨ f 0 = false := by cases f 0 <;> simp
    have h1 : f 1 = true ∨ f 1 = false := by cases f 1 <;> simp
    have h2 : f 2 = true ∨ f 2 = false := by cases f 2 <;> simp
    match i with
    | 0 =>
      change fin8ToBits (bitsToFin8 (f 0) (f 1) (f 2)).val 0 = f 0
      rcases h0 with h0 | h0 <;> rcases h1 with h1 | h1 <;> rcases h2 with h2 | h2 <;>
        rw [h0, h1, h2] <;> rfl
    | 1 =>
      change fin8ToBits (bitsToFin8 (f 0) (f 1) (f 2)).val 1 = f 1
      rcases h0 with h0 | h0 <;> rcases h1 with h1 | h1 <;> rcases h2 with h2 | h2 <;>
        rw [h0, h1, h2] <;> rfl
    | 2 =>
      change fin8ToBits (bitsToFin8 (f 0) (f 1) (f 2)).val 2 = f 2
      rcases h0 with h0 | h0 <;> rcases h1 with h1 | h1 <;> rcases h2 with h2 | h2 <;>
        rw [h0, h1, h2] <;> rfl
    | n + 3 => omega
  right_inv k := by
    rcases k with ⟨n, hn⟩
    match n with
    | 0 | 1 | 2 | 3 | 4 | 5 | 6 | 7 => rfl
    | n + 8 => omega

/-! ### 5.6 Literal Counterexamples to Clause 1 ("generated by complete chain products") -/

/-- The three 3-element chains `{bot, a, top}`, `{bot, b, top}`, `{bot, c, top}` inside `M3`,
    each embedding `Chain3` as a complete sublattice of `M3`. -/
def m3ChainEmb (k : Fin 3) : Chain3 → M3
  | .c0 => .bot
  | .c1 => match k.val with | 0 => .a | 1 => .b | _ => .c
  | .c2 => .top

noncomputable def m3ChainCompleteEmbedding (k : Fin 3) : CompleteLatticeEmbedding Chain3 M3 where
  toFun := m3ChainEmb k
  injective := by
    rcases k with ⟨n, hn⟩
    intro x y h
    match n with
    | 0 | 1 | 2 => cases x <;> cases y <;> cases h <;> rfl
    | n + 3 => omega
  map_sInf := by
    intro S
    apply le_antisymm'
    · apply le_sInf
      rintro _ ⟨x, hx, rfl⟩
      have hle : CompleteLattice.le (CompleteLattice.sInf S) x := sInf_le hx
      rcases k with ⟨n, hn⟩
      revert hle
      generalize CompleteLattice.sInf S = z
      match n with
      | 0 | 1 | 2 => dsimp only [m3ChainEmb]; cases z <;> cases x <;> decide
      | n + 3 => omega
    · generalize hp : CompleteLattice.sInf (fun p => ∃ x, S x ∧ m3ChainEmb k x = p) = p
      by_cases hc0 : S .c0
      · have hp_le : CompleteLattice.le p (m3ChainEmb k .c0) :=
          hp ▸ sInf_le ⟨.c0, hc0, rfl⟩
        have hs_eq : CompleteLattice.sInf S = .c0 :=
          le_antisymm' (sInf_le hc0) (by generalize CompleteLattice.sInf S = z; cases z <;> decide)
        rw [hs_eq]; exact hp_le
      · by_cases hc1 : S .c1
        · have hp_le : CompleteLattice.le p (m3ChainEmb k .c1) :=
            hp ▸ sInf_le ⟨.c1, hc1, rfl⟩
          have hs_eq : CompleteLattice.sInf S = .c1 := by
            apply le_antisymm' (sInf_le hc1)
            apply le_sInf
            intro x hx; cases x
            · exact False.elim (hc0 hx)
            · decide
            · decide
          rw [hs_eq]; exact hp_le
        · have hs_eq : CompleteLattice.sInf S = .c2 := by
            apply le_antisymm' (by generalize CompleteLattice.sInf S = z; cases z <;> decide)
            apply le_sInf
            intro x hx; cases x
            · exact False.elim (hc0 hx)
            · exact False.elim (hc1 hx)
            · decide
          rw [hs_eq]
          change m3Le p .top = true
          cases p <;> decide
  map_sSup := by
    intro S
    apply le_antisymm'
    · generalize hp : CompleteLattice.sSup (fun p => ∃ x, S x ∧ m3ChainEmb k x = p) = p
      by_cases hc2 : S .c2
      · have hle_p : CompleteLattice.le (m3ChainEmb k .c2) p :=
          hp ▸ le_sSup ⟨.c2, hc2, rfl⟩
        have hs_eq : CompleteLattice.sSup S = .c2 :=
          le_antisymm' (by generalize CompleteLattice.sSup S = z; cases z <;> decide) (le_sSup hc2)
        rw [hs_eq]; exact hle_p
      · by_cases hc1 : S .c1
        · have hle_p : CompleteLattice.le (m3ChainEmb k .c1) p :=
            hp ▸ le_sSup ⟨.c1, hc1, rfl⟩
          have hs_eq : CompleteLattice.sSup S = .c1 := by
            apply le_antisymm'
            · apply sSup_le
              intro x hx; cases x
              · decide
              · decide
              · exact False.elim (hc2 hx)
            · exact le_sSup hc1
          rw [hs_eq]; exact hle_p
        · have hs_eq : CompleteLattice.sSup S = .c0 := by
            apply le_antisymm'
            · apply sSup_le
              intro x hx; cases x
              · decide
              · exact False.elim (hc1 hx)
              · exact False.elim (hc2 hx)
            · generalize CompleteLattice.sSup S = z; cases z <;> decide
          rw [hs_eq]
          change m3Le .bot p = true
          cases p <;> decide
    · apply sSup_le
      rintro _ ⟨x, hx, rfl⟩
      have hle : CompleteLattice.le x (CompleteLattice.sSup S) := le_sSup hx
      rcases k with ⟨n, hn⟩
      revert hle
      generalize CompleteLattice.sSup S = z
      match n with
      | 0 | 1 | 2 => dsimp only [m3ChainEmb]; cases x <;> cases z <;> decide
      | n + 3 => omega

/-- Literal Reading 1A of "generated by complete chain products": `L` is internally generated
    (as a complete lattice, indeed already as a set union!) by embedded complete chain products,
    yet `M3` satisfies this and fails complete distributivity! -/
def InternallyGeneratedByChainProducts (L : Type u) [CompleteLattice L] : Prop :=
  ∃ (K : Type u) (A : K → Type u) (C : (k : K) → A k → Type u)
    (_ : ∀ k a, CompleteLattice (C k a)),
    (∀ k a, IsChain (C k a)) ∧
    ∃ (emb : (k : K) → CompleteLatticeEmbedding ((a : A k) → C k a) L),
      ∀ x : L, ∃ (k : K) (p : (a : A k) → C k a), (emb k).toFun p = x

theorem M3_internallyGeneratedByChainProducts : InternallyGeneratedByChainProducts M3 := by
  let unitEmb : ∀ k : Fin 3, CompleteLatticeEmbedding ((_ : Unit) → Chain3) M3 := fun k => {
    toFun := fun f => (m3ChainCompleteEmbedding k).toFun (f ())
    injective := fun f g h => funext (fun u => by
      cases u; exact (m3ChainCompleteEmbedding k).injective h)
    map_sInf := fun S => by
      have h1 : CompleteLattice.sInf S () = CompleteLattice.sInf (fun c => ∃ f, S f ∧ f () = c) :=
        rfl
      rw [h1, (m3ChainCompleteEmbedding k).map_sInf]
      apply le_antisymm'
      · apply le_sInf
        rintro _ ⟨f, hf, rfl⟩
        exact sInf_le ⟨f (), ⟨f, hf, rfl⟩, rfl⟩
      · apply le_sInf
        rintro _ ⟨c, ⟨f, hf, rfl⟩, rfl⟩
        exact sInf_le ⟨f, hf, rfl⟩
    map_sSup := fun S => by
      have h1 : CompleteLattice.sSup S () = CompleteLattice.sSup (fun c => ∃ f, S f ∧ f () = c) :=
        rfl
      rw [h1, (m3ChainCompleteEmbedding k).map_sSup]
      apply le_antisymm'
      · apply sSup_le
        rintro _ ⟨c, ⟨f, hf, rfl⟩, rfl⟩
        exact le_sSup ⟨f, hf, rfl⟩
      · apply sSup_le
        rintro _ ⟨f, hf, rfl⟩
        exact le_sSup ⟨f (), ⟨f, hf, rfl⟩, rfl⟩
  }
  refine ⟨Fin 3, fun _ => Unit, fun _ _ => Chain3, fun _ _ => inferInstance,
    fun _ _ => isChain_Chain3, unitEmb, ?_⟩
  intro x
  cases x with
  | bot => exact ⟨⟨0, by omega⟩, fun _ => .c0, rfl⟩
  | a   => exact ⟨⟨0, by omega⟩, fun _ => .c1, rfl⟩
  | b   => exact ⟨⟨1, by omega⟩, fun _ => .c1, rfl⟩
  | c   => exact ⟨⟨2, by omega⟩, fun _ => .c1, rfl⟩
  | top => exact ⟨⟨0, by omega⟩, fun _ => .c2, rfl⟩

/-- Literal Clause 1 under Reading 1A is FALSE: `M3` is internally generated by complete
    chain products, yet `M3` is NOT completely distributive. -/
theorem clause1_literal_internal_false :
    ¬ (∀ (L : Type) [CompleteLattice L],
        IsCompletelyDistributive L ↔ InternallyGeneratedByChainProducts L) := by
  intro h
  exact not_isCompletelyDistributive_M3 ((h M3).mpr M3_internallyGeneratedByChainProducts)

/-- Literal Reading 1B of "generated by complete chain products": `L` is a surjective
    complete-join homomorphic image (closure quotient) of a direct product of complete chains. -/
def CompleteJoinQuotientOfChainProduct (L : Type u) [CompleteLattice L] : Prop :=
  ∃ (A : Type u) (C : A → Type u) (_ : ∀ a, CompleteLattice (C a)),
    (∀ a, IsChain (C a)) ∧
    ∃ (π : ((a : A) → C a) → L),
      Surjective π ∧
      ∀ S : ((a : A) → C a) → Prop,
        π (CompleteLattice.sSup S) = CompleteLattice.sSup (fun y => ∃ p, S p ∧ π p = y)

def m3JoinQuotient (f : Fin 3 → Chain2) : M3 :=
  match f 0, f 1, f 2 with
  | false, false, false => .bot
  | true,  false, false => .a
  | false, true,  false => .b
  | false, false, true  => .c
  | _,     _,     _     => .top

def m3JoinRightAdjoint (y : M3) : Fin 3 → Chain2 := fun i =>
  match y, i.val with
  | .bot, _ => false
  | .a,   0 => true
  | .a,   _ => false
  | .b,   1 => true
  | .b,   _ => false
  | .c,   2 => true
  | .c,   _ => false
  | .top, _ => true

theorem m3JoinQuotient_galois (f : Fin 3 → Chain2) (y : M3) :
    CompleteLattice.le (m3JoinQuotient f) y ↔
    CompleteLattice.le f (m3JoinRightAdjoint y) := by
  change m3Le (m3JoinQuotient f) y = true ↔ ∀ i : Fin 3, chain2Le (f i) (m3JoinRightAdjoint y i) = true
  have h0 : f 0 = true ∨ f 0 = false := by cases f 0 <;> simp
  have h1 : f 1 = true ∨ f 1 = false := by cases f 1 <;> simp
  have h2 : f 2 = true ∨ f 2 = false := by cases f 2 <;> simp
  rcases h0 with h0 | h0 <;> rcases h1 with h1 | h1 <;> rcases h2 with h2 | h2 <;> cases y
  all_goals
    simp only [m3JoinQuotient, h0, h1, h2]
    constructor
    · intro h ⟨i, hi⟩
      match i with
      | 0 => change chain2Le (f 0) (m3JoinRightAdjoint _ 0) = true; rw [h0]; revert h; decide
      | 1 => change chain2Le (f 1) (m3JoinRightAdjoint _ 1) = true; rw [h1]; revert h; decide
      | 2 => change chain2Le (f 2) (m3JoinRightAdjoint _ 2) = true; rw [h2]; revert h; decide
      | n + 3 => omega
    · intro h
      have c0 : chain2Le (f 0) (m3JoinRightAdjoint _ 0) = true := h 0
      have c1 : chain2Le (f 1) (m3JoinRightAdjoint _ 1) = true := h 1
      have c2 : chain2Le (f 2) (m3JoinRightAdjoint _ 2) = true := h 2
      rw [h0] at c0; rw [h1] at c1; rw [h2] at c2
      revert c0 c1 c2
      decide

theorem M3_completeJoinQuotientOfChainProduct : CompleteJoinQuotientOfChainProduct M3 := by
  refine ⟨Fin 3, fun _ => Chain2, fun _ => inferInstance, fun _ => isChain_Chain2,
    m3JoinQuotient, ?_, ?_⟩
  · intro y
    refine ⟨m3JoinRightAdjoint y, ?_⟩
    cases y <;> rfl
  · intro S
    apply le_antisymm'
    · rw [m3JoinQuotient_galois]
      apply sSup_le
      intro f hf
      rw [← m3JoinQuotient_galois]
      exact le_sSup ⟨f, hf, rfl⟩
    · apply sSup_le
      rintro _ ⟨f, hf, rfl⟩
      rw [m3JoinQuotient_galois]
      refine le_trans' (le_sSup hf) ?_
      rw [← m3JoinQuotient_galois]
      exact le_refl' _

/-- Literal Clause 1 under Reading 1B is FALSE: `M3` is a surjective complete-join quotient
    of the finite complete chain product `Chain2^3`, yet `M3` fails complete distributivity. -/
theorem clause1_literal_joinQuotient_false :
    ¬ (∀ (L : Type) [CompleteLattice L],
        IsCompletelyDistributive L ↔ CompleteJoinQuotientOfChainProduct L) := by
  intro h
  exact not_isCompletelyDistributive_M3 ((h M3).mpr M3_completeJoinQuotientOfChainProduct)

/-! ## Section 6: Universal Refutations of Clause 2 and Master Disproof Theorem -/

/-- Combinatorial lemma: any type `α` injecting into `Fin 5` that does NOT inject into `Fin 4`
    must map surjectively onto `Fin 5`, yielding `Equiv α (Fin 5)`. -/
noncomputable def equivFin5OfInjectiveFin5NotFin4 {α : Type u}
    (f : α → Fin 5) (hf : Injective f)
    (hnot4 : ¬ ∃ g : α → Fin 4, Injective g) :
    Equiv α (Fin 5) := by
  have hsurj : ∀ k : Fin 5, ∃ a : α, f a = k := by
    intro k
    apply Classical.byContradiction
    intro hk
    apply hnot4
    let g : α → Fin 4 := fun a =>
      if h : (f a).val < k.val then
        ⟨(f a).val, by have := k.isLt; omega⟩
      else
        ⟨(f a).val - 1, by
          have hne : (f a).val ≠ k.val := fun hv => hk ⟨a, Fin.eq_of_val_eq hv⟩
          have := (f a).isLt
          omega⟩
    refine ⟨g, ?_⟩
    intro a1 a2 heq
    have hne1 : (f a1).val ≠ k.val := fun hv => hk ⟨a1, Fin.eq_of_val_eq hv⟩
    have hne2 : (f a2).val ≠ k.val := fun hv => hk ⟨a2, Fin.eq_of_val_eq hv⟩
    dsimp only [g] at heq
    split at heq <;> split at heq
    · have hv : (f a1).val = (f a2).val := by simpa using congrArg Fin.val heq
      exact hf (Fin.eq_of_val_eq hv)
    · have hv : (f a1).val = (f a2).val - 1 := by simpa using congrArg Fin.val heq
      omega
    · have hv : (f a1).val - 1 = (f a2).val := by simpa using congrArg Fin.val heq
      omega
    · have hv : (f a1).val - 1 = (f a2).val - 1 := by simpa using congrArg Fin.val heq
      have hv2 : (f a1).val = (f a2).val := by omega
      exact hf (Fin.eq_of_val_eq hv2)
  exact {
    toFun := f
    invFun := fun k => Classical.choose (hsurj k)
    left_inv := fun a => hf (Classical.choose_spec (hsurj (f a)))
    right_inv := fun k => Classical.choose_spec (hsurj k)
  }

/-- Reading 2-Card of "the smallest complete lattice failing complete distributivity is `L_star`":
    `L_star` fails complete distributivity, injects into every complete lattice `M` failing
    complete distributivity (`|L_star| ≤ |M|`), and is unique up to `OrderIso` at that minimum
    cardinality. -/
def IsUniqueSmallestNonCDByCard (L_star : Type) [CompleteLattice L_star] : Prop :=
  ¬ IsCompletelyDistributive L_star ∧
  ∀ (M : Type) [CompleteLattice M], ¬ IsCompletelyDistributive M →
    (∃ i : L_star → M, Injective i) ∧
    (Nonempty (Equiv L_star M) → Nonempty (OrderIso L_star M))

/-- **Universal Refutation of Clause 2 (Cardinality + Uniqueness)**:
    NO complete lattice `L_star` whatsoever is the unique smallest complete lattice failing
    complete distributivity! -/
theorem clause2_false_by_cardinality (L_star : Type) [CompleteLattice L_star] :
    ¬ IsUniqueSmallestNonCDByCard L_star := by
  rintro ⟨hnotCD, hmin⟩
  rcases (hmin M3 not_isCompletelyDistributive_M3).1 with ⟨iM3, hiM3⟩
  let f5 : L_star → Fin 5 := fun x => equivM3Fin5.toFun (iM3 x)
  have hf5 : Injective f5 := fun _ _ h => hiM3 (equivM3Fin5.injective h)
  have hnot4 : ¬ ∃ g : L_star → Fin 4, Injective g := by
    rintro ⟨g, hg⟩
    exact hnotCD (completelyDistributive_of_injective_fin_le_four (Nat.le_refl 4) g hg)
  let eq5 : Equiv L_star (Fin 5) := equivFin5OfInjectiveFin5NotFin4 f5 hf5 hnot4
  have eqM3 : Nonempty (Equiv L_star M3) := ⟨eq5.trans equivM3Fin5.symm⟩
  have eqN5 : Nonempty (Equiv L_star N5) := ⟨eq5.trans equivN5Fin5.symm⟩
  rcases (hmin M3 not_isCompletelyDistributive_M3).2 eqM3 with ⟨isoM3⟩
  rcases (hmin N5 not_isCompletelyDistributive_N5).2 eqN5 with ⟨isoN5⟩
  exact not_orderIso_M3_N5 ⟨isoM3.symm.trans isoN5⟩

/-- Reading 2-Emb of "the smallest complete lattice failing complete distributivity is `L_star`":
    `L_star` fails complete distributivity and order-embeds (which includes sublattice and
    complete-sublattice embeddings as special cases!) into every complete lattice `M` failing
    complete distributivity. -/
def IsSmallestNonCDByOrderEmbedding (L_star : Type) [CompleteLattice L_star] : Prop :=
  ¬ IsCompletelyDistributive L_star ∧
  ∀ (M : Type) [CompleteLattice M], ¬ IsCompletelyDistributive M →
    ∃ e : L_star → M, ∀ x y : L_star,
      CompleteLattice.le x y ↔ CompleteLattice.le (e x) (e y)

/-- **Universal Refutation of Clause 2 (Order / Sublattice Embedding Minimality)**:
    NO complete lattice `L_star` failing complete distributivity order-embeds into every
    complete lattice failing complete distributivity! -/
theorem clause2_false_by_embedding (L_star : Type) [CompleteLattice L_star] :
    ¬ IsSmallestNonCDByOrderEmbedding L_star := by
  rintro ⟨hnotCD, hemb⟩
  have hnot4 : ¬ ∃ g : L_star → Fin 4, Injective g := by
    rintro ⟨g, hg⟩
    exact hnotCD (completelyDistributive_of_injective_fin_le_four (Nat.le_refl 4) g hg)
  have mkIso : ∀ (M : Type) [CompleteLattice M] (eqM : Equiv M (Fin 5))
      (e : L_star → M),
      (∀ x y : L_star, CompleteLattice.le x y ↔ CompleteLattice.le (e x) (e y)) →
      OrderIso L_star M := by
    intro M _ eqM e he
    have hinj : Injective e := by
      intro x y hxy
      apply le_antisymm'
      · exact (he x y).mpr (hxy ▸ le_refl' (e x))
      · exact (he y x).mpr (hxy ▸ le_refl' (e x))
    let f5 : L_star → Fin 5 := fun x => eqM.toFun (e x)
    have hf5 : Injective f5 := fun _ _ h => hinj (eqM.injective h)
    let eq5 := equivFin5OfInjectiveFin5NotFin4 f5 hf5 hnot4
    have hsurj : ∀ m : M, ∃ x : L_star, e x = m := by
      intro m
      refine ⟨eq5.invFun (eqM.toFun m), ?_⟩
      apply eqM.injective
      exact eq5.right_inv (eqM.toFun m)
    exact {
      toFun := e
      invFun := fun m => Classical.choose (hsurj m)
      left_inv := fun x => hinj (Classical.choose_spec (hsurj (e x)))
      right_inv := fun m => Classical.choose_spec (hsurj m)
      map_le_iff := fun x y => (he x y).symm
    }
  rcases hemb M3 not_isCompletelyDistributive_M3 with ⟨e1, he1⟩
  rcases hemb N5 not_isCompletelyDistributive_N5 with ⟨e2, he2⟩
  let isoM3 := mkIso M3 equivM3Fin5 e1 he1
  let isoN5 := mkIso N5 equivN5Fin5 e2 he2
  exact not_orderIso_M3_N5 ⟨isoM3.symm.trans isoN5⟩

/-- Explicit specialization to Reading 2A (`OrderDual M3`, dual of the Dedekind–MacNeille /
    bounded completion of the 3-element antichain) and Reading 2B (`DualDownSetA3`, dual of
    the down-set completion `O(A_3)`). -/
theorem explicit_antichain_constructions_fail_clause2 :
    ¬ IsUniqueSmallestNonCDByCard (OrderDual M3) ∧
    ¬ IsSmallestNonCDByOrderEmbedding (OrderDual M3) ∧
    IsCompletelyDistributive DualDownSetA3 ∧
    ¬ IsUniqueSmallestNonCDByCard DualDownSetA3 ∧
    ¬ IsSmallestNonCDByOrderEmbedding DualDownSetA3 :=
  ⟨clause2_false_by_cardinality (OrderDual M3),
   clause2_false_by_embedding (OrderDual M3),
   isCompletelyDistributive_DualDownSetA3,
   clause2_false_by_cardinality DualDownSetA3,
   clause2_false_by_embedding DualDownSetA3⟩

/-- **Master Disproof of Conjecture 00000008559**:
    For ANY proposition `Clause1 : Prop` (whether the literal internal chain-product generation
    equivalence, the complete-join quotient equivalence, or Raney's charitable complete-sublattice
    equivalence!) and ANY candidate complete lattice `L_star : Type` representing "the dual of the
    three-element antichain construction", the conjunction `Clause1 ∧ Clause2(L_star)` is FALSE
    under both cardinality-minimality and order-embedding minimality! -/
theorem conjecture_00000008559_disproved
    (Clause1 : Prop) (L_star : Type) [CompleteLattice L_star] :
    ¬ (Clause1 ∧ IsUniqueSmallestNonCDByCard L_star) ∧
    ¬ (Clause1 ∧ IsSmallestNonCDByOrderEmbedding L_star) :=
  ⟨fun ⟨_, h2⟩ => clause2_false_by_cardinality L_star h2,
   fun ⟨_, h2⟩ => clause2_false_by_embedding L_star h2⟩

end Conjecture00000008559

