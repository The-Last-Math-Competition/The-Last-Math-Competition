/-!
# A one-variable counterexample to the claimed Veronese F-signature asymptotics

The ring is the actual F₂-subalgebra of F₂[X] generated by all degree-d monomials.
For every positive d and every e, its actual e-th Frobenius restriction-of-scalars
module is proved free of rank 2^e. The maximal rank of a split free summand is
computed from actual linear injections and retractions. Since the actual Krull
dimension is one, the normalized splitting counts are all one, so their limit is
one. This contradicts the asserted d^(-1)(1+c/d+O(d^(-2))) asymptotic for n=1.
-/


noncomputable section
open Polynomial Filter
open scoped Topology
namespace Conjecture3904

abbrev K := ZMod 2
abbrev R := Polynomial K

def veronese (d : ℕ) : Subalgebra K R := Algebra.adjoin K {X ^ d}

theorem expand_range (d : ℕ) : (expand K d).range = veronese d := by
  rw [veronese, Algebra.adjoin_singleton_eq_range_aeval]
  rfl

noncomputable def veroneseEquiv (d : ℕ) (hd : 0 < d) : R ≃ₐ[K] veronese d :=
  (AlgEquiv.ofInjective (expand K d) (expand_injective hd)).trans
    (Subalgebra.equivOfEq _ _ (expand_range d))

theorem veroneseEquiv_coe (d : ℕ) (hd : 0 < d) (f : R) :
    (veroneseEquiv d hd f : R) = expand K d f := rfl

theorem coefficient_frobenius : frobenius K 2 = 1 := by
  ext x
  fin_cases x <;> decide

theorem expand_pow_two (e : ℕ) (f : R) : expand K (2 ^ e) f = f ^ (2 ^ e) := by
  have h := map_expand_pow_char (R := K) 2 f e
  rw [coefficient_frobenius, one_pow] at h
  simpa only [RingHom.one_def, Polynomial.map_id] using h


/-- The underlying additive group, with scalar action restricted along `X ↦ X^q`. -/
def Push (_q : ℕ) : Type := R
instance (q : ℕ) : AddCommGroup (Push q) := inferInstanceAs (AddCommGroup R)
instance (q : ℕ) : Module R (Push q) := Module.compHom R (expand K q).toRingHom

def synth (q : ℕ) : (Fin q → R) →ₗ[R] Push q where
  toFun f := ∑ i : Fin q, expand K q (f i) * X ^ i.val
  map_add' f g := by simp [Finset.sum_add_distrib, add_mul]
  map_smul' r f := by
    change (∑ i : Fin q, expand K q (r * f i) * X ^ i.val) =
      expand K q r * ∑ i : Fin q, expand K q (f i) * X ^ i.val
    simp [Finset.mul_sum, mul_assoc]


theorem coeff_synth (q : ℕ) (hq : 0 < q) (f : Fin q → R) (i : Fin q) (n : ℕ) :
    (synth q f : R).coeff (q * n + i.val) = (f i).coeff n := by
  change (∑ j : Fin q, expand K q (f j) * X ^ j.val).coeff (q * n + i.val) = _
  rw [finset_sum_coeff, Finset.sum_eq_single i]
  · rw [coeff_mul_X_pow, coeff_expand_mul' hq]
  · intro j _ hji
    rw [coeff_mul_X_pow']
    split_ifs with hj
    · rw [coeff_expand hq, if_neg]
      intro hdiv
      obtain ⟨k, hk⟩ := hdiv
      have he : q*n+i.val = q*k+j.val := by omega
      have hm := congrArg (fun z : ℕ => z % q) he
      have hij : i.val = j.val := by
        simpa [Nat.add_mod, Nat.mod_eq_of_lt i.isLt, Nat.mod_eq_of_lt j.isLt] using hm
      exact hji (Fin.ext hij.symm)
    · rfl
  · simp

theorem synth_injective (q : ℕ) (hq : 0 < q) : Function.Injective (synth q) := by
  intro f g h
  funext i
  ext n
  have he := congrArg (fun p : Push q => (p : R).coeff (q*n+i.val)) h
  simpa only [coeff_synth q hq] using he

theorem synth_single (q : ℕ) (i : Fin q) (p : R) :
    (synth q (Pi.single i p) : R) = expand K q p * X ^ i.val := by
  change (∑ j : Fin q, expand K q ((Pi.single i p : Fin q → R) j) * X ^ j.val) = _
  rw [Finset.sum_eq_single i]
  · simp
  · intro j _ hji
    simp [Pi.single_eq_of_ne hji]
  · simp

theorem synth_surjective (q : ℕ) (hq : 0 < q) : Function.Surjective (synth q) := by
  intro p
  change ∃ f, (synth q f : R) = p
  induction p using Polynomial.induction_on' with
  | add p r hp hr =>
    obtain ⟨f, hf⟩ := hp
    obtain ⟨g, hg⟩ := hr
    exact ⟨f+g, by rw [map_add]; exact congrArg₂ (·+·) hf hg⟩
  | monomial n a =>
    let i : Fin q := ⟨n%q, Nat.mod_lt n hq⟩
    refine ⟨Pi.single i (monomial (n/q) a), ?_⟩
    rw [synth_single, expand_monomial, monomial_mul_X_pow]
    have hn : n/q*q + i.val = n := by
      dsimp [i]
      simpa [Nat.add_comm, Nat.mul_comm] using Nat.mod_add_div n q
    rw [hn]

noncomputable def pushEquiv (q : ℕ) (hq : 0 < q) : (Fin q → R) ≃ₗ[R] Push q :=
  LinearEquiv.ofBijective (synth q) ⟨synth_injective q hq, synth_surjective q hq⟩

noncomputable def pushBasis (q : ℕ) (hq : 0 < q) : Basis (Fin q) R (Push q) :=
  Basis.ofEquivFun (pushEquiv q hq).symm

theorem push_finrank (q : ℕ) (hq : 0 < q) : Module.finrank R (Push q) = q := by
  simpa using Module.finrank_eq_card_basis (pushBasis q hq)

instance (d : ℕ) : CharP (veronese d) 2 :=
  charP_of_injective_algebraMap' K (veronese d) 2

def VPush (d _e : ℕ) : Type := veronese d
instance (d e : ℕ) : AddCommGroup (VPush d e) :=
  inferInstanceAs (AddCommGroup (veronese d))
instance (d e : ℕ) : Module (veronese d) (VPush d e) :=
  Module.compHom (veronese d) (iterateFrobenius (veronese d) 2 e)

def vPushUnderlying (d e : ℕ) (m : VPush d e) : veronese d := m

theorem vPush_smul (d e : ℕ) (a : veronese d) (m : VPush d e) :
    vPushUnderlying d e (a • m) = a ^ (2^e) * vPushUnderlying d e m := rfl

def vSynth (d : ℕ) (hd : 0 < d) (e : ℕ) :
    (Fin (2^e) → veronese d) →ₗ[veronese d] VPush d e where
  toFun f := veroneseEquiv d hd (synth (2^e) (fun i => (veroneseEquiv d hd).symm (f i)))
  map_add' f g := by
    simp only [Pi.add_apply, map_add]
    change veroneseEquiv d hd (synth (2^e)
      ((fun i => (veroneseEquiv d hd).symm (f i)) +
        (fun i => (veroneseEquiv d hd).symm (g i)))) = _
    rw [map_add, map_add]
  map_smul' a f := by
    change veroneseEquiv d hd (synth (2^e) (fun i =>
      (veroneseEquiv d hd).symm (a * f i))) =
      a ^ (2^e) * veroneseEquiv d hd (synth (2^e) (fun i =>
        (veroneseEquiv d hd).symm (f i)))
    have he : (fun i => (veroneseEquiv d hd).symm (a * f i)) =
        (veroneseEquiv d hd).symm a • (fun i => (veroneseEquiv d hd).symm (f i)) := by
      funext i
      simp only [map_mul, Pi.smul_apply, smul_eq_mul]
    rw [he, map_smul]
    change veroneseEquiv d hd (expand K (2^e) ((veroneseEquiv d hd).symm a) * _) = _
    rw [expand_pow_two, map_mul, map_pow, AlgEquiv.apply_symm_apply]

theorem vSynth_bijective (d : ℕ) (hd : 0 < d) (e : ℕ) :
    Function.Bijective (vSynth d hd e) := by
  constructor
  · intro f g h
    have hs := (veroneseEquiv d hd).injective h
    have hc := synth_injective (2^e) (by positivity) hs
    funext i
    exact (veroneseEquiv d hd).symm.injective (congrFun hc i)
  · intro y
    obtain ⟨f, hf⟩ := synth_surjective (2^e) (by positivity) ((veroneseEquiv d hd).symm y)
    use fun i => veroneseEquiv d hd (f i)
    change veroneseEquiv d hd (synth (2^e) (fun i =>
      (veroneseEquiv d hd).symm (veroneseEquiv d hd (f i)))) = y
    simp only [AlgEquiv.symm_apply_apply]
    rw [hf, AlgEquiv.apply_symm_apply]

noncomputable def veroneseFrobeniusEquiv (d : ℕ) (hd : 0 < d) (e : ℕ) :
    (Fin (2^e) → veronese d) ≃ₗ[veronese d] VPush d e :=
  LinearEquiv.ofBijective (vSynth d hd e) (vSynth_bijective d hd e)

theorem veroneseFrobeniusEquiv_single (d : ℕ) (hd : 0 < d) (e : ℕ)
    (i : Fin (2^e)) :
    (vPushUnderlying d e ((veroneseFrobeniusEquiv d hd e) (Pi.single i 1)) : R) =
      X ^ (d * i.val) := by
  change expand K d (synth (2^e) (fun j => (veroneseEquiv d hd).symm
    ((Pi.single i 1 : Fin (2^e) → veronese d) j))) = _
  have hi : (fun j => (veroneseEquiv d hd).symm
      ((Pi.single i 1 : Fin (2^e) → veronese d) j)) =
      (Pi.single i 1 : Fin (2^e) → R) := by
    funext j
    by_cases h : j = i
    · subst j; simp
    · simp [Pi.single_eq_of_ne h]
  rw [hi, synth_single]
  simp only [map_one, one_mul, map_pow, expand_X, pow_mul]

theorem veronese_noetherian (d : ℕ) (hd : 0 < d) : IsNoetherianRing (veronese d) :=
  isNoetherianRing_of_ringEquiv R (veroneseEquiv d hd).toRingEquiv

section FreeRank
variable (A M : Type*) [CommRing A] [AddCommGroup M] [Module A M]

/-- Ranks of actual free direct summands, expressed by a split linear injection. -/
def freeSummandRanks : Set ℕ := {n | ∃ (i : (Fin n → A) →ₗ[A] M)
  (r : M →ₗ[A] (Fin n → A)), r.comp i = LinearMap.id}

noncomputable def freeRank : ℕ := sSup (freeSummandRanks A M)

variable [StrongRankCondition A] [Module.Finite A M]

theorem freeSummandRanks_bounded : BddAbove (freeSummandRanks A M) := by
  use Module.finrank A M
  rintro n ⟨i, r, hr⟩
  have hi : Function.Injective i := by
    apply Function.LeftInverse.injective (f := i) (g := r)
    intro x
    exact LinearMap.congr_fun hr x
  simpa only [Module.finrank_pi, Fintype.card_fin] using
    LinearMap.finrank_le_finrank_of_injective hi

theorem freeRank_eq_of_equiv (n : ℕ) (E : (Fin n → A) ≃ₗ[A] M) : freeRank A M = n := by
  have hmem : n ∈ freeSummandRanks A M := by
    refine ⟨E.toLinearMap, E.symm.toLinearMap, ?_⟩
    apply LinearMap.ext
    intro x
    exact E.symm_apply_apply x
  apply le_antisymm
  · apply csSup_le
    · exact ⟨n, hmem⟩
    · rintro k ⟨i, r, hr⟩
      have hi : Function.Injective i := by
        apply Function.LeftInverse.injective (f := i) (g := r)
        intro x
        exact LinearMap.congr_fun hr x
      have he : Module.finrank A M = n := by
        rw [← E.finrank_eq]
        simp only [Module.finrank_pi, Fintype.card_fin]
      have hb := LinearMap.finrank_le_finrank_of_injective hi
      simpa only [Module.finrank_pi, Fintype.card_fin, he] using hb
  · exact le_csSup (freeSummandRanks_bounded A M) hmem
end FreeRank


theorem polynomial_dimension : ringKrullDim R = 1 := by
  haveI : Ring.KrullDimLE 1 R := Ring.KrullDimLE.mk₁' fun I hI hp => by
    exact hp.isMaximal hI
  have hu : ringKrullDim R ≤ 1 := (Order.krullDimLE_iff 1 (PrimeSpectrum R)).mp inferInstance
  have hl := ringKrullDim_succ_le_ringKrullDim_polynomial (R := K)
  rw [ringKrullDim_eq_zero_of_field, zero_add] at hl
  exact le_antisymm hu hl

theorem veronese_dimension (d : ℕ) (hd : 0 < d) : ringKrullDim (veronese d) = 1 := by
  rw [← ringKrullDim_eq_of_ringEquiv (veroneseEquiv d hd).toRingEquiv, polynomial_dimension]

theorem degree_d_monomials_adjoin (d : ℕ) :
    Algebra.adjoin K (Set.range fun a : K => monomial d a) = veronese d := by
  apply le_antisymm
  · apply Algebra.adjoin_le
    rintro _ ⟨a, rfl⟩
    change monomial d a ∈ veronese d
    rw [← C_mul_X_pow_eq_monomial]
    exact (veronese d).mul_mem ((veronese d).algebraMap_mem a)
      (Algebra.subset_adjoin (by simp))
  · apply Algebra.adjoin_le
    rintro p (rfl : p = X ^ d)
    apply Algebra.subset_adjoin
    exact ⟨1, monomial_one_right_eq_X_pow d⟩

theorem veronese_splitting_number (d : ℕ) (hd : 0 < d) (e : ℕ) :
    freeRank (veronese d) (VPush d e) = 2 ^ e := by
  letI : Module.Finite (veronese d) (VPush d e) :=
    Module.Finite.of_surjective (vSynth d hd e) (vSynth_bijective d hd e).2
  exact freeRank_eq_of_equiv _ _ _ (veroneseFrobeniusEquiv d hd e)

/-- The actual normalized free-summand count of the `e`th Frobenius pushforward.
The dimension-one denominator is justified by `veronese_dimension`; the coefficient field F₂
is perfect, so the residue-field correction in the normalization is one. -/
def signatureApprox (d e : ℕ) : ℝ :=
  (freeRank (veronese d) (VPush d e) : ℝ) / (2 : ℝ)^e

/-- F-signature computed as the limit of actual Frobenius splitting counts. -/
noncomputable def fSignature (d : ℕ) : ℝ := limUnder atTop (signatureApprox d)

theorem signatureApprox_eq_one (d : ℕ) (hd : 0 < d) (e : ℕ) : signatureApprox d e = 1 := by
  simp only [signatureApprox, veronese_splitting_number d hd, Nat.cast_pow, Nat.cast_ofNat]
  exact div_self (by positivity)

theorem signatureApprox_tendsto (d : ℕ) (hd : 0 < d) :
    Tendsto (signatureApprox d) atTop (𝓝 1) := by
  have he : signatureApprox d = (fun _ : ℕ => (1 : ℝ)) :=
    funext (signatureApprox_eq_one d hd)
  rw [he]
  exact tendsto_const_nhds

theorem fSignature_eq_one (d : ℕ) (hd : 0 < d) : fSignature d = 1 :=
  (signatureApprox_tendsto d hd).limUnder_eq

theorem no_claimed_asymptotic :
    ¬ ∃ (c : ℝ) (r : ℕ → ℝ),
      Asymptotics.IsBigO atTop r (fun d : ℕ => (1 : ℝ) / (d : ℝ)^2) ∧
      ∀ᶠ d : ℕ in atTop, fSignature d = (1 : ℝ) / d * (1 + c / d + r d) := by
  rintro ⟨c, r, hr, he⟩
  have hi : Tendsto (fun d : ℕ => (1 : ℝ) / d) atTop (𝓝 0) := by
    simpa only [one_div] using tendsto_inv_atTop_zero.comp
      (tendsto_natCast_atTop_atTop : Tendsto (fun d : ℕ => (d : ℝ)) atTop atTop)
  have hi2 : Tendsto (fun d : ℕ => (1 : ℝ) / (d : ℝ)^2) atTop (𝓝 0) := by
    simpa only [div_pow, one_pow, zero_pow (by decide : 2 ≠ 0)] using hi.pow 2
  have hrem := hr.trans_tendsto hi2
  have hc : Tendsto (fun d : ℕ => c / (d : ℝ)) atTop (𝓝 0) := by
    simpa only [mul_one_div, mul_zero] using hi.const_mul c
  have hp : Tendsto (fun d : ℕ => (1 : ℝ) / d * (1 + c / d + r d)) atTop (𝓝 0) := by
    simpa only [zero_add, add_zero, zero_mul] using hi.mul
      (((tendsto_const_nhds : Tendsto (fun _ : ℕ => (1 : ℝ)) atTop (𝓝 1)).add hc).add hrem)
  have hs : Tendsto fSignature atTop (𝓝 1) := by
    apply Tendsto.congr' _ tendsto_const_nhds
    filter_upwards [eventually_ge_atTop 1] with d hd
    exact (fSignature_eq_one d hd).symm
  have hz : Tendsto fSignature atTop (𝓝 0) := hp.congr' (he.mono fun _ h => h.symm)
  have hbad : (1 : ℝ) = 0 := tendsto_nhds_unique hs hz
  norm_num at hbad

